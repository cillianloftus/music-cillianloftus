---
import JobTray from '../components/JobTray.astro';
import SearchOverlay from '../components/SearchOverlay.astro';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import { THEME_COOKIE, themeFrom } from '../lib/theme';

interface Props {
  title: string;
  description?: string;
  /** A picture for link previews: a stored cover path such as /art/release/x/1200.jpg. */
  image?: string | null;
}

const { title, description = 'Albums and tracks, rated by Cillian Loftus.', image = null } = Astro.props;
const absolute = (path: string) => new URL(path, Astro.url.origin).toString();
const theme = themeFrom(Astro.cookies.get(THEME_COOKIE)?.value);
const fullTitle = title === 'music' ? 'music · Cillian Loftus' : `${title} · music · Cillian Loftus`;
---

<!doctype html>
<html lang="en-IE" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:site_name" content="music · Cillian Loftus" />
    <meta property="og:title" content={title === 'music' ? 'music · Cillian Loftus' : title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={absolute(Astro.url.pathname)} />
    <meta property="og:type" content="website" />
    {image && <meta property="og:image" content={absolute(image)} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <link rel="canonical" href={absolute(Astro.url.pathname)} />
    <meta name="theme-color" content={theme === 'light' ? '#f6f3ec' : '#0e0e10'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <script is:inline>
      // The text size chosen on Manage, applied before anything paints.
      try {
        const scale = Number(localStorage.getItem('ui-scale'));
        if (scale >= 0.7 && scale <= 1.5) document.documentElement.style.setProperty('--ui-scale', String(scale));
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader theme={theme} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {Astro.locals.user && <JobTray />}
    <SearchOverlay />
    <script>
      // Every pop-up menu (a <details data-menu>) closes on a click or tap
      // anywhere outside it, on Escape, and when another one opens.
      const menus = () => [...document.querySelectorAll<HTMLDetailsElement>('details[data-menu][open]')];
      document.addEventListener('click', (event) => {
        for (const menu of menus()) if (!menu.contains(event.target as Node)) menu.open = false;
      });
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        for (const menu of menus()) {
          menu.open = false;
          menu.querySelector('summary')?.focus();
        }
      });
      document.addEventListener(
        'toggle',
        (event) => {
          const opened = event.target as HTMLDetailsElement;
          if (!opened.matches?.('details[data-menu]') || !opened.open) return;
          for (const menu of menus()) if (menu !== opened && !menu.contains(opened)) menu.open = false;
        },
        true,
      );

      // Installable as an app (public/sw.js). Not in development, where a
      // worker would outlive code changes.
      if (import.meta.env.PROD && 'serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js').catch(() => {});
      }
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    z-index: 10;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-s);
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 600;
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }

  /* A stacking context of its own, so page backdrops (z-index -1) sit
     behind the content but above the page background. */
  main {
    position: relative;
    isolation: isolate;
    padding-block: var(--space-5) var(--space-7);
  }

  main:focus {
    outline: none;
  }
</style>
