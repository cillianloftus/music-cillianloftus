---
import { pictureAt } from '../../lib/pictures';
/**
 * A genre: where it sits (every parent, since a genre can belong to more
 * than one), what sits beneath it, and the best of it in the library.
 * Only what is tagged with the genre itself by default (an art pop song is
 * not thereby a pop song); ?beneath=1 counts its subgenres too.
 */
import Base from '../../layouts/Base.astro';
import Findings from '../../components/Findings.astro';
import { discover, trackFacts } from '../../lib/discover';
import AlbumCard from '../../components/AlbumCard.astro';
import CardGrid from '../../components/CardGrid.astro';
import Segmented from '../../components/Segmented.astro';
import ResultList from '../../components/ResultList.astro';
import { hueOf } from '../../lib/art/playlist';
import { ownerId } from '../../lib/auth/user';
import { genreAlbums, genreArtists, genreDetail, genreTopTracks } from '../../lib/pages';
import GenreMosaic from '../../components/GenreMosaic.astro';
import { buildGenreTree, genreSubtreeRows } from '../../lib/genres';
import Score from '../../components/Score.astro';
import { encodeDefinition } from '../../lib/query/builder';
import { hydrateTracks } from '../../lib/query/run';
import { redirectFor } from '../../lib/catalogue';

const id = Astro.params.id!;
const deep = Astro.url.searchParams.get('beneath') === '1';
const genre = await genreDetail(id, deep);
if (!genre) {
  // Merged into another genre by a rename: its old address leads there.
  const merged = await redirectFor('genre', id);
  if (merged) return Astro.redirect(`/genre/${merged}${Astro.url.search}`, 301);
  return Astro.rewrite('/404');
}

const user = Astro.locals.user;
const viewerId = user?.id ?? (await ownerId());
const [albums, trackIds, artists, subtree] = await Promise.all([
  genreAlbums(id, viewerId, 18, deep),
  genreTopTracks(id, viewerId, 10, deep),
  genreArtists(id, viewerId, 8, deep),
  // Its subgenres as a map, once there are enough to be worth one.
  genre.children.length > 3 ? genreSubtreeRows(id).then(buildGenreTree) : Promise.resolve([]),
]);
const [tracks, genreFacts] = await Promise.all([hydrateTracks(trackIds, viewerId), viewerId && !deep ? trackFacts(viewerId, { genreId: id }) : Promise.resolve([])]);
// What stands out within the genre: who makes your favourite of it, which era, and so on.
const genreFindings = discover(genreFacts, { genreId: id, limit: 6 }).filter((f) => f.kind !== 'habit');

const family = genre.ancestors[0]?.name ?? genre.name;
const hue = hueOf(family);
const others = genre.parents;
const playlistHref = `/query?d=${encodeDefinition({
  entity: 'recording',
  where: { field: 'genre', op: deep ? 'in_tree' : 'eq', value: genre.name },
  sort: [{ field: 'personal_score', dir: 'desc' }],
  collapse_by_work: true,
  limit: 50,
})}`;
const list = (items: string[]) =>
  items.length <= 1 ? items.join('') : `${items.slice(0, -1).join(', ')} and ${items.at(-1)}`;
---

<Base
  title={genre.name}
  description={`${genre.name}: ${genre.tracks} ${genre.tracks === 1 ? 'track' : 'tracks'} across ${genre.albums} ${genre.albums === 1 ? 'album' : 'albums'}, best first.`}
>
  <div class="wrap page" style={`--h: ${hue}`}>
    <div class="band" aria-hidden="true"></div>
    <header>
      <nav aria-label="Where it sits" class="crumbs">
        <a href="/genres">Genres</a>
        {genre.ancestors.map((a) => (
          <>
            <span aria-hidden="true">›</span>
            <a href={`/genre/${a.id}`}>{a.name}</a>
          </>
        ))}
      </nav>
      <h1>{genre.name}</h1>
      <p class="facts">
        {genre.tracks} {genre.tracks === 1 ? 'track' : 'tracks'} · {genre.albums} {genre.albums === 1 ? 'album' : 'albums'}
      </p>
      {
        Astro.locals.user && (
          <details class="rename">
            <summary>Edit</summary>
            <form method="post" action="/api/write/genre">
              <input type="hidden" name="intent" value="rename" />
              <input type="hidden" name="id" value={id} />
              <input type="hidden" name="from" value="genre" />
              <label class="visually-hidden" for="genre-name">New name</label>
              <input class="input" id="genre-name" name="name" value={genre.name} required maxlength="80" autocomplete="off" spellcheck="false" />
              <button class="button" type="submit">Rename</button>
            </form>
            <p class="hint">
              Renaming changes it everywhere; a name another genre already has merges the two.{' '}
              <a href={`/manage/genres#genre-${id}`}>Move it in the tree</a>
            </p>
          </details>
        )
      }
      {
        /* Just this genre, or with everything beneath it: a toggle, not a sentence. */
        genre.children.length > 0 && genre.tracksBeneath !== genre.tracks && (
          <Segmented
            label="Which tracks"
            items={[
              { href: `/genre/${id}`, label: genre.name, count: genre.tracksDirect, current: !deep },
              { href: `/genre/${id}?beneath=1`, label: 'With subgenres', count: genre.tracksBeneath, current: deep },
            ]}
          />
        )
      }
      {
        others.length > 1 && (
          <p class="muted">
            Part of{' '}
            {others.map((p, i) => (
              <>
                {i > 0 && (i === others.length - 1 ? ' and ' : ', ')}
                <a href={`/genre/${p.id}`}>{p.name}</a>
              </>
            ))}
            .
          </p>
        )
      }
      {
        subtree.length > 1 ? (
          <>
            <GenreMosaic
              nodes={subtree}
              family={family}
              label={`Inside ${genre.name}`}
              compact
              moreHref="#beneath"
            />
            <details class="all-beneath" id="beneath">
              <summary>Every subgenre ({genre.children.length}) <span aria-hidden="true">›</span></summary>
              <ul role="list" class="children" aria-label="Beneath it">
              {genre.children.map((c) => (
                <li>
                  <a href={`/genre/${c.id}`}>
                    {c.name}
                    {c.tracks > 0 && <span class="count tabular">{c.tracks}</span>}
                  </a>
                </li>
              ))}
            </ul>
            </details>
          </>
        ) : (
          genre.children.length > 0 && (
            <ul role="list" class="children" aria-label="Beneath it">
              {genre.children.map((c) => (
                <li>
                  <a href={`/genre/${c.id}`}>
                    {c.name}
                    {c.tracks > 0 && <span class="count tabular">{c.tracks}</span>}
                  </a>
                </li>
              ))}
            </ul>
          )
        )
      }
      {user && (
        <p>
          <a class="button" href={playlistHref}>
            Make a playlist of it
          </a>
        </p>
      )}
    </header>

    {
      tracks.length > 0 && (
        <section aria-labelledby="tracks-heading">
          <h2 id="tracks-heading">Favourite tracks</h2>
          <ResultList results={tracks} />
        </section>
      )
    }

    {
      artists.length > 1 && (
        <section aria-labelledby="artists-heading">
          <h2 id="artists-heading">Artists</h2>
          <ol role="list" class="artists">
            {artists.map((a) => (
              <li>
                <span class="avatar" style={`--h: ${hueOf(a.name)}`} aria-hidden="true">
                  {a.image_key ? <img src={pictureAt(a.image_key, 160)} alt="" width="80" height="80" loading="lazy" decoding="async" /> : a.name.slice(0, 1).toUpperCase()}
                </span>
                <span class="who">
                  <a href={`/artist/${a.id}`}>{a.name}</a>
                  <span class="muted small tabular">{a.rated} rated</span>
                </span>
                <Score quality={a.average} size="s" />
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {
      genreFindings.length > 0 && (
        <section aria-labelledby="standout-heading">
          <h2 id="standout-heading">What stands out</h2>
          <Findings findings={genreFindings} />
        </section>
      )
    }

    {
      albums.length > 0 && (
        <section aria-labelledby="albums-heading">
          <h2 id="albums-heading">Albums</h2>
          <CardGrid>
            {albums.map((album) => (
              <li>
                <AlbumCard album={album} />
              </li>
            ))}
          </CardGrid>
        </section>
      )
    }

    {genre.tracks === 0 && <p class="muted">Nothing in the library is tagged {genre.name} yet{genre.children.length ? `, or ${list(genre.children.map((c) => c.name))}` : ''}.</p>}
  </div>
</Base>

<style>
  .page {
    display: grid;
    gap: var(--space-7);
  }

  /* A wash in the genre's family colour, the same hue as its circle. */
  .band {
    position: absolute;
    inset: 0 0 auto;
    z-index: -1;
    max-width: none;
    height: 22rem;
    background: radial-gradient(ellipse 80% 100% at 20% 0%, oklch(0.32 0.09 var(--h) / 0.55), transparent 70%);
    pointer-events: none;
  }

  :global([data-theme='light']) .band {
    background: radial-gradient(ellipse 80% 100% at 20% 0%, oklch(0.9 0.06 var(--h) / 0.8), transparent 70%);
  }

  header {
    display: grid;
    gap: var(--space-4);
    padding-top: var(--space-6);
  }

  .all-beneath summary {
    display: flex;
    align-items: center;
    min-height: var(--target);
    color: var(--text-muted);
    font-weight: 600;
    cursor: pointer;
  }

  .all-beneath[open] summary {
    margin-bottom: var(--space-3);
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-muted);
    font-size: var(--step--1);
    font-weight: 600;
  }

  .crumbs a {
    color: inherit;
  }

  /* Lowercase names hang descenders (the p of pop) below a tight line:
     room beneath so the facts never sit against them. */
  h1 {
    margin-block: var(--space-2) var(--space-2);
    font-size: clamp(2.6rem, 1.4rem + 5vw, 5.5rem);
    letter-spacing: -0.045em;
    line-height: 0.92;
  }

  .facts {
    font-size: var(--step-1);
    font-weight: 600;
  }

  .facts .muted {
    font-size: var(--step-0);
    font-weight: 400;
  }

  .children {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .children a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--target);
    padding: 0 var(--space-4);
    border: 1px solid oklch(0.5 0.08 var(--h) / 0.6);
    border-radius: 999px;
    background: oklch(0.3 0.05 var(--h) / 0.35);
    font-weight: 650;
    text-decoration: none;
  }

  :global([data-theme='light']) .children a {
    border-color: oklch(0.75 0.08 var(--h));
    background: oklch(0.94 0.04 var(--h));
  }

  .children a:hover {
    border-color: var(--text-subtle);
  }

  .count {
    color: var(--text-muted);
    font-size: var(--step--1);
    font-weight: 500;
  }

  h2 {
    margin-bottom: var(--space-4);
    font-size: var(--step-2);
    letter-spacing: -0.02em;
  }

  /* Rows, several across when there is room: picture, name over count, the score on the name's line. */
  .artists {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: 0 var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .artists li {
    position: relative;
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr) auto;
    grid-template-areas:
      'pic name score'
      'pic count count';
    align-items: baseline;
    gap: 0 var(--space-3);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--border);
  }

  .artists li > :global(:last-child) {
    grid-area: score;
  }

  .avatar {
    grid-area: pic;
    align-self: center;
    display: grid;
    place-items: center;
    width: 2.75rem;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 50%;
    background: radial-gradient(circle at 30% 25%, oklch(0.78 0.09 var(--h)), oklch(0.5 0.1 var(--h)));
    color: oklch(0.98 0.02 var(--h));
    font-weight: 800;
  }

  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Name and count take their own places in the row's grid. */
  .who {
    display: contents;
  }

  .who .muted {
    grid-area: count;
  }

  .who a {
    grid-area: name;
    min-width: 0;
    overflow: hidden;
    font-weight: 700;
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* The whole row is the link. */
  .who a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .artists li:hover .who a {
    text-decoration: underline;
  }

  .rename summary {
    width: fit-content;
    color: var(--text-muted);
    font-size: var(--step--1);
    font-weight: 600;
    cursor: pointer;
  }

  .rename form {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .rename .input {
    flex: 1 1 12rem;
  }

  .rename .hint {
    margin-top: var(--space-1);
    color: var(--text-muted);
    font-size: var(--step--1);
  }
</style>
