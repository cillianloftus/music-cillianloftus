---
import Base from '../layouts/Base.astro';
import { listDefinitions } from '../lib/definitions';

const definitions = await listDefinitions();
const user = Astro.locals.user;
---

<Base title="Playlists" description="Playlists generated from saved queries over rated music.">
  <div class="wrap page">
    <header>
      <h1>Playlists</h1>
      <p class="muted">Each one is a saved question, re-asked whenever ratings change.</p>
      {user && <a class="button button--primary" href="/query">New playlist</a>}
    </header>

    {
      definitions.length === 0 ? (
        <p class="empty">No playlists yet.</p>
      ) : (
        <ul class="grid" role="list">
          {definitions.map((d) => (
            <li>
              <img class="art" src={`/playlist/${d.id}/art.svg`} alt="" width="640" height="640" loading="lazy" decoding="async" />
              <a class="name" href={`/playlist/${d.id}`}>{d.name}</a>
              {d.description && <p class="muted">{d.description}</p>}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</Base>

<style>
  .page {
    display: grid;
    gap: var(--space-6);
  }

  header {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }

  .muted {
    color: var(--text-muted);
  }

  .empty {
    padding: var(--space-6);
    border: 1px dashed var(--border);
    border-radius: var(--radius-l);
    color: var(--text-muted);
  }

  h1 {
    font-size: clamp(2.2rem, 1.6rem + 2.4vw, 3.25rem);
    font-weight: 850;
    letter-spacing: -0.035em;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(11rem, 44%), 1fr));
    gap: var(--space-6) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .grid li {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-2);
  }

  .art {
    width: 100%;
    height: auto;
    border-radius: var(--radius-m);
    box-shadow: var(--shadow);
    transition: transform 0.25s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .grid li:hover .art {
    transform: translateY(-3px);
  }

  .name {
    margin-top: var(--space-1);
    font-size: var(--step-0);
    font-weight: 700;
    text-decoration: none;
  }

  /* The whole tile is the link. */
  .name::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-m);
  }

  .grid li:hover .name {
    text-decoration: underline;
  }

  .name:focus-visible {
    outline: none;
  }

  .name:focus-visible::after {
    outline: 3px solid var(--focus);
    outline-offset: 4px;
  }

  .grid .muted {
    font-size: var(--step--1);
  }
</style>
