---
import Base from '../layouts/Base.astro';
import { listDefinitions } from '../lib/definitions';

const definitions = await listDefinitions();
const user = Astro.locals.user;
---

<Base title="Playlists" description="Playlists generated from saved queries over rated music.">
  <div class="wrap page">
    <header>
      <h1>Playlists</h1>
      <p class="muted">Each one is a saved question, re-asked whenever ratings change.</p>
      {user && <a class="button button--primary" href="/query">New playlist</a>}
    </header>

    {
      definitions.length === 0 ? (
        <p class="empty">No playlists yet.</p>
      ) : (
        <ul class="list" role="list">
          {definitions.map((d) => (
            <li>
              <a class="name" href={`/playlist/${d.id}`}>{d.name}</a>
              {d.description && <p class="muted">{d.description}</p>}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</Base>

<style>
  .page {
    display: grid;
    gap: var(--space-6);
  }

  header {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }

  h1 {
    font-size: var(--step-2);
  }

  .muted {
    color: var(--text-muted);
  }

  .empty {
    padding: var(--space-6);
    border: 1px dashed var(--border);
    border-radius: var(--radius-l);
    color: var(--text-muted);
  }

  .list {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .list li {
    position: relative;
    display: grid;
    gap: var(--space-1);
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-m);
    background: var(--surface-1);
  }

  .list li:hover {
    border-color: var(--text-subtle);
  }

  .name {
    font-size: var(--step-1);
    font-weight: 700;
    text-decoration: none;
  }

  .name::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-m);
  }
</style>
