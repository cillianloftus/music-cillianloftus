---
import Base from '../../layouts/Base.astro';
import Backdrop from '../../components/Backdrop.astro';
import DefinitionChips from '../../components/DefinitionChips.astro';
import ResultList from '../../components/ResultList.astro';
import SpotifyPanel from '../../components/SpotifyPanel.astro';
import { getDefinition } from '../../lib/definitions';
import { runDefinition } from '../../lib/query/run';
import { encodeDefinition } from '../../lib/query/builder';

const saved = await getDefinition(Astro.params.id!);
if (!saved) return Astro.rewrite('/404');

// A playlist reflects its owner's ratings, whoever is looking at it.
const results = await runDefinition(saved.definition, {
  userId: saved.user_id,
  pins: saved.pins,
  excludes: saved.excludes,
});
const user = Astro.locals.user;
const artSrc = saved.art_mode === 'uploaded' && saved.art_key ? `/playlist/${saved.id}/cover.jpg` : `/playlist/${saved.id}/art.svg`;

const noun = saved.definition.entity === 'recording' ? 'track' : saved.definition.entity === 'release_group' ? 'album' : 'artist';
const totalMs = results.reduce((sum, r) => sum + ('length_ms' in r && typeof r.length_ms === 'number' ? r.length_ms : 0), 0);
const hours = Math.floor(totalMs / 3_600_000);
const minutes = Math.round((totalMs % 3_600_000) / 60_000);
const summary = [
  `${results.length} ${noun}${results.length === 1 ? '' : 's'}`,
  totalMs > 0 ? (hours ? `${hours} hr ${minutes} min` : `${minutes} min`) : null,
]
  .filter(Boolean)
  .join(' · ');
---

<Base title={saved.name} description={saved.description ?? undefined}>
  <div class="wrap page">
    <Backdrop src={artSrc} height="32rem" />
    <header>
      <div class="art-col">
        <img class="art" src={artSrc} alt="" width="640" height="640" decoding="async" />
        {
          user?.id === saved.user_id && (
            <form method="post" action="/api/write/playlist/art" enctype="multipart/form-data" class="art-tools" data-art-form>
              <input type="hidden" name="id" value={saved.id} />
              <label class="art-pick">
                <input type="file" name="cover" accept="image/*" data-art-input />
                <span>{saved.art_mode === 'uploaded' ? 'Change cover' : 'Use your own cover'}</span>
              </label>
              {saved.art_mode === 'uploaded' && (
                <button class="art-reset" type="submit" name="intent" value="generated" formnovalidate>
                  Back to generated
                </button>
              )}
            </form>
          )
        }
      </div>
      <div class="intro">
        <div class="titles">
          <p class="eyebrow">Playlist · {saved.owner_name}</p>
          <h1>{saved.name}</h1>
          {saved.description && <p class="muted">{saved.description}</p>}
          <p class="count tabular">{summary}</p>
        </div>
        <div class="rules">
          <DefinitionChips definition={saved.definition} />
          {
            user?.id === saved.user_id && (
              <p class="actions">
                <a class="button" href={`/query?d=${encodeDefinition(saved.definition)}&saved=${saved.id}`}>Edit filters</a>
                <a class="button button--quiet" href={`/edit/definition/${saved.id}`}>Edit as JSON</a>
              </p>
            )
          }
        </div>
      </div>
    </header>

    {
      user?.id === saved.user_id && (
        <div class="spotify-strip">
          <SpotifyPanel
            definitionId={saved.id}
            spotifyPlaylistId={saved.spotify_playlist_id}
            entity={saved.definition.entity}
            userId={user.id}
          />
        </div>
      )
    }

    {
      saved.spotify_playlist_id && user?.id !== saved.user_id && (
        <p>
          <a href={`https://open.spotify.com/playlist/${saved.spotify_playlist_id}`} rel="external">Open in Spotify</a>
        </p>
      )
    }

    <script>
      // A chosen cover is cropped square and resized here, then sent as JPEG.
      const form = document.querySelector<HTMLFormElement>('[data-art-form]');
      const input = form?.querySelector<HTMLInputElement>('[data-art-input]');
      input?.addEventListener('change', async () => {
        const file = input.files?.[0];
        if (!file || !form) return;
        try {
          const bitmap = await createImageBitmap(file);
          const side = Math.min(bitmap.width, bitmap.height);
          const canvas = document.createElement('canvas');
          canvas.width = canvas.height = Math.min(640, side);
          canvas.getContext('2d')!.drawImage(bitmap, (bitmap.width - side) / 2, (bitmap.height - side) / 2, side, side, 0, 0, canvas.width, canvas.height);
          const blob = await new Promise<Blob | null>((resolve) => canvas.toBlob(resolve, 'image/jpeg', 0.9));
          if (!blob) return;
          const body = new FormData();
          body.set('id', form.querySelector<HTMLInputElement>('input[name=id]')!.value);
          body.set('cover', blob, 'cover.jpg');
          await fetch(form.action, { method: 'POST', body });
          location.reload();
        } catch {
          form.submit();
        }
      });
    </script>

    <section aria-label="Results">
      <ResultList results={results} />
    </section>
  </div>
</Base>

<style>
  .page {
    display: grid;
    gap: var(--space-6);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  /* As on album pages: the cover's top meets the eyebrow, the rules and
     buttons sit along its bottom edge, and Spotify follows under the text. */
  header {
    display: grid;
    gap: var(--space-5);
    padding-top: var(--space-6);
  }

  .intro {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-5);
    min-width: 0;
  }

  .titles,
  .rules {
    display: grid;
    gap: var(--space-3);
  }

  @media (min-width: 48rem) {
    header {
      grid-template-columns: 20rem minmax(0, 1fr);
      column-gap: var(--space-7);
      row-gap: var(--space-5);
    }

    .art-col {
      align-self: start;
    }
  }

  /* Generated from the playlist's contents; decorative, as the list below says it all in words. */
  .art {
    width: min(20rem, 72vw);
    height: auto;
    border-radius: var(--radius-m);
    box-shadow:
      0 2px 4px rgb(0 0 0 / 0.3),
      0 24px 60px -12px rgb(0 0 0 / 0.55);
  }

  h1 {
    font-size: clamp(2.2rem, 1.4rem + 3.2vw, 4.25rem);
    font-weight: 850;
    letter-spacing: -0.035em;
    line-height: 0.98;
    text-wrap: balance;
  }

  .count {
    color: var(--text-muted);
    font-weight: 600;
  }

  .muted {
    color: var(--text-muted);
    max-width: 40rem;
  }

  .art-col {
    display: grid;
    gap: var(--space-3);
    width: min(20rem, 100%);
  }

  .art-tools {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .art-pick,
  .art-reset {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0 var(--space-3);
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface-1);
    color: var(--text-muted);
    font: inherit;
    font-size: var(--step--1);
    font-weight: 650;
    cursor: pointer;
  }

  .art-pick:hover,
  .art-reset:hover {
    border-color: var(--accent);
    color: var(--text);
  }

  .art-pick:focus-within {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }

  .art-pick input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
  }

  /* Spotify as one slim strip across the page, under the header. */
  .spotify-strip :global(.spotify) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    padding: var(--space-3) var(--space-5);
  }
</style>
