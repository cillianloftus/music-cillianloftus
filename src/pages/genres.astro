---
/**
 * The genre tree as a circle packing: each circle's area is the number of
 * tracks in that genre. Laid out on the server (d3-hierarchy) and sent as
 * plain SVG, so it renders without JavaScript and without layout shift.
 * The nested list below carries the same information as text.
 */
import Base from '../layouts/Base.astro';
import GenreList from '../components/GenreList.astro';
import { buildGenreTree, genreRows, packGenres } from '../lib/genres';

const SIZE = 800;
const tree = buildGenreTree(await genreRows());
const circles = packGenres(tree, SIZE);
const largestLeaf = Math.max(1, ...circles.filter((c) => c.leaf).map((c) => c.value));
const totalGenres = circles.filter((c) => !c.self).length;

/**
 * Leaf colour strength, as % accent over the surface: square root, so small
 * genres stay visible. Capped at 45% so labels in --text keep >= 4.5:1 in
 * both modes (about 5:1 on the darkest dark-mode fill, 7:1 in light).
 */
const mix = (value: number) => Math.round(10 + 35 * Math.sqrt(value / largestLeaf));

function leafLabel(name: string, r: number): { text: string; size: number } | null {
  if (r < 20) return null;
  const size = Math.min(22, Math.max(10, r / 3.2));
  const fits = Math.floor((r * 1.8) / (size * 0.56));
  if (fits < 3) return null;
  return { text: name.length > fits ? `${name.slice(0, fits - 1)}…` : name, size };
}
---

<Base title="Genres" description="Genres in the library, sized by how many tracks sit in each.">
  <div class="wrap page">
    <header>
      <h1>Genres</h1>
      <p class="muted">
        Each circle’s area is how many tracks sit in that genre. Genres nest inside their parents.
      </p>
    </header>

    {
      circles.length === 0 ? (
        <p class="empty">No genres yet. Imports bring them in.</p>
      ) : (
        <>
          <figure>
            <svg viewBox={`0 0 ${SIZE} ${SIZE}`} aria-hidden="true" focusable="false">
              {circles.map((c) => {
                const label = c.leaf && !c.self ? leafLabel(c.name, c.r) : null;
                return (
                  <g>
                    <title>{`${c.name}: ${c.value} ${c.value === 1 ? 'track' : 'tracks'}${c.self ? ' tagged directly' : ''}`}</title>
                    <circle
                      cx={c.x.toFixed(1)}
                      cy={c.y.toFixed(1)}
                      r={c.r.toFixed(1)}
                      class:list={[c.leaf ? 'leaf' : `group depth-${Math.min(c.depth, 3)}`, { self: c.self }]}
                      style={c.leaf ? `--mix: ${mix(c.value)}` : undefined}
                    />
                    {label && (
                      <text
                        x={c.x.toFixed(1)}
                        y={c.y.toFixed(1)}
                        class="label"
                        font-size={label.size.toFixed(1)}
                        text-anchor="middle"
                        dominant-baseline="central"
                      >
                        {label.text}
                      </text>
                    )}
                    {!c.leaf && c.r >= 70 && (
                      <text x={c.x.toFixed(1)} y={(c.y - c.r + 20).toFixed(1)} class="group-label" text-anchor="middle">
                        {c.name}
                      </text>
                    )}
                  </g>
                );
              })}
            </svg>
            <figcaption class="muted">
              {totalGenres} {totalGenres === 1 ? 'genre' : 'genres'}. Shaded by size; hover a circle for its count.
            </figcaption>
          </figure>

          <section aria-labelledby="list-heading" class="genre-list">
            <h2 id="list-heading">All genres</h2>
            <GenreList nodes={tree} />
          </section>
        </>
      )
    }
  </div>
</Base>

<style>
  .page {
    display: grid;
    gap: var(--space-6);
  }

  header {
    display: grid;
    gap: var(--space-2);
  }

  h1 {
    font-size: var(--step-2);
  }

  h2 {
    font-size: var(--step-1);
    margin-bottom: var(--space-3);
  }

  .muted {
    color: var(--text-muted);
  }

  figure {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    justify-items: center;
  }

  svg {
    width: 100%;
    max-width: 44rem;
    height: auto;
    aspect-ratio: 1;
    font-family: var(--font-sans);
  }

  .group {
    fill: transparent;
    stroke: var(--border);
    stroke-width: 1.5;
  }

  .depth-1 {
    fill: var(--surface-1);
  }

  .depth-2 {
    fill: color-mix(in srgb, var(--surface-2) 60%, var(--surface-1));
  }

  .depth-3 {
    fill: var(--surface-2);
  }

  .leaf {
    fill: color-mix(in srgb, var(--accent) calc(var(--mix) * 1%), var(--surface-2));
  }

  .leaf.self {
    stroke: var(--accent);
    stroke-dasharray: 3 3;
  }

  g:hover .leaf {
    stroke: var(--text);
    stroke-width: 2;
  }

  .label {
    fill: var(--text);
    font-weight: 650;
    pointer-events: none;
  }

  .group-label {
    fill: var(--text-muted);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    pointer-events: none;
  }

  .empty {
    padding: var(--space-6);
    border: 1px dashed var(--border);
    border-radius: var(--radius-l);
    color: var(--text-muted);
  }
</style>
