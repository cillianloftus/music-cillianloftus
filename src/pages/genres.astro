---
/**
 * Every genre in the library as a map (GenreMosaic): area is tracks, each
 * family a panel of its subgenres. Below it, the whole tree as a list,
 * one family at a time, with a box to find a genre by name.
 */
import EmptyState from '../components/EmptyState.astro';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import GenreList from '../components/GenreList.astro';
import GenreMosaic from '../components/GenreMosaic.astro';
import { buildGenreTree, genreRows, type GenreTreeNode } from '../lib/genres';

const rows = await genreRows();
const tree = buildGenreTree(rows);
const ids = new Set<string>();
const walk = (nodes: GenreTreeNode[]) => nodes.forEach((node) => (ids.add(node.id), walk(node.children)));
walk(tree);
const n = (x: number) => x.toLocaleString('en-GB');
---

<Base title="Genres" description="Every genre in the library, sized by how many tracks sit in it.">
  <div class="wrap page">
    <PageHeader title="Genres" count={ids.size}>
      {Astro.locals.user && <a href="/manage/genres">Edit</a>}
    </PageHeader>

    {
      tree.length === 0 ? (
        <EmptyState>No genres yet. Imports bring them in.</EmptyState>
      ) : (
        <>
          <figure>
            <GenreMosaic nodes={tree} label="Genre map" />
            <figcaption>Each tile’s size is the tracks tagged with it. Tap a family for its subgenres.</figcaption>
          </figure>

          <section id="all-genres" aria-labelledby="list-heading" class="genre-list">
            <div class="list-head">
              <h2 id="list-heading">All genres</h2>
              <label class="visually-hidden" for="genre-filter">Find a genre</label>
              <input id="genre-filter" class="input" type="search" placeholder="Find a genre" autocomplete="off" spellcheck="false" data-genre-filter />
            </div>
            <ul role="list" class="families" data-genre-tree>
              {tree.map((node) =>
                node.children.length > 0 ? (
                  <li data-name={node.name}>
                    {/* The name is a link and the chevron a button beside it: a
                        link inside a <summary> was one control inside another. */}
                    <div class="row">
                      <a class="name" href={`/genre/${node.id}`}>{node.name}</a>
                      <span class="count">{n(node.total)}</span>
                      <button type="button" class="toggle" aria-expanded="true" aria-controls={`sub-${node.id}`} data-toggle hidden>
                        <span class="visually-hidden">Genres within {node.name}</span>
                        <svg class="chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
                      </button>
                    </div>
                    <div class="sub" id={`sub-${node.id}`}>
                      <GenreList nodes={node.children} />
                    </div>
                  </li>
                ) : (
                  <li data-name={node.name} class="single">
                    <a class="name" href={`/genre/${node.id}`}>{node.name}</a>
                    <span class="count">{n(node.total)}</span>
                  </li>
                ),
              )}
            </ul>
            <p class="none" hidden data-genre-none>No genre by that name.</p>
          </section>
        </>
      )
    }
  </div>
</Base>

<script>
  // Find a genre: show what matches and the families holding it, opened.
  const box = document.querySelector<HTMLInputElement>('[data-genre-filter]');
  const tree = document.querySelector<HTMLElement>('[data-genre-tree]');
  const none = document.querySelector<HTMLElement>('[data-genre-none]');
  // A family's genres fold away behind its chevron; without this script they stay open.
  const setOpen = (button: HTMLButtonElement, open: boolean) => {
    button.setAttribute('aria-expanded', String(open));
    const sub = document.getElementById(button.getAttribute('aria-controls')!);
    if (sub) sub.hidden = !open;
  };
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-toggle]')) {
    button.hidden = false;
    setOpen(button, false);
    button.addEventListener('click', () => setOpen(button, button.getAttribute('aria-expanded') !== 'true'));
  }

  if (box && tree && none) {
    const items = [...tree.querySelectorAll<HTMLLIElement>('li[data-name]')].reverse();
    box.addEventListener('input', () => {
      const q = box.value.trim().toLowerCase();
      // Deepest first, so a parent knows whether anything beneath it matched.
      for (const li of items) {
        const self = !q || li.dataset.name!.toLowerCase().includes(q);
        const below = q !== '' && [...li.querySelectorAll<HTMLLIElement>(':scope > ul > li, :scope > .sub > ul > li')].some((c) => !c.hidden);
        li.hidden = !(self || below);
        const toggle = li.querySelector<HTMLButtonElement>(':scope > .row [data-toggle]');
        if (toggle) setOpen(toggle, below);
      }
      none.hidden = !q || items.some((li) => !li.hidden);
    });
  }
</script>

<style>
  .page {
    display: grid;
    gap: var(--space-6);
  }

  figure {
    display: grid;
    gap: var(--space-3);
    margin: 0;
  }

  figcaption,
  .count,
  .none,
  .list-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  h2 {
    font-size: var(--step-1);
  }

  .list-head .input {
    flex: 1 1 14rem;
    max-width: 22rem;
  }

  .families {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }

  .families > li {
    border-bottom: 1px solid var(--border);
  }

  .row,
  .single {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--target);
  }

  .name {
    font-weight: 650;
  }

  /* In a family's row the count sits on the name's line: the caption rule
     above gave it a bottom margin, which lifted it. */
  .row .count,
  .single .count {
    display: inline;
    margin-bottom: 0;
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  /* The chevron's button: the row's height, at the end of it. */
  .toggle {
    display: grid;
    place-items: center;
    min-width: var(--target);
    min-height: var(--target);
    margin-left: auto;
    margin-right: calc(var(--space-2) * -1);
    padding: 0;
    border: 0;
    border-radius: var(--radius-s);
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .toggle[hidden] {
    display: none;
  }

  .toggle:hover {
    background: var(--surface-2);
  }

  .chevron {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.15s ease;
  }

  .toggle[aria-expanded='true'] .chevron {
    transform: rotate(90deg);
  }

  .sub > :global(ul) {
    margin: 0 0 var(--space-3) var(--space-2);
  }

  @media (prefers-reduced-motion: reduce) {
    .chevron {
      transition: none;
    }
  }
</style>
