---
import { env } from 'cloudflare:workers';
import Base from '../../../../layouts/Base.astro';
import { typeLabel } from '../../../../lib/format';
import Backdrop from '../../../../components/Backdrop.astro';
import CoverArt from '../../../../components/CoverArt.astro';
import CreditLine from '../../../../components/CreditLine.astro';
import RatingSheet from '../../../../components/RatingSheet.astro';
import { artistLines } from '../../../../lib/catalogue';
import { ALBUM_AXES, CRAFT_AXES, ratingHistory, safeReturnPath, type RatableEntity, type RatingRow } from '../../../../lib/ratings';
import { activeWeights } from '../../../../lib/weights';

const { type, id } = Astro.params as { type: string; id: string };
if (type !== 'recording' && type !== 'release_group') return Astro.rewrite('/404');
const entityType: RatableEntity = type;
const user = Astro.locals.user!;

interface Subject {
  title: string;
  album_id: string | null;
  album_title: string | null;
  art_key: string | null;
  /** Album, single, EP…; absent for a track. */
  type?: string | null;
}

// The thing being rated, with album context for a recording.
const subject =
  entityType === 'recording'
    ? await env.DB.prepare(
        // The earliest release with a cover: an edition without art would show initials.
        `SELECT rec.title, g.id AS album_id, g.title AS album_title, r.art_key
         FROM recording rec
         LEFT JOIN track t ON t.recording_id = rec.id
         LEFT JOIN release r ON r.id = t.release_id
         LEFT JOIN release_group g ON g.id = r.release_group_id
         WHERE rec.id = ?
         ORDER BY r.art_key IS NULL, r.date IS NULL, r.date
         LIMIT 1`,
      )
        .bind(id)
        .first<Subject>()
    : await env.DB.prepare(
        `SELECT g.title, g.id AS album_id, NULL AS album_title, g.type,
                coalesce(r.art_key, (SELECT x.art_key FROM release x WHERE x.release_group_id = g.id AND x.art_key IS NOT NULL
                                     ORDER BY x.date IS NULL, x.date LIMIT 1)) AS art_key
         FROM release_group g
         LEFT JOIN v_release_group_canonical c ON c.release_group_id = g.id
         LEFT JOIN release r ON r.id = c.release_id
         WHERE g.id = ?`,
      )
        .bind(id)
        .first<Subject>();
if (!subject) return Astro.rewrite('/404');

const [lines, history, weights, calibration] = await Promise.all([
  artistLines(entityType, [id]),
  ratingHistory(user.id, entityType, id),
  activeWeights(user.id),
  env.DB.prepare('SELECT gut_offset FROM v_gut_calibration WHERE user_id = ?').bind(user.id).first<number>('gut_offset'),
]);
const credits = lines.get(id) ?? [];
const current = history[0];

const fallbackReturn = subject.album_id ? `/album/${subject.album_id}` : '/';
const returnTo = safeReturnPath(Astro.url.searchParams.get('return_to'), fallbackReturn);
const error = Astro.url.searchParams.get('error');

const axes = entityType === 'recording' ? CRAFT_AXES : ALBUM_AXES;
const capitalise = (s: string) => s[0]!.toUpperCase() + s.slice(1);
/** A row as it was given: production before the split, its halves after. */
const givenAxes = (row: RatingRow): string[] =>
  entityType === 'recording' && row.production != null ? ['production', ...CRAFT_AXES.slice(2)] : [...axes];

const ratedAt = new Intl.DateTimeFormat('en-IE', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Europe/Dublin' });
---

<Base title={`Rate ${subject.title}`}>
  <div class="wrap page">
    <Backdrop artKey={subject.art_key} height="20rem" />

    <header class="subject">
      <div class="thumb">
        <CoverArt artKey={subject.art_key} title={subject.album_title ?? subject.title} sizes="4.5rem" />
      </div>
      <div>
        <a class="back" href={returnTo}>← Back</a>
        <p class="eyebrow">{entityType === 'recording' ? 'Rate track' : `Rate ${subject.type ? (typeLabel(subject.type) === 'EP' ? 'EP' : typeLabel(subject.type).toLowerCase()) : 'album'}`}</p>
        <h1>{subject.title}</h1>
        <p class="muted">
          <CreditLine credits={credits} link={false} />
          {subject.album_title && <> · {subject.album_title}</>}
        </p>
      </div>
    </header>

    {error && <p class="error" role="alert">{error}</p>}

    <RatingSheet entityType={entityType} entityId={id} current={current} returnTo={returnTo} preview={{ weights, offset: calibration ?? 0 }} />

    {
      entityType === 'recording' && (
        <form method="post" action="/api/write/track-kind" class="not-song">
          <input type="hidden" name="id" value={id} />
          <input type="hidden" name="back" value={returnTo} />
          <span class="muted">Not really a song?</span>
          <button class="button button--quiet" type="submit" name="kind" value="skit">
            It’s a skit
          </button>
          <button class="button button--quiet" type="submit" name="kind" value="interlude">
            It’s an interlude
          </button>
        </form>
      )
    }

    {
      history.length > 0 && (
        <section aria-labelledby="history-heading" class="history">
          <h2 id="history-heading">History</h2>
          <ol role="list">
            {history.map((row) => (
              <li>
                <time datetime={row.rated_at}>{ratedAt.format(new Date(row.rated_at))}</time>
                <span>
                  {row.gut_score != null && <>Gut {row.gut_score}</>}
                  {row.depth === 'detailed' &&
                    givenAxes(row)
                      .filter((axis) => row[axis as keyof RatingRow] != null)
                      .map((axis) => ` · ${capitalise(axis)} ${row[axis as keyof RatingRow]}`)
                      .join('')}
                  {row.impact != null && <> · Impact {row.impact}</>}
                </span>
              </li>
            ))}
          </ol>
        </section>
      )
    }
  </div>
</Base>

<style>
  .page {
    display: grid;
    gap: var(--space-4);
    --content-max: 40rem;
  }

  .back {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .subject {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: var(--space-4);
    align-items: center;
  }

  h1 {
    font-size: var(--step-1);
    font-weight: 800;
    line-height: 1.15;
  }

  h2 {
    font-size: var(--step-1);
  }

  .muted {
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .error {
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--danger);
    border-radius: var(--radius-s);
    color: var(--danger);
  }

  .history ol {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .history li {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: var(--space-3);
    font-size: var(--step--1);
  }

  .history time {
    color: var(--text-muted);
  }

  /* Phones: the date over what was given, full width. */
  @media (max-width: 39.99rem) {
    .history ol {
      gap: var(--space-3);
    }

    .history li {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }

  .not-song {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    font-size: var(--step--1);
  }
</style>
