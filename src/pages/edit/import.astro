---
import Base from '../../layouts/Base.astro';

const error = Astro.url.searchParams.get('error');
const previous = Astro.url.searchParams.get('source') ?? '';
---

<Base title="Import">
  <div class="wrap page">
    <header>
      <h1>Import</h1>
      <p class="muted">
        From MusicBrainz or Spotify, from your own files, or by hand.
      </p>
    </header>

    <form method="post" action="/api/write/import" novalidate>
      <div class="field">
        <label for="source">MusicBrainz or Spotify link</label>
        <input
          class="input"
          id="source"
          name="source"
          type="text"
          inputmode="url"
          autocomplete="off"
          spellcheck="false"
          required
          value={previous}
          aria-describedby={error ? 'source-hint source-error' : 'source-hint'}
          aria-invalid={error ? 'true' : undefined}
        />
        <span class="hint" id="source-hint">
          A MusicBrainz album or edition page, or a Spotify album or track link. Spotify albums are looked up on
          MusicBrainz first, by barcode, and imported from there when found.
        </span>
        {
          error && (
            <span class="error" id="source-error" role="alert">
              That is not a MusicBrainz release or release group link, or a Spotify album or track link.
            </span>
          )
        }
      </div>
      <button class="button button--primary" type="submit">Import</button>
    </form>

    <section aria-labelledby="other-heading">
      <h2 id="other-heading">Or</h2>
      <ul role="list" class="options">
        <li>
          <a href="/edit/import/files">Import a folder</a>
          <p>Have the files? Their tags are read on your machine; only text is sent.</p>
        </li>
        <li>
          <a href="/edit/import/manual">Add by hand</a>
          <p>On no database at all? Paste the tracklist.</p>
        </li>
      </ul>
    </section>

    <section aria-labelledby="how-heading" class="how">
      <h2 id="how-heading">What happens</h2>
      <ul>
        <li>The import runs as a job, usually finished within a few seconds.</li>
        <li>An album already in the catalogue gains the new edition rather than a duplicate.</li>
        <li>Existing details are only ever filled in, never overwritten.</li>
      </ul>
    </section>
  </div>
</Base>

<style>
  .page {
    display: grid;
    gap: var(--space-6);
    max-width: 40rem;
  }

  header {
    display: grid;
    gap: var(--space-2);
  }

  h2 {
    font-size: var(--step-0);
    margin-bottom: var(--space-2);
  }

  form {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  form .field {
    width: 100%;
  }

  .muted,
  .how {
    color: var(--text-muted);
  }

  .how ul {
    margin: 0;
    padding-left: 1.2rem;
    display: grid;
    gap: var(--space-1);
  }

  .options {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .options li {
    position: relative;
    display: grid;
    gap: var(--space-1);
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-m);
    background: var(--surface-1);
  }

  .options li:hover {
    border-color: var(--text-subtle);
  }

  .options a {
    font-weight: 700;
    text-decoration: none;
  }

  /* The whole card is the link. */
  .options a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-m);
  }

  .options a:focus-visible {
    outline: none;
  }

  .options a:focus-visible::after {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }

  .options p {
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .error {
    color: var(--danger);
    font-weight: 600;
  }
</style>
