---
/**
 * The front page, in order: one album up front (the latest one rated
 * highly) with the shape of the library; what today brings; albums half
 * rated; what the ratings show; favourite tracks and artists; the best
 * albums, singles, EPs and mixtapes; the diary of recent ratings; and the
 * rest (played but unrated, genres, recently added).
 */
import Base from '../layouts/Base.astro';
import Findings from '../components/Findings.astro';
import { discover, libraryFacts } from '../lib/discover';
import AlbumCard from '../components/AlbumCard.astro';
import Backdrop from '../components/Backdrop.astro';
import CoverArt from '../components/CoverArt.astro';
import CreditLine from '../components/CreditLine.astro';
import Score from '../components/Score.astro';
import Shelf from '../components/Shelf.astro';
import { ownerId } from '../lib/auth/user';
import { recentReleaseGroups, releaseGroupsByIds, type ReleaseGroupSummary } from '../lib/catalogue';
import { yearOf } from '../lib/dates';
import { formatRelative, typeLabel } from '../lib/format';
import { libraryStats, recentRatings } from '../lib/overview';
import { inProgress, lovedArtists, lovedGenres, playedNotRated, topByType, topTracks } from '../lib/home';
import { encodeDefinition } from '../lib/query/builder';
import { spotifyLink } from '../lib/spotify/links';
import { ordinal, todayIn, todayPicks, whenText, type Pick } from '../lib/today';
import { byLibrary } from '../lib/library-cache';
import { artistLines } from '../lib/catalogue';
import { hueOf } from '../lib/art/playlist';

const viewerId = Astro.locals.user?.id ?? (await ownerId());
const isOwner = Boolean(Astro.locals.user);
// Everything here changes only when the library does (or, for the picks, the
// day), so it is worked out once per change and kept: a dozen queries that
// D1 runs one after another, about 0.7s, become one cache read.
const [[recent, top, ratings, stats, picks, topSingles, topEps, topMixtapes, favourites, started, artistsLoved, genresLoved, unplayed], facts] = await Promise.all([
  byLibrary(`home:v2:${todayIn()}:${isOwner ? 'owner' : 'public'}`, viewerId, () =>
    Promise.all([
      recentReleaseGroups(viewerId, 12),
      topByType(viewerId, ['album'], 10),
      recentRatings(viewerId, 8),
      libraryStats(viewerId),
      todayPicks(viewerId, { includeUnrated: isOwner }),
      topByType(viewerId, ['single'], 10),
      topByType(viewerId, ['ep'], 10),
      topByType(viewerId, ['mixtape'], 10),
      topTracks(viewerId, 10),
      isOwner && viewerId ? inProgress(viewerId, 10) : Promise.resolve([]),
      lovedArtists(viewerId, 10),
      lovedGenres(viewerId, 12),
      isOwner && viewerId ? playedNotRated(viewerId, 10) : Promise.resolve([]),
    ]),
  ),
  viewerId ? libraryFacts(viewerId) : Promise.resolve([]),
]);

// Things the ratings show: the strongest fifteen sent, three shown, a fresh
// three on every visit (Findings turns them over in the browser).
const noticed = discover(facts, { limit: 15 });

// Artist lines for the picks, so each artist links to their page.
const pickAlbums = picks.filter((p) => ['anniversary', 'unrated', 'month', 'revisit'].includes(p.kind)).map((p) => p.id);
const pickTracks = picks.filter((p) => p.kind === 'favourite').map((p) => p.id);
const [albumLines, trackLines] = await Promise.all([artistLines('release_group', pickAlbums), artistLines('recording', pickTracks)]);
const pickCredits = (p: Pick) => (p.kind === 'favourite' ? trackLines.get(p.id) : albumLines.get(p.id)) ?? null;
const todayLabel = new Intl.DateTimeFormat('en-GB', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'Europe/Dublin' }).format(new Date());

/** What a pick is marking, in a few words. */
function pickLine(p: Pick): string {
  const when = whenText(p.daysAway);
  switch (p.kind) {
    case 'birthday':
      return p.daysAway === 0 ? `Turns ${p.years} today` : `Turns ${p.years} ${when}`;
    case 'formed':
      return `Formed ${p.years} ${p.years === 1 ? 'year' : 'years'} ago ${when}`;
    case 'anniversary': {
      const what = p.type === 'single' ? 'Single' : p.type === 'ep' ? 'EP' : 'Album';
      return p.daysAway === 0 ? `${what} out ${p.years} ${p.years === 1 ? 'year' : 'years'} ago today` : `${what}’s ${ordinal(p.years!)} anniversary ${when}`;
    }
    case 'unrated':
      return 'Not rated yet';
    default:
      return p.reason ?? '';
  }
}

/** One thing to do with a pick. */
function pickAction(p: Pick): { label: string; href: string; external?: boolean } | null {
  if (p.kind === 'birthday' || p.kind === 'formed') {
    return isOwner
      ? {
          label: `Playlist of their best`,
          href: `/query?d=${encodeDefinition({
            entity: 'recording',
            where: { field: 'artist', op: 'eq', value: p.title },
            sort: [{ field: 'personal_score', dir: 'desc' }],
            collapse_by_work: true,
            limit: 25,
          })}`,
        }
      : p.spotifyId
        ? { label: 'Listen on Spotify', href: `https://open.spotify.com/artist/${p.spotifyId}`, external: true }
        : null;
  }
  if (p.kind === 'unrated') return { label: 'Rate it', href: `/edit/rate/release_group/${p.id}?return_to=/` };
  if (p.kind === 'genre') return { label: 'Make a playlist', href: `/genre/${p.id}` };
  if (p.kind === 'artist') return p.spotifyId ? { label: 'Listen on Spotify', href: `https://open.spotify.com/artist/${p.spotifyId}`, external: true } : null;
  if (p.kind === 'favourite') return { label: p.spotifyId ? 'Listen on Spotify' : 'Find on Spotify', href: spotifyLink('track', p.spotifyId, `${p.by ?? ''} ${p.title}`), external: true };
  return { label: p.spotifyId ? 'Listen on Spotify' : 'Find on Spotify', href: spotifyLink('album', p.spotifyId, `${p.by ?? ''} ${p.title}`), external: true };
}

// Up front: the album most recently rated 80 or more, else the best there is.
const lovedRating = ratings.find((r) => r.entity_type === 'release_group' && (r.quality_score ?? 0) >= 80);
let featured: ReleaseGroupSummary | undefined = top[0];
let featuredNote: string | null = null;
let featuredWhen: string | null = null;
if (lovedRating) {
  [featured] = await releaseGroupsByIds([lovedRating.entity_id], viewerId);
  featuredNote = lovedRating.impact_note;
  featuredWhen = lovedRating.rated_at;
}

/** The best of each kind of release, one ranked shelf each (shown with two or more). */
const best = [
  { key: 'albums', heading: 'Best albums', items: top },
  { key: 'singles', heading: 'Best singles', items: topSingles },
  { key: 'eps', heading: 'Best EPs', items: topEps },
  { key: 'mixtapes', heading: 'Best mixtapes', items: topMixtapes },
].filter((b) => b.items.length > 1);

/** For today, read at a glance: the first few, as a list rather than a shelf. */
const todays = picks.slice(0, 6);

const statItems = [
  { value: stats.albums, label: stats.albums === 1 ? 'album' : 'albums' },
  { value: stats.tracks, label: stats.tracks === 1 ? 'track' : 'tracks' },
  { value: stats.artists, label: stats.artists === 1 ? 'artist' : 'artists' },
  { value: stats.ratings, label: stats.ratings === 1 ? 'rating' : 'ratings' },
];
---

<Base title="music" image={featured?.art_key ? `/${featured.art_key}/1200.jpg` : null}>
  <div class="wrap home">
    <h1 class="visually-hidden">Music, rated by Cillian Loftus</h1>

    {
      featured ? (
        <>
          <Backdrop artKey={featured.art_key} height="46rem" />
          <section class="feature" aria-labelledby="feature-title">
            <a class="feature-art" href={`/album/${featured.id}`} tabindex="-1" aria-hidden="true">
              <CoverArt artKey={featured.art_key} title={featured.title} sizes="(min-width: 48rem) 22rem, 70vw" priority />
            </a>
            <div class="feature-text">
              <p class="eyebrow">{lovedRating ? 'Lately loved' : 'Highest rated'}</p>
              <h2 id="feature-title">
                <a href={`/album/${featured.id}`}>{featured.title}</a>
              </h2>
              <p class="feature-by">
                <CreditLine credits={featured.credits} />
              </p>
              <div class="feature-meta">
                <span class="feature-score">
                  <Score quality={featured.quality_score} personal={featured.personal_score} size="l" />
                </span>
                <span class="feature-facts">
                  <span>{[typeLabel(featured.type), yearOf(featured.first_release_date)].filter(Boolean).join(' · ')}</span>
                  {featuredWhen && <span class="muted">Rated {formatRelative(featuredWhen)}</span>}
                </span>
              </div>
              {featuredNote && (
                <blockquote class="note">
                  <p>{featuredNote}</p>
                </blockquote>
              )}
            </div>
          </section>

          <dl class="stats" aria-label="The library">
            {statItems.map((s) => (
              <div>
                <dt>{s.label}</dt>
                <dd class="tabular">{s.value.toLocaleString('en-GB')}</dd>
              </div>
            ))}
          </dl>
          <p class="stats-link">
            <a href="/insights">What the ratings say →</a>
          </p>
        </>
      ) : null
    }

    {
      todays.length > 0 && (
        <section aria-labelledby="today-heading">
          <div class="section-head">
            <h2 id="today-heading">For today</h2>
            <span class="muted date">{todayLabel}</span>
          </div>
          <ul role="list" class="picks">
            {todays.map((p) => {
              const action = pickAction(p);
              const href = p.href ?? (p.kind === 'birthday' || p.kind === 'formed' ? `/artist/${p.id}` : `/album/${p.id}`);
              return (
                <li class:list={['pick', { milestone: p.milestone, round: p.kind === 'birthday' || p.kind === 'formed' || p.kind === 'artist' }]}>
                  <span class:list={['pick-art', { genre: p.kind === 'genre' }]} style={p.kind === 'genre' ? `--h: ${hueOf(p.title)}` : undefined}>
                    {p.kind === 'genre' ? (
                      <span class="genre-mark" aria-hidden="true">{p.title.slice(0, 1).toUpperCase()}</span>
                    ) : p.imageKey ? (
                      <img src={`/${p.imageKey}`} alt="" width="160" height="160" loading="lazy" decoding="async" />
                    ) : (
                      <CoverArt artKey={p.artKey} title={p.title} sizes="4.5rem" />
                    )}
                  </span>
                  <span class="pick-text">
                    <span class="pick-line">{pickLine(p)}</span>
                    <a class="pick-title" href={href}>
                      {p.title}
                    </a>
                    {pickCredits(p) ? (
                      <span class="muted small pick-by">
                        <CreditLine credits={pickCredits(p)!} />
                      </span>
                    ) : (
                      p.by && <span class="muted small pick-by">{p.by}</span>
                    )}
                  </span>
                  {action && (
                    <a class="pick-action" href={action.href} {...(action.external ? { target: '_blank', rel: 'noopener' } : {})}>
                      {action.label}
                      {action.external && <span class="visually-hidden"> (opens in a new tab)</span>}
                    </a>
                  )}
                </li>
              );
            })}
          </ul>
        </section>
      )
    }

    {
      started.length > 0 && (
        <section aria-labelledby="started-heading">
          <div class="section-head">
            <h2 id="started-heading">Pick up where you left off</h2>
            <a href="/queue">Queue</a>
          </div>
          <Shelf label="albums in progress" item="min(17rem, 78vw)">
            <ul role="list">
              {started.map((s) => (
                <li class="progress-card">
                  <a class="progress-art" href={`/album/${s.album.id}`} tabindex="-1" aria-hidden="true">
                    <CoverArt artKey={s.album.art_key} title={s.album.title} sizes="4.5rem" />
                  </a>
                  <span class="progress-text">
                    <a class="progress-title" href={`/album/${s.album.id}`}>{s.album.title}</a>
                    <span class="muted small progress-by"><CreditLine credits={s.album.credits} /></span>
                    <span class="progress-bar" aria-hidden="true"><span style={`inline-size: ${Math.round((s.rated / s.total) * 100)}%`} /></span>
                    <span class="progress-line small">
                      <span class="tabular">{s.rated} of {s.total}</span>
                      {s.nextId && <a href={`/edit/rate/recording/${s.nextId}?return_to=/`}>Rate the next</a>}
                    </span>
                  </span>
                </li>
              ))}
            </ul>
          </Shelf>
        </section>
      )
    }

    {
      noticed.length > 0 && (
        <section aria-labelledby="noticed-heading">
          <div class="section-head">
            <h2 id="noticed-heading">You might not have noticed</h2>
            <a href="/insights#patterns-heading">More</a>
          </div>
          <Findings findings={noticed} show={3} rotate="home" moreList={false} />
        </section>
      )
    }

    {
      favourites.length > 1 && (
        <section aria-labelledby="fav-heading">
          <div class="section-head">
            <h2 id="fav-heading">Favourite tracks</h2>
            <a href="/playlists">Playlists</a>
          </div>
          <Shelf label="favourite tracks" item="min(11rem, 42vw)">
            <ol role="list">
              {favourites.map((t, i) => (
                <li class="track-card ranked">
                  <span class="rank tabular" aria-hidden="true">
                    {i + 1}
                  </span>
                  <a class="track-art" href={`/track/${t.id}`} tabindex="-1" aria-hidden="true">
                    <CoverArt artKey={t.art_key} title={t.title} sizes="11rem" />
                  </a>
                  <a class="track-title" href={`/track/${t.id}`}>{t.title}</a>
                  <span class="muted small track-by"><CreditLine credits={t.credits} /></span>
                  <span class="track-foot">
                    {t.album_id ? <a class="muted small album-link" href={`/album/${t.album_id}`}>{t.album_title}</a> : <span />}
                    <Score quality={t.quality_score} personal={t.personal_score} size="s" />
                  </span>
                </li>
              ))}
            </ol>
          </Shelf>
        </section>
      )
    }

    {
      artistsLoved.length > 1 && (
        <section aria-labelledby="artists-heading">
          <div class="section-head">
            <h2 id="artists-heading">Favourite artists</h2>
            <a href="/artists">All artists</a>
          </div>
          <Shelf label="favourite artists" item="min(9rem, 36vw)">
            <ol role="list">
              {artistsLoved.map((a, i) => (
                <li class="face-card ranked">
                  <span class="rank tabular" aria-hidden="true">
                    {i + 1}
                  </span>
                  <a href={`/artist/${a.id}`}>
                    <span class="face">
                      {a.image_key ? (
                        <img src={`/${a.image_key}`} alt="" loading="lazy" decoding="async" width="200" height="200" />
                      ) : (
                        <CoverArt artKey={a.art_key} title={a.name} sizes="9rem" />
                      )}
                    </span>
                    <span class="face-name">{a.name}</span>
                  </a>
                  <span class="muted small tabular">
                    {Math.round(a.average)} across {a.tracks}
                  </span>
                </li>
              ))}
            </ol>
          </Shelf>
        </section>
      )
    }

    {
      best.map((b) => (
        <section aria-labelledby={`best-${b.key}-heading`}>
          <div class="section-head">
            <h2 id={`best-${b.key}-heading`}>{b.heading}</h2>
            {b.key === 'albums' && <a href="/albums">All albums</a>}
          </div>
          <Shelf label={b.heading.toLowerCase()}>
            <ol role="list">
              {b.items.map((album, i) => (
                <li class="ranked">
                  <span class="rank tabular" aria-hidden="true">
                    {i + 1}
                  </span>
                  <AlbumCard album={album} />
                </li>
              ))}
            </ol>
          </Shelf>
        </section>
      ))
    }

    {
      ratings.length > 0 && (
        <section aria-labelledby="ratings-heading">
          <div class="section-head">
            <h2 id="ratings-heading">Recently rated</h2>
            <a href="/diary">The whole diary</a>
          </div>
          <ul class="ratings" role="list">
            {ratings.map((r) => (
              <li>
                <span class="thumb">
                  <CoverArt artKey={r.art_key} title={r.album_title ?? r.title} sizes="3.5rem" />
                </span>
                <div class="rating-text">
                  <p class="rating-title">
                    <a href={r.entity_type === 'recording' ? `/track/${r.entity_id}` : `/album/${r.entity_id}`}>{r.title}</a>
                  </p>
                  <p class="rating-by">
                    <CreditLine credits={r.credits} />
                    <span>
                      {' · '}
                      {r.entity_type === 'release_group' ? (
                        'Album'
                      ) : r.album_title && r.album_id ? (
                        <>
                          Track on <a class="credit-link" href={`/album/${r.album_id}`}>{r.album_title}</a>
                        </>
                      ) : (
                        'Track'
                      )}
                    </span>
                  </p>
                  <time class="when-inline" datetime={r.rated_at}>{formatRelative(r.rated_at)}</time>
                  {r.impact_note && <p class="rating-note">“{r.impact_note}”</p>}
                </div>
                <div class="rating-side">
                  <Score quality={r.quality_score} personal={r.personal_score} size="m" />
                  <time datetime={r.rated_at}>{formatRelative(r.rated_at)}</time>
                </div>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      unplayed.length > 0 && (
        <section aria-labelledby="unplayed-heading">
          <div class="section-head">
            <h2 id="unplayed-heading">Played a lot, never rated</h2>
            <a href="/manage/history">History</a>
          </div>
          <Shelf label="played but not rated" item="min(11rem, 42vw)">
            <ul role="list">
              {unplayed.map((t) => (
                <li class="track-card">
                  <a class="track-art" href={`/track/${t.id}`} tabindex="-1" aria-hidden="true">
                    <CoverArt artKey={t.art_key} title={t.title} sizes="11rem" />
                  </a>
                  <a class="track-title" href={`/track/${t.id}`}>{t.title}</a>
                  <span class="muted small"><CreditLine credits={t.credits} /></span>
                  <span class="track-foot">
                    <span class="muted small tabular">{t.plays} plays</span>
                    <a class="small rate-link" href={`/edit/rate/recording/${t.id}?return_to=/`}>Rate it</a>
                  </span>
                </li>
              ))}
            </ul>
          </Shelf>
        </section>
      )
    }

    {
      genresLoved.length > 2 && (
        <section aria-labelledby="genres-heading">
          <div class="section-head">
            <h2 id="genres-heading">Genres you love</h2>
            <a href="/genres">All genres</a>
          </div>
          <ul role="list" class="genre-chips">
            {genresLoved.map((g) => (
              <li>
                <a href={`/genre/${g.id}`} style={`--h: ${hueOf(g.name)}`}>
                  {g.name}
                  <span class="tabular">{Math.round(g.average)}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section aria-labelledby="recent-heading">
      <div class="section-head">
        <h2 id="recent-heading">Recently added</h2>
        <a href="/search">Search</a>
      </div>
      {
        recent.length === 0 ? (
          <div class="empty">
            <p>Nothing in the catalogue yet.</p>
            {Astro.locals.user && (
              <a class="button button--primary" href="/manage/import">
                Import an album
              </a>
            )}
          </div>
        ) : (
          <ul class="grid" role="list">
            {recent.map((album) => (
              <li>
                <AlbumCard album={album} />
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </div>
</Base>

<style>
  .home {
    display: grid;
    gap: var(--space-7);
  }

  /* Featured album */
  .feature {
    display: grid;
    gap: var(--space-5);
    align-items: end;
    padding-top: var(--space-4);
  }

  .feature-art {
    display: block;
    width: min(22rem, 72vw);
    border-radius: var(--radius-m);
    box-shadow:
      0 2px 4px rgb(0 0 0 / 0.3),
      0 30px 70px -16px rgb(0 0 0 / 0.6);
    transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .feature-art:hover {
    transform: translateY(-3px) scale(1.01);
  }

  .feature-text {
    display: grid;
    gap: var(--space-3);
    min-width: 0;
  }

  .when {
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
  }

  .feature h2 {
    font-size: clamp(2.4rem, 1.4rem + 4vw, 5rem);
    font-weight: 850;
    letter-spacing: -0.04em;
    line-height: 0.95;
    text-wrap: balance;
  }

  .feature h2 a {
    text-decoration: none;
  }

  .feature h2 a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  .feature-by {
    font-size: var(--step-1);
    font-weight: 600;
  }

  .feature-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-4);
    color: var(--text-muted);
  }

  .note {
    margin: var(--space-2) 0 0;
    padding-left: var(--space-4);
    border-left: 2px solid var(--accent);
    max-width: 34rem;
    font-size: var(--step-1);
    font-style: italic;
    line-height: 1.4;
  }

  @media (min-width: 48rem) {
    .feature {
      grid-template-columns: 22rem minmax(0, 1fr);
      gap: var(--space-7);
      padding-top: var(--space-6);
    }
  }

  /* Stats */
  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
    border-block: 1px solid var(--border);
  }

  .stats div {
    display: flex;
    flex-direction: column-reverse;
    gap: 2px;
    padding: var(--space-4) var(--space-3);
  }

  .stats div + div {
    border-left: 1px solid var(--border);
  }

  .stats dd {
    margin: 0;
    font-size: clamp(1.4rem, 1rem + 2vw, 2.25rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .stats dt {
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .stats-link {
    margin-top: calc(var(--space-7) * -1 + var(--space-3));
    text-align: right;
    font-size: var(--step--1);
  }

  .stats-link a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target);
    color: var(--text-muted);
    font-weight: 600;
  }

  /* Sections */
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .section-head h2 {
    font-size: var(--step-2);
    letter-spacing: -0.02em;
  }

  .section-head a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target);
    color: var(--text-muted);
    font-size: var(--step--1);
    font-weight: 600;
  }

  .muted {
    color: var(--text-muted);
  }

