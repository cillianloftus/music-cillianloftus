---
import { pictureAt, pictureSrcset } from '../../lib/pictures';
import Base from '../../layouts/Base.astro';
import Shelf from '../../components/Shelf.astro';
import AlbumCard from '../../components/AlbumCard.astro';
import Backdrop from '../../components/Backdrop.astro';
import CoverArt from '../../components/CoverArt.astro';
import Score from '../../components/Score.astro';
import LinkIcon from '../../components/LinkIcon.astro';
import GenreChips from '../../components/GenreChips.astro';
import Tile from '../../components/Tile.astro';
import Tiles from '../../components/Tiles.astro';
import { ownerId } from '../../lib/auth/user';
import {
  artist as getArtist,
  artistAppearances,
  artistCollaborators,
  artistReleaseGroups,
  hiddenUnofficial,
  artistTracks,
  redirectFor,
  TRACKS_PER_PAGE,
} from '../../lib/catalogue';
import TrackPage from '../../components/TrackPage.astro';
import { artistImages } from '../../lib/artist-images';
import { artistBreakdown } from '../../lib/discover';
import { kinOf } from '../../lib/kin';
import Findings from '../../components/Findings.astro';
import CareerArc from '../../components/CareerArc.astro';
import { hasArc, type ArcRelease } from '../../lib/arc';
import { ageOf, artistAbout, artistGenres, lifeWords } from '../../lib/artists';
import { groupCredits } from '../../lib/credits';
import { formatPartialDate, yearOf } from '../../lib/dates';

const id = Astro.params.id!;
const artist = await getArtist(id);
if (!artist) {
  const merged = await redirectFor('artist', id);
  if (merged) return Astro.redirect(`/artist/${merged}`, 301);
  return Astro.rewrite('/404');
}

const viewerId = Astro.locals.user?.id ?? (await ownerId());
const [albums, appearances, { tracks: topTracks, total: trackTotal }, collaborators, about, images, genres, breakdown, kin] = await Promise.all([
  artistReleaseGroups(artist.id, viewerId),
  artistAppearances(artist.id),
  artistTracks(artist.id, viewerId, 0, TRACKS_PER_PAGE),
  artistCollaborators(artist.id, 8),
  artistAbout(artist.id),
  artistImages(artist.id),
  artistGenres(artist.id),
  viewerId ? artistBreakdown(viewerId, id) : Promise.resolve(null),
  kinOf(id, 6),
]);
// Releases by kind, each newest first: the records, then the shorter ones.
// Sections that earn their place: mixtapes get their own only when there
// are enough of them (Logic's dozen, not Quadeca's one), and so do EPs and
// singles; otherwise they join the section above. Live albums, compilations
// and soundtracks are always their own, since they are a different thing.
const ENOUGH = 3;
// Remix singles and EPs ("Illusion (Honey Dijon remix)") are versions of a
// song, not releases to browse past: their own shelf, folded until opened.
const isVersion = (a: { type: string; title: string }) => (a.type === 'single' || a.type === 'ep') && splitVersion(a.title).version !== null;
const versionReleases = albums.filter(isVersion);
const releases = albums.filter((a) => !isVersion(a));
const ofType = (t: string) => releases.filter((a) => a.type === t).length;
const ownMixtapes = ofType('mixtape') >= ENOUGH;
const ownEps = ofType('ep') >= ENOUGH;
const ownSingles = ofType('single') >= ENOUGH;
// EPs and singles: each its own shelf when there are enough of both; when
// only one kind has enough, the few of the other join it; when neither
// does, they share one shelf. Named for what is actually on it.
const eps = ofType('ep');
const singles = ofType('single');
const shortShelves: { key: string; heading: string; types: string[] }[] =
  ownEps && ownSingles
    ? [
        { key: 'eps', heading: 'EPs', types: ['ep'] },
        { key: 'singles', heading: 'Singles', types: ['single'] },
      ]
    : eps + singles === 0
      ? []
      : [
          {
            key: 'short',
            heading: !eps ? 'Singles' : !singles ? 'EPs' : ownSingles ? 'Singles and EPs' : 'EPs and singles',
            types: ['ep', 'single'],
          },
        ];
const SHELVES = [
  {
    key: 'albums',
    heading: ownMixtapes ? 'Albums' : ofType('mixtape') ? 'Albums and mixtapes' : 'Albums',
    types: ownMixtapes ? ['album'] : ['album', 'mixtape'],
  },
  ...(ownMixtapes ? [{ key: 'mixtapes', heading: 'Mixtapes', types: ['mixtape'] }] : []),
  ...shortShelves,
  { key: 'live', heading: 'Live', types: ['live'] },
  { key: 'compilations', heading: 'Compilations', types: ['compilation'] },
  { key: 'soundtracks', heading: 'Soundtracks', types: ['soundtrack'] },
];
const shelves = [
  ...SHELVES.map((s) => ({ ...s, items: releases.filter((a) => s.types.includes(a.type)), closed: false })),
  { key: 'versions', heading: 'Remixes and versions', types: [], items: versionReleases, closed: true },
].filter((s) => s.items.length > 0);
const user = Astro.locals.user;
const refreshed = Astro.url.searchParams.get('refreshed');
const hidden = user ? await hiddenUnofficial(artist.id) : 0;

// "Born 14 November 2000 (25) · Los Angeles". Their kind (person, group)
// stays behind the scenes: it decides "Born" or "Formed", nothing more.
const words = lifeWords(about.kind);
const age = ageOf(about);
const born = formatPartialDate(about.begin_date, about.begin_precision);
const died = formatPartialDate(about.end_date, about.end_precision);
const identity = [
  born ? `${words.begin} ${born}${age !== null ? ` (${age})` : ''}` : null,
  died ? `${words.end} ${died}` : null,
  about.area,
].filter(Boolean);
// Names they go by. Search hints stay searchable but are often misspellings
// ("Fleedwood Mac"), so they are shown only when they are a real name
// MusicBrainz filed loosely: never for a group, and only alongside a legal name.
const latin = (name: string) => /\p{Script=Latin}/u.test(name);
const otherNames = about.aliases.filter(
  (a) =>
    (a.kind !== 'search' || (about.kind === 'person' && about.aliases.some((b) => b.kind === 'legal'))) &&
    // Not a joint credit MusicBrainz files as an alias ("Kendrick Lamar, SZA"),
    !/,|\s&\s|\sfeat\.?\s|\sx\s/i.test(a.name.replace(artist.name, '')) &&
    // nor the name written in another script, which reads as noise in a list.
    (latin(a.name) || !latin(artist.name)),
);
const firstImage = images[0];
// "Photo: Name, CC BY-SA 4.0 · Wikimedia Commons", without saying the source twice.
const captionOf = (img: (typeof images)[number]) =>
  [...new Set([[img.credit, img.licence].filter(Boolean).join(', '), ({ spotify: 'Spotify', wikimedia: 'Wikimedia Commons', deezer: 'Deezer', genius: 'Genius' } as Record<string, string>)[img.source] ?? ''])]
    .filter(Boolean)
    .join(' · ');

// The wash behind the name: their best-rated album's cover, else the latest.
const rated = albums.filter((a) => a.quality_score != null).sort((a, b) => b.quality_score! - a.quality_score!);
const backdrop = (rated[0] ?? albums[0])?.art_key ?? null;
const scores = rated.map((a) => a.quality_score!);
const average = scores.length ? Math.round(scores.reduce((a, b) => a + b, 0) / scores.length) : null;
const years = albums.map((a) => yearOf(a.first_release_date)).filter((y): y is string => y !== null).sort();
// Still going (something out in the last two years, not split or died):
// "9 releases since 2019". Otherwise the closed span: "12 releases · 1975–1987".
const thisYear = new Date().getUTCFullYear();
const active = years.length > 0 && Number(years.at(-1)) >= thisYear - 2 && !about.end_date;
const span = years.length
  ? active
    ? `since ${years[0]}`
    : years[0] === years.at(-1)
      ? years[0]
      : `${years[0]}–${years.at(-1)}`
  : null;

// Their credits beyond being the artist, by kind, in a panel beside the best tracks.
const otherRoles = appearances.filter((a) => a.family !== 'artist');
const roleFamilies = groupCredits(otherRoles, (r) => r).map((g) => ({ name: g.name, roles: g.items }));
// About: the first paragraph or so of the bio, never a wall of text.
const bioText = about.bio ? (about.bio.length > 700 ? `${about.bio.slice(0, about.bio.lastIndexOf('. ', 700) + 1 || 700)}` : about.bio) : null;
const sentence = (items: string[]) => {
  const words = items.slice(0, 6);
  const text = words.length > 1 ? `${words.slice(0, -1).join(', ')} and ${words.at(-1)}` : (words[0] ?? '');
  return text.charAt(0).toUpperCase() + text.slice(1);
};
// What Wikidata says of them, a line each; influences that are artists here lead to them.
const factsOf = (property: string) => about.facts.filter((f) => f.property === property);
const named = (property: string) => factsOf(property).map((f) => ({ id: f.artist_id, name: f.label }));
const factRows = [
  { term: 'Also called', items: named('nickname') },
  { term: words.begin === 'Formed' ? 'Formed in' : 'Born in', items: named('birthplace') },
  { term: 'Died in', items: named('deathplace') },
  { term: 'Citizen of', items: named('citizenship') },
  { term: 'Studied at', items: named('educated_at') },
  { term: 'Labels', items: named('label') },
  { term: 'Influenced by', items: named('influenced_by') },
  { term: 'Influenced', items: about.influenced.map((a) => ({ id: a.id as string | null, name: a.name })) },
]
  // Born in only when MusicBrainz gave no place: the identity line says it already.
  .filter((r) => r.items.length > 0 && !(r.term.endsWith(' in') && r.term !== 'Died in' && about.area));
const awards = factsOf('award');
const nominations = factsOf('nomination');
const AWARDS_SHOWN = 5;
const LINK_NAMES: Record<string, string> = {
  website: 'Website',
  instagram: 'Instagram',
  x: 'X',
  youtube: 'YouTube',
  tiktok: 'TikTok',
  bandcamp: 'Bandcamp',
  soundcloud: 'SoundCloud',
  facebook: 'Facebook',
  genius: 'Genius',
};
const links = [
  ...about.urls.filter((u) => u.kind in LINK_NAMES).map((u) => ({ href: u.url, label: LINK_NAMES[u.kind]!, icon: u.kind })),
  ...(about.spotify_id ? [{ href: `https://open.spotify.com/artist/${about.spotify_id}`, label: 'Spotify', icon: 'spotify' }] : []),
  ...(about.mbid ? [{ href: `https://musicbrainz.org/artist/${about.mbid}`, label: 'MusicBrainz', icon: 'musicbrainz' }] : []),
  ...(about.discogs_id ? [{ href: `https://www.discogs.com/artist/${about.discogs_id}`, label: 'Discogs', icon: 'discogs' }] : []),
];
// Their own records and singles with a score, by when they came out.
const arcReleases: ArcRelease[] = albums
  .filter((g) => ['album', 'mixtape', 'ep', 'single'].includes(g.type) && g.quality_score != null && g.first_release_date)
  .map((g) => ({ id: g.id, title: g.title, type: g.type, date: g.first_release_date!, score: g.quality_score! }));
const showArc = hasArc(arcReleases);
// Album bars start a little below the lowest average, so close scores still differ visibly.
const albumFloor = breakdown?.albums.length ? Math.max(0, Math.min(...breakdown.albums.map((x) => x.average)) - 15) : 0;
const albumShare = (avg: number) => Math.max(6, Math.round(((avg - albumFloor) / Math.max(1, 100 - albumFloor)) * 100));
const count = albums.length ? `${albums.length} ${albums.length === 1 ? 'release' : 'releases'}` : null;
const facts = [
  active && count ? `${count} ${span}` : count,
  active && count ? null : span,
  average !== null ? `averaging ${average} across ${rated.length} rated` : null,
].filter(Boolean);
import { splitVersion } from '../../lib/versions';
---

<Base
  title={artist.name}
  description={facts.length ? `${artist.name}: ${facts.join(', ')}.` : `${artist.name}, in Cillian Loftus’s music library.`}
  image={backdrop ? `/${backdrop}/1200.jpg` : null}
>
  <div class="wrap page">
    <Backdrop artKey={backdrop} height="30rem" />

    <header class:list={['hero', { 'with-portrait': images.length > 0 }]}>
      {
        firstImage && (
          <figure class="portrait" data-portrait>
            <div class="frames" data-frames tabindex={images.length > 1 ? 0 : undefined} aria-label={images.length > 1 ? `Pictures of ${artist.name}` : undefined}>
              {images.map((img, i) => (
                <img
                  src={pictureAt(img.key, 640)}
                  srcset={`${pictureSrcset(img.key)}, /${img.key} 1600w`}
                  sizes="(min-width: 48rem) 20rem, 100vw"
                  alt={i === 0 ? artist.name : `${artist.name}, picture ${i + 1}`}
                  width={img.width ?? 800}
                  height={img.height ?? 800}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                  data-credit={captionOf(img)}
                  data-href={img.source_url ?? ''}
                />
              ))}
            </div>
            {
              images.length > 1 && (
                <div class="dots" data-dots hidden>
                  {images.map((_, i) => (
                    <button type="button" aria-label={`Picture ${i + 1} of ${images.length}`} aria-current={i === 0 ? 'true' : undefined} data-dot={i} />
                  ))}
                </div>
              )
            }
            <figcaption class="credit">
              <details data-menu>
                <summary aria-label="Picture credit">
                  <svg viewBox="0 0 16 16" aria-hidden="true">
                    <circle cx="8" cy="8" r="6.5" />
                    <path d="M8 7.2v4M8 4.8v.1" />
                  </svg>
                </summary>
                <p>
                  <span data-caption>{captionOf(firstImage)}</span>
                  {firstImage.source_url && (
                    <>
                      {' '}
                      <a href={firstImage.source_url} data-caption-link rel="external noopener" target="_blank">
                        Source<span class="visually-hidden"> (opens in a new tab)</span>
                      </a>
                    </>
                  )}
                </p>
              </details>
            </figcaption>
          </figure>
        )
      }
      <div class="hero-text">
        <div class="who">
        {
          user && (
            <details class="manage" data-manage data-menu>
              <summary>
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="12" r="1.6" /><circle cx="12" cy="12" r="1.6" /><circle cx="19" cy="12" r="1.6" /></svg>
                Manage
              </summary>
              <form method="post" action="/api/write/artist/refresh" class="manage-menu">
                <input type="hidden" name="id" value={artist.id} />
                <a href={`/edit/artist/${artist.id}`}>Edit details, names and pictures</a>
                <button type="submit">Refresh details and pictures</button>
                {albums.length > 0 && (
                  <button type="submit" formaction="/api/write/artist/catalogue" data-catalogue>
                    Refresh all {albums.length} releases
                  </button>
                )}
                {artist.mbid && (
                  <a href={`/manage/import?${new URLSearchParams({ artist: `https://musicbrainz.org/artist/${artist.mbid}` })}#disco-heading`}>
                    Import their discography
                  </a>
                )}
              </form>
            </details>
          )
        }
        {refreshed === '1' && <p role="status" class="muted small">Updated.</p>}
        {refreshed === 'failed' && <p role="alert" class="muted small">That lookup failed; try again shortly.</p>}
        <p class="eyebrow">Artist</p>
        <h1>{artist.name}</h1>
        {
          (identity.length > 0 || artist.disambiguation) && (
            <p class="identity">{[...identity, artist.disambiguation].filter(Boolean).join(' · ')}</p>
          )
        }
        {otherNames.length > 0 && <p class="muted aka">Also known as {otherNames.map((a) => a.name).join(', ')}</p>}
        {
          about.members.length > 0 && (
            <p class="muted">
              Members:{' '}
              {about.members.map((m, i) => (
                <>
                  {i > 0 && ', '}
                  <a href={`/artist/${m.id}`}>{m.name}</a>
                  {m.years && <span class="years"> ({m.years})</span>}
                </>
              ))}
            </p>
          )
        }
        {
          about.memberOf.length > 0 && (
            <p class="muted">
              Member of{' '}
              {about.memberOf.map((m, i) => (
                <>
                  {i > 0 && ', '}
                  <a href={`/artist/${m.id}`}>{m.name}</a>
                  {m.years && <span class="years"> ({m.years})</span>}
                </>
              ))}
            </p>
          )
        }
        {
          about.sameAs.length > 0 && (
            <p class="muted">
              Same person as{' '}
              {about.sameAs.map((m, i) => (
                <>
                  {i > 0 && ', '}
                  <a href={`/artist/${m.id}`}>{m.name}</a>
                </>
              ))}
            </p>
          )
        }
        <GenreChips genres={genres} />
        </div>
        <div class="what">
          {(average !== null || count) && (
            <div class="verdict">
              {average !== null && (
                <span class="verdict-score">
                  <Score quality={average} personal={null} size="l" />
                </span>
              )}
              <span class="verdict-facts">
                {average !== null && <span>Average of {rated.length} rated {rated.length === 1 ? 'release' : 'releases'}</span>}
                {count && <span class="muted">{[active ? `${count} ${span}` : count, active ? null : span].filter(Boolean).join(' · ')}</span>}
              </span>
            </div>
          )}
        </div>
      </div>
    </header>

    {/* Their music first: it is what the page is for. Then favourites, credits and the breakdown. */}
    {
      albums.length === 0 ? (
        <section aria-labelledby="albums-heading">
          <h2 id="albums-heading">Releases</h2>
          <p class="muted">No releases under this name in the catalogue.</p>
        </section>
      ) : (
        <Tiles>
          {shelves.map((shelf) => (
            // One group: opening a kind closes the one open (name), and an open kind takes the whole row.
            <Tile name="release-kinds" key={shelf.key} heading={shelf.heading} count={shelf.items.length}>
              {/* A few covers, so a closed kind still shows its music. */}
              <Fragment slot="peek">
                {shelf.items.slice(0, 3).map((album) => (
                  <span class="peek-art">
                    <CoverArt artKey={album.art_key} title={album.title} sizes="3rem" />
                  </span>
                ))}
              </Fragment>
              <Shelf label={shelf.heading.toLowerCase()}>
                <ul role="list">
                  {shelf.items.map((album) => (
                    <li>
                      <AlbumCard album={album} />
                    </li>
                  ))}
                </ul>
              </Shelf>
            </Tile>
          ))}
        </Tiles>
      )
    }
    {
      hidden > 0 && (
        <p class="hidden-note">
          {hidden} not-official {hidden === 1 ? 'release' : 'releases'} kept off this page. <a href="/manage/unofficial">Clear them</a>
        </p>
      )
    }
    {/* Inline, straight after the kinds: the one to show is open before they paint. */}
    <script is:inline>
      (() => {
        // The kind last opened on this device stays open from page to page
        // ("" when every one was closed); otherwise the first, so the music shows.
        const kinds = [...document.querySelectorAll('details[data-kind]')];
        let last = null;
        try {
          last = localStorage.getItem('open-kind');
        } catch {}
        const remembered = kinds.find((k) => k.dataset.kind === last);
        const open = last === '' ? null : remembered ?? kinds[0];
        if (open) open.open = true;
        for (const kind of kinds) {
          kind.addEventListener('toggle', () => {
            // Closing one because another opened is not a choice to close them all.
            if (!kind.open && kinds.some((k) => k.open)) return;
            try {
              localStorage.setItem('open-kind', kind.open ? kind.dataset.kind : '');
            } catch {}
          });
        }
      })();
    </script>

    {
      (topTracks.length > 0 || roleFamilies.length > 0) && (
        <div class="pair">
    {
          topTracks.length > 0 && (
            <section aria-labelledby="tracks-heading" class="favourites" data-favourites={trackTotal > TRACKS_PER_PAGE ? `/artist/${artist.id}/tracks` : undefined} data-total={trackTotal} data-per-page={TRACKS_PER_PAGE}>
              <div class="favourites-head">
                <h2 id="tracks-heading">Favourite tracks</h2>
                {/* Ten at a time, sideways; past the last comes the first again, and before the first the last. */}
                {trackTotal > TRACKS_PER_PAGE && (
                  <div class="pager" data-pager hidden>
                    <button type="button" data-step="-1" aria-label="Previous ten">
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 6-6 6 6 6" /></svg>
                    </button>
                    <span class="tabular" data-showing aria-live="polite">1–{TRACKS_PER_PAGE} of {trackTotal}</span>
                    <button type="button" data-step="1" aria-label="Next ten">
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
                    </button>
                  </div>
                )}
              </div>
              <div class="track-pages" data-track-pages>
                <TrackPage tracks={topTracks} from={0} />
              </div>
            </section>
          )
        }

          {
            roleFamilies.length > 0 && (
              <section aria-labelledby="credits-heading" class="credits-panel">
                <h2 id="credits-heading">Credited as</h2>
                <dl>
                  {roleFamilies.map((f) => (
                    <div>
                      <dt>{f.name}</dt>
                      <dd>
                        <ul role="list">
                          {f.roles.map((r) => (
                            <li>
                              <a href={`/artist/${artist.id}/as/${r.role}`}>{r.label}</a>
                              <span class="tabular">{r.count}</span>
                            </li>
                          ))}
                        </ul>
                      </dd>
                    </div>
                  ))}
                </dl>
              </section>
            )
          }
        </div>
      )
    }

    {
      breakdown && (
        <section class="breakdown" aria-labelledby="breakdown-heading">
          <h2 id="breakdown-heading">Breakdown</h2>
          <dl class="tiles">
            <div>
              <dt>Highest</dt>
              <dd>
                <span class="tile-value tabular">{Math.round(breakdown.best.score)}</span>
                <span>
                  <a href={`/track/${breakdown.best.id}`}>{breakdown.best.title}</a>
                  {breakdown.best.level > 0 && <span class="also"> and {breakdown.best.level} more</span>}
                </span>
              </dd>
            </div>
            <div>
              <dt>Lowest</dt>
              <dd>
                <span class="tile-value tabular">{Math.round(breakdown.worst.score)}</span>
                <span>
                  <a href={`/track/${breakdown.worst.id}`}>{breakdown.worst.title}</a>
                  {breakdown.worst.level > 0 && <span class="also"> and {breakdown.worst.level} more</span>}
                </span>
              </dd>
            </div>
            <div>
              <dt>Range</dt>
              <dd>
                <span class="tile-value tabular">{Math.round(breakdown.best.score - breakdown.worst.score)}</span>
                <span>
                  {breakdown.steadiness === 'steady' ? 'Steadier than most' : breakdown.steadiness === 'uneven' ? 'More uneven than most' : 'About as even as most'}
                </span>
              </dd>
            </div>
            <div>
              <dt>Against your average</dt>
              <dd>
                <span class="tile-value tabular">
                  {breakdown.versusLibrary >= 0 ? '+' : '−'}
                  {Math.abs(Math.round(breakdown.versusLibrary))}
                </span>
                <span>Median {Math.round(breakdown.median)} over {breakdown.rated} tracks</span>
              </dd>
            </div>
            {breakdown.rank && breakdown.rank.of > 1 && (
              <div>
                <dt>Rank</dt>
                <dd>
                  <span class="tile-value tabular">
                    {breakdown.rank.position}
                    <span class="of"> of {breakdown.rank.of}</span>
                  </span>
                  <a href="/artists">Among artists you’ve rated</a>
                </dd>
              </div>
            )}
          </dl>
          {showArc && (
            <>
              <h3>Over the years</h3>
              <CareerArc releases={arcReleases} title={`${artist.name}'s releases by year and score`} />
            </>
          )}
          {breakdown.albums.length > 1 && (
            <>
              <h3>Their releases, best first</h3>
              <ol class="ranked-albums" role="list">
                {breakdown.albums.map((a) => (
                  <li>
                    <span class="bar" style={`--share: ${albumShare(a.average)}%`} aria-hidden="true" />
                    <a href={`/album/${a.id}`}>{a.title}</a>
                    <span class="muted small tabular">
                      {Math.round(a.average)} · {a.tracks}{a.of && a.of > a.tracks ? ` of ${a.of}` : ''} rated
                    </span>
                  </li>
                ))}
              </ol>
            </>
          )}
          {breakdown.findings.length > 0 && (
            <>
              <h3>What stands out</h3>
              <Findings findings={breakdown.findings} />
            </>
          )}
        </section>
      )
    }

    {
      collaborators.length > 0 && (
        <section aria-labelledby="with-heading">
          <h2 id="with-heading">Works with</h2>
          <ul class="people" role="list">
            {collaborators.map((c) => (
              <li>
                <a href={`/artist/${c.id}`}>{c.name}</a>
                <span class="muted small tabular">
                  {c.count} {c.count === 1 ? 'credit' : 'credits'}
                </span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      kin.length > 0 && (
        <section aria-labelledby="kin-heading">
          <h2 id="kin-heading">Close to</h2>
          <ul class="kin" role="list">
            {kin.map((k) => (
              <li>
                <a href={`/artist/${k.id}`}>{k.name}</a>
                <span class="muted small">
                  {[
                    k.sharedGenres.length ? k.sharedGenres.join(', ') : null,
                    k.sharedPeople.length ? `both work with ${k.sharedPeople.map((p) => p.name).join(', ')}` : null,
                  ]
                    .filter(Boolean)
                    .join(' · ')}
                </span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      (about.bio || about.occupations.length > 0 || about.facts.length > 0 || about.influenced.length > 0 || links.length > 0) && (
        <section class="about" aria-labelledby="about-heading">
          <h2 id="about-heading">{about.bio || about.occupations.length > 0 || about.facts.length > 0 ? 'About' : 'Links'}</h2>
          <div class="about-grid">
            {about.bio && (
              <div class="bio">
                <p>{bioText}</p>
                {about.bio_url && (
                  <p class="small">
                    <a href={about.bio_url} rel="external noopener">
                      More on Wikipedia
                    </a>
                  </p>
                )}
              </div>
            )}
            {(about.occupations.length > 0 || about.instruments.length > 0 || factRows.length > 0 || about.influenced.length > 0) && (
              <dl class="does">
                {about.occupations.length > 0 && (
                  <div>
                    <dt>Does</dt>
                    <dd>{sentence(about.occupations)}</dd>
                  </div>
                )}
                {about.instruments.length > 0 && (
                  <div>
                    <dt>Plays</dt>
                    <dd>{sentence(about.instruments)}</dd>
                  </div>
                )}
                {factRows.map((row) => (
                  <div>
                    <dt>{row.term}</dt>
                    <dd>
                      {row.items.map((item, i) => (
                        <>
                          {i > 0 && ', '}
                          {item.id ? <a href={`/artist/${item.id}`}>{item.name}</a> : item.name}
                        </>
                      ))}
                    </dd>
                  </div>
                ))}
              </dl>
            )}
          </div>
          {awards.length + nominations.length > 0 && (
            <div class="awards">
              <h3>
                {[
                  awards.length ? `${awards.length} ${awards.length === 1 ? 'award' : 'awards'}` : null,
                  nominations.length ? `${nominations.length} ${nominations.length === 1 ? 'nomination' : 'nominations'}` : null,
                ]
                  .filter(Boolean)
                  .join(' · ')}
              </h3>
              <ul role="list">
                {(awards.length ? awards : nominations).slice(0, AWARDS_SHOWN).map((f) => (
                  <li>
                    {f.label}
                    {f.year && <span class="muted"> · {f.year}</span>}
                  </li>
                ))}
              </ul>
              {(awards.length > AWARDS_SHOWN || (awards.length > 0 && nominations.length > 0) || nominations.length > AWARDS_SHOWN) && (
                <details>
                  <summary>All of them</summary>
                  {awards.length > AWARDS_SHOWN && (
                    <ul role="list">
                      {awards.slice(AWARDS_SHOWN).map((f) => (
                        <li>
                          {f.label}
                          {f.year && <span class="muted"> · {f.year}</span>}
                        </li>
                      ))}
                    </ul>
                  )}
                  {awards.length > 0 && nominations.length > 0 && <h4>Nominated for</h4>}
                  <ul role="list">
                    {nominations.slice(awards.length ? 0 : AWARDS_SHOWN).map((f) => (
                      <li>
                        {f.label}
                        {f.year && <span class="muted"> · {f.year}</span>}
                      </li>
                    ))}
                  </ul>
                </details>
              )}
            </div>
          )}
          {links.length > 0 && (
            <ul class="links" role="list" aria-label="Elsewhere">
              {links.map((l) => (
                <li>
                  <a href={l.href} rel="external noopener" target="_blank">
                    <LinkIcon name={l.icon} />
                    {l.label}
                    <span class="visually-hidden"> (opens in a new tab)</span>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </section>
      )
    }

    <div class="elsewhere" data-elsewhere={`/artist/${artist.id}/elsewhere`} aria-live="polite"></div>
  </div>
</Base>

<script>
  // The outside view (Last.fm, setlist.fm) arrives after the page: a slow
  // service never holds up the rest. Fetched when it is nearly in view.
  const slot = document.querySelector<HTMLElement>('[data-elsewhere]');
  if (slot) {
    const load = async () => {
      try {
        const res = await fetch(slot.dataset.elsewhere!);
        if (res.ok) slot.innerHTML = await res.text();
      } catch {
        /* Nothing to add. */
      }
    };
    if ('IntersectionObserver' in window) {
      const seen = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            seen.disconnect();
            void load();
          }
        },
        { rootMargin: '600px' },
      );
      seen.observe(slot);
    } else void load();
  }
</script>

<script>
  // Favourite tracks, ten at a time, swiped sideways or stepped with the
  // arrows. The pages after the first arrive when the list nears view. A
  // copy of the last page waits before the first and a copy of the first
  // after the last: once a swipe settles on a copy, the strip jumps to the
  // page it copies, so the list runs on round in either direction.
  const section = document.querySelector<HTMLElement>('[data-favourites]');
  const strip = section?.querySelector<HTMLElement>('[data-track-pages]');
  const pager = section?.querySelector<HTMLElement>('[data-pager]');
  const showing = section?.querySelector<HTMLElement>('[data-showing]');
  if (section && strip && pager && showing) {
    const total = Number(section.dataset.total);
    const perPage = Number(section.dataset.perPage);
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let pages = 1;
    let step = 1;
    let index = 0;

    const measure = () => {
      const [a, b] = strip.children as HTMLCollectionOf<HTMLElement>;
      step = b && a ? b.offsetLeft - a.offsetLeft : strip.clientWidth;
    };
    // Which real page is in view, from the strip's position (0 is the copy of the last).
    const label = () => {
      const real = (((index - 1) % pages) + pages) % pages;
      showing.textContent = `${real * perPage + 1}–${Math.min(total, (real + 1) * perPage)} of ${total}`;
    };
    const jump = (i: number) => {
      index = i;
      strip.scrollTo({ left: i * step, behavior: 'instant' });
    };
    const settle = () => {
      index = Math.round(strip.scrollLeft / step);
      if (index === 0) jump(pages);
      else if (index === pages + 1) jump(1);
      label();
    };

    const load = async () => {
      let html: string;
      try {
        const res = await fetch(section.dataset.favourites!);
        if (!res.ok) return;
        html = await res.text();
      } catch {
        return; // The first ten stay; nothing to page through.
      }
      strip.insertAdjacentHTML('beforeend', html);
      const real = [...strip.children] as HTMLElement[];
      if (real.length < 2) return;
      pages = real.length;
      const copy = (page: HTMLElement) => {
        const c = page.cloneNode(true) as HTMLElement;
        c.inert = true;
        c.setAttribute('aria-hidden', 'true');
        return c;
      };
      strip.insertAdjacentElement('afterbegin', copy(real.at(-1)!));
      strip.insertAdjacentElement('beforeend', copy(real[0]!));
      measure();
      jump(1);
      pager.hidden = false;

      if ('onscrollend' in window) strip.addEventListener('scrollend', settle);
      else {
        let timer = 0;
        strip.addEventListener('scroll', () => {
          clearTimeout(timer);
          timer = window.setTimeout(settle, 120);
        }, { passive: true });
      }
      // The count follows the swipe, not only its end.
      strip.addEventListener('scroll', () => {
        const near = Math.round(strip.scrollLeft / step);
        if (near !== index) {
          index = near;
          label();
        }
      }, { passive: true });
      for (const button of pager.querySelectorAll<HTMLButtonElement>('[data-step]')) {
        button.addEventListener('click', () => {
          index = Math.round(strip.scrollLeft / step) + Number(button.dataset.step);
          strip.scrollTo({ left: index * step, behavior: still ? 'instant' : 'smooth' });
          label();
        });
      }
      // A wider or narrower screen: the same page stays in view.
      new ResizeObserver(() => {
        const at = index;
        measure();
        jump(at);
      }).observe(strip);
    };

    if ('IntersectionObserver' in window) {
      const near = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            near.disconnect();
            void load();
          }
        },
        { rootMargin: '600px' },
      );
      near.observe(section);
    } else void load();
  }
</script>

<script>
  // Queue the whole catalogue without leaving the page; the tray follows each album.
  const catalogue = document.querySelector<HTMLButtonElement>('[data-catalogue]');
  catalogue?.addEventListener('click', async (event) => {
    const form = catalogue.form;
    if (!form) return;
    event.preventDefault();
    catalogue.disabled = true;
    const label = catalogue.textContent;
    catalogue.textContent = 'Queueing…';
    catalogue.closest('details')?.removeAttribute('open');
    try {
      const res = await fetch(catalogue.formAction, { method: 'POST', body: new FormData(form), headers: { accept: 'application/json' } });
      const { albums } = (await res.json()) as { albums: { title: string; jobs: string[] }[] };
      const jobs = albums.flatMap((album) =>
        album.jobs.map((id, n) => ({ id, label: album.jobs.length > 1 ? `${album.title} (${n + 1} of ${album.jobs.length})` : album.title })),
      );
      window.dispatchEvent(new CustomEvent('job:watch', { detail: { jobs } }));
      catalogue.textContent = albums.length ? `Queued ${albums.length} ${albums.length === 1 ? 'release' : 'releases'}` : 'Nothing to look up';
    } catch {
      form.action = catalogue.formAction;
      form.submit();
    }
    window.setTimeout(() => {
      catalogue.textContent = label;
      catalogue.disabled = false;
    }, 4000);
  });
</script>

<script>
  // The portrait is a strip of pictures: swipe it, tap a dot, or let it
  // move along on its own. It slides; it never fades. It stops moving by
  // itself once touched, and never moves under reduced motion.
  const portrait = document.querySelector<HTMLElement>('[data-portrait]');
  const strip = portrait?.querySelector<HTMLElement>('[data-frames]');
  const frames = strip ? [...strip.querySelectorAll<HTMLImageElement>('img')] : [];
  if (portrait && strip && frames.length > 1) {
    const dots = [...portrait.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    portrait.querySelector<HTMLElement>('[data-dots]')!.hidden = false;
    const caption = portrait.querySelector<HTMLElement>('[data-caption]');
    const link = portrait.querySelector<HTMLAnchorElement>('[data-caption-link]');
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;
    let touched = false;

    const show = (i: number) => {
      current = i;
      dots.forEach((d, n) => (n === i ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));
      const frame = frames[i]!;
      if (caption) caption.textContent = frame.dataset.credit ?? '';
      if (link) {
        link.hidden = !frame.dataset.href;
        if (frame.dataset.href) link.href = frame.dataset.href;
      }
    };
    const go = (i: number) => strip.scrollTo({ left: i * strip.clientWidth, behavior: still ? 'auto' : 'smooth' });

    // The picture in view decides the dot and the credit, however it got there.
    strip.addEventListener(
      'scroll',
      () => {
        const i = Math.round(strip.scrollLeft / strip.clientWidth);
        if (i !== current && frames[i]) show(i);
      },
      { passive: true },
    );
    dots.forEach((dot, i) =>
      dot.addEventListener('click', () => {
        touched = true;
        go(i);
      }),
    );
    for (const event of ['pointerdown', 'wheel', 'keydown'] as const) strip.addEventListener(event, () => (touched = true), { passive: true });
    strip.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') go(Math.min(current + 1, frames.length - 1));
      if (event.key === 'ArrowLeft') go(Math.max(current - 1, 0));
    });

    if (!still) {
      setInterval(() => {
        if (touched || document.hidden || portrait.matches(':hover')) return;
        go((current + 1) % frames.length);
      }, 7000);
    }
  }
</script>

