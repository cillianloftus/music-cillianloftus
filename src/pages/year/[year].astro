---
/**
 * A year in review, drawn from the ratings and plays alone (src/lib/year.ts).
 * Public, like the ratings. Sections without anything to show are left out,
 * so a quiet year is a short page rather than a page of empty boxes.
 */
import Base from '../../layouts/Base.astro';
import AlbumCard from '../../components/AlbumCard.astro';
import Findings from '../../components/Findings.astro';
import ResultList from '../../components/ResultList.astro';
import Shelf from '../../components/Shelf.astro';
import RatingCalendar from '../../components/RatingCalendar.astro';
import { dublinDate } from '../../lib/calendar';
import { ratingMomentsIn } from '../../lib/overview';
import { ownerId } from '../../lib/auth/user';
import { releaseGroupsByIds } from '../../lib/catalogue';
import { hydrateTracks } from '../../lib/query/run';
import { yearInReview } from '../../lib/year';

const year = Number(Astro.params.year);
const thisYear = new Date().getUTCFullYear();
if (!Number.isInteger(year) || year < 1900 || year > thisYear) return Astro.rewrite('/404');

const viewerId = Astro.locals.user?.id ?? (await ownerId());
if (!viewerId) return Astro.rewrite('/404');
const review = await yearInReview(viewerId, year);
const [releases, discoveries, moments, bestOut] = await Promise.all([
  releaseGroupsByIds(review.releases, viewerId),
  hydrateTracks(review.discoveries, viewerId),
  ratingMomentsIn(viewerId, year),
  hydrateTracks(review.released.best, viewerId),
]);
// Keep the order the review chose (best first).
const releaseOrder = new Map(review.releases.map((id, i) => [id, i]));
releases.sort((a, b) => releaseOrder.get(a.id)! - releaseOrder.get(b.id)!);

const n = (x: number, one: string, many = `${one}s`) => `${x.toLocaleString('en-GB')} ${x === 1 ? one : many}`;
const monthName = (m: string) => new Date(`${m}-01T00:00:00Z`).toLocaleDateString('en-GB', { month: 'short', timeZone: 'UTC' });
// The busiest month by the same count the calendar shows: every rating, by its Dublin date.
const byMonth = new Map<string, number>();
for (const at of moments) {
  const month = dublinDate(at).slice(0, 7);
  if (month.startsWith(String(year))) byMonth.set(month, (byMonth.get(month) ?? 0) + 1);
}
const busiest = [...byMonth].map(([month, count]) => ({ month, count })).sort((a, b) => b.count - a.count)[0];
const older = review.years.filter((y) => y < year)[0];
const newer = [...review.years].reverse().find((y) => y > year);
const inProgress = year === thisYear;
// Two kinds of year: the music that came out in it, and the rating done in
// it. Only what has something to say is shown, so 2015 is about 2015's
// records and this year is about both.
const out = review.released;
const stats = [
  ...(out.albums ? [{ label: out.albums === 1 ? 'album or EP from it' : 'albums and EPs from it', value: out.albums }] : []),
  ...(out.rated ? [{ label: out.rated === 1 ? 'track rated' : 'tracks rated', value: out.rated }] : []),
  ...(out.average !== null ? [{ label: 'their average', value: Math.round(out.average) }] : []),
  ...(review.rated ? [{ label: `rated in ${year}`, value: review.rated }] : []),
  ...(review.newArtists ? [{ label: review.newArtists === 1 ? 'new artist' : 'new artists', value: review.newArtists }] : []),
  ...(review.plays ? [{ label: 'plays', value: review.plays }] : []),
];
---

<Base title={`${year} in review`} description={`${year} in music: the best of what came out, and what was rated.`}>
  <div class="wrap page">
    <header>
      <p class="eyebrow">{inProgress ? 'So far' : 'In review'}</p>
      <h1>{year}</h1>
      <nav class="years" aria-label="Other years">
        {older && <a href={`/year/${older}`} rel="prev">← {older}</a>}
        {newer && <a href={`/year/${newer}`} rel="next">{newer} →</a>}
      </nav>
    </header>

    {
      review.rated === 0 && releases.length === 0 && out.rated === 0 ? (
        <p class="muted">Nothing from {year} rated yet.</p>
      ) : (
        <>
          <dl class="stats">
            {stats.map((s) => (
              <div>
                <dd class="tabular">{s.value.toLocaleString('en-GB')}</dd>
                <dt>{s.label}</dt>
              </div>
            ))}
          </dl>

          {review.findings.length > 0 && (
            <section aria-labelledby="different-heading">
              <h2 id="different-heading">What was different about {year}</h2>
              <Findings findings={review.findings} />
            </section>
          )}

          {releases.length > 0 && (
            <section aria-labelledby="releases-heading">
              <h2 id="releases-heading">Best of {year}’s releases</h2>
              <Shelf label={`Best releases of ${year}`}>
                <ol role="list">
                  {releases.map((album) => (
                    <li>
                      <AlbumCard album={album} />
                    </li>
                  ))}
                </ol>
              </Shelf>
            </section>
          )}

          {bestOut.length > 0 && (
            <section aria-labelledby="best-out-heading">
              <h2 id="best-out-heading">Best songs of {year}</h2>
              <ResultList results={bestOut} />
            </section>
          )}

          {out.artists.length > 1 && (
            <section aria-labelledby="year-artists-heading">
              <h2 id="year-artists-heading">Whose {year} it was</h2>
              <ol class="found" role="list">
                {out.artists.map((a) => (
                  <li>
                    <a href={`/artist/${a.id}`}>{a.name}</a>
                    <span class="muted small tabular">
                      {Math.round(a.average)} across {n(a.tracks, 'track')}
                    </span>
                  </li>
                ))}
              </ol>
            </section>
          )}

          {discoveries.length > 0 && (
            <section aria-labelledby="discoveries-heading">
              <h2 id="discoveries-heading">Loved first in {year}</h2>
              <ResultList results={discoveries} />
            </section>
          )}

          {review.found.length > 0 && (
            <section aria-labelledby="found-heading">
              <h2 id="found-heading">Artists you found</h2>
              <ol class="found" role="list">
                {review.found.map((a) => (
                  <li>
                    <a href={`/artist/${a.id}`}>{a.name}</a>
                    <span class="muted small tabular">
                      {Math.round(a.average)} across {n(a.tracks, 'track')}
                    </span>
                  </li>
                ))}
              </ol>
            </section>
          )}

          {review.rated > 0 && (
            <section aria-labelledby="months-heading">
              <h2 id="months-heading">When</h2>
              {busiest && busiest.count > 0 && (
                <p class="muted lead">
                  {monthName(busiest.month)} was the busiest month, with {n(busiest.count, 'rating')}.
                </p>
              )}
              <RatingCalendar ratedAt={moments} today={dublinDate(new Date())} from={`${year}-01-01`} to={`${year}-12-31`} />
            </section>
          )}
        </>
      )
    }
  </div>
</Base>

<style>
  .page {
    display: grid;
    gap: var(--space-7);
  }

  .page > :global(*) {
    min-width: 0;
  }

  header {
    display: grid;
    gap: var(--space-2);
    padding-top: var(--space-6);
  }

  h1 {
    font-size: clamp(3.5rem, 2rem + 8vw, 8rem);
    font-weight: 850;
    letter-spacing: -0.05em;
    line-height: 0.9;
  }

  .years {
    display: flex;
    gap: var(--space-5);
    font-weight: 650;
  }

  .years a {
    text-decoration: none;
  }

  .years a:hover {
    text-decoration: underline;
  }

  h2 {
    margin-bottom: var(--space-4);
    font-size: var(--step-2);
    letter-spacing: -0.02em;
  }

  .muted {
    color: var(--text-muted);
  }

  .small {
    font-size: var(--step--1);
  }

  .lead {
    margin-bottom: var(--space-3);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: var(--space-5) 0;
    border-block: 1px solid var(--border);
  }

  .stats div {
    display: grid;
  }

  .stats dd {
    margin: 0;
    font-size: var(--step-3);
    font-weight: 850;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .stats dt {
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .found {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-2) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .found li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--border);
  }

  .found a {
    font-weight: 650;
    text-decoration: none;
  }

  .found a:hover {
    text-decoration: underline;
  }
</style>
