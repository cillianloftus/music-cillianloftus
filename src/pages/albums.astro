---
/**
 * Every release in the library, one kind at a time: albums (with
 * mixtapes), EPs, singles, and the rest (live, compilations, soundtracks).
 * Best first by default. Sixty at a time; "Show more" adds the next sixty
 * in place, and is an ordinary link without JavaScript.
 */
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import AlbumCard from '../components/AlbumCard.astro';
import CardGrid from '../components/CardGrid.astro';
import Segmented from '../components/Segmented.astro';
import { ownerId } from '../lib/auth/user';
import { byLibrary } from '../lib/library-cache';
import { shelfOfKind, type ShelfKind, type ShelfSort } from '../lib/catalogue';

const PAGE = 60;
const params = Astro.url.searchParams;
const KINDS: [ShelfKind, string][] = [
  ['albums', 'Albums'],
  ['eps', 'EPs'],
  ['singles', 'Singles'],
  ['other', 'Live and more'],
];
const SORTS: [ShelfSort, string][] = [
  ['score', 'Highest scored'],
  ['newest', 'Newest'],
  ['added', 'Recently added'],
  ['name', 'A–Z'],
];
const kind = (KINDS.find(([k]) => k === params.get('kind'))?.[0] ?? 'albums') as ShelfKind;
const sort = (SORTS.find(([s]) => s === params.get('sort'))?.[0] ?? 'score') as ShelfSort;
const page = Math.max(1, Math.min(200, Number(params.get('page')) || 1));

const viewerId = Astro.locals.user?.id ?? (await ownerId());
// The whole shelf is kept per library state, and sliced here.
const all = await byLibrary(`shelf:v1:${kind}:${sort}`, viewerId, () => shelfOfKind(viewerId, kind, sort));
const shown = all.slice((page - 1) * PAGE, page * PAGE);
const more = all.length > page * PAGE;

const href = (next: { kind?: ShelfKind; sort?: ShelfSort; page?: number }) => {
  const q = new URLSearchParams();
  const k = next.kind ?? kind;
  const s = next.sort ?? sort;
  if (k !== 'albums') q.set('kind', k);
  if (s !== 'score') q.set('sort', s);
  if (next.page && next.page > 1) q.set('page', String(next.page));
  const query = q.toString();
  return query ? `/albums?${query}` : '/albums';
};
const heading = KINDS.find(([k]) => k === kind)![1];
---

<Base title={heading === 'Albums' ? 'Albums' : `${heading} · Albums`} description={`${all.length} ${heading.toLowerCase()} in the library, best first.`}>
  <div class="wrap page">
    <PageHeader title={heading === 'Live and more' ? 'Live and more' : heading} count={all.length} />

    <div class="tools">
      <Segmented label="Kind" emphasis items={KINDS.map(([value, label]) => ({ href: href({ kind: value, page: 1 }), label, current: kind === value }))} />
      <Segmented label="Order" items={SORTS.map(([value, label]) => ({ href: href({ sort: value, page: 1 }), label, current: sort === value }))} />
    </div>

    {
      all.length === 0 ? (
        <p class="muted">Nothing of this kind yet.</p>
      ) : (
        <>
          <CardGrid data-shelf-grid>
            {shown.map((album) => (
              <li>
                <AlbumCard album={album} />
              </li>
            ))}
          </CardGrid>
          {more && (
            <p class="more">
              <a class="button" href={href({ page: page + 1 })} data-more>
                Show more
              </a>
              <span class="muted small" data-more-count>
                {Math.min(page * PAGE, all.length)} of {all.length}
              </span>
            </p>
          )}
        </>
      )
    }
  </div>
</Base>

<script>
  // "Show more" adds the next page under this one, keeping your place.
  const link = document.querySelector<HTMLAnchorElement>('[data-more]');
  const grid = document.querySelector<HTMLElement>('[data-shelf-grid]');
  link?.addEventListener('click', async (event) => {
    if (!grid || event.metaKey || event.ctrlKey) return;
    event.preventDefault();
    link.setAttribute('aria-busy', 'true');
    try {
      const doc = new DOMParser().parseFromString(await (await fetch(link.href)).text(), 'text/html');
      for (const item of doc.querySelectorAll('[data-shelf-grid] > li')) grid.appendChild(item);
      const next = doc.querySelector<HTMLAnchorElement>('[data-more]');
      const count = document.querySelector('[data-more-count]');
      const nextCount = doc.querySelector('[data-more-count]');
      if (next) {
        link.href = next.href;
        if (count && nextCount) count.textContent = nextCount.textContent;
      } else {
        link.closest('p')?.remove();
      }
    } catch {
      location.href = link.href;
    } finally {
      link.removeAttribute('aria-busy');
    }
  });
</script>

<style>
  .page {
    display: grid;
    gap: var(--space-5);
  }

  .tools {
    display: grid;
    gap: var(--space-2);
  }

  .more {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }
</style>
