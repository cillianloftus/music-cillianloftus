---
/**
 * A track: where it appears, how it is rated and why, who made it, and
 * every other version of the same song in the library.
 */
import Base from '../../layouts/Base.astro';
import Backdrop from '../../components/Backdrop.astro';
import CoverArt from '../../components/CoverArt.astro';
import CreditLine from '../../components/CreditLine.astro';
import Score from '../../components/Score.astro';
import ScorePanel from '../../components/ScorePanel.astro';
import { groupCredits } from '../../lib/credits';
import LinkIcon from '../../components/LinkIcon.astro';
import { ownerId } from '../../lib/auth/user';
import { redirectFor, standardTracklist, trackGenres } from '../../lib/catalogue';
import AlbumShape from '../../components/AlbumShape.astro';
import { hasShape, shapeOf } from '../../lib/shape';
import { yearOf } from '../../lib/dates';
import { describeDuration, formatDuration, roleLabel } from '../../lib/format';
import { playCounts, trackListening } from '../../lib/history';
import { libraryFacts } from '../../lib/discover';
import { standing } from '../../lib/standing';
import BarChart from '../../components/BarChart.astro';
import { otherVersions, trackAppearances, trackCredits, trackDetail } from '../../lib/pages';
import { ratingHistory } from '../../lib/ratings';
import { spotifyLink } from '../../lib/spotify/links';
import { splitVersion } from '../../lib/versions';
import { trackLinks, type LinkedTrack } from '../../lib/song-links';

const id = Astro.params.id!;
const user = Astro.locals.user;
const viewerId = user?.id ?? (await ownerId());
const track = await trackDetail(id, viewerId);
if (!track) {
  const merged = await redirectFor('recording', id);
  if (merged) return Astro.redirect(`/track/${merged}`, 301);
  return Astro.rewrite('/404');
}

const [appearances, credits, versions, genres, history, plays, songLinks] = await Promise.all([
  trackAppearances(id, viewerId),
  trackCredits(id),
  otherVersions(id, track.work_id, viewerId),
  trackGenres(id),
  viewerId ? ratingHistory(viewerId, 'recording', id) : Promise.resolve([]),
  user ? playCounts(user.id, [id]) : Promise.resolve(new Map<string, number>()),
  trackLinks(id),
]);
// What it takes from and what takes from it, each kind only when there is some.
const LINKS_SHOWN = 5;
const linkGroups = [
  { key: 'samples', label: 'Samples', tracks: songLinks.samples },
  { key: 'interpolates', label: 'Interpolates', tracks: songLinks.interpolates },
  { key: 'sampled-in', label: 'Sampled in', tracks: songLinks.sampledIn },
  { key: 'interpolated-in', label: 'Interpolated in', tracks: songLinks.interpolatedIn },
].filter((g) => g.tracks.length > 0);
const hasSamples = songLinks.samples.length + songLinks.sampledIn.length > 0;
const hasInterpolations = songLinks.interpolates.length + songLinks.interpolatedIn.length > 0;
const linksHeading = hasSamples && hasInterpolations ? 'Samples and interpolations' : hasSamples ? 'Samples' : 'Interpolations';
// What sets each version apart, said first ("Swisha House remix", "Live at
// Reading 2017"); plain takes, the song itself elsewhere, come first.
const VERSIONS_SHOWN = 6;
const sortedVersions = versions
  .map((v) => {
    const kind = splitVersion(v.title).version;
    return { ...v, kind: kind ? kind.charAt(0).toUpperCase() + kind.slice(1) : null, };
  })
  .sort((a, b) => Number(a.kind !== null) - Number(b.kind !== null));

// The album it belongs to (for "4 on …"), and the release it first came out
// on (for its cover): a single's art when the single came first, the
// album's when the album did.
const firstOut = appearances[0] ?? null;
const home = appearances.find((a) => a.album.type === 'album' || a.album.type === 'mixtape') ?? firstOut;
const latest = history[0] ?? null;
const artistNames = track.credits.map((c) => c.name).join(', ');
const byRole = new Map<string, typeof credits>();
for (const c of credits) byRole.set(c.role, [...(byRole.get(c.role) ?? []), c]);
const creditFamilies = groupCredits([...byRole], ([, list]) => list[0]!).map((g) => ({ name: g.name, roles: g.items }));
// Axes given, and those marked as not applying (an instrumental's lyrics).
// A rating from before production split in two shows it as it was given.
const axes = latest
  ? ([
      ...(latest.production != null
        ? ([['Production', 'production', latest.production]] as const)
        : ([
            ['Arrangement', 'arrangement', latest.arrangement],
            ['Sound', 'sound', latest.sound],
          ] as const)),
      ['Songwriting', 'songwriting', latest.songwriting],
      ['Lyrics', 'lyrics', latest.lyrics],
      ['Performance', 'performance', latest.performance],
      ['Originality', 'originality', latest.originality],
    ] as const)
      .filter(([, key, v]) => v != null || latest.not_applicable.includes(key))
      .map(([label, key, v]) => [label, v ?? (latest.not_applicable.includes(key) ? 'n/a' : null)] as const)
  : [];
// Pages elsewhere about this track, only those that exist.
const links = [
  track.spotify_id ? { label: 'Spotify', href: `https://open.spotify.com/track/${track.spotify_id}`, icon: 'spotify' } : null,
  track.genius_url ? { label: 'Lyrics on Genius', href: track.genius_url, icon: 'genius' } : null,
  track.mbid ? { label: 'MusicBrainz', href: `https://musicbrainz.org/recording/${track.mbid}`, icon: 'musicbrainz' } : null,
].filter((l): l is { label: string; href: string; icon: string } => l !== null);
const listenHref = spotifyLink('track', track.spotify_id, `${track.credits[0]?.name ?? ''} ${track.title}`);
const rateHref = `/edit/rate/recording/${id}?return_to=${encodeURIComponent(`/track/${id}`)}`;
const playCount = plays.get(id) ?? 0;
const listening = user && playCount > 0 ? await trackListening(user.id, id) : null;
// Where it stands among everything else rated: only the notable is said.
const standingLines = viewerId && track.quality_score !== null ? standing(await libraryFacts(viewerId), id) : [];
// Where it falls in its album's run, when the album has a shape to show.
const homeTracks = home ? await standardTracklist(home.album.id, viewerId) : [];
const homeOrder = homeTracks.map((t) => ({ id: t.recording_id, position: t.position, title: t.title, score: t.quality_score ?? null }));
const homeShape = homeOrder.some((t) => t.id === id) && hasShape(homeOrder.map((t) => t.score)) ? shapeOf(homeOrder.map((t) => t.score)) : null;
const monthName = (m: string) => new Date(`${m}-01T00:00:00Z`).toLocaleDateString('en-GB', { month: 'short', year: '2-digit', timeZone: 'UTC' });
const dayName = (iso: string) => new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Dublin' });
const SOURCE: Record<string, string> = { spotify_export: 'Spotify', lastfm: 'Last.fm', listenbrainz: 'ListenBrainz', manual: 'by hand' };
// How loud it was mastered, from Deezer's replay gain: how far a player turns
// it down, so the more negative, the louder.
function loudnessWords(gain: number | null): string | null {
  if (gain === null) return null;
  const db = `${gain < 0 ? '−' : '+'}${Math.abs(gain).toFixed(1)} dB`;
  return gain <= -10 ? `mastered very loud (${db})` : gain <= -7 ? `mastered loud (${db})` : gain <= -3 ? null : `mastered quietly (${db})`;
}
const compact = new Intl.NumberFormat('en-GB', { notation: 'compact', maximumFractionDigits: 1 });
// What kind of recording, from MusicBrainz: "Live cover", "Instrumental".
const kindText = [track.is_live ? 'live' : null, track.is_cover ? 'cover' : null, track.is_instrumental ? 'instrumental' : null].filter(Boolean).join(' ');
const kindWords = kindText ? kindText.charAt(0).toUpperCase() + kindText.slice(1) : null;
function ordinalOf(n: number): string {
  const rem = n % 100;
  const suffix = rem >= 11 && rem <= 13 ? 'th' : ({ 1: 'st', 2: 'nd', 3: 'rd' } as Record<number, string>)[n % 10] ?? 'th';
  return `${n}${suffix}`;
}
---

<Base
  title={`${track.title} by ${artistNames}`}
  description={[home ? `From ${home.album.title}.` : null, track.personal_score != null ? `Rated ${Math.round(track.personal_score)}.` : null, latest?.impact_note ? `“${latest.impact_note}”` : null]
    .filter(Boolean)
    .join(' ')}
  image={firstOut?.album.art_key ? `/${firstOut.album.art_key}/1200.jpg` : null}
>
  <article class="wrap page">
    <Backdrop artKey={firstOut?.album.art_key} height="34rem" />

    <header class="hero">
      {
        home && (
          <a class="art" href={`/album/${firstOut!.album.id}`} tabindex="-1" aria-hidden="true">
            <CoverArt artKey={firstOut!.album.art_key} title={firstOut!.album.title} sizes="(min-width: 48rem) 16rem, 60vw" priority />
          </a>
        )
      }
      <div class="intro">
        <div class="titles">
        <p class="eyebrow">
          Track
          {home && home.position && <> · {home.disc && home.disc > 1 ? `${home.disc}.` : ''}{home.position} on <a href={`/album/${home.album.id}`}>{home.album.title}</a></>}
          {home && yearOf(home.album.first_release_date) && <> · {yearOf(home.album.first_release_date)}</>}
        </p>
        <h1 class:list={[{ long: track.title.length > 18, longer: track.title.length > 34 }]}>{track.title}</h1>
        <p class="by"><CreditLine credits={track.credits} /></p>
        <p class="facts muted">
          {[
            kindWords,
            track.length_ms ? formatDuration(track.length_ms) : null,
            track.bpm ? `${Math.round(track.bpm)} BPM` : null,
            loudnessWords(track.loudness),
            track.explicit ? 'Explicit' : null,
            user && playCount > 0 ? `you have played it ${playCount} ${playCount === 1 ? 'time' : 'times'}` : null,
          ]
            .filter(Boolean)
            .join(' · ')}
          {track.length_ms && <span class="visually-hidden"> ({describeDuration(track.length_ms)})</span>}
        </p>
        {
          latest?.impact_note && (
            <blockquote class="epigraph" aria-label="Your note">
              <p>{latest.impact_note}</p>
            </blockquote>
          )
        }
        </div>

        <ScorePanel quality={track.quality_score} personal={track.personal_score} rating={null} trackAxes={axes} rateHref={user ? rateHref : null} />
      </div>

      <div class="more">
        {
          standingLines.length > 0 && (
            <ul class="standing" role="list" aria-label="Where it stands">
              {standingLines.map((s) => (
                <li>{s.href ? <a href={s.href}>{s.text}</a> : s.text}</li>
              ))}
            </ul>
          )
        }

        {
          (track.listen_count != null || track.mb_rating != null) && (
            <p class="heard muted small">
              {[
                track.listen_count != null && track.listener_count != null
                  ? `${compact.format(track.listen_count)} ${track.listen_count === 1 ? 'listen' : 'listens'} by ${compact.format(track.listener_count)} ${track.listener_count === 1 ? 'person' : 'people'} on ListenBrainz`
                  : null,
                track.mb_rating != null
                  ? `rated ${track.mb_rating.toFixed(1)} of 5 by ${track.mb_rating_votes} on MusicBrainz`
                  : null,
              ]
                .filter(Boolean)
                .join(' · ')}
            </p>
          )
        }

        {
          genres.genres.length > 0 && (
            <ul class="genres" aria-label={genres.inherited ? 'Genres, from its album' : 'Genres'} title={genres.inherited ? 'From its album' : undefined}>
              {genres.genres.map((g) => (
                <li>
                  <a href={`/genre/${g.id}`}>{g.name}</a>
                </li>
              ))}
            </ul>
          )
        }

        <p class="actions">
          <a class="button" href={listenHref} target="_blank" rel="noopener" data-play={track.spotify_id ? '' : undefined} data-track={track.spotify_id ?? undefined}>
<svg class="spotify-mark" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="9" />
              <path d="M7.5 10c3-1 6.3-.7 9 .8M8.2 13.2c2.4-.7 5-.5 7.2.6M8.8 16.2c1.8-.4 3.6-.3 5.3.4" />
            </svg>
            {track.spotify_id ? 'Listen' : 'Search'}
            <span class="visually-hidden">{track.spotify_id ? ' on Spotify' : ' for it on Spotify'}</span>
            <span class="visually-hidden"> (opens in a new tab)</span>
          </a>
          {user && (
            <a class="button button--quiet" href={`/edit/track/${id}`}>
              Edit
            </a>
          )}
        </p>
      </div>
    </header>

    <div class="below">
      <div class="main-col">
    {
      listening && listening.months.length > 1 && (
        <section aria-labelledby="listening-heading">
          <h2 id="listening-heading">Listening</h2>
          <p class="muted">
            {listening.total.toLocaleString('en-GB')} {listening.total === 1 ? 'play' : 'plays'}, your {listening.rank === 1 ? 'most played' : `${ordinalOf(listening.rank)} most played`} of {listening.of.toLocaleString('en-GB')}.
            First on {dayName(listening.first)}, last on {dayName(listening.last)}. From {listening.sources.map((s) => SOURCE[s] ?? s).join(' and ')}.
          </p>
          <BarChart
            title="Plays by month"
            valueLabel="Plays"
            labelEvery={Math.max(1, Math.ceil(listening.months.length / 8))}
            bars={listening.months.map((m) => ({ label: monthName(m.month), value: m.count, detail: `${m.count} ${m.count === 1 ? 'play' : 'plays'}` }))}
          />
        </section>
      )
    }
    {
      home && homeShape && (
        <section aria-labelledby="place-heading">
          <h2 id="place-heading">
            Track {homeOrder.findIndex((t) => t.id === id) + 1} of {homeOrder.length} on <a href={`/album/${home.album.id}`}>{home.album.title}</a>
          </h2>
          <AlbumShape tracks={homeOrder} shape={homeShape} albumTitle={home.album.title} highlight={id} />
        </section>
      )
    }
    {
      appearances.length > 0 && (
        <section aria-labelledby="on-heading">
          <h2 id="on-heading">{appearances.length === 1 ? 'Appears on' : `Appears on ${appearances.length} albums`}</h2>
          <ul role="list" class="rows">
            {appearances.map((a) => (
              <li>
                <span class="thumb">
                  <CoverArt artKey={a.album.art_key} title={a.album.title} sizes="3rem" />
                </span>
                <span class="row-text">
                  <a href={`/album/${a.album.id}`}>{a.album.title}</a>
                  <span class="muted small">
                    <CreditLine credits={a.album.credits} />
                    {yearOf(a.album.first_release_date) && ` · ${yearOf(a.album.first_release_date)}`}
                    {a.position && ` · track ${a.position}`}
                  </span>
                </span>
                <Score quality={a.album.quality_score} personal={a.album.personal_score} size="m" quietWhenEmpty />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      versions.length > 0 && (
        <section aria-labelledby="versions-heading">
          <h2 id="versions-heading">
            Other versions <span class="count tabular">{versions.length}</span>
          </h2>
          <ul role="list" class="rows">
            {sortedVersions.slice(0, VERSIONS_SHOWN).map((v) => (
              <li>
                <span class="thumb">
                  <CoverArt artKey={v.art_key} title={v.album_title ?? v.title} sizes="3rem" />
                </span>
                <span class="row-text">
                  <a href={`/track/${v.id}`}>
                    {v.kind ?? v.album_title ?? 'Original'}
                    <span class="visually-hidden">: {v.title}</span>
                  </a>
                  <span class="muted small">
                    <CreditLine credits={v.credits} />
                    {v.kind && v.album_title && ` · ${v.album_title}`}
                    {v.year && ` · ${v.year}`}
                  </span>
                </span>
                <Score quality={v.quality_score} personal={v.personal_score} size="m" quietWhenEmpty />
              </li>
            ))}
          </ul>
          {sortedVersions.length > VERSIONS_SHOWN && (
            <details class="more-versions">
              <summary>All {sortedVersions.length} versions</summary>
              <ul role="list" class="rows">
                {sortedVersions.slice(VERSIONS_SHOWN).map((v) => (
                  <li>
                <span class="thumb">
                  <CoverArt artKey={v.art_key} title={v.album_title ?? v.title} sizes="3rem" />
                </span>
                <span class="row-text">
                  <a href={`/track/${v.id}`}>
                    {v.kind ?? v.album_title ?? 'Original'}
                    <span class="visually-hidden">: {v.title}</span>
                  </a>
                  <span class="muted small">
                    <CreditLine credits={v.credits} />
                    {v.kind && v.album_title && ` · ${v.album_title}`}
                    {v.year && ` · ${v.year}`}
                  </span>
                </span>
                <Score quality={v.quality_score} personal={v.personal_score} size="m" quietWhenEmpty />
              </li>
                ))}
              </ul>
            </details>
          )}
        </section>
      )
    }

        {
          linkGroups.length > 0 && (
            <section aria-labelledby="song-links-heading" class="song-links">
              <h2 id="song-links-heading">{linksHeading}</h2>
              {linkGroups.map((g) => {
                const row = (t: LinkedTrack) => (
                  <li class:list={{ here: t.recording_id !== null }}>
                    {t.recording_id ? (
                      <a href={`/track/${t.recording_id}`}>{t.title}</a>
                    ) : (
                      <a href={t.url} rel="external noopener" target="_blank">
                        {t.title}
                        <span class="visually-hidden"> on Genius (opens in a new tab)</span>
                      </a>
                    )}
                    <span class="muted small">
                      {t.artist}
                      {t.year && ` · ${t.year}`}
                    </span>
                  </li>
                );
                return (
                  <div class="link-group">
                    <h3 id={`links-${g.key}`}>
                      {g.label} {g.tracks.length > 1 && <span class="count tabular">{g.tracks.length}</span>}
                    </h3>
                    <ul role="list" aria-labelledby={`links-${g.key}`}>
                      {g.tracks.slice(0, LINKS_SHOWN).map(row)}
                    </ul>
                    {g.tracks.length > LINKS_SHOWN && (
                      <details class="more-versions">
                        <summary>All {g.tracks.length}</summary>
                        <ul role="list">{g.tracks.slice(LINKS_SHOWN).map(row)}</ul>
                      </details>
                    )}
                  </div>
                );
              })}
              <p class="muted small">From Genius</p>
            </section>
          )
        }

        {
          links.length > 0 && (
            <section class="links" aria-labelledby="links-heading">
              <h2 id="links-heading">Links</h2>
              <ul role="list">
                {links.map((l) => (
                  <li>
                    <a href={l.href} rel="external noopener" target="_blank">
                      <LinkIcon name={l.icon} />
                      {l.label}
                      <span class="visually-hidden"> (opens in a new tab)</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </div>

    {
      byRole.size > 0 && (
        <aside aria-labelledby="credits-heading" class="credits-panel">
          <h2 id="credits-heading">Credits</h2>
          <dl>
            {creditFamilies.map((f) => (
              <div class="family">
                <dt>{f.name}</dt>
                {f.roles.map(([role, list]) => (
                  <dd>
                    <span class="role">{roleLabel(role, list.length, list[0]!.role_label)}</span>
                    <span class="names">
                      {list.map((c, i) => (
                        <>
                          <a href={`/artist/${c.artist_id}`}>{c.name}</a>
                          {i < list.length - 1 && ', '}
                        </>
                      ))}
                    </span>
                  </dd>
                ))}
              </div>
            ))}
          </dl>
        </aside>
      )
    }
    </div>

    {
      history.length > 1 && (
        <details class="history-box">
          <summary>
            <h2 id="history-heading">Rated {history.length} times</h2>
          </summary>
          <ol role="list" class="history">
            {history.map((r) => (
              <li>
                <time datetime={r.rated_at}>{new Date(r.rated_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}</time>
                <span>
                  {r.gut_score != null && `Gut ${r.gut_score}`}
                  {r.production != null && ` · Production ${r.production}`}
                  {r.production == null && r.arrangement != null && ` · Arrangement ${r.arrangement}`}
                  {r.production == null && r.sound != null && ` · Sound ${r.sound}`}
                  {r.songwriting != null && ` · Songwriting ${r.songwriting}`}
                  {r.lyrics != null && ` · Lyrics ${r.lyrics}`}
                  {r.performance != null && ` · Performance ${r.performance}`}
                  {r.originality != null && ` · Originality ${r.originality}`}
                  {r.impact != null && ` · Impact ${r.impact}`}
                </span>
              </li>
            ))}
          </ol>
        </details>
      )
    }
  </article>
</Base>

<style>
  .page {
    display: grid;
    gap: var(--space-7);
  }

  /* As on the album page: titles at the top of the column, the score
     panel along the cover's bottom edge, the rest in a row beneath. */
  .hero {
    display: grid;
    gap: var(--space-5);
    padding-top: var(--space-6);
  }

  @media (min-width: 48rem) {
    .hero {
      grid-template-columns: 16rem minmax(0, 1fr);
      column-gap: var(--space-7);
      row-gap: var(--space-5);
    }

    .art {
      align-self: start;
    }

    .more {
      grid-column: 2;
    }
  }

  /* Phones: full width, as on album pages; wide screens: a little smaller than an album's. */
  .art {
    display: block;
    width: 100%;
    max-width: 24rem;
    border-radius: var(--radius-m);
    box-shadow:
      0 2px 4px rgb(0 0 0 / 0.3),
      0 24px 60px -12px rgb(0 0 0 / 0.55);
  }

  .intro {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-5);
    min-width: 0;
  }

  .titles,
  .more {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    min-width: 0;
  }

  .eyebrow a {
    color: inherit;
  }

  h1 {
    font-size: clamp(2.2rem, 1.4rem + 3.2vw, 4rem);
    line-height: 0.98;
  }

  /* The tight display title needs air before the artist line. */
  .by {
    margin-top: var(--space-3);
    font-size: var(--step-1);
    font-weight: 600;
  }

  .muted {
    color: var(--text-muted);
  }

  .small {
    font-size: var(--step--1);
  }

  .facts:empty {
    display: none;
  }

  .axes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
  }

  .axes div {
    display: flex;
    gap: var(--space-2);
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: var(--step--1);
  }

  .axes dt {
    color: var(--text-muted);
  }

  .axes dd {
    margin: 0;
    font-weight: 700;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .note {
    margin: var(--space-2) 0 0;
    padding-left: var(--space-4);
    border-left: 2px solid var(--accent);
    max-width: 34rem;
  }

  .note blockquote {
    margin: 0;
    font-size: var(--step-1);
    font-style: italic;
  }

  .note figcaption {
