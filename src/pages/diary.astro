---
/**
 * The rating diary: everything rated, newest first, by month, with the
 * impact notes that say where and when. Ratings are public by Cillian's
 * choice (ARCHITECTURE.md §3), and the notes are the part that will matter
 * most in ten years.
 */
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Backdrop from '../components/Backdrop.astro';
import CoverArt from '../components/CoverArt.astro';
import CreditLine from '../components/CreditLine.astro';
import Score from '../components/Score.astro';
import { ownerId } from '../lib/auth/user';
import RatingCalendar from '../components/RatingCalendar.astro';
import { dublinDate } from '../lib/calendar';
import { byLibrary } from '../lib/library-cache';
import { ratingMoments, recentRatings, type RecentRating } from '../lib/overview';

const viewerId = Astro.locals.user?.id ?? (await ownerId());
// Kept per library state: a new rating moves the stamp, so the diary is never behind.
const [ratings, moments] = await byLibrary('diary:v1', viewerId, () => Promise.all([recentRatings(viewerId, 400), ratingMoments(viewerId)]));

const month = new Intl.DateTimeFormat('en-GB', { month: 'long', year: 'numeric', timeZone: 'Europe/Dublin' });
const day = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', timeZone: 'Europe/Dublin' });
const months = new Map<string, RecentRating[]>();
for (const r of ratings) {
  const key = month.format(new Date(r.rated_at));
  months.set(key, [...(months.get(key) ?? []), r]);
}
---

<Base title="Diary" description="Every album and track rated, newest first, with notes on where and when.">
  <div class="wrap page">
    <Backdrop artKey={ratings[0]?.art_key} height="28rem" />
    <PageHeader title="Diary" />
    {moments.length > 0 && <RatingCalendar ratedAt={moments} today={dublinDate(new Date())} />}

    {
      ratings.length === 0 ? (
        <p class="muted">Nothing rated yet.</p>
      ) : (
        [...months].map(([name, entries]) => (
          <section aria-labelledby={`m-${name.replace(/\s+/g, '-')}`} class="month">
            <h2 id={`m-${name.replace(/\s+/g, '-')}`}>
              {name.split(' ')[0]} <span class="year">{name.split(' ')[1]}</span>
            </h2>
            <ol role="list" class="entries">
              {entries.map((r, i) => (
                <li class:list={[{ noted: r.impact_note }]}>
                  {/* The date once per day, as a diary would; the slot keeps its width either way. */}
                  <time datetime={r.rated_at} class:list={[{ again: i > 0 && day.format(new Date(entries[i - 1]!.rated_at)) === day.format(new Date(r.rated_at)) }]}>
                    {day.format(new Date(r.rated_at))}
                  </time>
                  <span class="art">
                    <CoverArt artKey={r.art_key} title={r.album_title ?? r.title} sizes="4rem" />
                  </span>
                  <div class="text">
                    <p class="title"><a href={r.entity_type === 'recording' ? `/track/${r.entity_id}` : `/album/${r.entity_id}`}>{r.title}</a></p>
                    <p class="by">
                      <CreditLine credits={r.credits} />
                      {' · '}
                      {r.entity_type === 'release_group' ? 'Album' : 'Track'}
                    </p>
                    {r.impact_note && <blockquote>{r.impact_note}</blockquote>}
                  </div>
                  <span class="score">
                    <Score quality={r.quality_score} personal={r.personal_score} size="m" />
                  </span>
                </li>
              ))}
            </ol>
          </section>
        ))
      )
    }
  </div>
</Base>

<style>
  .page {
    display: grid;
    gap: var(--space-6);
    --content-max: 50rem;
  }

  header {
    display: grid;
    gap: var(--space-2);
    padding-top: var(--space-5);
  }


  .muted {
    color: var(--text-muted);
  }

  /* A month opens like a chapter: the name large, the year quiet beside it. */
  h2 {
    margin: 0 0 var(--space-3);
    font-size: var(--step-2);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .year {
    color: var(--text-subtle);
    font-weight: 500;
  }

  .entries {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: 3.5rem 4rem minmax(0, 1fr) auto;
    align-items: start;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--border);
  }

  time {
    padding-top: 0.15rem;
    color: var(--text-subtle);
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
  }

  .art {
    width: 4rem;
    border-radius: var(--radius-s);
    overflow: hidden;
  }

  .text {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .title {
    font-weight: 700;
  }

  .title a {
    text-decoration: none;
  }

  .title a:hover {
    text-decoration: underline;
  }

  .by {
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  blockquote {
    margin: var(--space-2) 0 0;
    padding-left: var(--space-3);
    border-left: 2px solid var(--accent);
    font-size: var(--step-1);
    font-style: italic;
    line-height: 1.4;
    text-wrap: pretty;
  }

  @media (max-width: 30rem) {
    li {
      grid-template-columns: 3.25rem minmax(0, 1fr) auto;
    }

    time {
      grid-column: 1 / -1;
    }

    .art {
      width: 3.25rem;
    }
  }

  /* A repeat of the day above: left out for everyone; the slot keeps its width. */
  time.again {
    visibility: hidden;
  }
</style>
