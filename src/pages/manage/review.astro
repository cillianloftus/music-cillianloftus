---
/**
 * The review queue (ARCHITECTURE.md §3). One kind at a time, a page of
 * cards each, so a big list never buries a small one. A pair asks one
 * question, "Are these the same?", with the two side by side and what
 * differs marked; "Same" merges them whole (src/lib/merge.ts), "Different"
 * never asks again, "Skip" sends it to the back for later.
 */
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import CoverArt from '../../components/CoverArt.astro';
import { missingInfo } from '../../lib/gaps';
import { byLibrary } from '../../lib/library-cache';
import { linkableVersions, matchingAlbumPairs, matchingTrackPairs, openAnomalies, openCounts, reviewEntities, type Anomaly, type AnomalyKind } from '../../lib/review';

const PAGE = 25;
/** The order they are offered in: the quick, important ones first. */
const ORDER: AnomalyKind[] = [
  'duplicate_artist_name',
  'near_duplicate_release_group',
  'near_duplicate_recording',
  'version_of_recording',
  'outdated_rating',
  'missing_cover_art',
  'unlinked_rated_recording',
  'track_count_mismatch',
  'orphaned_track',
];
const KINDS: Record<AnomalyKind, { tab: string; question?: string; explain: string }> = {
  duplicate_artist_name: {
    tab: 'Artists',
    question: 'Same artist?',
    explain: 'Two artists with one name. If they are one person or group, merging puts all their albums, songs, credits and pictures together.',
  },
  near_duplicate_release_group: {
    tab: 'Albums',
    question: 'Same album?',
    explain: 'One album filed twice. Identical: the same release entered twice, folded into one edition. An edition of the other: a deluxe or reissue, kept as its own edition of one album. Both sets of ratings stay either way.',
  },
  near_duplicate_recording: {
    tab: 'Songs',
    question: 'Same song?',
    explain:
      'One song recorded twice in the catalogue: the single’s copy and the album’s, say. Merging makes them one song, with both sets of ratings and plays. Live takes and different versions are not asked about.',
  },
  version_of_recording: {
    tab: 'Remixes',
    question: 'Another version of this song?',
    explain:
      'Remixes, sped-up and slowed takes, acoustic, live and instrumental versions, each beside the song itself. Linked, they show as versions of one track, and a playlist plays the song once.',
  },
  outdated_rating: {
    tab: 'Older ratings',
    explain:
      'Tracks rated before arrangement and sound were scored apart, or before originality was asked: one production score stands in for both, and originality is missing. Rate each again to bring it up to date; it leaves this list once rated.',
  },
  missing_cover_art: {
    tab: 'Cover art',
    explain: 'Albums with no cover stored. “Look again” asks the Cover Art Archive once more; you can also add one from the album’s edit page.',
  },
  unlinked_rated_recording: {
    tab: 'Versions',
    explain: 'Rated songs not yet matched with their other versions, so a live or remixed take cannot be recognised as the same song.',
  },
  track_count_mismatch: {
    tab: 'Editions',
    explain: 'Albums whose editions differ a lot in length: sometimes a box set or a compilation filed in the wrong album.',
  },
  orphaned_track: {
    tab: 'Loose songs',
    explain: 'Songs in the catalogue but on no album, so nothing links to them.',
  },
};

const params = Astro.url.searchParams;
const counts = await openCounts();
const kinds = ORDER.filter((k) => (counts.get(k)?.open ?? 0) > 0);
const asked = params.get('kind');
const showGaps = asked === 'missing';
const kind = (showGaps ? null : (kinds.find((k) => k === asked) ?? kinds[0])) ?? null;
const items = kind ? await openAnomalies(kind, PAGE) : [];
const [entities, gaps, matching] = await Promise.all([
  reviewEntities(items),
  // Kept per state of the library (and ratings, which order it): the
  // writer list alone checks every track, 112,000 rows.
  byLibrary('gaps:v1', Astro.locals.user?.id ?? null, missingInfo),
  kind === 'near_duplicate_recording'
    ? matchingTrackPairs()
    : kind === 'near_duplicate_release_group'
      ? matchingAlbumPairs()
      : kind === 'version_of_recording'
        ? linkableVersions()
        : Promise.resolve([]),
]);
const total = [...counts.values()].reduce((n, c) => n + c.open, 0);

const done = params.get('done');
const MESSAGES: Record<string, string> = {
  dismiss: 'Noted. It will not come up again.',
  link_work: 'Linked as versions of one song.',
  merge: 'Merged into one. The old page leads to the one kept.',
  skip: 'Skipped for now.',
  refetch_art: 'Cover art found and stored.',
};
const message = (() => {
  if (!done) return null;
  if (done === 'detect') {
    const raised = Number(params.get('raised') ?? 0);
    const cleared = Number(params.get('cleared') ?? 0);
    if (raised === 0 && cleared === 0) return 'Checked. Nothing new.';
    return [raised > 0 && `${raised} new`, cleared > 0 && `${cleared} cleared up`].filter(Boolean).join(', ') + '.';
  }
  if (done === 'merge_matching')
    return asked === 'version_of_recording' ? `Linked ${params.get('merged')} as versions.` : `Merged ${params.get('merged')}.`;
  return MESSAGES[done] ?? null;
})();

const isPair = (a: Anomaly) => a.entity_b !== null;
const singleActions: Partial<Record<AnomalyKind, { intent: string; label: string }[]>> = {
  missing_cover_art: [
    { intent: 'refetch_art', label: 'Look again' },
    { intent: 'dismiss', label: 'Leave without art' },
  ],
  unlinked_rated_recording: [
    { intent: 'link_work', label: 'Match it' },
    { intent: 'dismiss', label: 'Leave it' },
  ],
  track_count_mismatch: [{ intent: 'dismiss', label: 'This is fine' }],
  orphaned_track: [{ intent: 'dismiss', label: 'Leave it' }],
  outdated_rating: [{ intent: 'dismiss', label: 'Keep as it is' }],
};
// Back here after rating again, to the same kind.
const rateAgain = (recordingId: string) =>
  `/edit/rate/recording/${recordingId}?${new URLSearchParams({ return_to: '/manage/review?kind=outdated_rating' })}`;
const artSrc = (e: { art: string | null; artKind: string | null }) =>
  e.art ? (e.artKind === 'cover' ? `/${e.art}/128.webp` : `/${e.art}`) : null;
const SOURCES: Record<string, string> = {
  musicbrainz: 'From MusicBrainz',
  spotify: 'From Spotify',
  discogs: 'From Discogs',
  files: 'From your files',
  manual: 'Added by hand',
};
---

<Base title="Review">
  <div class="wrap page">
    <PageHeader title="Review" count={total || null}>
      <form method="post" action="/api/write/review">
        <button class="button" type="submit" name="intent" value="detect">Check now</button>
      </form>
    </PageHeader>

    {params.get('error') && <p class="notice notice--error" role="alert">{params.get('error')}</p>}
    {message && <p class="notice" role="status">{message}</p>}

    {
      (kinds.length > 0 || gaps.length > 0) && (
        <nav class="kinds" aria-label="Kinds of item">
          {kinds.map((k) => (
            <a href={`/manage/review?kind=${k}`} aria-current={k === kind ? 'page' : undefined}>
              {KINDS[k].tab} <span class="n tabular">{counts.get(k)!.open}</span>
            </a>
          ))}
          {gaps.length > 0 && (
            <a href="/manage/review?kind=missing" aria-current={showGaps ? 'page' : undefined}>
              Missing info
            </a>
          )}
        </nav>
      )
    }

    {total === 0 && !showGaps && <p class="empty">Nothing to review.</p>}

    {
      kind && (
        <section aria-labelledby="kind-heading" class="group">
          <h2 id="kind-heading" class="visually-hidden">
            {KINDS[kind].tab}
          </h2>
          <p class="muted explain">{KINDS[kind].explain}</p>

          {matching.length > 0 && (
            <form method="post" action="/api/write/review" class="bulk" data-bulk>
              <input type="hidden" name="kind" value={kind} />
              <button class="button button--primary" type="submit" name="intent" value="merge_matching">
                {kind === 'near_duplicate_release_group'
                  ? `Merge all ${matching.length} that are plainly one album`
                  : kind === 'version_of_recording'
                    ? `Link all ${matching.length} as versions`
                    : `Merge all ${matching.length} that match to the second`}
              </button>
              <span class="muted small" data-bulk-status aria-live="polite">
                {kind === 'near_duplicate_release_group'
                  ? 'Same artist, same kind, same title once words like “Deluxe” or “Special Edition” are set aside. Each becomes an edition of one album.'
                  : kind === 'version_of_recording'
                    ? 'Each one’s title is the song’s with a version named in brackets or after a dash. Look down the list first: anything that is not a version, mark “Not a version”.'
                    : 'Same title, same artist, lengths within two seconds: the same recording entered twice.'}
              </span>
            </form>
          )}

          <ul role="list" class="items" data-items>
            {items.map((a) => {
              const shown = [a.entity_a, a.entity_b].filter((x): x is string => x !== null).map((id) => entities.get(id));
              const pair = isPair(a) && shown[0] && shown[1];
              // Fact rows where the two disagree are marked.
              const differs = (label: string) =>
                pair ? shown[0]!.facts.find((f) => f.label === label)?.value !== shown[1]!.facts.find((f) => f.label === label)?.value : false;
              return (
                <li class="item" id={`a-${a.id}`}>
                  {isPair(a) && (
                    <p class="question">
                      {KINDS[a.kind].question}
                      {a.skipped_at && <span class="skipped">skipped before</span>}
                    </p>
                  )}
                  <div class:list={['sides', { pair: isPair(a) }]}>
                    {shown.map((e) =>
                      e ? (
                        <article class="side">
                          <a class="art" href={e.href ?? undefined} tabindex="-1" aria-hidden="true">
                            {e.artKind === 'cover' ? (
                              <CoverArt artKey={e.art} title={e.title} sizes="4.5rem" />
                            ) : artSrc(e) ? (
                              <img src={artSrc(e)!} alt="" width="72" height="72" loading="lazy" />
                            ) : (
                              <CoverArt artKey={null} title={e.title} sizes="4.5rem" />
                            )}
                          </a>
                          <div class="body">
                            <h3 class="title">{e.href ? <a href={e.href}>{e.title}</a> : e.title}</h3>
                            <dl class="facts">
                              {e.facts
                                .filter((f) => f.value || (pair && differs(f.label)))
                                .map((f) => (
                                  <div class:list={[{ differs: differs(f.label) }]}>
                                    <dt>{f.label}</dt>
                                    <dd>{f.value || '—'}</dd>
                                  </div>
                                ))}
                            </dl>
                            <p class="source">
                              {e.mbid ? (
                                <a href={`https://musicbrainz.org/${a.entity_type.replace('_', '-')}/${e.mbid}`} rel="noopener" target="_blank">
                                  {e.source === 'musicbrainz' ? 'From MusicBrainz' : `${SOURCES[e.source] ?? e.source}, on MusicBrainz`}
                                  <span class="visually-hidden"> (opens in a new tab)</span>
                                </a>
                              ) : (
                                (SOURCES[e.source] ?? e.source)
                              )}
                            </p>
                          </div>
                        </article>
                      ) : (
                        <p class="gone">No longer in the catalogue.</p>
                      ),
                    )}
                  </div>
                  <form method="post" action="/api/write/review" class="actions" data-row>
                    <input type="hidden" name="id" value={a.id} />
                    <input type="hidden" name="kind" value={kind} />
                    {a.kind === 'version_of_recording' ? (
                      <>
                        <button class="button button--primary" type="submit" name="intent" value="link_work">
                          Link as a version
                        </button>
                        <button class="button" type="submit" name="intent" value="dismiss">
                          Not a version
                        </button>
                      </>
                    ) : isPair(a) && a.kind === 'near_duplicate_release_group' ? (
                      <>
                        {/* Two ways to be one album: the same release entered twice, or one an edition (a deluxe, a reissue) of the other. */}
                        <button class="button button--primary" type="submit" name="intent" value="same_identical">
                          Identical: one edition
                        </button>
                        <button class="button" type="submit" name="intent" value="same">
                          An edition of the other
                        </button>
                        <button class="button" type="submit" name="intent" value="dismiss">
                          Different
                        </button>
                      </>
                    ) : isPair(a) ? (
                      <>
                        <button class="button button--primary" type="submit" name="intent" value="same">
                          Same: merge them
                        </button>
                        <button class="button" type="submit" name="intent" value="dismiss">
                          Different
                        </button>
                      </>
                    ) : (
                      <>
                      {a.kind === 'outdated_rating' && (
                        <a class="button button--primary" href={rateAgain(a.entity_a)}>
                          Rate again
                        </a>
                      )}
                      {(singleActions[a.kind] ?? []).map((action, i) =>
                        action.intent === 'refetch_art' && !shown[0]?.mbid ? null : (
                          <button class:list={['button', { 'button--primary': i === 0 && a.kind !== 'outdated_rating' }]} type="submit" name="intent" value={action.intent}>
                            {action.label}
                          </button>
                        ),
                      )}
                      </>
                    )}
                    <button class="button button--quiet" type="submit" name="intent" value="skip">
                      Skip
                    </button>
                  </form>
                </li>
              );
            })}
          </ul>
          {(counts.get(kind)?.open ?? 0) > items.length && (
            <p class="muted small more">
              {(counts.get(kind)?.open ?? 0) - items.length} more after these. The next ones load as you clear this page.
            </p>
          )}
        </section>
      )
    }

    {
      showGaps && (
        <section aria-labelledby="gaps-heading" class="gaps">
          <h2 id="gaps-heading" class="visually-hidden">
            Missing information
          </h2>
          <p class="muted explain">Not wrong, just not known yet. Most of it can be filled from the album or artist’s edit page, or by looking the album up again.</p>
          {gaps.map((g) => (
            <section aria-labelledby={`gap-${g.key}`} class="gap">
              <h3 id={`gap-${g.key}`}>
                {g.heading} <span class="count tabular">{g.total}</span>
              </h3>
              <p class="muted explain">{g.explain}</p>
              <ul role="list" class="gap-items">
                {g.items.map((item) => (
                  <li>
                    <a href={item.href}>{item.title}</a>
                    {item.detail && <span class="detail">{item.detail}</span>}
                  </li>
                ))}
              </ul>
              {g.total > g.items.length && <p class="muted more">And {g.total - g.items.length} more. Rated music comes first.</p>}
            </section>
          ))}
        </section>
      )
    }
  </div>
</Base>

<script>
  type Reply = { ok: boolean; error?: string; merged?: string; left?: string };
  const post = async (form: HTMLFormElement, intent: string): Promise<Reply> => {
    const body = new FormData(form);
    body.set('intent', intent);
    const response = await fetch(form.action, { method: 'POST', body, headers: { Accept: 'application/json' } });
    return (await response.json()) as Reply;
  };

  const list = document.querySelector<HTMLElement>('[data-items]');
  // Each decision takes its card away and moves to the next; a cleared page fetches the next one.
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-row]')) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const intent = (event.submitter as HTMLButtonElement | null)?.value ?? 'skip';
      const card = form.closest('li')!;
      const buttons = [...form.querySelectorAll('button')];
      for (const b of buttons) b.disabled = true;
      const result = await post(form, intent);
      if (!result.ok) {
        alert(result.error ?? 'That did not work.');
        for (const b of buttons) b.disabled = false;
        return;
      }
      const next = card.nextElementSibling;
      card.remove();
      if (next) next.querySelector<HTMLButtonElement>('.button--primary, button')?.focus({ preventScroll: false });
      else if (list && list.children.length === 0) location.reload();
    });
  }

  // Merge every matching pair, a batch at a time, then a fresh page.
  const bulk = document.querySelector<HTMLFormElement>('[data-bulk]');
  bulk?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const button = bulk.querySelector('button')!;
    const status = bulk.querySelector<HTMLElement>('[data-bulk-status]')!;
    button.disabled = true;
    const kind = bulk.querySelector<HTMLInputElement>('input[name="kind"]')!.value;
    let merged = 0;
    for (;;) {
      const result = await post(bulk, 'merge_matching');
      if (!result.ok) {
        status.textContent = result.error ?? 'That did not work.';
        button.disabled = false;
        return;
      }
      merged += Number(result.merged ?? 0);
      const left = Number(result.left ?? 0);
      status.textContent = `${kind === 'version_of_recording' ? 'Linked' : 'Merged'} ${merged}${left ? `, ${left} to go…` : '.'}`;
      if (!left || !Number(result.merged)) break;
    }
    location.assign(`/manage/review?kind=${kind}&done=merge_matching&merged=${merged}`);
  });
</script>

<style>
  .page {
    display: grid;
    gap: var(--space-5);
    --content-max: 52rem;
  }

  .muted {
    color: var(--text-muted);
  }

  .small {
    font-size: var(--step--1);
  }

  .notice {
    padding: var(--space-3) var(--space-4);
    border-left: 3px solid var(--accent);
    background: var(--surface-2);
  }

  .notice--error {
    border-color: var(--danger);
    color: var(--danger);
  }

  /* The kinds, as a row of tabs that scrolls sideways on a phone. */
  .kinds {
    display: flex;
    gap: var(--space-2);
    margin-inline: calc(var(--gutter) * -1);
    padding: 2px var(--gutter);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .kinds a {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--target);
    padding: 0 var(--space-4);
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-muted);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .kinds a[aria-current='page'] {
    border-color: var(--text);
    background: var(--surface-2);
    color: var(--text);
  }

  .n {
    color: var(--text-subtle);
    font-size: var(--step--1);
  }

  .group {
    display: grid;
    gap: var(--space-4);
  }

  .explain {
    max-width: 62ch;
    font-size: var(--step--1);
  }

  .bulk {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
  }

  .items {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .item {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-m);
    background: var(--surface-1);
  }

  .question {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-3);
    font-size: var(--step-1);
    font-weight: 750;
  }

  .skipped {
    color: var(--text-subtle);
    font-size: var(--step--1);
    font-weight: 500;
  }

  .sides {
    display: grid;
    gap: var(--space-4);
  }

  /* A pair side by side once there is room; stacked, with a rule between, on a phone. */
  @media (min-width: 40rem) {
    .sides.pair {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 39.99rem) {
    .sides.pair > .side + .side {
      padding-top: var(--space-4);
      border-top: 1px solid var(--border);
    }
  }

  .side {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    align-items: start;
    gap: var(--space-3);
    min-width: 0;
  }

  .art {
    display: block;
    width: 4.5rem;
    aspect-ratio: 1;
    border-radius: var(--radius-s);
    overflow: hidden;
    background: var(--surface-2);
  }

  .art img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .body {
    display: grid;
    gap: var(--space-2);
    min-width: 0;
  }

  .title {
    font-size: var(--step-0);
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .title a {
    text-decoration: none;
  }

  .facts {
    display: grid;
    gap: 2px;
    margin: 0;
    font-size: var(--step--1);
  }

  /* Labels in one column, so values line up whatever the label's length. */
  .facts > div {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: var(--space-2);
    padding: 1px var(--space-1);
    border-radius: var(--radius-s);
  }

  .facts dt {
    color: var(--text-subtle);
  }

  .facts dd {
    margin: 0;
    overflow-wrap: anywhere;
  }

  /* What differs between the two, marked on both. */
  .facts .differs {
    background: color-mix(in oklch, var(--accent) 14%, transparent);
  }

  .facts .differs dd {
    font-weight: 650;
  }

  .source {
    color: var(--text-subtle);
    font-size: var(--step--1);
  }

  .gone {
    color: var(--text-subtle);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  /* Skip sits apart from the decisions. */
  .actions .button--quiet {
    margin-left: auto;
  }

  .more {
    text-align: center;
  }

  .empty {
    padding: var(--space-6) 0;
    color: var(--text-muted);
    font-size: var(--step-1);
  }

  .gaps {
    display: grid;
    gap: var(--space-5);
  }

  .gap h3 {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    font-size: var(--step-0);
  }

  .count {
    padding: 0 var(--space-2);
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--text-muted);
    font-size: var(--step--1);
    font-weight: 600;
  }

  .gap-items {
    display: grid;
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
  }

  .gap-items li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--space-3);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--border);
  }

  .gap-items a {
    font-weight: 650;
  }

  .gap-items .detail {
    color: var(--text-muted);
    font-size: var(--step--1);
  }
</style>
