---
/**
 * The work queue, by what queued it: each discography, refresh or files
 * import is one card with its progress, which can be put first, sent back
 * in line or emptied (0072); a batch's own page lists its albums. Failures
 * come first; single imports, backups and pushes are listed after.
 */
import { env } from 'cloudflare:workers';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import BatchCard from '../../components/BatchCard.astro';
import JobList from '../../components/JobList.astro';
import { describeJobs } from '../../lib/jobs/describe';
import { failedJobs, jobBatches, looseJobs, queuePaused, queueProgress } from '../../lib/jobs/queue';
import { runJobs } from '../../lib/jobs/runner';

const [batches, failed, loose, progressNow, paused] = await Promise.all([jobBatches(6), failedJobs(), looseJobs(30), queueProgress(), queuePaused()]);
const totals = progressNow.counts;
// At the recent pace, how long the queue has left.
const left = progressNow.perHour ? (totals.queued + totals.running) / progressNow.perHour : null;
const leftText =
  left === null
    ? null
    : left < 1
      ? `about ${Math.max(1, Math.round(left * 60))} min`
      : left < 24
        ? `about ${Math.round(left)} h`
        : `about ${Math.floor(left / 24)} d ${Math.round(left % 24)} h`;
const queued = totals.queued;
const running = totals.running;
// Paused with work waiting is not "active": nothing will change until resumed.
const active = queued + running > 0 && !(paused && running === 0);

// Jobs waiting and nothing working them: start now. (The cron does this
// every minute in production; local dev has no cron.) This page refreshes
// itself while work is in progress, so a long queue keeps moving.
const working = await env.DB.prepare(
  `SELECT 1 AS yes FROM job WHERE status = 'running' AND started_at > strftime('%Y-%m-%dT%H:%M:%fZ', 'now', '-2 minutes')`,
).first();
if (queued > 0 && !working && !paused) Astro.locals.cfContext.waitUntil(runJobs({ budgetMs: 25_000 }));

// In the order they will run: those put first, then the oldest.
const going = batches.filter((b) => b.queued + b.running > 0).sort((a, b) => Number(b.first) - Number(a.first) || a.created_at.localeCompare(b.created_at));
const finished = batches.filter((b) => b.queued + b.running === 0);
const others = loose.filter((j) => j.status !== 'failed');
const shown = await describeJobs([...failed, ...others]);
const total = going.length + finished.length + failed.length + others.length;
const progress = queued + running + totals.done > 0 ? totals.done / (queued + running + totals.done) : 0;
const back = '/manage/jobs';
---

<Base title="Jobs">
  <div class="wrap page" data-jobs data-active={active ? 'true' : undefined}>
    <PageHeader title="Jobs" />
    <p class="visually-hidden" role="status">{active ? 'Working through the queue.' : ''}</p>

    {
      total > 0 && (
        <section class="summary" aria-label="Summary" data-summary>
          <dl>
            <div>
              <dt>Running</dt>
              <dd class="tabular">{running}</dd>
            </div>
            <div>
              <dt>{paused ? 'Paused' : 'Waiting'}</dt>
              <dd class="tabular">{queued}</dd>
            </div>
            <div>
              <dt>Done</dt>
              <dd class="tabular">{totals.done}</dd>
            </div>
            <div class:list={[{ alert: totals.failed > 0 }]}>
              <dt>Failed</dt>
              <dd class="tabular">{totals.failed}</dd>
            </div>
          </dl>
          {queued + running > 0 && !paused && leftText && (
            <p class="pace muted">
              {Math.round(progressNow.perHour!)} an hour, {leftText} left
              {progressNow.current && <> · now {progressNow.current}</>}
            </p>
          )}
          {queued + running > 0 && (
            <span class:list={['bar', { paused }]} aria-hidden="true">
              <span style={`inline-size: ${Math.round(progress * 100)}%`} />
            </span>
          )}
          <div class="actions">
            {paused ? (
              <form method="post" action="/api/write/jobs/control">
                <input type="hidden" name="intent" value="resume" />
                <button class="button button--primary" type="submit">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
                  Resume
                </button>
              </form>
            ) : (
              queued + running > 0 && (
                <form method="post" action="/api/write/jobs/control">
                  <input type="hidden" name="intent" value="pause" />
                  <button class="button" type="submit">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5h3v14H8zM13 5h3v14h-3z" /></svg>
                    Pause
                  </button>
                </form>
              )
            )}
            {queued > 0 && !paused && running === 0 && (
              <form method="post" action="/api/write/jobs/run">
                <button class="button" type="submit">
                  Start the {queued} waiting
                </button>
              </form>
            )}
            {totals.failed > 0 && (
              <form method="post" action="/api/write/jobs/retry">
                <input type="hidden" name="all" value="1" />
                <button class="button button--primary" type="submit">
                  {totals.failed === 1 ? 'Retry the failed one' : `Retry all ${totals.failed} failed`}
                </button>
              </form>
            )}
            <a class="button button--quiet" href="/manage/import">
              Import more
            </a>
          </div>
        </section>
      )
    }

    {
      total === 0 ? (
        <p class="muted">
          No jobs yet. <a href="/manage/import">Import something.</a>
        </p>
      ) : (
        <div class="groups" data-groups>
          {failed.length > 0 && (
            <section aria-labelledby="group-failed" class="group">
              <h2 id="group-failed">
                Needs attention <span class="count tabular">{failed.length}</span>
              </h2>
              <JobList jobs={failed} shown={shown} paused={paused} back={back} />
            </section>
          )}
          {going.length > 0 && (
            <section aria-labelledby="group-going" class="group">
              <h2 id="group-going">
                Imports and refreshes <span class="count tabular">{going.length}</span>
              </h2>
              <ol role="list" class="batches">
                {going.map((batch) => (
                  <li>
                    <BatchCard batch={batch} paused={paused} back={back} />
                  </li>
                ))}
              </ol>
            </section>
          )}
          {others.length > 0 && (
            <section aria-labelledby="group-others" class="group">
              <h2 id="group-others">Single imports and other jobs</h2>
              <JobList jobs={others} shown={shown} paused={paused} back={back} />
            </section>
          )}
          {finished.length > 0 && (
            <section aria-labelledby="group-finished" class="group">
              <h2 id="group-finished">Finished</h2>
              <ol role="list" class="batches">
                {finished.map((batch) => (
                  <li>
                    <BatchCard batch={batch} paused={paused} back={back} />
                  </li>
                ))}
              </ol>
            </section>
          )}
        </div>
      )
    }
  </div>
</Base>

<script>
  // While anything is queued or running, re-fetch this page every few
  // seconds and swap in the new summary and list. Focus and scroll are
  // untouched; the status line says when everything has finished.
  const root = document.querySelector<HTMLElement>('[data-jobs]');

  async function poll() {
    if (!root?.dataset.active) return;
    await new Promise((resolve) => setTimeout(resolve, 3000));
    const response = await fetch(location.href, { headers: { Accept: 'text/html' } });
    if (!response.ok) return;
    const next = new DOMParser().parseFromString(await response.text(), 'text/html').querySelector<HTMLElement>('[data-jobs]');
    if (!next) return;
    for (const part of ['[data-summary]', '[data-groups]']) {
      const fresh = next.querySelector(part);
      const old = root.querySelector(part);
      if (fresh && old) old.replaceWith(fresh);
    }
    if (next.dataset.active) {
      poll();
    } else {
      delete root.dataset.active;
      root.querySelector('[role="status"]')!.textContent = 'All jobs finished.';
    }
  }

  poll();
</script>

<style>
  .page {
    display: grid;
    gap: var(--space-6);
    --content-max: 52rem;
  }

  /* The queue at a glance. */
  .summary {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-l);
    background: var(--surface-1);
  }

  .summary dl {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-3);
    margin: 0;
  }

  .summary dt {
    color: var(--text-muted);
    font-size: var(--step--1);
    font-weight: 600;
  }

  .summary dd {
    margin: 0;
    font-size: var(--step-3);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .summary .alert dd {
    color: var(--danger);
  }

  .pace {
    margin: 0;
    font-size: var(--step--1);
  }

  .bar {
    display: block;
    height: 6px;
    border-radius: 999px;
    background: var(--surface-2);
    overflow: hidden;
  }

  .bar > span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--accent);
    transition: inline-size 0.4s ease;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .groups {
    display: grid;
    gap: var(--space-6);
  }

  .group h2 {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
    font-size: var(--step-1);
  }

  .count {
    color: var(--text-subtle);
    font-size: var(--step--1);
    font-weight: 700;
  }

  .batches {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .actions .button svg {
    width: 1rem;
    height: 1rem;
    margin-right: var(--space-1);
    fill: currentColor;
  }

  .bar.paused > span {
    background: var(--text-subtle);
  }

</style>
