---
/**
 * Import from local files (ARCHITECTURE.md §5, rung 4): choose or drop a
 * folder; the browser reads each file's tags and fingerprint and sends
 * only that text. Audio never leaves the machine.
 */
import BackLink from '../../../components/BackLink.astro';
import Base from '../../../layouts/Base.astro';
import { MAX_FILES } from '../../../lib/import/files';
---

<Base title="Import from files">
  <div class="wrap page">
    <header>
      <p><BackLink href="/manage/import">Import</BackLink></p>
      <h1>Import from files</h1>
      <p class="muted">Choose a folder: its albums join your library and their audio is uploaded privately, to play anywhere you are signed in.</p>
    </header>

    <noscript>
      <p class="notice">Reading files needs JavaScript. <a href="/manage/import/manual">Add an album by hand</a> instead.</p>
    </noscript>

    <section class="choose" data-choose hidden>
      <div class="field">
        <label for="root">Where this folder lives <span class="optional">(optional)</span></label>
        <input class="input" id="root" type="text" autocomplete="off" spellcheck="false" placeholder="D:\Music" aria-describedby="root-hint" />
        <span class="hint" id="root-hint">Browsers only reveal paths inside the folder you choose, so this is put in front of them. Remembered on this device.</span>
      </div>

      <label class="drop" data-drop>
        <input type="file" {...{ webkitdirectory: true }} multiple class="visually-hidden" data-picker />
        <strong data-pick-label>Choose a folder</strong>
        <span class="muted" data-pick-hint>or drop one here. Up to {MAX_FILES} files at a time.</span>
      </label>
    </section>

    <p class="status" role="status" data-status></p>
    <progress max="1" value="0" hidden data-progress></progress>

    <section class="preview" data-preview hidden aria-labelledby="preview-heading">
      <h2 id="preview-heading" tabindex="-1" data-preview-heading>What will be added</h2>
      <ul role="list" class="albums" data-albums></ul>
      <div class="buttons">
        <button class="button button--primary" type="button" data-add>Add to catalogue</button>
        <button class="button button--quiet" type="button" data-again>Choose another folder</button>
      </div>
    </section>

    <template data-album-template>
      <li class="album">
        <div class="album-head">
          <p class="album-title"></p>
          <p class="album-meta muted"></p>
        </div>
        <fieldset class="same" hidden>
          <legend>Is this already in your library?</legend>
          <div class="options"></div>
        </fieldset>
        <p class="album-source"></p>
        <ul class="album-notes"></ul>
        <details>
          <summary>Tracks</summary>
          <ol class="tracks"></ol>
        </details>
      </li>
    </template>
  </div>
</Base>

<script>
  import { groupAlbums, type AlbumGroup, type FileRecord } from '../../../lib/tags/albums';
  import { AUDIO_EXTENSIONS } from '../../../lib/tags/albums';
  import { readTags } from '../../../lib/tags/read';
  import { describeUpload, uploadAudio } from '../../../lib/audio-upload';

  const MAX_FILES = 2000;
  const $ = <T extends Element>(selector: string) => document.querySelector<T>(selector)!;
  const choose = $<HTMLElement>('[data-choose]');
  const picker = $<HTMLInputElement>('[data-picker]');
  const drop = $<HTMLElement>('[data-drop]');
  const rootInput = $<HTMLInputElement>('#root');
  const status = $<HTMLElement>('[data-status]');
  const progress = $<HTMLProgressElement>('[data-progress]');
  const preview = $<HTMLElement>('[data-preview]');
  const list = $<HTMLUListElement>('[data-albums]');
  const template = $<HTMLTemplateElement>('[data-album-template]');
  const addButton = $<HTMLButtonElement>('[data-add]');

  choose.hidden = false;
  // Phones cannot pick a folder; there the same input takes a set of files.
  if (!('webkitdirectory' in picker)) {
    $('[data-pick-label]').textContent = 'Choose files';
    $('[data-pick-hint]').textContent = `Every track of an album at once. Up to ${MAX_FILES} files.`;
  }
  try {
    rootInput.value = localStorage.getItem('import-root') ?? '';
  } catch {
    /* storage unavailable: nothing remembered */
  }
  rootInput.addEventListener('change', () => {
    try {
      localStorage.setItem('import-root', rootInput.value.trim());
    } catch {
      /* fine */
    }
  });

  let records: FileRecord[] = [];
  /** Each record's file, for uploading its audio once the albums are in. */
  const fileFor = new Map<string, File>();

  const extension = (name: string) => name.split('.').at(-1)?.toLowerCase() ?? '';
  const isAudio = (file: File) => extension(file.name) in AUDIO_EXTENSIONS;

  async function sha256(file: File): Promise<string> {
    const hash = await crypto.subtle.digest('SHA-256', await file.arrayBuffer());
    return [...new Uint8Array(hash)].map((b) => b.toString(16).padStart(2, '0')).join('');
  }

  async function readAll(files: { file: File; path: string }[]) {
    const audio = files.filter((f) => isAudio(f.file));
    preview.hidden = true;
    if (audio.length === 0) {
      status.textContent = 'No audio files in that folder (MP3, FLAC, Ogg, Opus or M4A).';
      return;
    }
    if (audio.length > MAX_FILES) {
      status.textContent = `That is ${audio.length} files; choose a smaller folder (up to ${MAX_FILES}).`;
      return;
    }
    progress.hidden = false;
    progress.max = audio.length;
    records = [];
    fileFor.clear();
    let unreadable = 0;
    for (const [i, { file, path }] of audio.entries()) {
      progress.value = i;
      status.textContent = `Reading ${i + 1} of ${audio.length}…`;
      const tags = await readTags(async (offset, length) => new Uint8Array(await file.slice(offset, offset + length).arrayBuffer())).catch(() => null);
      if (!tags) {
        unreadable += 1;
        continue;
      }
      records.push({ ...tags, path, size: file.size, checksum: await sha256(file) });
      fileFor.set(path, file);
    }
    progress.hidden = true;
    const albums = groupAlbums(records);
    status.textContent = 'Looking for these in your library…';
    const candidates = await findCandidates(albums);
    status.textContent = unreadable ? `${unreadable} ${unreadable === 1 ? 'file' : 'files'} could not be read and will be left out.` : '';
    render(albums, candidates);
  }

  type Candidate = { id: string; title: string; artist: string; type: string; year: string | null; tracks: number; art: string | null; shared: number; likely: boolean };
  /** Each album's answer: an album already held, or 'new'. */
  let choices: Record<string, string> = {};

  async function findCandidates(albums: AlbumGroup[]): Promise<Record<string, Candidate[]>> {
    const response = await fetch('/api/write/import/files-check', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ albums: albums.map((a) => ({ key: a.key, artist: a.artist, title: a.title, tracks: a.tracks.map((t) => t.title) })) }),
    }).catch(() => null);
    if (!response?.ok) return {};
    return ((await response.json()) as { candidates: Record<string, Candidate[]> }).candidates;
  }

  const plural = (n: number, one: string) => `${n} ${n === 1 ? one : `${one}s`}`;

  /** What happens to an album, given its answer. */
  function describe(album: AlbumGroup, choice: string, found: Candidate[]): string {
    if (choice !== 'new') {
      const c = found.find((f) => f.id === choice);
      return `These files join ${c ? `“${c.title}”` : 'that album'}. Nothing new is added.`;
    }
    return album.mbReleaseId ? 'Added as a new album, imported from MusicBrainz (it is tagged by them).' : 'Added as a new album, from the tags.';
  }

  function option(name: string, value: string, checked: boolean, label: Node[], onPick: () => void): HTMLLabelElement {
    const wrap = document.createElement('label');
    wrap.className = 'option';
    const input = Object.assign(document.createElement('input'), { type: 'radio', name, value, checked });
    input.addEventListener('change', onPick);
    for (const node of [input, ...label]) wrap.appendChild(node);
    return wrap;
  }

  function render(albums: AlbumGroup[], candidates: Record<string, Candidate[]>) {
    list.replaceChildren();
    choices = {};
    for (const [index, album] of albums.entries()) {
      const item = template.content.firstElementChild!.cloneNode(true) as HTMLLIElement;
      // Tag text is untrusted: textContent only.
      item.querySelector('.album-title')!.textContent = `${album.title}, ${album.artist}`;
      item.querySelector('.album-meta')!.textContent = [album.date, `${album.tracks.length} ${album.tracks.length === 1 ? 'track' : 'tracks'}`]
        .filter(Boolean)
        .join(' · ');
      const found = candidates[album.key] ?? [];
      const source = item.querySelector<HTMLElement>('.album-source')!;
      choices[album.key] = found.find((c) => c.likely)?.id ?? 'new';
      source.textContent = found.length ? describe(album, choices[album.key]!, found) : `Not in your library yet. ${describe(album, 'new', found)}`;
      if (found.length) {
        const fieldset = item.querySelector<HTMLFieldSetElement>('.same')!;
        const options = fieldset.querySelector('.options')!;
        const pick = (value: string) => () => {
          choices[album.key] = value;
          source.textContent = describe(album, value, found);
        };
        for (const c of found) {
          const art = c.art ? Object.assign(document.createElement('img'), { src: c.art, alt: '', width: 48, height: 48, loading: 'lazy' }) : document.createElement('span');
          art.className = 'thumb';
          // A cover that will not load leaves the plain square.
          art.addEventListener('error', () => art.removeAttribute('src'));
          const text = document.createElement('span');
          text.className = 'option-text';
          const title = document.createElement('strong');
          title.textContent = `Yes, ${c.title}`;
          const meta = document.createElement('span');
          meta.className = 'muted';
          meta.textContent = [c.artist, c.year, plural(c.tracks, 'song'), c.shared ? `${c.shared} of ${album.tracks.length} songs match` : null].filter(Boolean).join(' · ');
          text.appendChild(title);
          text.appendChild(meta);
          options.appendChild(option(`same-${index}`, c.id, choices[album.key] === c.id, [art, text], pick(c.id)));
        }
        const no = document.createElement('span');
        no.className = 'option-text';
        no.textContent = 'No, it is a different album: add it as new';
        options.appendChild(option(`same-${index}`, 'new', choices[album.key] === 'new', [document.createElement('span'), no], pick('new')));
        fieldset.hidden = false;
      }
      const notes = item.querySelector('.album-notes')!;
      for (const note of album.notes) {
        const li = document.createElement('li');
        li.textContent = note;
        notes.appendChild(li);
      }
      const tracks = item.querySelector('.tracks')!;
      for (const t of album.tracks) {
        const li = document.createElement('li');
        li.value = t.position;
        li.textContent = t.artist === album.artist ? t.title : `${t.title} (${t.artist})`;
        tracks.appendChild(li);
      }
      list.appendChild(item);
    }
    $('[data-preview-heading]').textContent = `${albums.length} ${albums.length === 1 ? 'album' : 'albums'} found`;
    const size = records.reduce((sum, r) => sum + r.size, 0);
    const amount = size > 1024 ** 3 ? `${(size / 1024 ** 3).toFixed(1)} GB` : `${Math.max(1, Math.round(size / 1024 ** 2))} MB`;
    addButton.textContent = `${albums.length === 1 ? 'Import it' : `Import all ${albums.length}`} and upload ${amount}`;
    addButton.disabled = false;
    preview.hidden = false;
    $<HTMLElement>('#preview-heading').focus();
  }

  addButton.addEventListener('click', async () => {
    addButton.disabled = true;
    status.textContent = 'Adding…';
    try {
      const response = await fetch('/api/write/import/files', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ root: rootInput.value.trim(), files: records, choices }),
      });
      const body = (await response.json()) as {
        error?: string;
        albums?: { title: string; artist: string; status: string; href: string | null; note: string | null }[];
      };
      if (!response.ok || !body.albums) throw new Error(body.error ?? 'The import failed.');
      list.replaceChildren();
      for (const album of body.albums) {
        const li = document.createElement('li');
        li.className = 'album';
        const verb =
          album.status === 'added' ? 'Added' : album.status === 'matched' ? 'Joined' : album.status === 'queued' ? 'Importing from MusicBrainz' : 'Skipped';
        const head = document.createElement('p');
        head.className = 'album-title';
        if (album.href) {
          const a = document.createElement('a');
          a.href = album.href;
          a.textContent = `${album.title}, ${album.artist}`;
          head.appendChild(document.createTextNode(`${verb}: `));
          head.appendChild(a);
        } else {
          head.textContent = `${verb}: ${album.title}, ${album.artist}`;
        }
        li.appendChild(head);
        if (album.note) {
          const note = document.createElement('p');
          note.className = 'muted';
          note.textContent = album.note;
          li.appendChild(note);
        }
        list.appendChild(li);
      }
      addButton.hidden = true;
      await uploadAll();
      $('[data-preview-heading]').textContent = 'Done';
    } catch (error) {
      status.textContent = error instanceof Error ? error.message : 'The import failed.';
      addButton.disabled = false;
    }
  });

  /** Every file's audio, to the private store (src/lib/audio-upload.ts), as catalogued. */
  async function uploadAll() {
    const prefix = rootInput.value.trim().replace(/[\\/]+$/, '');
    const local = records.flatMap((r) => {
      const file = fileFor.get(r.path);
      if (!file || !r.checksum) return [];
      return [
        {
          file,
          path: prefix ? `${prefix}/${r.path}` : r.path,
          format: r.format,
          checksum: r.checksum,
          title: r.title,
          artist: r.artist,
          albumArtist: r.albumArtist,
          album: r.album,
          lengthMs: r.lengthMs,
          mbRecordingId: r.mbRecordingId,
        },
      ];
    });
    $('[data-preview-heading]').textContent = 'Uploading the audio…';
    progress.hidden = false;
    try {
      const report = await uploadAudio(local, (done, total) => {
        progress.max = Math.max(1, total);
        progress.value = done;
        status.textContent = total ? `Uploading the audio: ${done} of ${total}…` : '';
      });
      status.textContent = describeUpload(report);
    } catch (error) {
      status.textContent = error instanceof Error ? error.message : 'The audio could not be uploaded. Import the folder again to retry.';
    } finally {
      progress.hidden = true;
    }
  }

  $('[data-again]').addEventListener('click', () => {
    addButton.hidden = false;
    picker.value = '';
    picker.click();
  });

  picker.addEventListener('change', () => {
    const files = [...(picker.files ?? [])].map((file) => ({ file, path: file.webkitRelativePath || file.name }));
    void readAll(files);
  });

  // Dropped folders: walk the entries, since a drop gives no file list for a directory.
  async function walk(entry: FileSystemEntry, out: { file: File; path: string }[]): Promise<void> {
    if (entry.isFile) {
      const file = await new Promise<File>((resolve, reject) => (entry as FileSystemFileEntry).file(resolve, reject));
      out.push({ file, path: entry.fullPath.replace(/^\//, '') });
    } else if (entry.isDirectory) {
      const reader = (entry as FileSystemDirectoryEntry).createReader();
      for (;;) {
        const batch = await new Promise<FileSystemEntry[]>((resolve, reject) => reader.readEntries(resolve, reject));
        if (batch.length === 0) break;
        for (const child of batch) await walk(child, out);
      }
    }
  }

  drop.addEventListener('dragover', (event) => {
    event.preventDefault();
    drop.dataset.over = '';
  });
  drop.addEventListener('dragleave', () => delete drop.dataset.over);
  drop.addEventListener('drop', async (event) => {
    event.preventDefault();
    delete drop.dataset.over;
    const entries = [...(event.dataTransfer?.items ?? [])].map((item) => item.webkitGetAsEntry()).filter((e): e is FileSystemEntry => e !== null);
    const files: { file: File; path: string }[] = [];
    status.textContent = 'Looking through the folder…';
    for (const entry of entries) await walk(entry, files);
    void readAll(files);
  });
</script>

<style>
  .page {
    display: grid;
    gap: var(--space-5);
    --content-max: 48rem;
  }

  header {
    display: grid;
    gap: var(--space-2);
  }

  h2 {
    font-size: var(--step-1);
  }

  .muted,
  .optional {
    color: var(--text-muted);
    font-weight: 400;
  }

  .notice {
    padding: var(--space-3) var(--space-4);
    border-left: 3px solid var(--accent);
    background: var(--surface-2);
  }

  .choose {
    display: grid;
    gap: var(--space-4);
  }

  .drop {
    display: grid;
    place-items: center;
    gap: var(--space-1);
    min-height: 9rem;
    padding: var(--space-5);
    border: 2px dashed var(--border);
    border-radius: var(--radius-l);
    background: var(--surface-1);
    text-align: center;
    cursor: pointer;
  }

  .drop:hover,
  .drop[data-over] {
    border-color: var(--accent);
  }

  .drop:focus-within {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .drop strong {
    font-size: var(--step-1);
  }

  .status:empty {
    display: none;
  }

  progress {
    width: 100%;
    accent-color: var(--accent);
  }

  .preview {
    display: grid;
    gap: var(--space-4);
  }

  .albums {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .albums :global(.album) {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-m);
    background: var(--surface-1);
    min-width: 0;
  }

  .albums :global(.album-title) {
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .albums :global(.album-source),
  .albums :global(.album-notes) {
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .albums :global(.album-notes) {
    margin: 0;
    padding-left: 1.2rem;
  }

  .albums :global(.album-notes:empty) {
    display: none;
  }

  .albums :global(.same) {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .albums :global(.same legend) {
    padding: 0;
    margin-bottom: var(--space-2);
    font-weight: 600;
  }

  .albums :global(.options) {
    display: grid;
    gap: var(--space-2);
  }

  .albums :global(.option) {
    display: grid;
    grid-template-columns: auto 3rem 1fr;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--target);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-m);
    cursor: pointer;
  }

  .albums :global(.option:has(input:checked)) {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }

  .albums :global(.option input) {
    accent-color: var(--accent);
    width: 1.1rem;
    height: 1.1rem;
  }

  .albums :global(.thumb) {
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-s, 4px);
    object-fit: cover;
    background: var(--surface-2);
  }

  .albums :global(.option-text) {
    display: grid;
    gap: 2px;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .albums :global(.option-text .muted) {
    font-size: var(--step--1);
  }

  .albums :global(summary) {
    min-height: var(--target);
    display: flex;
    align-items: center;
    cursor: pointer;
    color: var(--text-muted);
  }

  .albums :global(.tracks) {
    margin: 0;
    padding-left: 1.8rem;
    font-size: var(--step--1);
  }

  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
