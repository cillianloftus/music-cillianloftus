---
/**
 * Manual entry: for music on no database at all, or a release made of
 * songs already here. The tracklist is built by searching the library and
 * typing new songs (ReleaseBuilder), or pasted; Preview shows exactly what
 * will be created (the dry run, ARCHITECTURE.md §5); Add writes it through
 * the same import writer as everything else.
 */
import BackLink from '../../../components/BackLink.astro';
import { env } from 'cloudflare:workers';
import Base from '../../../layouts/Base.astro';
import ChipInput from '../../../components/ChipInput.astro';
import { formatDuration } from '../../../lib/format';
import { MAX_TRACKS, buildManualPlan, existingSongs, fittingChoices, lineKey, parseTracklist, songsByIds, validateManual, type ExistingSong, type ManualInput } from '../../../lib/import/manual';
import ReleaseBuilder, { type BuilderRow } from '../../../components/ReleaseBuilder.astro';

import type { ReleaseGroupType } from '../../../lib/import/plan';
import { writePlan } from '../../../lib/import/write';
import { findCover } from '../../../lib/covers';
import { waitUntilOf } from '../../../lib/art-serve';

const TYPES: [ReleaseGroupType, string][] = [
  ['album', 'Album'],
  ['ep', 'EP'],
  ['single', 'Single'],
  ['mixtape', 'Mixtape'],
  ['compilation', 'Compilation'],
  ['soundtrack', 'Soundtrack'],
  ['live', 'Live album'],
];

let input: ManualInput = { artist: '', title: '', type: 'album', date: '', genres: '', tracklist: '' };
let errors: string[] = [];
let previewing = false;
let duplicates: { id: string; title: string }[] = [];
// Each line's songs already here (by the same artist and title), to reuse instead of copying.
let matches: Record<string, ExistingSong[]> = {};
// What each line was set to last time ("new", or a song's id); unset, the best match.
let chosen: Record<string, string> = {};

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const text = (name: string) => form.get(name)?.toString() ?? '';
  const type = text('type') as ReleaseGroupType;
  input = {
    artist: text('artist'),
    title: text('title'),
    type: TYPES.some(([t]) => t === type) ? type : 'album',
    date: text('date'),
    genres: text('genres'),
    tracklist: text('tracklist'),
  };
  for (const [name, value] of form) if (name.startsWith('existing_')) chosen[name.slice('existing_'.length)] = String(value);
  // Only lines set to a song, and only while the tracklist is the one previewed.
  input.existing = Object.fromEntries(Object.entries(chosen).filter(([, value]) => value && value !== 'new'));
  errors = validateManual(input);

  if (errors.length === 0 && form.get('intent') === 'save') {
    // A song chosen for a line is used only while it still is that line's (the tracklist may have changed since the preview).
    input.existing = await fittingChoices(input.existing ?? {}, parseTracklist(input.tracklist));
    const result = await writePlan(buildManualPlan(input));
    // Its cover, looked for after the answer (Apple Music, then Genius through its songs, which knows most releases made by hand).
    const cover = findCover(result.releaseId, { replace: false }).catch((error) => console.warn('Cover for a release by hand failed', error));
    const waitUntil = waitUntilOf(Astro.locals);
    if (waitUntil) waitUntil(cover);
    else await cover;
    // The release, saying it was just added: the page itself is the proof.
    return Astro.redirect(`/album/${result.releaseGroupId}?added=1`, 303);
  }
  if (errors.length > 0) Astro.response.status = 422;
  previewing = errors.length === 0;

  if (previewing) {
    const { results } = await env.DB.prepare(
      `SELECT g.id, g.title FROM release_group g
       JOIN artist_credit c ON c.entity_type = 'release_group' AND c.entity_id = g.id AND c.role = 'primary'
       JOIN artist a ON a.id = c.artist_id
       WHERE lower(g.title) = lower(?) AND lower(a.name) = lower(?)`,
    )
      .bind(input.title.trim(), input.artist.trim())
      .all<{ id: string; title: string }>();
    duplicates = results;
    matches = await existingSongs(input.artist, parseTracklist(input.tracklist), Astro.locals.user?.id ?? null);
    // Songs picked in the builder (by any artist, a guest's say) are offered on their lines too, first.
    const picked = await songsByIds(Object.values(input.existing ?? {}), Astro.locals.user?.id ?? null);
    for (const [key, id] of Object.entries(input.existing ?? {})) {
      const song = picked.get(id);
      if (song && !matches[key]?.some((m) => m.id === id)) matches[key] = [song, ...(matches[key] ?? [])];
    }
  }
}

// The builder's rows, from what was sent: each line, and the library song chosen for it.
const builderRows: BuilderRow[] = [];
{
  const lines = input.tracklist.split('\n').map((l) => l.trim()).filter(Boolean);
  const details = await songsByIds(Object.values(input.existing ?? {}), Astro.locals.user?.id ?? null);
  let disc = 1;
  let position = 0;
  for (const line of lines) {
    if (/^(?:disc|cd|disk)\s*\d+\b/i.test(line)) {
      disc++;
      position = 0;
      builderRows.push({ kind: 'disc', text: line });
      continue;
    }
    position++;
    const id = input.existing?.[`${disc}-${position}`];
    const song = id ? details.get(id) : undefined;
    builderRows.push({
      kind: 'song',
      text: song ? song.title : line.replace(/^\d+[.)]\s*/, ''),
      existing: song ? { id: song.id, detail: [song.album_title, song.score !== null ? `rated ${Math.round(song.score)}` : null].filter(Boolean).join(' · ') } : null,
    });
  }
}

const tracks = previewing ? parseTracklist(input.tracklist) : [];
const genreNames = (await env.DB.prepare(`SELECT name FROM genre ORDER BY name`).all<{ name: string }>()).results.map((g) => g.name);
const discs = new Set(tracks.map((t) => t.disc)).size;
---

<Base title="Add by hand">
  <div class="wrap page">
    <header>
      <p><BackLink href="/manage/import">Import</BackLink></p>
      <h1>Add by hand</h1>
      <p class="muted">For music on no database (mixtapes, demos, bedroom releases), or a release made of songs already in your library.</p>
    </header>

    {
      errors.length > 0 && (
        <div class="errors" role="alert">
          <ul>{errors.map((e) => <li>{e}</li>)}</ul>
        </div>
      )
    }

    {/* Posted as an ordinary page (data-native): the answer to Preview is this page with the preview
        on it, which the background save (SoftForms) threw away by reloading, so the form came back
        empty and nothing said what had happened (15 Nov). It lands at the preview. */}
    <form method="post" action="#preview" class="form" id="manual-form" data-native>
      <div class="row">
        <div class="field">
          <label for="artist">Artist</label>
          <input class="input" id="artist" name="artist" value={input.artist} required autocomplete="off" list="artist-options" />
          <datalist id="artist-options"></datalist>
        </div>
        <div class="field">
          <label for="title">Title</label>
          <input class="input" id="title" name="title" value={input.title} required autocomplete="off" />
        </div>
      </div>
      <div class="row">
        <div class="field">
          <label for="type">Type</label>
          <select class="input" id="type" name="type">
            {TYPES.map(([value, label]) => <option value={value} selected={input.type === value}>{label}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="date">Released <span class="optional">(optional)</span></label>
          <input class="input" id="date" name="date" value={input.date} placeholder="2019 or 2019-08" autocomplete="off" aria-describedby="date-hint" />
          <span class="hint" id="date-hint">Only as precise as you know: a year is fine.</span>
        </div>
      </div>
      <ChipInput
        id="genres"
        name="genres"
        label="Genres (optional)"
        value={input.genres}
        options={genreNames}
        placeholder="Add a genre"
        hint="Your own tags, over any imported ones."
      />
      <ReleaseBuilder form="manual-form" rows={builderRows} max={MAX_TRACKS} />

      <div class="buttons">
        <button class="button" type="submit" name="intent" value="preview">Preview</button>
        {previewing && <button class="button button--primary" type="submit" name="intent" value="save">Add to catalogue</button>}
        {!previewing && <span class="muted small">Preview shows what will be made. Nothing is added until you press Add.</span>}
      </div>
    </form>

    {
      previewing && (
        <section class="preview" id="preview" aria-labelledby="preview-heading" tabindex="-1">
          <h2 id="preview-heading">Preview</h2>
          <p class="not-yet" role="status">Not added yet. Check it below, change anything above, then Add to catalogue.</p>
          {duplicates.length > 0 && (
            <p class="warning" role="status">
              The catalogue already has{' '}
              {duplicates.map((d, i) => (
                <>
                  {i > 0 && ', '}
                  <a href={`/album/${d.id}`}>{d.title}</a>
                </>
              ))}{' '}
              by {input.artist}. Adding this creates a separate album.
            </p>
          )}
          <p>
            <strong>{input.title}</strong> by {input.artist}
            <span class="muted">
              {' · '}
              {TYPES.find(([t]) => t === input.type)?.[1]}
              {input.date && ` · ${input.date}`}
              {` · ${tracks.length} ${tracks.length === 1 ? 'track' : 'tracks'}`}
              {discs > 1 && ` on ${discs} discs`}
            </span>
          </p>
          {Object.keys(matches).length > 0 && (
            <p class="muted">
              {Object.keys(matches).length} of these {Object.keys(matches).length === 1 ? 'is a song' : 'are songs'} already in the library: they go on the
              album as they are, ratings, plays and credits with them. Choose “New song” for any that is a different recording.
            </p>
          )}
          {tracks.length > 0 && (
            <table>
              <thead>
                <tr>
                  <th scope="col">#</th>
                  <th scope="col">Title</th>
                  <th scope="col">Featuring</th>
                  <th scope="col">Length</th>
                  {Object.keys(matches).length > 0 && <th scope="col">Song</th>}
                </tr>
              </thead>
              <tbody>
                {tracks.map((t) => (
                  <tr>
                    <td class="tabular">{discs > 1 ? `${t.disc}.${t.position}` : t.position}</td>
                    <td>{t.title}</td>
                    <td>{t.featured.join(', ')}</td>
                    <td class="tabular">{formatDuration(t.length_ms) ?? ''}</td>
                    {Object.keys(matches).length > 0 && (
                      <td>
                        {matches[lineKey(t)] ? (
                          <select class="input small" name={`existing_${lineKey(t)}`} form="manual-form" aria-label={`${t.title}: a song already here, or a new one`}>
                            {matches[lineKey(t)]!.map((m, i) => (
                              <option value={m.id} selected={chosen[lineKey(t)] ? chosen[lineKey(t)] === m.id : i === 0}>
                                Already here{m.album_title ? `: ${m.album_title}` : ''}{m.score !== null ? ` (rated ${Math.round(m.score)})` : ''}
                              </option>
                            ))}
                            <option value="new" selected={chosen[lineKey(t)] === 'new'}>
                              New song
                            </option>
                          </select>
                        ) : (
                          <span class="muted">New song</span>
                        )}
                      </td>
                    )}
                  </tr>
                ))}
              </tbody>
            </table>
          )}
          <div class="buttons">
            <button class="button button--primary" type="submit" form="manual-form" name="intent" value="save">Add to catalogue</button>
          </div>
        </section>
      )
    }
  </div>
</Base>

<script>
  // The artist field suggests artists already in the library as you type.
  const artist = document.querySelector('#artist') as unknown as HTMLInputElement | null;
  const options = document.querySelector('#artist-options');
  let timer: number | undefined;
  artist?.addEventListener('input', () => {
    window.clearTimeout(timer);
    timer = window.setTimeout(async () => {
      const q = artist.value.trim();
      if (q.length < 2 || !options) return;
      const response = await fetch(`/api/search?${new URLSearchParams({ q })}`).catch(() => null);
      if (!response?.ok) return;
      const { artists } = (await response.json()) as { artists: { title: string }[] };
      options.replaceChildren(...artists.map((a) => Object.assign(document.createElement('option'), { value: a.title })));
    }, 250);
  });
</script>

<style>
  .page {
    display: grid;
    gap: var(--space-5);
    --content-max: 48rem;
  }

  header {
    display: grid;
    gap: var(--space-2);
  }

  h2 {
    font-size: var(--step-1);
  }

  .muted,
  .optional {
    color: var(--text-muted);
    font-weight: 400;
  }

  .form {
    display: grid;
    gap: var(--space-4);
  }

  .row {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 40rem) {
    .row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .tracklist {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    resize: vertical;
  }

  .buttons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .small {
    font-size: var(--step--1);
  }

  /* Plainly a preview: nothing has been made yet. */
  .not-yet {
    padding: var(--space-3) var(--space-4);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius-s);
    background: var(--surface-1);
    font-weight: 600;
  }

  .preview:focus {
    outline: none;
  }

  .errors {
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--danger);
    border-radius: var(--radius-m);
    color: var(--danger);
  }

  .errors ul {
    margin: 0;
    padding-left: 1.2rem;
  }

  .preview {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-l);
    background: var(--surface-1);
    overflow-x: auto;
  }

  .warning {
    padding: var(--space-3) var(--space-4);
    border-left: 3px solid var(--accent);
    background: var(--surface-2);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step--1);
  }

  th,
  td {
    padding: var(--space-2) var(--space-3) var(--space-2) 0;
    border-bottom: 1px solid var(--border);
    text-align: left;
    vertical-align: top;
  }

  thead th {
    color: var(--text-muted);
    font-weight: 600;
  }
</style>
