---
/**
 * Your files (ARCHITECTURE.md §3, "Ownership and files"): every file
 * catalogued against its song, album by album, with whether its audio is
 * uploaded to play anywhere and how loud it plays, so what an import did can
 * be checked at a glance; albums with something missing come first. Also a
 * check that a folder still matches, so a missing or damaged rip is noticed
 * before it matters (in the browser, changing nothing).
 */
import EmptyState from '../../components/EmptyState.astro';
import LosslessLinks from '../../components/LosslessLinks.astro';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { catalogue } from '../../lib/import/files';
import { levelFor } from '../../lib/client/local-player';

const files = await catalogue();
const byFormat = new Map<string, number>();
for (const f of files) byFormat.set(f.format, (byFormat.get(f.format) ?? 0) + 1);
const byAlbum = new Map<string, { id: string | null; title: string; artist: string | null; files: typeof files }>();
for (const f of files) {
  const key = f.album_id ?? '(none)';
  const entry = byAlbum.get(key) ?? { id: f.album_id, title: f.album_title ?? 'Not on an album', artist: f.artist, files: [] };
  entry.files.push(f);
  byAlbum.set(key, entry);
}
// Something left to upload first, then by title.
const albums = [...byAlbum.values()]
  .map((a) => ({ ...a, up: a.files.filter((f) => f.audio_bytes != null).length }))
  .sort((a, b) => Number(a.up === a.files.length) - Number(b.up === b.files.length) || a.title.localeCompare(b.title));
const known = files.map((f) => ({ path: f.path, checksum: f.checksum }));
// Uploaded but not yet measured for loudness: measured from the stored copy (Level them now).
const toLevel = files.filter((f) => f.audio_bytes != null && f.loudness_lufs == null).map((f) => ({ id: f.id, path: f.path, checksum: f.checksum, bytes: f.audio_bytes! }));
const mb = (bytes: number) => (bytes >= 1024 ** 3 ? `${(bytes / 1024 ** 3).toFixed(1)} GB` : `${Math.max(1, Math.round(bytes / 1024 ** 2))} MB`);
const uploaded = files.filter((f) => f.audio_bytes != null);
const uploadedBytes = uploaded.reduce((sum, f) => sum + (f.audio_bytes ?? 0), 0);
const measured = uploaded.filter((f) => f.loudness_lufs != null).length;
const lufs = (v: number) => `${v.toFixed(1).replace('-', '−')} LUFS`;
const playsAt = (v: number | null) => `plays at ${Math.round(levelFor(v) * 100)}%`;
const done = Astro.url.searchParams.get('done');
// FLAC, WAV, AIFF; or anything at a lossless rate (an ALAC .m4a). Lossy albums offer an upgrade.
const isLossless = (f: { format: string; bitrate: number | null }) => /^(flac|wav|aiff?|alac)$/i.test(f.format) || (f.bitrate ?? 0) >= 700;
---

<Base title="Files">
  <div class="wrap page">
    <PageHeader title="Files">
      <span class="head-links">
        <a href="/manage/import/files">Import and upload a folder</a>
      </span>
    </PageHeader>

    {
      files.length === 0 ? (
        <EmptyState>No files catalogued yet.</EmptyState>
      ) : (
        <>
          <dl class="stats tabular">
            <div>
              <dt>Files</dt>
              <dd>{files.length.toLocaleString('en-GB')}</dd>
              <dd class="sub">{[...byFormat].map(([format, n]) => `${n} ${format.toUpperCase()}`).join(', ')}</dd>
            </div>
            <div>
              <dt>Uploaded</dt>
              <dd>{uploaded.length.toLocaleString('en-GB')}</dd>
              <dd class="sub">{uploaded.length ? `${mb(uploadedBytes)}, play anywhere` : 'none yet'}</dd>
            </div>
            <div>
              <dt>Not uploaded</dt>
              <dd>{(files.length - uploaded.length).toLocaleString('en-GB')}</dd>
              <dd class="sub">{files.length - uploaded.length ? 'import their folders' : 'all done'}</dd>
            </div>
            <div>
              <dt>Levelled</dt>
              <dd>{measured.toLocaleString('en-GB')}</dd>
              <dd class="sub">{uploaded.length - measured ? `${uploaded.length - measured} to measure below` : 'with Spotify'}</dd>
            </div>
          </dl>
          {done && <p class="notice" role="status">{done}</p>}

          {toLevel.length > 0 && (
            <section class="level" aria-labelledby="level-heading" data-level>
              <h2 id="level-heading">Level the rest with Spotify</h2>
              <p class="muted">
                {toLevel.length} uploaded {toLevel.length === 1 ? 'file has' : 'files have'} not been measured for loudness yet, so loud ones play louder than
                Spotify's songs. Measuring fetches each back from your store once ({mb(toLevel.reduce((sum, f) => sum + f.bytes, 0))}): best on a computer, or on Wi-Fi.
              </p>
              <button type="button" class="button button--primary" data-level-start>Level them now</button>
              <p role="status" class="status" data-level-status></p>
              <progress hidden data-level-progress></progress>
            </section>
          )}

          <section aria-labelledby="list-heading" class="list">
            <h2 id="list-heading">By album</h2>
            <ul role="list" class="albums">
              {albums.map((album) => (
                <li>
                  <details>
                    <summary>
                      <span class="name">
                        <span class="title">{album.title}</span>
                        {album.artist && <span class="muted"> · {album.artist}</span>}
                      </span>
                      <span class:list={['badge', 'tabular', album.up === album.files.length ? 'all' : album.up === 0 ? 'none' : 'some']}>
                        {album.up === album.files.length
                          ? `${album.up} uploaded`
                          : `${album.up} of ${album.files.length} uploaded`}
                      </span>
                    </summary>
                    <p class="album-actions">
                      {album.id && <a href={`/album/${album.id}`}>Open album</a>}
                      {album.up < album.files.length && <a href="/manage/import/files">Import its folder to upload the rest</a>}
                      {album.files.some((f) => !isLossless(f)) && (
                        <span class="upgrade">
                          <span class="muted">Lossy files; lossless from</span>
                          <LosslessLinks artist={album.artist ?? ''} album={album.title} bare />
                        </span>
                      )}
                      {album.up > 0 && (
                        <form method="post" action="/api/write/audio/remove" data-confirm="Remove this album's uploaded audio? Your own files are not touched.">
                          {album.files.filter((f) => f.audio_bytes != null).map((f) => <input type="hidden" name="id" value={f.id} />)}
                          <button class="link-button" type="submit">Remove this album's uploads</button>
                        </form>
                      )}
                    </p>
                    <ul role="list" class="songs">
                      {album.files.map((f) => (
                        <li>
                          <span class="song">
                            <a href={`/track/${f.recording_id}`}>{f.title}</a>
                            <span class:list={['state', f.audio_bytes != null ? 'up' : 'down']}>
                              {f.audio_bytes != null ? `Uploaded, ${mb(f.audio_bytes)}` : 'Not uploaded'}
                            </span>
                          </span>
                          <span class="facts muted">
                            {f.format.toUpperCase()}
                            {f.bitrate && ` · ${f.bitrate} kbps`}
                            {f.audio_bytes != null && (f.loudness_lufs != null ? ` · ${lufs(f.loudness_lufs)}, ${playsAt(f.loudness_lufs)}` : ' · loudness not measured yet')}
                            {!f.checksum && ' · no checksum'}
                          </span>
                          <span class="path">{f.path}</span>
                          {f.audio_bytes != null && (
                            <form method="post" action="/api/write/audio/remove" class="remove">
                              <input type="hidden" name="id" value={f.id} />
                              <button class="link-button" type="submit">Remove upload</button>
                            </form>
                          )}
                        </li>
                      ))}
                    </ul>
                  </details>
                </li>
              ))}
            </ul>
          </section>

          <section class="verify" aria-labelledby="verify-heading" data-verify hidden>
            <h2 id="verify-heading">Check a folder</h2>
            <div class="field">
              <label for="root">Where that folder lives</label>
              <input class="input" id="root" type="text" autocomplete="off" spellcheck="false" placeholder="D:\Music" />
            </div>
            <label class="button pick">
              <input type="file" {...{ webkitdirectory: true }} multiple class="visually-hidden" data-picker />
              Choose the folder
            </label>
            <p role="status" class="status" data-status></p>
            <progress hidden data-progress></progress>
            <div data-report></div>
          </section>
        </>
      )
    }

    <script is:inline type="application/json" id="to-level" set:html={JSON.stringify(toLevel).replaceAll('<', '\\u003c')} />
    <script is:inline type="application/json" id="known-files" set:html={JSON.stringify(known).replaceAll('<', '\\u003c')} />
  </div>
</Base>

<script>
  import { verify } from '../../lib/tags/verify';

  const section = document.querySelector<HTMLElement>('[data-verify]');
  if (section) {
    section.hidden = false;
    const known = JSON.parse(document.getElementById('known-files')!.textContent!) as { path: string; checksum: string | null }[];
    const picker = section.querySelector<HTMLInputElement>('[data-picker]')!;
    const rootInput = section.querySelector<HTMLInputElement>('#root')!;
    const status = section.querySelector<HTMLElement>('[data-status]')!;
    const progress = section.querySelector<HTMLProgressElement>('[data-progress]')!;
    const report = section.querySelector<HTMLElement>('[data-report]')!;
    try {
      rootInput.value = localStorage.getItem('import-root') ?? '';
    } catch {
      /* nothing remembered */
    }

    const AUDIO = /\.(mp3|flac|ogg|oga|opus|m4a|mp4|alac)$/i;

    picker.addEventListener('change', async () => {
      const chosen = [...(picker.files ?? [])].filter((f) => AUDIO.test(f.name));
      const root = rootInput.value.trim().replace(/[\\/]+$/, '');
      const full = (relative: string) => (root ? `${root}/${relative}` : relative);
      const folder = full((chosen[0]?.webkitRelativePath ?? '').split('/')[0] ?? '');
      report.replaceChildren();
      progress.hidden = false;
      progress.max = chosen.length || 1;
      const found: { path: string; checksum: string }[] = [];
      for (const [i, file] of chosen.entries()) {
        progress.value = i;
        status.textContent = `Fingerprinting ${i + 1} of ${chosen.length}…`;
        const hash = await crypto.subtle.digest('SHA-256', await file.arrayBuffer());
        found.push({ path: full(file.webkitRelativePath || file.name), checksum: [...new Uint8Array(hash)].map((b) => b.toString(16).padStart(2, '0')).join('') });
      }
      progress.hidden = true;

      const result = verify(known, found, folder);
      const groups: [string, string[], string][] = [
        ['Unchanged', result.ok, 'ok'],
        ['Changed since import', result.changed, 'bad'],
        ['Missing', result.missing, 'bad'],
        ['Not catalogued', result.unknown, 'note'],
        ['Present, but imported without a checksum', result.unchecked, 'note'],
      ];
      status.textContent =
        result.changed.length + result.missing.length === 0
          ? `All ${result.ok.length} catalogued files in ${folder} are present and unchanged.`
          : `${result.changed.length} changed and ${result.missing.length} missing in ${folder}.`;
      for (const [heading, paths, tone] of groups) {
        if (paths.length === 0 || tone === 'ok') continue;
        const h = document.createElement('h3');
        h.textContent = `${heading} (${paths.length})`;
        h.dataset.tone = tone;
        const ul = document.createElement('ul');
        for (const p of paths.slice(0, 200)) {
          const li = document.createElement('li');
          li.textContent = p;
          ul.appendChild(li);
        }
        report.appendChild(h);
        report.appendChild(ul);
      }
    });
  }
</script>

<script>
  import { measureLoudness } from '../../lib/client/loudness';

  // Level them now: each unmeasured upload fetched back from the store, measured here, and
  // its loudness saved (api/write/audio/loudness), one at a time (decoding takes memory).
  const level = document.querySelector<HTMLElement>('[data-level]');
  if (level) {
    const files = JSON.parse(document.getElementById('to-level')!.textContent!) as { id: string; path: string; checksum: string | null }[];
    const start = level.querySelector<HTMLButtonElement>('[data-level-start]')!;
    const status = level.querySelector<HTMLElement>('[data-level-status]')!;
    const progress = level.querySelector<HTMLProgressElement>('[data-level-progress]')!;
    start.addEventListener('click', async () => {
      start.disabled = true;
      progress.hidden = false;
      progress.max = files.length;
      let saved = 0;
      let failed = 0;
      for (const [i, f] of files.entries()) {
        progress.value = i;
        status.textContent = `Measuring ${i + 1} of ${files.length}…`;
        const res = await fetch(`/audio/${f.id}`).catch(() => null);
        const lufs = res?.ok ? await measureLoudness(await res.blob()) : null;
        if (lufs === null) {
          failed++;
          continue;
        }
        const sent = await fetch('/api/write/audio/loudness', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ files: [{ path: f.path, checksum: f.checksum, lufs }] }),
        }).catch(() => null);
        if (sent?.ok) saved++;
        else failed++;
      }
      progress.hidden = true;
      status.textContent = `${saved} levelled${failed ? `, ${failed} could not be measured (try again)` : ''}. They now play at Spotify's level.`;
      start.textContent = 'Done';
    });
  }

  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-confirm]')) {
    form.addEventListener('submit', (event) => {
      if (!confirm(form.dataset.confirm!)) event.preventDefault();
    });
  }
</script>

<style>
  .up {
    color: var(--accent);
    font-weight: 600;
  }

  .album-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
  }

  .upgrade {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .album-actions form,
  .remove {
    display: inline;
  }

  .link-button {
    padding: 0;
    border: 0;
    background: none;
    color: var(--text-muted);
    font: inherit;
    font-size: var(--step--1);
    text-decoration: underline;
    cursor: pointer;
  }

  .link-button:hover {
    color: var(--text);
  }

  .head-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
  }

  .page {
    display: grid;
    gap: var(--space-6);
    --content-max: 52rem;
  }

  h2 {
    font-size: var(--step-1);
  }

  .level {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    padding: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-l);
    background: var(--surface-1);
  }

  .level p {
    margin: 0;
  }

  .verify {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    padding: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-l);
    background: var(--surface-1);
  }

  .verify .field {
    width: 100%;
  }

  .pick:focus-within {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .status:empty {
    display: none;
  }

  progress {
    width: 100%;
    accent-color: var(--accent);
  }

  [data-report] {
    display: grid;
    gap: var(--space-2);
    width: 100%;
    font-size: var(--step--1);
  }

  [data-report] :global(h3[data-tone='bad']) {
    color: var(--danger);
  }

  [data-report] :global(ul) {
    margin: 0;
    padding-left: 1.2rem;
    overflow-wrap: anywhere;
  }

  .albums {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
  }

  summary {
    display: flex;
    align-items: center;
    min-height: var(--target);
    cursor: pointer;
  }

  .title {
    font-weight: 700;
  }

  /* The four counts: two across on a phone, four on a wide screen. */
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(9rem, calc(50% - var(--space-3))), 1fr));
    gap: var(--space-3);
    margin: 0;
  }

  .stats div {
    display: grid;
    align-content: start;
    gap: 2px;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-m);
    background: var(--surface-1);
  }

  .stats dt {
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .stats dd {
    margin: 0;
    font-size: var(--step-2);
    font-weight: 800;
    line-height: 1.1;
  }

  .stats dd.sub {
    color: var(--text-muted);
    font-size: var(--step--1);
    font-weight: 400;
  }

  summary {
    justify-content: space-between;
    gap: var(--space-3);
  }

  .name {
    min-width: 0;
  }

  /* How much of the album is uploaded: all (accent), some (outlined), none (quiet). */
  .badge {
    flex: none;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    font-size: var(--step--1);
    font-weight: 700;
    white-space: nowrap;
  }

  .badge.all {
    background: color-mix(in srgb, var(--accent) 18%, transparent);
    color: var(--accent);
  }

  .badge.some {
    outline: 1px dashed var(--accent);
    outline-offset: -1px;
    color: var(--text);
  }

  .badge.none {
    background: var(--surface-2);
    color: var(--text-muted);
  }

  .songs {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-2) 0 var(--space-4);
    padding: 0;
    list-style: none;
    font-size: var(--step--1);
  }

  .songs li {
    display: grid;
    gap: 2px;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border);
  }

  .song {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-1) var(--space-3);
    font-size: var(--step-0);
    font-weight: 650;
  }

  .state {
    font-size: var(--step--1);
    font-weight: 700;
  }

  .state.up {
    color: var(--accent);
  }

  .state.down {
    color: var(--text-muted);
  }

  .list {
    display: grid;
    gap: var(--space-2);
  }

  .path {
    color: var(--text-subtle);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    overflow-wrap: anywhere;
  }
</style>
