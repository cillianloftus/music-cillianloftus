---
/**
 * The Manage hub: everything behind sign-in. What needs Cillian first,
 * then compact lists grouped by what he goes there to do (add music, tidy,
 * listen, scores, settings), each row a word of live status. Seventeen
 * tall cards made the one wanted hard to find on a phone (15 Nov).
 */
import { env } from 'cloudflare:workers';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import DisplaySettings from '../../components/DisplaySettings.astro';
import NotificationSettings from '../../components/NotificationSettings.astro';
import { THEME_COOKIE, themeFrom } from '../../lib/theme';
import { connection } from '../../lib/spotify/client';
import { waitingCount } from '../../lib/connections';
import { latestBackup, nightlyRuns } from '../../lib/health';
import { jobCounts } from '../../lib/jobs/queue';

const user = Astro.locals.user!;
const [counts, spotify, jobs] = await Promise.all([
  env.DB.prepare(
    `SELECT (SELECT count(*) FROM anomaly WHERE status = 'open') AS review,
            (SELECT count(*) FROM file) AS files,
            (SELECT count(*) FROM play WHERE user_id = ?1 AND counted = 1) AS plays,
            (SELECT count(*) FROM release_group WHERE official = 0 AND keep_unofficial = 0) AS unofficial`,
  )
    .bind(user.id)
    .first<{ review: number; files: number; plays: number; unofficial: number }>(),
  connection(user.id).catch(() => null),
  // Kept by triggers (0070), not counted.
  jobCounts().catch(() => null),
]);
const [waiting, backup, nightly] = await Promise.all([
  waitingCount().catch(() => 0),
  latestBackup().catch(() => null),
  nightlyRuns().catch(() => []),
]);
const nightFailed = nightly.filter((t) => !t.ok).length;
const health =
  !backup || backup.overdue
    ? { text: 'Backup overdue', tone: 'attention' as const }
    : nightFailed
      ? { text: `${nightFailed} nightly ${nightFailed === 1 ? 'task' : 'tasks'} failed`, tone: 'attention' as const }
      : { text: 'All well', tone: 'quiet' as const };

type Tone = 'attention' | 'quiet';
interface Item {
  href: string;
  title: string;
  text: string;
  icon: string;
  status?: { text: string; tone: Tone } | null | undefined;
}

const n = (x: number, one: string, many = `${one}s`) => `${x.toLocaleString('en-GB')} ${x === 1 ? one : many}`;

// Simple 24px line icons, one path each.
const ICONS = {
  import: 'M12 4v11m0 0l-4-4m4 4l4-4M5 19h14',
  files: 'M4 6h6l2 2h8v10H4z',
  playlist: 'M4 7h12M4 12h12M4 17h7M18 14v6m-3-3h6',
  history: 'M12 7v5l3 2M3 12a9 9 0 1 0 3-6.7M3 4v4h4',
  spotify: 'M6 10c4-1.5 8-1 12 1M7 13.5c3-1 6.5-.7 9.5.8M8 17c2.2-.6 4.6-.4 6.8.6',
  review: 'M9 12l2 2 4-4M12 3l8 4v5c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V7z',
  kinds: 'M9 18V6l10-2v12M9 18a2 2 0 1 1-4 0 2 2 0 0 1 4 0zm10-2a2 2 0 1 1-4 0 2 2 0 0 1 4 0z',
  genres: 'M12 7a3 3 0 1 0 0-.1M6 20a3 3 0 1 0 0-.1M18 20a3 3 0 1 0 0-.1M12 7v4m0 0l-5 5m5-5l5 5',
  weights: 'M4 7h10M18 7h2M4 17h4M12 17h8M14 5v4M8 15v4',
  jobs: 'M4 6h16M4 12h10M4 18h6M17 15l2 2 3-4',
  connections: 'M9 15l6-6M10 6l1.5-1.5a4.2 4.2 0 0 1 6 6L16 12M8 12l-1.5 1.5a4.2 4.2 0 0 0 6 6L14 18',
  roles: 'M12 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7zM5 20c1.2-3.6 3.8-5.5 7-5.5s5.8 1.9 7 5.5',
  refresh: 'M20 12a8 8 0 1 1-2.4-5.7M20 4v5h-5',
  health: 'M3 12h4l2-5 4 10 2-5h6',
  backups: 'M5 7c0-1.7 3.1-3 7-3s7 1.3 7 3-3.1 3-7 3-7-1.3-7-3zm0 0v10c0 1.7 3.1 3 7 3s7-1.3 7-3V7M5 12c0 1.7 3.1 3 7 3s7-1.3 7-3',
};

// Not official releases are a Review tab now: counted with the rest of it.
const toReview = (counts?.review ?? 0) + (counts?.unofficial ?? 0);
const working = (jobs?.queued ?? 0) + (jobs?.running ?? 0);
const item = {
  import: { href: '/manage/import', title: 'Import', text: 'MusicBrainz, Spotify, a folder or by hand.', icon: ICONS.import },
  jobs: {
    href: '/manage/jobs',
    title: 'Jobs',
    text: 'Imports, refreshes, pushes and backups.',
    icon: ICONS.jobs,
    status: jobs?.failed
      ? { text: `${jobs.failed} failed`, tone: 'attention' }
      : working
        ? { text: `${working.toLocaleString('en-GB')} to import`, tone: 'quiet' }
        : null,
  },
  files: {
    href: '/manage/files',
    title: 'Files',
    text: 'Your own audio: upload it to play anywhere, and check for damaged rips.',
    icon: ICONS.files,
    status: counts?.files ? { text: n(counts.files, 'file'), tone: 'quiet' } : null,
  },
  review: {
    href: '/manage/review',
    title: 'Review',
    text: 'Duplicates, versions, bootlegs and loose ends.',
    icon: ICONS.review,
    status: toReview ? { text: `${toReview.toLocaleString('en-GB')} to look at`, tone: 'attention' } : { text: 'All clear', tone: 'quiet' },
  },
  genres: { href: '/manage/genres', title: 'Genre tree', text: 'Which genre sits under which.', icon: ICONS.genres },
  kinds: { href: '/manage/track-kinds', title: 'Track kinds', text: 'Interludes and skits.', icon: ICONS.kinds },
  roles: { href: '/manage/roles', title: 'Credit roles', text: 'Which credits come first.', icon: ICONS.roles },
  playlist: { href: '/query', title: 'New playlist', text: 'Ask for it, or build it with filters.', icon: ICONS.playlist },
  history: {
    href: '/manage/history',
    title: 'Listening history',
    text: 'What you play against what you rate.',
    icon: ICONS.history,
    status: counts?.plays ? { text: n(counts.plays, 'play'), tone: 'quiet' } : null,
  },
  spotify: {
    href: '/manage/spotify',
    title: 'Spotify',
    text: 'Where playlists are pushed.',
    icon: ICONS.spotify,
    status: spotify ? { text: 'Connected', tone: 'quiet' } : { text: 'Not connected', tone: 'attention' },
  },
  weights: { href: '/manage/weights', title: 'Weights', text: 'How scores are worked out.', icon: ICONS.weights },
  connections: {
    href: '/manage/connections',
    title: 'Connections',
    text: 'Keys for outside services.',
    icon: ICONS.connections,
    status: waiting ? { text: `${waiting} waiting for a key`, tone: 'attention' } : { text: 'All connected', tone: 'quiet' },
  },
  health: { href: '/manage/health', title: 'Health', text: 'Backups, database reads, last night.', icon: ICONS.health, status: health },
  backups: { href: '/manage/backups', title: 'Backups', text: 'Daily copies, and restoring one.', icon: ICONS.backups },
  refresh: { href: '/manage/refresh', title: 'Refresh everything', text: 'Look the whole library up again.', icon: ICONS.refresh },
} satisfies Record<string, Item>;

// By what Cillian goes there to do, the most used first in each.
const groups: { heading: string; items: Item[] }[] = [
  { heading: 'Add music', items: [item.import, item.jobs, item.files] },
  { heading: 'Tidy the library', items: [item.review, item.genres, item.kinds, item.roles] },
  { heading: 'Listen', items: [item.playlist, item.history, item.spotify] },
  { heading: 'Scores', items: [item.weights] },
  { heading: 'Settings', items: [item.connections, item.health, item.backups, item.refresh] },
];
// What wants him now, whichever group it is in: first, so nothing waits unseen.
const needs: Item[] = (Object.values(item) as Item[]).filter((i) => i.status?.tone === 'attention');
const shown = [...(needs.length ? [{ heading: 'Needs you', items: needs }] : []), ...groups];
const slug = (heading: string) => heading.toLowerCase().replace(/\s+/g, '-');
---

<Base title="Manage">
  <div class="wrap page">
    <PageHeader title="Manage">
      <span class="muted small">{user.email}</span>
    </PageHeader>

    {
      shown.map((group) => (
        <section aria-labelledby={`group-${slug(group.heading)}`} class:list={[{ needs: group.heading === 'Needs you' }]}>
          <h2 id={`group-${slug(group.heading)}`}>{group.heading}</h2>
          <ul role="list" class="rows">
            {group.items.map((entry) => (
              <li>
                <span class="icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24">
                    <path d={entry.icon} />
                  </svg>
                </span>
                <div class="text">
                  <a href={entry.href}>{entry.title}</a>
                  <p>{entry.text}</p>
                </div>
                {entry.status ? (
                  <span class="status" data-tone={entry.status.tone}>
                    {entry.status.text}
                  </span>
                ) : (
                  <span />
                )}
                <svg class="chevron" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="m9 6 6 6-6 6" />
                </svg>
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <section aria-labelledby="group-notifications">
      <h2 id="group-notifications">Notifications</h2>
      <NotificationSettings />
    </section>

    <section aria-labelledby="group-display">
      <h2 id="group-display">Display</h2>
      <DisplaySettings theme={themeFrom(Astro.cookies.get(THEME_COOKIE)?.value)} />
    </section>
  </div>
</Base>

<style>
  .page {
    display: grid;
    gap: var(--space-5);
    --content-max: 44rem;
  }

  h2 {
    margin-bottom: var(--space-2);
    color: var(--text-muted);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .needs h2 {
    color: var(--accent);
  }

  /* One rounded list per group, rows divided by hairlines: a phone screen
     shows most of the page, where cards showed four. */
  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--border);
    border-radius: var(--radius-m);
    background: var(--surface-1);
    overflow: hidden;
  }

  li {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    align-items: center;
    gap: var(--space-3);
    min-height: 3.5rem;
    padding: var(--space-2) var(--space-3);
  }

  li + li {
    border-top: 1px solid var(--border);
  }

  li:hover {
    background: var(--surface-2);
  }

  .icon {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: var(--radius-s);
    background: color-mix(in srgb, var(--accent) 14%, var(--surface-2));
    color: var(--accent);
  }

  .icon svg {
    width: 1.2rem;
    height: 1.2rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .text {
    display: grid;
    min-width: 0;
  }

  a {
    font-weight: 700;
    font-size: var(--step-0);
    text-decoration: none;
  }

  /* The whole row is the link target. */
  a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  a:focus-visible {
    outline: none;
  }

  a:focus-visible::after {
    outline: 3px solid var(--focus);
    outline-offset: -3px;
    border-radius: var(--radius-m);
  }

  p {
    overflow: hidden;
    margin: 0;
    color: var(--text-muted);
    font-size: var(--step--1);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .status {
    padding: 0.1rem 0.55rem;
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--text-muted);
    font-size: var(--step--1);
    font-weight: 600;
    white-space: nowrap;
  }

  .status[data-tone='attention'] {
    background: color-mix(in srgb, var(--accent) 20%, transparent);
    color: var(--accent);
  }

  .chevron {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: var(--text-subtle);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Phones: the name and its status only; what each is for is plain from its name. */
  @media (max-width: 39.99rem) {
    p {
      display: none;
    }
  }
</style>
