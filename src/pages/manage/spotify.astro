---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { connection, isConfigured } from '../../lib/spotify/client';

const user = Astro.locals.user!;
const configured = isConfigured();
const status = configured ? await connection(user.id) : null;

const ERRORS: Record<string, string> = {
  'not-configured': 'Spotify credentials are not set yet.',
  access_denied: 'Spotify access was declined.',
  state: 'That sign-in attempt could not be verified. Try connecting again.',
  exchange: 'Spotify did not accept the sign-in. Try connecting again.',
  link: 'Finding albums on Spotify failed part-way. Try again in a moment.',
};
const linked = Astro.url.searchParams.get('linked');
const linkedTracks = Astro.url.searchParams.get('tracks');
const missed = Astro.url.searchParams.get('missed');
const error = Astro.url.searchParams.get('error');
const connected = Astro.url.searchParams.get('connected');

const date = new Intl.DateTimeFormat('en-IE', { dateStyle: 'long', timeZone: 'Europe/Dublin' });
const WARN_DAYS = 21;
/** When the playback scopes were added to what connecting asks for. */
const PLAYBACK_SINCE = '2026-11-08T16:00:00Z';
---

<Base title="Spotify">
  <div class="wrap page">
    <PageHeader title="Spotify" />
    <p class="muted">Authorisations last six months; this page warns before then.</p>

    {error && <p class="notice notice--error" role="alert">{ERRORS[error] ?? `Spotify returned: ${error}`}</p>}
    {connected && <p class="notice" role="status">Connected.</p>}
    {
      linked !== null && (
        <p class="notice" role="status">
          Linked {linked} {linked === '1' ? 'album' : 'albums'} and {linkedTracks} {linkedTracks === '1' ? 'track' : 'tracks'}.
          {missed && ` Not found with confidence: ${missed}.`}
        </p>
      )
    }

    {
      !configured ? (
        <section class="form-card" aria-labelledby="setup-heading">
          <h2 id="setup-heading">Set up</h2>
          <ol>
            <li>
              Create an app at <a href="https://developer.spotify.com/dashboard" rel="external">developer.spotify.com/dashboard</a>,
              with Web API selected.
            </li>
            <li>
              Add redirect URIs <code>http://127.0.0.1/api/write/spotify/callback</code> (local; no port)
              and <code>https://music.cillianloftus.com/api/write/spotify/callback</code>.
            </li>
            <li>
              Put the client id and secret in <code>.dev.vars</code> as <code>SPOTIFY_CLIENT_ID</code> and{' '}
              <code>SPOTIFY_CLIENT_SECRET</code>, and for production run{' '}
              <code>wrangler secret put</code> for each.
            </li>
            <li>Restart the dev server and come back here.</li>
          </ol>
        </section>
      ) : !status ? (
        <section class="form-card" aria-labelledby="connect-heading">
          <h2 id="connect-heading">Not connected</h2>
          <p class="muted">Connect the account playlists should be created in.</p>
          <a class="button button--primary" href="/api/write/spotify/connect">Connect Spotify</a>
        </section>
      ) : (
        <section class="form-card" aria-labelledby="status-heading">
          <h2 id="status-heading">Connected</h2>
          <dl>
            <div>
              <dt>Authorised</dt>
              <dd>{date.format(new Date(status.authorized_at))}</dd>
            </div>
            <div>
              <dt>Expires</dt>
              <dd>
                {date.format(new Date(status.expires_on))}
                <span class:list={['days', { warn: status.days_left <= WARN_DAYS }]}>
                  {status.days_left > 0 ? ` · ${status.days_left} days left` : ' · expired'}
                </span>
              </dd>
            </div>
          </dl>
          {
            status.days_left <= WARN_DAYS && (
              <p class="notice notice--warn">
                Reconnect before it expires, or pushes will stop working.
              </p>
            )
          }
          {
            // Connections made before Now playing lack the playback permissions.
            status.authorized_at < PLAYBACK_SINCE && (
              <p class="notice notice--warn">
                Reconnect once to let <a href="/now">Now playing</a> show and steer what Spotify is playing.
              </p>
            )
          }
          <a class:list={['button', { 'button--primary': status.days_left <= WARN_DAYS || status.authorized_at < PLAYBACK_SINCE }]} href="/api/write/spotify/connect">
            Reconnect
          </a>
        </section>
      )
    }
    {
      configured && status && (
        <section class="form-card" aria-labelledby="link-heading">
          <h2 id="link-heading">Album links</h2>
          <p class="muted">Found each night and after every import. Exact matches only.</p>
          <form method="post" action="/api/write/spotify/link">
            <button class="button" type="submit">Find albums on Spotify now</button>
          </form>
        </section>
      )
    }
  </div>
</Base>

<style>
  .page {
    display: grid;
    gap: var(--space-5);
    --content-max: 40rem;
  }

  h2 {
    font-size: var(--step-1);
  }

  .form-card {
    gap: var(--space-4);
    justify-items: start;
  }

  ol {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding-left: 1.2rem;
  }

  code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    overflow-wrap: anywhere;
  }

  dl {
    display: grid;
    gap: var(--space-3);
    margin: 0;
  }

  dt {
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  dd {
    margin: 0;
  }

  .warn {
    color: var(--danger);
    font-weight: 600;
  }

  .notice {
    padding: var(--space-3) var(--space-4);
    border-left: 3px solid var(--accent);
    background: var(--surface-1);
  }

  .notice--error,
  .notice--warn {
    border-left-color: var(--danger);
  }
</style>
