---
/**
 * Your own uploaded files (src/lib/audio.ts), as a page: an album's in
 * order, a playlist's, or one song, from ?track. Play buttons elsewhere
 * start the music in place and it plays on from page to page
 * (src/lib/client/local-player.ts); this page is where they go without
 * script, and what is kept on the device to play with no signal, so it can
 * host the player itself. The owner's only.
 */
import Base from '../layouts/Base.astro';
import { ownerId } from '../lib/auth/user';
import type { PlayableTrack } from '../lib/audio';
import { playQueue } from '../lib/play-queue';
import KeepButton from '../components/KeepButton.astro';

const user = Astro.locals.user;
const owner = user ? user.id === (await ownerId()) : false;
const albumId = Astro.url.searchParams.get('album');
const playlistId = Astro.url.searchParams.get('playlist');
const { queue, start }: { queue: PlayableTrack[]; start: number } = owner ? await playQueue(Astro.url.searchParams) : { queue: [], start: 0 };
const first = queue[start];
---

<Base title={first ? `${first.title} · Playing` : 'Player'}>
  <div class="wrap player" data-player data-queue={JSON.stringify(queue)} data-start={start}>
    {
      !owner ? (
        <p class="muted">Your own files play here once you are signed in.</p>
      ) : queue.length === 0 ? (
        <div class="none">
          <h1>Nothing to play here</h1>
          <p class="muted">
            None of {playlistId ? 'this playlist' : albumId ? 'this album' : 'this song'} is uploaded yet. <a href="/manage/import/files">Import its folder</a> to upload it.
          </p>
        </div>
      ) : (
        <>
          <div class="art">
            {first?.artKey ? <img src={`/${first.artKey}/500.jpg`} alt="" width="500" height="500" data-art /> : <div class="no-art" data-art-none />}
          </div>
          <div class="now">
            <p class="eyebrow">Your files</p>
            <h1 data-title>{first?.title}</h1>
            <p class="by">
              <span data-artist>{first?.artist}</span>
              {first?.album && (
                <>
                  {' · '}
                  <a href={first.albumId ? `/album/${first.albumId}` : '#'} data-album target="_self">
                    {first.album}
                  </a>
                </>
              )}
            </p>
          </div>
          <div class="seek">
            <input type="range" min="0" max="1000" value="0" step="1" aria-label="Position in the song" data-seek />
            <div class="times tabular">
              <span data-at>0:00</span>
              <span data-length>0:00</span>
            </div>
          </div>
          <div class="controls">
            <button type="button" class="ctl" data-prev aria-label="Previous">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5v14M19 5 9 12l10 7z" /></svg>
            </button>
            <button type="button" class="ctl main" data-toggle aria-label="Play">
              <svg viewBox="0 0 24 24" aria-hidden="true" data-icon-play><path d="M8 5.5v13l10.5-6.5z" /></svg>
              <svg viewBox="0 0 24 24" aria-hidden="true" data-icon-pause style="display: none"><path d="M8 5v14M16 5v14" /></svg>
            </button>
            <button type="button" class="ctl" data-next aria-label="Next">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 5v14M5 5l10 7-10 7z" /></svg>
            </button>
          </div>
          <p class="status muted" role="status" data-status></p>
          {/* Kept on this device: plays with no signal (keep-offline.ts, the service worker serves it). */}
          <KeepButton query={Astro.url.search.slice(1)} />
          {queue.length > 1 && (
            <ol class="queue" role="list" data-list>
              {queue.map((t, i) => (
                <li>
                  <button type="button" data-index={i} aria-current={i === start ? 'true' : undefined}>
                    <span class="n tabular">{i + 1}</span>
                    <span class="t">{t.title}</span>
                  </button>
                </li>
              ))}
            </ol>
          )}
        </>
      )
    }
  </div>
</Base>

<script>
  import { CHANNEL, framedHost, hostPlayer, type LocalMessage, type LocalState, type LocalTrack } from '../lib/client/local-player';

  const root = document.querySelector<HTMLElement>('[data-player]');
  if (root && root.querySelector('[data-seek]')) {
    const queue = JSON.parse(root.dataset.queue || '[]') as LocalTrack[];
    const start = Number(root.dataset.start) || 0;
    const $ = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel);
    const seek = $<HTMLInputElement>('[data-seek]')!;
    const at = $('[data-at]')!;
    const length = $('[data-length]')!;
    const toggle = $<HTMLButtonElement>('[data-toggle]')!;
    const status = $('[data-status]')!;
    const time = (ms: number) => (Number.isFinite(ms) ? `${Math.floor(ms / 60000)}:${String(Math.floor((ms / 1000) % 60)).padStart(2, '0')}` : '0:00');
    let seeking = false;

    // The player itself (local-player.ts): the shell's, when this page is in its frame, so it
    // plays on from page to page; else this page's own (opened directly, or with no signal).
    const player = framedHost() ?? hostPlayer();
    const channel = 'BroadcastChannel' in window ? new BroadcastChannel(CHANNEL) : null;
    const send = (m: LocalMessage) => (channel ? channel.postMessage(m) : player.command(m));

    // A cover that will not load leaves the plain square, not a broken image.
    const artImage = $<HTMLImageElement>('[data-art]');
    artImage?.addEventListener('error', () => (artImage.style.visibility = 'hidden'));
    artImage?.addEventListener('load', () => (artImage.style.visibility = ''));
    if (artImage?.complete && artImage.naturalWidth === 0) artImage.style.visibility = 'hidden';

    let shown = '';
    const paint = (s: LocalState) => {
      if (s.recordingId !== shown) {
        shown = s.recordingId;
        $('[data-title]')!.textContent = s.title;
        $('[data-artist]')!.textContent = s.artist;
        const album = $<HTMLAnchorElement>('[data-album]');
        if (album) {
          album.textContent = s.album ?? '';
          if (s.albumId) album.href = `/album/${s.albumId}`;
        }
        if (artImage && s.artKey) artImage.src = `/${s.artKey}/500.jpg`;
        document.title = `${s.title} · Playing`;
        for (const b of root.querySelectorAll<HTMLButtonElement>('[data-index]')) {
          if (Number(b.dataset.index) === s.index) b.setAttribute('aria-current', 'true');
          else b.removeAttribute('aria-current');
        }
      }
      $('[data-icon-play]')!.style.display = s.playing ? 'none' : '';
      $('[data-icon-pause]')!.style.display = s.playing ? '' : 'none';
      toggle.setAttribute('aria-label', s.playing ? 'Pause' : 'Play');
      status.textContent = s.problem ?? '';
      length.textContent = time(s.durationMs);
      if (!seeking) {
        at.textContent = time(s.positionMs);
        seek.value = s.durationMs ? String(Math.round((s.positionMs / s.durationMs) * 1000)) : '0';
      }
    };
    channel?.addEventListener('message', (event) => {
      const m = event.data as LocalMessage;
      if (m.type === 'state') paint(m.state);
    });
    // Between the player's word every couple of seconds, the clock from its audio.
    setInterval(() => {
      const s = player.state();
      if (s) paint(s);
    }, 500);

    toggle.addEventListener('click', () => send({ type: 'command', cmd: 'toggle' }));
    $('[data-prev]')!.addEventListener('click', () => send({ type: 'command', cmd: 'previous' }));
    $('[data-next]')!.addEventListener('click', () => send({ type: 'command', cmd: 'next' }));
    for (const b of root.querySelectorAll<HTMLButtonElement>('[data-index]')) {
      b.addEventListener('click', () => send({ type: 'command', cmd: 'jump', index: Number(b.dataset.index) }));
    }
    seek.addEventListener('input', () => {
      seeking = true;
      const s = player.state();
      if (s) at.textContent = time((Number(seek.value) / 1000) * s.durationMs);
    });
    seek.addEventListener('change', () => {
      const s = player.state();
      if (s?.durationMs) send({ type: 'command', cmd: 'seek', ms: (Number(seek.value) / 1000) * s.durationMs });
      seeking = false;
    });

    player.load(queue, start, true);
    const first = player.state();
    if (first) paint(first);
  }
</script>

<style>
  .player {
    display: grid;
    gap: var(--space-4);
    justify-items: center;
    padding-block: var(--space-6);
    --content-max: 28rem;
    text-align: center;
  }

  .art {
    width: min(100%, 22rem);
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius-l);
    background: var(--surface-2);
    box-shadow: 0 24px 60px -16px rgb(0 0 0 / 0.55);
  }

  .art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .now {
    display: grid;
    gap: var(--space-1);
  }

  .now h1 {
    margin: 0;
    font-size: var(--step-2);
    text-wrap: balance;
  }

  .by {
    margin: 0;
    color: var(--text-muted);
  }

  .seek {
    width: 100%;
  }

  .seek input {
    width: 100%;
    accent-color: var(--accent);
  }

  .times {
    display: flex;
    justify-content: space-between;
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .controls {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  .ctl {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--text);
    cursor: pointer;
  }

  .ctl.main {
    width: 4.25rem;
    height: 4.25rem;
    background: var(--text);
    color: var(--bg);
  }

  .ctl svg {
    width: 1.6rem;
    height: 1.6rem;
    fill: currentColor;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ctl [hidden] {
    display: none;
  }

  .small {
    font-size: var(--step--1);
  }

  .status:empty {
    display: none;
  }

  .queue {
    display: grid;
    width: 100%;
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
    text-align: left;
  }

  .queue button {
    display: flex;
    gap: var(--space-3);
    width: 100%;
    min-height: var(--target);
    align-items: center;
    padding: var(--space-2) var(--space-3);
    border: 0;
    border-bottom: 1px solid var(--border);
    background: none;
    color: var(--text);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .queue button[aria-current] {
    color: var(--accent);
    font-weight: 700;
  }

  .queue .n {
    min-width: 1.5rem;
    color: var(--text-muted);
  }

  .none {
    display: grid;
    gap: var(--space-2);
  }
</style>
