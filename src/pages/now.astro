---
/**
 * Now playing: what Spotify is playing, steered from here (back, play,
 * next, seek, shuffle, repeat), with the song's synced lyrics, its
 * credits, and the rating form, so a song can be graded while it plays
 * without leaving the site. The music itself plays in Spotify's app.
 *
 * The page polls /api/write/player every few seconds while it is in view.
 * When the song changes it fetches this page again and swaps in the new
 * song's part (#now-song), so the rating form and credits follow along.
 */
import { env } from 'cloudflare:workers';
import Base from '../layouts/Base.astro';
import RatingSheet from '../components/RatingSheet.astro';
import Score from '../components/Score.astro';
import { ratingHistory } from '../lib/ratings';
import { spotifyFor } from '../lib/spotify/client';
import { nowPlaying, PlayerError, type NowState } from '../lib/spotify/player';
import { activeWeights } from '../lib/weights';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/manage');

let state: NowState | null = null;
let problem: string | null = null;
try {
  state = await nowPlaying(spotifyFor(user.id));
} catch (error) {
  problem = error instanceof PlayerError ? error.message : 'Spotify could not be reached. Is it connected on Manage › Spotify?';
}
const song = state?.track ?? null;

interface Here {
  id: string;
  title: string;
  album_id: string | null;
  album_title: string | null;
  quality: number | null;
  personal: number | null;
}

// The song in the catalogue: by its Spotify id, or as a listen already matched to it.
const here = song
  ? await env.DB.prepare(
      `SELECT rec.id, rec.title, g.id AS album_id, g.title AS album_title,
              (SELECT s.quality_score FROM v_recording_score s WHERE s.recording_id = rec.id AND s.user_id = ?2) AS quality,
              (SELECT s.personal_score FROM v_recording_score s WHERE s.recording_id = rec.id AND s.user_id = ?2) AS personal
       FROM recording rec
       LEFT JOIN track t ON t.recording_id = rec.id
       LEFT JOIN release r ON r.id = t.release_id
       LEFT JOIN release_group g ON g.id = r.release_group_id
       WHERE rec.id = coalesce((SELECT id FROM recording WHERE spotify_id = ?1),
                               (SELECT recording_id FROM listen_track WHERE key = 'spotify:' || ?1))
       ORDER BY r.date IS NULL, r.date
       LIMIT 1`,
    )
      .bind(song.spotifyId, user.id)
      .first<Here>()
  : null;

const [history, weights, calibration, creditRows] = here
  ? await Promise.all([
      ratingHistory(user.id, 'recording', here.id),
      activeWeights(user.id),
      env.DB.prepare('SELECT gut_offset FROM v_gut_calibration WHERE user_id = ?').bind(user.id).first<number>('gut_offset'),
      env.DB.prepare(
        `SELECT cr.label, a.id, a.name
         FROM artist_credit ac JOIN artist a ON a.id = ac.artist_id JOIN credit_role cr ON cr.id = ac.role
         WHERE ac.entity_type = 'recording' AND ac.entity_id = ?
         ORDER BY cr.family = 'artist' DESC, cr.label, ac.position`,
      )
        .bind(here.id)
        .all<{ label: string; id: string; name: string }>(),
    ])
  : [[], null, null, null];
const credits = new Map<string, { id: string; name: string }[]>();
for (const c of creditRows?.results ?? []) credits.set(c.label, [...(credits.get(c.label) ?? []), c]);

// Each of Spotify's artists in the catalogue: by Spotify id, else by name among the song's credits.
const known = song
  ? (
      await env.DB.prepare(
        `SELECT a.id, a.name, a.spotify_id FROM artist a
         WHERE a.spotify_id IN (SELECT value FROM json_each(?1))
            OR a.id IN (SELECT artist_id FROM artist_credit WHERE entity_type = 'recording' AND entity_id = ?2)`,
      )
        .bind(JSON.stringify(song.artistIds), here?.id ?? null)
        .all<{ id: string; name: string; spotify_id: string | null }>()
    ).results
  : [];
const fold = (s: string) => s.normalize('NFKD').replace(/\p{M}/gu, '').toLowerCase();
/** Where the song's names lead, for the titles under the cover (drawn again by the script below). */
const links = song
  ? {
      song: song.spotifyId,
      track: here ? `/track/${here.id}` : null,
      album: here?.album_id ? `/album/${here.album_id}` : null,
      artists: song.artists.map((name, i) => {
        const a = known.find((k) => k.spotify_id === song.artistIds[i]) ?? known.find((k) => fold(k.name) === fold(name));
        return { name, href: a ? `/artist/${a.id}` : null };
      }),
    }
  : null;

const time = (ms: number) => {
  const s = Math.max(0, Math.floor(ms / 1000));
  return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
};
const ICON = {
  previous: 'M7 6v12M18 6l-8 6 8 6z',
  next: 'M17 6v12M6 6l8 6-8 6z',
  play: 'M8 5.5v13l11-6.5z',
  pause: 'M8 5.5v13M16 5.5v13',
  shuffle: 'M4 7h3c5 0 5 10 10 10h3M17 14l3 3-3 3M4 17h3c1.6 0 2.7-1 3.5-2.3M13.5 9.3C14.3 8 15.4 7 17 7h3M17 4l3 3-3 3',
  repeat: 'M5 11V9a2 2 0 0 1 2-2h12M16 4l3 3-3 3M19 13v2a2 2 0 0 1-2 2H5M8 20l-3-3 3-3',
};
---

<Base title="Now playing">
  <div class="wrap now" data-now={JSON.stringify(state)}>
    {
      problem ? (
        <section class="empty">
          <h1>Now playing</h1>
          <p>{problem}</p>
          <p><a href="/manage/spotify">Manage › Spotify</a></p>
        </section>
      ) : (
        <>
          <div class="player" data-player hidden={!song}>
            <img class="cover" src={song?.art ?? ''} alt="" width="640" height="640" data-art />
            <div class="titles">
              <h1 data-title>{links?.track ? <a href={links.track}>{song?.title}</a> : song?.title}</h1>
              <p class="by" data-by>
                {links?.artists.map((a, i) => (
                  <>
                    {i > 0 && ', '}
                    {a.href ? <a href={a.href}>{a.name}</a> : a.name}
                  </>
                ))}
              </p>
              <p class="album muted" data-album>{links?.album ? <a href={links.album}>{song?.album}</a> : song?.album}</p>
            </div>

            <div class="progress">
              <label for="seek" class="visually-hidden">Position</label>
              <input id="seek" type="range" min="0" max={song?.durationMs ?? 0} step="any" value={state?.progressMs ?? 0} data-seek />
              <div class="times tabular muted">
                <span data-elapsed>{time(state?.progressMs ?? 0)}</span>
                <span data-length>{time(song?.durationMs ?? 0)}</span>
              </div>
            </div>

            <div class="controls">
              <button type="button" class="ctl small" data-cmd="shuffle" aria-label="Shuffle" aria-pressed={state?.shuffle ? 'true' : 'false'}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d={ICON.shuffle} /></svg>
              </button>
              <button type="button" class="ctl" data-cmd="previous" aria-label="Back">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d={ICON.previous} /></svg>
              </button>
              <button type="button" class="ctl main" data-cmd="toggle" aria-label={state?.playing ? 'Pause' : 'Play'} data-toggle>
                <svg viewBox="0 0 24 24" aria-hidden="true" class="when-paused"><path d={ICON.play} /></svg>
                <svg viewBox="0 0 24 24" aria-hidden="true" class="when-playing"><path d={ICON.pause} /></svg>
              </button>
              <button type="button" class="ctl" data-cmd="next" aria-label="Next">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d={ICON.next} /></svg>
              </button>
              <button type="button" class="ctl small" data-cmd="repeat" aria-label="Repeat" aria-pressed={state?.repeat !== 'off' ? 'true' : 'false'} data-repeat={state?.repeat ?? 'off'}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d={ICON.repeat} /></svg>
              </button>
            </div>
            <p class="device muted" data-device>{state?.device ? `On ${state.device.name}` : ''}</p>
            <p class="status" role="status" data-status></p>
          </div>

          <section class="empty" data-idle hidden={Boolean(song)}>
            <h1>Nothing playing</h1>
            <p class="muted">Start something in Spotify, or press Listen on any track or album here. This page follows along.</p>
          </section>

          <div id="now-song" class="song" data-song-id={song?.spotifyId ?? ''} data-links={JSON.stringify(links)}>
            {
              song && here && (
                <>
                  <section aria-labelledby="rate-heading" class="rate" data-rate>
                    <div class="rate-head">
                      <h2 id="rate-heading">Your rating</h2>
                      {/* Redrawn after each save (the script below). */}
                      <span data-now-score>
                        <Score quality={here.quality} personal={here.personal} size="m" />
                      </span>
                    </div>
                    <RatingSheet entityType="recording" entityId={here.id} current={history[0]} returnTo="/now" preview={{ weights: weights!, offset: calibration ?? 0 }} />
                  </section>
                  {credits.size > 0 && (
                    <section aria-labelledby="credits-heading" class="credits">
                      <h2 id="credits-heading">Credits</h2>
                      <dl>
                        {[...credits].map(([label, people]) => (
                          <div>
                            <dt>{label}</dt>
                            <dd>
                              {people.map((p, i) => (
                                <>
                                  {i > 0 && ', '}
                                  <a href={`/artist/${p.id}`}>{p.name}</a>
                                </>
                              ))}
                            </dd>
                          </div>
                        ))}
                      </dl>
                    </section>
                  )}
                </>
              )
            }
            {
              song && !here && (
                <section class="outside">
                  <p>Not in the library yet, so there is nothing to rate.</p>
                  <button type="button" class="button button--primary" data-import={`https://open.spotify.com/album/${song.albumSpotifyId}`}>
                    Import {song.album}
                  </button>
                </section>
              )
            }
          </div>

          <section aria-labelledby="lyrics-heading" class="lyrics" data-lyrics-box hidden>
            <h2 id="lyrics-heading">Lyrics</h2>
            <ol class="lines" data-lyrics role="list"></ol>
            <p class="muted small">From LRCLIB.</p>
          </section>
        </>
      )
    }
  </div>
</Base>

<script>
  import { enhanceAxes } from '../lib/client/axis-slider';
  import { scoreTone } from '../lib/format';
  import { NowClock, fetchNow, type Track } from '../lib/client/now-clock';
  import { enhanceAutosave, flushAutosave } from '../lib/client/rating-autosave';
  import { enhancePreviews } from '../lib/client/rating-preview';
  import type { NowState } from '../lib/spotify/now-state';

  interface Lyrics {
    syncedLyrics?: string | null;
    plainLyrics?: string | null;
    instrumental?: boolean;
  }

  /** Where the song's names lead, rendered with its part of the page (#now-song). */
  interface Links {
    song: string;
    track: string | null;
    album: string | null;
    artists: { name: string; href: string | null }[];
  }

  const root = document.querySelector<HTMLElement>('[data-now]');
  const player = root?.querySelector<HTMLElement>('[data-player]');
  if (root && player) {
    const clock = new NowClock(JSON.parse(root.dataset.now || 'null') as NowState | null);
    // Timed by the server's clock when the page was made; the first poll puts it right.
    if (clock.state) clock.state.at = Date.now();
    clock.save();
    const $ = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
    const seek = $<HTMLInputElement>('[data-seek]');
    const elapsed = $('[data-elapsed]');
    const length = $('[data-length]');
    const status = $('[data-status]');
    const idle = $('[data-idle]');
    const art = $<HTMLImageElement>('[data-art]');
    let dragging = false;

    const time = (ms: number) => {
      const s = Math.max(0, Math.floor(ms / 1000));
      return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
    };

    // Lyrics from LRCLIB, timed where it has them.
    let lines: { at: number; el: HTMLLIElement }[] = [];
    const lyricsBox = $('[data-lyrics-box]');
    const lyricsList = $<HTMLOListElement>('[data-lyrics]');
    async function loadLyrics(track: Track) {
      lines = [];
      lit = -1;
      lyricsList.replaceChildren();
      lyricsBox.hidden = true;
      const params = new URLSearchParams({
        track_name: track.title,
        artist_name: track.artists[0] ?? '',
        album_name: track.album,
        duration: String(Math.round(track.durationMs / 1000)),
      });
      try {
        let res = await fetch(`https://lrclib.net/api/get?${params}`);
        let found: Lyrics | null = res.ok ? ((await res.json()) as Lyrics) : null;
        if (!found) {
          res = await fetch(`https://lrclib.net/api/search?${new URLSearchParams({ track_name: track.title, artist_name: track.artists[0] ?? '' })}`);
          found = res.ok ? (((await res.json()) as Lyrics[])[0] ?? null) : null;
        }
        if (!found || clock.state?.track?.spotifyId !== track.spotifyId) return;
        const synced = found.syncedLyrics ?? '';
        const plain = found.plainLyrics ?? '';
        if (found.instrumental) {
          lyricsList.appendChild(Object.assign(document.createElement('li'), { textContent: 'Instrumental.' }));
        } else if (synced) {
          for (const raw of synced.split('\n')) {
            const m = /^\[(\d+):(\d+(?:\.\d+)?)\]\s?(.*)$/.exec(raw);
            if (!m) continue;
            const el = document.createElement('li');
            el.textContent = m[3] || '♪';
            lyricsList.appendChild(el);
            lines.push({ at: (Number(m[1]) * 60 + Number(m[2])) * 1000, el });
          }
        } else if (plain) {
          for (const text of plain.split('\n')) lyricsList.appendChild(Object.assign(document.createElement('li'), { textContent: text || ' ' }));
        } else return;
        lyricsBox.hidden = false;
        lyricsBox.classList.toggle('synced', lines.length > 0);
      } catch {
        /* No lyrics is fine. */
      }
    }
    let lit = -1;
    const followLyrics = (ms: number) => {
      if (!lines.length) return;
      let i = lines.findIndex((l) => l.at > ms) - 1;
      if (i < -1) i = lines.length - 1;
      if (i === lit) return;
      lines[lit]?.el.classList.remove('lit');
      lit = i;
      const line = lines[i]?.el;
      if (!line) return;
      line.classList.add('lit');
      // Scroll the lyrics box, never the page.
      lyricsList.scrollTo({ top: line.offsetTop - lyricsList.clientHeight / 2 + line.clientHeight / 2, behavior: 'smooth' });
    };

    // The names under the cover, as links once the song's page part says where they lead.
    const linksFor = (id: string): Links | null => {
      try {
        const links = JSON.parse(document.getElementById('now-song')?.dataset.links || 'null') as Links | null;
        return links?.song === id ? links : null;
      } catch {
        return null;
      }
    };
    const linkOrText = (text: string, href: string | null | undefined): Node => {
      if (!href) return document.createTextNode(text);
      return Object.assign(document.createElement('a'), { href, textContent: text });
    };
    let titlesFor = clock.state?.track ? `${clock.state.track.spotifyId}${linksFor(clock.state.track.spotifyId) ? '+' : ''}` : '';
    const paintTitles = (track: Track) => {
      const links = linksFor(track.spotifyId);
      const key = `${track.spotifyId}${links ? '+' : ''}`;
      if (key === titlesFor) return;
      titlesFor = key;
      $('[data-title]').replaceChildren(linkOrText(track.title, links?.track));
      const by = $<HTMLElement>('[data-by]');
      by.replaceChildren();
      track.artists.forEach((name, i) => {
        if (i > 0) by.appendChild(document.createTextNode(', '));
        by.appendChild(linkOrText(name, links?.artists[i]?.href));
      });
      $('[data-album]').replaceChildren(linkOrText(track.album, links?.album));
    };

    const paint = () => {
      const state = clock.state;
      const track = state?.track ?? null;
      player.hidden = !track;
      idle.hidden = Boolean(track);
      if (!track || !state) return;
      if (art.getAttribute('src') !== (track.art ?? '')) art.src = track.art ?? '';
      paintTitles(track);
      $('[data-device]').textContent = state.device ? `On ${state.device.name}` : '';
      seek.max = String(track.durationMs);
      length.textContent = time(track.durationMs);
      player.classList.toggle('is-playing', state.playing);
      $('[data-toggle]').setAttribute('aria-label', state.playing ? 'Pause' : 'Play');
      $('[data-cmd="shuffle"]').setAttribute('aria-pressed', String(state.shuffle));
      const repeat = $('[data-cmd="repeat"]');
      repeat.setAttribute('aria-pressed', String(state.repeat !== 'off'));
      repeat.dataset.repeat = state.repeat;
      repeat.setAttribute('aria-label', state.repeat === 'track' ? 'Repeat: this song' : state.repeat === 'context' ? 'Repeat: on' : 'Repeat: off');
    };

    // A new song: this page again, and its song part swapped in once the
    // server sees the same song (it may be a moment behind a predicted one).
    let swapping = '';
    async function swapSong(id: string) {
      const song = document.getElementById('now-song');
      if (!song || song.dataset.songId === id || swapping === id) return;
      swapping = id;
      // Whatever was being rated is saved before its form goes.
      flushAutosave(song);
      for (let attempt = 0; attempt < 5 && clock.state?.track?.spotifyId === id; attempt++) {
        try {
          const html = await (await fetch('/now', { headers: { accept: 'text/html' } })).text();
          const fresh = new DOMParser().parseFromString(html, 'text/html').getElementById('now-song');
          if (fresh?.dataset.songId === id) {
            song.innerHTML = fresh.innerHTML;
            song.dataset.songId = id;
            song.dataset.links = fresh.dataset.links ?? 'null';
            enhanceAxes(song);
            enhancePreviews(song);
            enhanceAutosave(song);
            if (clock.state?.track) paintTitles(clock.state.track);
            break;
          }
        } catch {
          /* Tried again below. */
        }
        await new Promise((resolve) => setTimeout(resolve, 1200));
      }
      if (swapping === id) swapping = '';
    }

    const songChanged = () => {
      paint();
      const track = clock.state?.track;
      if (!track) return;
      void loadLyrics(track);
      void swapSong(track.spotifyId);
    };

    // Problems show as a toast over the page, never pushing it about, and
    // only once they last: a hiccup or two from Spotify is shrugged off.
    let toastTimer: ReturnType<typeof setTimeout> | undefined;
    const notice = (text: string) => {
      status.textContent = text;
      clearTimeout(toastTimer);
      if (text) toastTimer = setTimeout(() => (status.textContent = ''), 6000);
    };
    let failures = 0;

    let polling = false;
    async function poll() {
      if (polling) return;
      polling = true;
      try {
        const answer = await fetchNow(true);
        if (!answer.ok) {
          // Three misses in a row (some seconds) before saying so.
          if (++failures >= 3) notice(answer.error ?? 'Spotify isn’t answering just now.');
          return;
        }
        failures = 0;
        if (status.textContent) notice('');
        if (clock.accept(answer.state)) songChanged();
        else paint();
      } catch {
        /* Offline for a moment. */
      } finally {
        polling = false;
      }
    }

    async function send(body: Record<string, unknown>) {
      try {
        const res = await fetch('/api/write/player', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) });
        if (!res.ok) {
          const data = (await res.json().catch(() => null)) as { error?: string; reason?: string } | null;
          // Something to do about it (reconnect, open Spotify, Premium): say so now.
          // Anything else may well have worked anyway; the polls below show what happened.
          if (data?.reason && data.reason !== 'other') notice(data.error ?? '');
        }
      } catch {
        /* Offline for a moment: the polls will tell. */
      }
      setTimeout(poll, 700);
      setTimeout(poll, 2000);
    }

    // Each frame: the bar and the lyrics move smoothly; the clock text once a second.
    let shownSecond = -1;
    let lastEnd = 0;
    const frame = () => {
      const now = Date.now();
      // The song ran out: on to the next in Spotify's queue, then check with Spotify.
      if (clock.ended(now) && now - lastEnd > 1500) {
        lastEnd = now;
        if (clock.advance(now)) songChanged();
        else paint();
        setTimeout(poll, 400);
      }
      const ms = clock.position(now);
      if (!dragging) seek.value = String(ms);
      const second = Math.floor((dragging ? Number(seek.value) : ms) / 1000);
      if (second !== shownSecond) {
        shownSecond = second;
        elapsed.textContent = time(second * 1000);
      }
      followLyrics(ms);
      requestAnimationFrame(frame);
    };

    root.querySelectorAll<HTMLButtonElement>('[data-cmd]').forEach((button) =>
      button.addEventListener('click', () => {
        const cmd = button.dataset.cmd!;
        const state = clock.state;
        if (cmd === 'toggle') {
          // Shown at once; Spotify confirms on the next poll.
          clock.set({ playing: !state?.playing });
          paint();
          void send({ action: clock.state?.playing ? 'play' : 'pause' });
        } else if (cmd === 'shuffle') {
          clock.set({ shuffle: !state?.shuffle });
          paint();
          void send({ action: 'shuffle', on: clock.state?.shuffle });
        } else if (cmd === 'repeat') {
          const next = { off: 'context', context: 'track', track: 'off' } as const;
          clock.set({ repeat: next[state?.repeat ?? 'off'] });
          paint();
          void send({ action: 'repeat', mode: clock.state?.repeat });
        } else if (cmd === 'next') {
          // The queue says what comes next, so it can show before Spotify gets there.
          if (clock.advance()) songChanged();
          void send({ action: 'next' });
        } else {
          void send({ action: cmd });
        }
      }),
    );
    seek.addEventListener('input', () => {
      dragging = true;
    });
    seek.addEventListener('change', () => {
      dragging = false;
      clock.set({ progressMs: Number(seek.value) });
      void send({ action: 'seek', positionMs: Math.round(Number(seek.value)) });
    });

    // Each save says what the score is now: redraw it as the Score component
    // draws it (same classes and scoping attributes, so its styles apply).
    root.addEventListener('rating:saved', (event) => {
      const { quality, personal } = (event as CustomEvent<{ quality: number | null; personal: number | null }>).detail;
      const old = root.querySelector('[data-now-score] .score');
      if (!old || quality == null) return;
      const scoped = [...old.attributes].filter((a) => a.name.startsWith('data-astro-cid'));
      const make = (className: string) => {
        const el = document.createElement('span');
        el.className = className;
        for (const a of scoped) el.setAttribute(a.name, a.value);
        return el;
      };
      const rounded = Math.round(quality);
      const impact = personal != null ? Math.round(personal - quality) : 0;
      const level = impact <= 0 ? 0 : impact <= 4 ? 1 : impact <= 7 ? 2 : 3;
      const tone = scoreTone(rounded);
      const score = make('score score--m');
      const number = make(`tabular ${tone.className}`);
      number.setAttribute('aria-hidden', 'true');
      if (tone.style) number.setAttribute('style', tone.style);
      number.textContent = String(rounded);
      score.appendChild(number);
      if (level > 0) {
        const mark = make('mark');
        mark.dataset.level = String(level);
        mark.setAttribute('aria-hidden', 'true');
        mark.title = `Impact ${impact} of 10`;
        mark.textContent = '✦';
        score.appendChild(mark);
      }
      const label = make('visually-hidden');
      label.textContent = `Score ${rounded} out of 100${impact > 0 ? `, and an impact of ${impact} out of 10` : ''}`;
      score.appendChild(label);
      old.replaceWith(score);
    });

    // Import the album of a song not in the library yet.
    root.addEventListener('click', async (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-import]');
      if (!button) return;
      button.disabled = true;
      const body = new FormData();
      body.set('source', button.dataset.import!);
      const res = await fetch('/api/write/import', { method: 'POST', body, headers: { accept: 'application/json' } });
      const data = (await res.json().catch(() => ({}))) as { jobId?: string; label?: string };
      if (res.ok && data.jobId) {
        window.dispatchEvent(new CustomEvent('job:watch', { detail: { id: data.jobId, label: data.label ?? 'Album' } }));
        button.textContent = 'Importing… it can be rated once it lands';
      } else button.disabled = false;
    });

    paint();
    if (clock.state?.track) void loadLyrics(clock.state.track);
    requestAnimationFrame(frame);
    void poll();
    // Every few seconds while the page is in view; at once on coming back to it.
    setInterval(() => document.visibilityState === 'visible' && poll(), 5000);
    document.addEventListener('visibilitychange', () => document.visibilityState === 'visible' && poll());
  }
</script>

