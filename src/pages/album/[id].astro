---
import { kindsOf } from '../../lib/track-kinds';
import Base from '../../layouts/Base.astro';
import Findings from '../../components/Findings.astro';
import AlbumShape from '../../components/AlbumShape.astro';
import { hasShape, shapeOf } from '../../lib/shape';
import { discover, trackFacts } from '../../lib/discover';
import { albumStanding, albumStandings } from '../../lib/standing';
import CoverArt from '../../components/CoverArt.astro';
import CreditLine from '../../components/CreditLine.astro';
import Backdrop from '../../components/Backdrop.astro';
import Score from '../../components/Score.astro';
import ScorePanel from '../../components/ScorePanel.astro';
import { ratingHistory } from '../../lib/ratings';
import { similarAlbums } from '../../lib/pages';
import AlbumCard from '../../components/AlbumCard.astro';
import Shelf from '../../components/Shelf.astro';
import LinkIcon from '../../components/LinkIcon.astro';
import { groupCredits } from '../../lib/credits';
import { spotifyLink } from '../../lib/spotify/links';
import { env } from 'cloudflare:workers';
import { ownerId } from '../../lib/auth/user';
import {
  contributors,
  editions,
  genresFor,
  redirectFor,
  releaseGroup,
  tracklist,
  type Contributor,
  type Edition,
} from '../../lib/catalogue';
import { formatPartialDate, yearOf } from '../../lib/dates';
import { albumExtras, placeIn } from '../../lib/album-extras';
import { describeDuration, describeLength, formatDuration, roleLabel, typeLabel } from '../../lib/format';
import { FORMAT_LABELS, HOLDING_FORMATS, OWNED_PHRASE, holdingsFor } from '../../lib/holdings';
import { playCounts } from '../../lib/history';

const id = Astro.params.id!;
const user = Astro.locals.user;
const viewerId = user?.id ?? (await ownerId());

const album = await releaseGroup(id, viewerId);
if (!album) {
  const merged = await redirectFor('release_group', id);
  if (merged) return Astro.redirect(`/album/${merged}`, 301);
  return Astro.rewrite('/404');
}

const allEditions = await editions(album.id);
const standardId = album.canonical_release_id;

// ?edition= picks which edition's tracklist to show; anything unknown falls
// back to the standard edition, the one album scores are computed from.
const requested = Astro.url.searchParams.get('edition');
const shown = allEditions.find((e) => e.id === requested) ?? allEditions.find((e) => e.id === standardId) ?? null;
const releaseId = shown?.id ?? null;
const isStandard = releaseId === standardId;

// Straight to the album on Spotify when its id is known; a search otherwise.
const albumLinks = await env.DB.prepare('SELECT spotify_id, genius_url FROM release_group WHERE id = ?')
  .bind(album.id)
  .first<{ spotify_id: string | null; genius_url: string | null }>();
const albumSpotifyId = albumLinks?.spotify_id ?? null;
// Pages elsewhere about this album, only those that exist.
const links = [
  albumSpotifyId ? { label: 'Spotify', href: `https://open.spotify.com/album/${albumSpotifyId}`, icon: 'spotify' } : null,
  albumLinks?.genius_url ? { label: 'Genius', href: albumLinks.genius_url, icon: 'genius' } : null,
  album.mbid ? { label: 'MusicBrainz', href: `https://musicbrainz.org/release-group/${album.mbid}`, icon: 'musicbrainz' } : null,
].filter((l): l is { label: string; href: string; icon: string } => l !== null);
const listenHref = spotifyLink('album', albumSpotifyId, `${album.credits[0]?.name ?? ''} ${album.title}`);

// The latest album rating, for the axes on the score panel.
const albumRating = viewerId ? ((await ratingHistory(viewerId, 'release_group', album.id))[0] ?? null) : null;

// The collection is private: only the signed-in owner of it sees it.
const holdings = user ? await holdingsFor(user.id, album.id) : [];
const holdingError = user ? Astro.url.searchParams.get('holding_error') : null;

const [tracks, standardTracks, genres, people, albumFacts, extras] = await Promise.all([
  releaseId ? tracklist(releaseId, viewerId) : Promise.resolve([]),
  standardId && !isStandard ? tracklist(standardId, viewerId) : Promise.resolve([]),
  genresFor('release_group', album.id),
  releaseId ? contributors(releaseId) : Promise.resolve([]),
  viewerId ? trackFacts(viewerId, { albumId: album.id }) : Promise.resolve([]),
  albumExtras(album.id),
]);
// What stands out on this album: found in its tracks' ratings, not chosen.
const albumLines = viewerId && album.quality_score !== null ? albumStanding(await albumStandings(viewerId), album.id) : [];
const albumFindings = discover(albumFacts, { albumId: album.id, limit: 4, minGroup: 2 }).filter((f) => f.kind !== 'habit');

// Tracks on this edition but not the standard one: bonus tracks, which do
// not count towards the album score.
const standardRecordings = new Set(standardTracks.map((t) => t.recording_id));
const isBonus = (recordingId: string) => !isStandard && !standardRecordings.has(recordingId);
const bonusCount = isStandard ? 0 : tracks.filter((t) => isBonus(t.recording_id)).length;
const missingCount = isStandard
  ? 0
  : standardTracks.filter((t) => !tracks.some((s) => s.recording_id === t.recording_id)).length;

const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`;
const differences = [
  bonusCount > 0 ? `${plural(bonusCount, 'bonus track')} not on the standard edition` : null,
  missingCount > 0 ? `${plural(missingCount, 'standard track')} missing` : null,
].filter(Boolean);
const editionNote = `${
  differences.length > 0 ? differences.join(', and ') : 'Same recordings as the standard edition'
}. Album scores always use the standard edition.`.replace(/^./, (c) => c.toUpperCase());

// Editions with titles of their own ("The Instrumentals") go by them, minus
// the album's name; otherwise by format, year and country, then by whatever
// still tells two apart.
const ownTitles = new Set(allEditions.map((e) => e.title)).size > 1;
const shortTitle = (e: Edition) => {
  const rest = e.title.startsWith(album.title) ? e.title.slice(album.title.length).replace(/^[\s:–—-]+|[()[\]]/g, '').trim() : e.title;
  return rest || 'Original';
};
const plainLabel = (e: Edition) => [e.format, yearOf(e.date), e.country].filter(Boolean).join(' · ') || e.title;
const editionLabel = (e: Edition) => (ownTitles ? shortTitle(e) : plainLabel(e));
const editionHref = (e: Edition) =>
  e.id === standardId ? `${Astro.url.pathname}#tracklist-heading` : `${Astro.url.pathname}?edition=${e.id}#tracklist-heading`;

// Listening history is private too: play counts only for the signed-in listener.
const [plays, kinds] = await Promise.all([
  user ? playCounts(user.id, tracks.map((t) => t.recording_id)) : Promise.resolve(new Map<string, number>()),
  kindsOf(tracks.map((t) => t.recording_id)),
]);
const totalPlays = [...plays.values()].reduce((a, b) => a + b, 0);

const discs = [...new Set(tracks.map((t) => t.disc))];

// What can be said about it at a glance, from what is held: full release
// date, length of the standard edition, label.
const standardEdition = allEditions.find((e) => e.id === standardId) ?? null;
const standardLength = (standardTracks.length ? standardTracks : tracks).reduce((sum, t) => sum + (t.length_ms ?? 0), 0);
// The standard edition's label, as a page of its own when MusicBrainz knows it.
const standardLabel = extras.labels.find((l) => l.release_id === standardId) ?? null;
const facts = [
  formatPartialDate(album.first_release_date, album.date_precision),
  album.track_count ? `${album.track_count} ${album.track_count === 1 ? 'track' : 'tracks'}` : null,
  standardLength > 0 ? describeLength(standardLength) : null,
  standardLabel ? null : (standardEdition?.label ?? null),
].filter(Boolean);
const LISTS_SHOWN = 4;

// The best-rated track on the standard edition.
const bestTrack = (standardTracks.length ? standardTracks : tracks)
  .filter((t) => t.quality_score != null)
  .sort((a, b) => (b.personal_score ?? b.quality_score!) - (a.personal_score ?? a.quality_score!))[0];
const best = bestTrack && (album.rated_track_count ?? 0) > 1 ? { title: bestTrack.title, href: `/track/${bestTrack.recording_id}`, quality: bestTrack.quality_score! } : null;

// The first track on the standard edition not rated yet, for "Rate the next".
const nextUnrated = (standardTracks.length ? standardTracks : tracks).find((t) => t.quality_score == null) ?? null;

// How its scores run from first track to last, on the standard edition.
const runningOrder = (standardTracks.length ? standardTracks : tracks).map((t) => ({
  id: t.recording_id,
  position: discs.length > 1 ? `${t.disc}.${t.position}` : t.position,
  title: t.title,
  score: t.quality_score ?? null,
}));
const shape = hasShape(runningOrder.map((t) => t.score)) ? shapeOf(runningOrder.map((t) => t.score)) : null;

const similar = await similarAlbums(album.id, viewerId, 10);
const albumArtistKey = album.credits.map((c) => c.artist_id).join();
const totalMs = tracks.reduce((sum, t) => sum + (t.length_ms ?? 0), 0);

const byRole = new Map<string, Contributor[]>();
for (const person of people) {
  byRole.set(person.role, [...(byRole.get(person.role) ?? []), person]);
}
// Credits, two ways. Key credits beside the tracklist: who wrote, produced
// and engineered it, the few on most tracks per role, and the players
// summarised by role. Then every credit, by kind, in a section of its own
// that opens on request. Nobody is left out; nothing crowds the page.
const KEY_PER_ROLE = 3;
// The key roles in full (well, their top few); everything else as one line of role counts.
const keyRoles = [...byRole].filter(([, list]) => list[0]!.key_order != null).sort(([, a], [, b]) => a[0]!.key_order! - b[0]!.key_order!);
const playerRoles = [...byRole].filter(([, list]) => list[0]!.key_order == null);
const people_count = new Set(people.map((p) => p.artist_id)).size;
const allCreditsShown = people.length > 12;
const creditFamilies = groupCredits([...byRole], ([, list]) => list[0]!).map((g) => ({ family: g.key, name: g.name, roles: g.items }));

const here = Astro.url.pathname + Astro.url.search;
const rateHref = (type: string, entityId: string) =>
  `/edit/rate/${type}/${entityId}?return_to=${encodeURIComponent(here)}`;
const artistNames = album.credits.map((c) => c.name).join(', ');
---

<Base
  title={`${album.title} by ${artistNames}`}
  description={[
    `${typeLabel(album.type)}${yearOf(album.first_release_date) ? `, ${yearOf(album.first_release_date)}` : ''}.`,
    album.quality_score != null ? `Rated ${Math.round(album.quality_score)} out of 100.` : null,
    album.impact_note ? `“${album.impact_note}”` : null,
  ]
    .filter(Boolean)
    .join(' ')}
  image={album.art_key ? `/${album.art_key}/1200.jpg` : null}
>
  <article class="wrap album">
    <Backdrop artKey={album.art_key} />
    <header class="hero">
      <div class="art">
        <CoverArt
          artKey={album.art_key}
          title={album.title}
          alt={`Cover of ${album.title}`}
          sizes="(min-width: 48rem) 20rem, calc(100vw - 32px)"
          priority
        />
      </div>

      <div class="intro">
        <div class="titles">
          <p class="eyebrow">
            {typeLabel(album.type)}
            {album.status !== 'released' && <> · {album.status === 'announced' ? 'Announced' : 'Cancelled'}</>}
          </p>
          <h1 class:list={[{ long: album.title.length > 18, longer: album.title.length > 34 }]}>{album.title}</h1>
          <p class="by"><CreditLine credits={album.credits} /></p>
          {(facts.length > 0 || standardLabel) && (
            <p class="facts">
              {facts.join(' · ')}
              {standardLabel && (
                <>
                  {facts.length > 0 && ' · '}
                  <a href={`/label/${standardLabel.label_id}`}>{standardLabel.name}</a>
                </>
              )}
            </p>
          )}
        </div>

        <ScorePanel
          quality={album.quality_score}
          personal={album.personal_score}
          ratedTracks={album.rated_track_count}
          trackCount={album.track_count}
          rating={albumRating}
          best={best}
          rateHref={user ? rateHref('release_group', album.id) : null}
          nextHref={user && nextUnrated ? rateHref('recording', nextUnrated.recording_id) : null}
        />
      </div>

      <div class="more">
        {
          albumLines.length > 0 && (
            <ul class="standing" role="list" aria-label="Where it stands">
              {albumLines.map((s) => (
                <li>{s.href ? <a href={s.href}>{s.text}</a> : s.text}</li>
              ))}
            </ul>
          )
        }
        <p class="actions">
          <a class="button" href={listenHref} target="_blank" rel="noopener" data-play={albumSpotifyId ? '' : undefined} data-album={albumSpotifyId ?? undefined}>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="9" />
              <path d="M7.5 10c3-1 6.3-.7 9 .8M8.2 13.2c2.4-.7 5-.5 7.2.6M8.8 16.2c1.8-.4 3.6-.3 5.3.4" />
            </svg>
            {albumSpotifyId ? 'Listen' : 'Search'}
            <span class="visually-hidden">{albumSpotifyId ? ' on Spotify' : ' for it on Spotify'}</span>
            <span class="visually-hidden"> (opens in a new tab)</span>
          </a>
          {user && (
            <a class="button button--quiet" href={`/edit/album/${album.id}`}>
              Edit
            </a>
          )}
        </p>

        {
          genres.length > 0 && (
            <ul class="genres" aria-label="Genres">
              {genres.map((genre) => (
                <li>
                  <a href={`/genre/${genre.id}`}>{genre.name}</a>
                </li>
              ))}
            </ul>
          )
        }

        {
          extras.lists.length > 0 && (
            <div class="lists">
              <h2 class="lists-heading">On {extras.lists.length === 1 ? 'a list' : `${extras.lists.length} lists`}</h2>
              <ul role="list">
                {extras.lists.slice(0, LISTS_SHOWN).map((l) => (
                  <li>
                    {l.name}
                    {placeIn(l) && <span class="muted"> · {placeIn(l)}</span>}
                  </li>
                ))}
              </ul>
              {extras.lists.length > LISTS_SHOWN && (
                <details>
                  <summary>All {extras.lists.length}</summary>
                  <ul role="list">
                    {extras.lists.slice(LISTS_SHOWN).map((l) => (
                      <li>
                        {l.name}
                        {placeIn(l) && <span class="muted"> · {placeIn(l)}</span>}
                      </li>
                    ))}
                  </ul>
                </details>
              )}
            </div>
          )
        }

        {
          extras.rating && (
            <p class="community muted">
              Rated {extras.rating.value.toFixed(1)} of 5 by {extras.rating.votes} on MusicBrainz
            </p>
          )
        }

        {
          album.impact_note && (
            <figure class="impact-note">
              <blockquote>
                <p>{album.impact_note}</p>
              </blockquote>
            </figure>
          )
        }
      </div>
    </header>

    <section class="tracks" aria-labelledby="tracklist-heading">
      <h2 id="tracklist-heading">Tracklist</h2>

      {
        allEditions.length > 1 && (
          <nav class="edition-switch" aria-label="Choose edition">
            <ul role="list">
              {allEditions.map((edition) => (
                <li>
                  <a href={editionHref(edition)} aria-current={edition.id === releaseId ? 'true' : undefined}>
                    <span class="switch-label">{editionLabel(edition)}</span>
                    <span class="switch-detail">
                      {ownTitles && `${[edition.format, yearOf(edition.date)].filter(Boolean).join(' · ')} · `}
                      {edition.track_count} tracks{edition.id === standardId && ' · standard'}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }

      {
        shown && !isStandard && (
          <p class="edition-note">{editionNote}</p>
        )
      }

      {
        tracks.length === 0 ? (
          <p class="muted">No tracklist yet.</p>
        ) : (
          discs.map((disc) => (
            <Fragment>
              {discs.length > 1 && <h3 class="disc">Disc {disc}</h3>}
              <ol class="tracklist" role="list">
                {tracks
                  .filter((track) => track.disc === disc)
                  .map((track) => (
                    <li class="track">
                      <span class="position tabular" aria-hidden="true">{track.position}</span>
                      <div class="title">
                        <span class="name">
                          <span class="visually-hidden">Track {track.position}: </span>
                          <a class="track-link" href={`/track/${track.recording_id}`}>{track.title}</a>
                          {isBonus(track.recording_id) && <span class="tag">Bonus</span>}
                          {kinds.has(track.recording_id) && <span class="tag">{kinds.get(track.recording_id) === 'skit' ? 'Skit' : 'Interlude'}</span>}
                        </span>
                        {track.credits.map((c) => c.artist_id).join() !== albumArtistKey && (
                          <span class="track-artist">
                            <CreditLine credits={track.credits} />
                          </span>
                        )}
                        {plays.has(track.recording_id) && (
                          <span class="plays tabular">
                            {plays.get(track.recording_id)} {plays.get(track.recording_id) === 1 ? 'play' : 'plays'}
                          </span>
                        )}
                      </div>
                      <span class="length tabular">
                        {track.length_ms != null && (
                          <>
                            <span aria-hidden="true">{formatDuration(track.length_ms)}</span>
                            <span class="visually-hidden">{describeDuration(track.length_ms)}</span>
                          </>
                        )}
                      </span>
                      <span class="track-score">
                        <Score quality={track.quality_score} personal={track.personal_score} size="s" quietWhenEmpty />
                      </span>
                      {/* A skit is not rated, but keeps the column, so its length lines up. */}
                      {user && kinds.get(track.recording_id) === 'skit' && (
                        <span class="rate rate--none" aria-hidden="true">
                          <svg viewBox="0 0 24 24" />
                        </span>
                      )}
                      {user && kinds.get(track.recording_id) !== 'skit' && (
                        <a class="rate" href={rateHref('recording', track.recording_id)} title={`Rate ${track.title}`}>
                          <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z" />
                          </svg>
                          <span class="visually-hidden">Rate {track.title}</span>
                        </a>
                      )}
                    </li>
                  ))}
              </ol>
            </Fragment>
          ))
        )
      }

      {
        totalMs > 0 && (
          <p class="total muted">
            {tracks.length} tracks · {formatDuration(totalMs)}
            {totalPlays > 0 && ` · you have played these ${totalPlays.toLocaleString('en-GB')} times`}
          </p>
        )
      }
    </section>

    <div class="aside">
    {
      byRole.size > 0 && (
        <section class="credits" aria-labelledby="credits-heading">
          <h2 id="credits-heading">{allCreditsShown ? 'Key credits' : 'Credits'}</h2>
          <dl>
            {(allCreditsShown ? keyRoles : [...byRole]).map(([role, list]) => (
              <div>
                <dt>{roleLabel(role, list.length, list[0]!.role_label)}</dt>
                <dd>
                  {(allCreditsShown ? list.slice(0, KEY_PER_ROLE) : list).map((person, i, shown) => (
                    <Fragment>
                      <a href={`/artist/${person.artist_id}`}>{person.name}</a>
                      {person.tracks < person.of && (
                        <span class="on-tracks tabular" title={`On ${person.tracks} of ${person.of} tracks`}>
                          {' '}
                          ({person.tracks})
                        </span>
                      )}
                      {i < shown.length - 1 && ', '}
                    </Fragment>
                  ))}
                  {allCreditsShown && list.length > KEY_PER_ROLE && (
                    <a class="more-credits" href="#all-credits">
                      {' '}
                      +{list.length - KEY_PER_ROLE} more
                    </a>
                  )}
                </dd>
              </div>
            ))}
            {allCreditsShown && playerRoles.length > 0 && (
              <div>
                <dt>Also credited</dt>
                <dd class="players">
                  {playerRoles.map(([, list], i) => (
                    <Fragment>
                      {list[0]!.role_label}
                      <span class="tabular on-tracks"> {list.length}</span>
                      {i < playerRoles.length - 1 && ' · '}
                    </Fragment>
                  ))}
                </dd>
              </div>
            )}
          </dl>
          {allCreditsShown && (
            <p>
              <a class="all-link" href="#all-credits">
                All {people.length} credits, {people_count} people
              </a>
            </p>
          )}
        </section>
      )
    }

    {
      (albumFindings.length > 0 || shape) && (
        <section class="standout" aria-labelledby="standout-heading">
          <h2 id="standout-heading">What stands out</h2>
          {shape && <AlbumShape tracks={runningOrder} shape={shape} albumTitle={album.title} />}
          {albumFindings.length > 0 && <Findings findings={albumFindings} />}
        </section>
      )
    }

    <section class="editions" aria-labelledby="editions-heading">
      <h2 id="editions-heading">{allEditions.length === 1 ? 'Edition' : 'Editions'}</h2>
      {holdingError && <p class="holding-error" role="alert">{holdingError}</p>}
      {
        allEditions.length === 0 ? (
          <p class="muted">No editions yet{album.status === 'announced' ? ': this album is announced' : ''}.</p>
        ) : (
          <ul role="list">
            {allEditions.map((edition) => (
              <li>
                <a
                  class="edition-title"
                  href={editionHref(edition)}
                  aria-current={edition.id === releaseId ? 'true' : undefined}
                >
                  {edition.title}
                </a>
                <span class="muted">
                  {[
                    edition.id === standardId && allEditions.length > 1 ? 'Standard' : null,
                    `${edition.track_count} tracks`,
                    formatPartialDate(edition.date, edition.date_precision),
                    edition.country,
                    // Its labels with their catalogue numbers, when MusicBrainz gave them; else the label's name.
                    extras.labels.some((l) => l.release_id === edition.id)
                      ? extras.labels
                          .filter((l) => l.release_id === edition.id)
                          .map((l) => (l.catalog_number ? `${l.name} ${l.catalog_number}` : l.name))
                          .join(', ')
                      : edition.label,
                    edition.format,
                    extras.packaging.get(edition.id) ?? null,
                  ]
                    .filter(Boolean)
                    .join(' · ')}
                </span>
                {edition.note && <span class="edition-note">{edition.note}</span>}
                {holdings
                  .filter((h) => h.release_id === edition.id)
                  .map((h) => (
                    <form class="held" method="post" action="/api/write/holding">
                      <span>
                        <strong>{OWNED_PHRASE[h.format]}</strong>
                        {h.acquired_at && <span class="muted"> · since {formatPartialDate(h.acquired_at, h.date_precision as never)}</span>}
                        {h.notes && <span class="muted"> · {h.notes}</span>}
                      </span>
                      <input type="hidden" name="intent" value="remove" />
                      <input type="hidden" name="id" value={h.id} />
                      <button class="button button--quiet small" type="submit">
                        Remove<span class="visually-hidden"> {FORMAT_LABELS[h.format]} copy of {edition.title}</span>
                      </button>
                    </form>
                  ))}
                {user && (
                  <details class="own">
                    <summary>I own this edition</summary>
                    <form method="post" action="/api/write/holding" class="own-form">
                      <input type="hidden" name="release_id" value={edition.id} />
                      <input type="hidden" name="album_id" value={album.id} />
                      <div class="field">
                        <label for={`format-${edition.id}`}>Format</label>
                        <select class="input" id={`format-${edition.id}`} name="format">
                          {HOLDING_FORMATS.map((f) => <option value={f}>{FORMAT_LABELS[f]}</option>)}
                        </select>
                      </div>
                      <div class="field">
                        <label for={`acquired-${edition.id}`}>Since <span class="muted">(optional)</span></label>
                        <input class="input" id={`acquired-${edition.id}`} name="acquired" placeholder="2019 or 2019-06" autocomplete="off" />
                      </div>
                      <div class="field wide">
                        <label for={`notes-${edition.id}`}>Notes <span class="muted">(optional)</span></label>
                        <input class="input" id={`notes-${edition.id}`} name="notes" maxlength="300" placeholder="Signed, first pressing…" autocomplete="off" />
                      </div>
                      <button class="button" type="submit">Add to collection</button>
                    </form>
                  </details>
                )}
              </li>
            ))}
          </ul>
        )
      }
    </section>

    {
      links.length > 0 && (
        <section class="links" aria-labelledby="links-heading">
          <h2 id="links-heading">Links</h2>
          <ul role="list">
            {links.map((l) => (
              <li>
                <a href={l.href} rel="external noopener" target="_blank">
                  <LinkIcon name={l.icon} />
                  {l.label}
                  <span class="visually-hidden"> (opens in a new tab)</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
    </div>
    {
      allCreditsShown && (
        <details class="all-credits" id="all-credits">
          <summary>
            <h2>All credits</h2>
            <span class="muted">
              {people.length} credits · {people_count} people
            </span>
          </summary>
          <div class="families">
            {creditFamilies.map((f) => (
              <section aria-label={f.name} class="family">
                <h3>{f.name}</h3>
                {f.roles.map(([role, list]) => (
                  <div class="role">
                    <h4>{roleLabel(role, list.length, list[0]!.role_label)}</h4>
                    <ul role="list">
                      {list.map((person) => (
                        <li>
                          <a href={`/artist/${person.artist_id}`}>{person.name}</a>
                          {person.tracks < person.of && <span class="on-tracks tabular">{person.tracks}</span>}
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </section>
            ))}
          </div>
        </details>
      )
    }
    {
      similar.length > 0 && (
        <section class="similar" aria-labelledby="similar-heading">
          <h2 id="similar-heading">More like this</h2>
          <Shelf label="similar albums">
            <ul role="list">
              {similar.map((a) => (
                <li>
                  <AlbumCard album={a} />
                </li>
              ))}
            </ul>
          </Shelf>
        </section>
      )
    }
  </article>
</Base>

<script>
  // "+N more" and "All credits" open the full list before jumping to it.
  const all = document.getElementById('all-credits') as HTMLDetailsElement | null;
  const openAll = () => {
    if (all && location.hash === '#all-credits') all.open = true;
  };
  addEventListener('hashchange', openAll);
  document.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a[href="#all-credits"]') && all) all.open = true;
  });
  openAll();
</script>

