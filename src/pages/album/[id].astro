---
import Base from '../../layouts/Base.astro';
import CoverArt from '../../components/CoverArt.astro';
import CreditLine from '../../components/CreditLine.astro';
import Backdrop from '../../components/Backdrop.astro';
import Score from '../../components/Score.astro';
import ScorePanel from '../../components/ScorePanel.astro';
import { ratingHistory } from '../../lib/ratings';
import { spotifyLink } from '../../lib/spotify/links';
import { env } from 'cloudflare:workers';
import { ownerId } from '../../lib/auth/user';
import {
  contributors,
  editions,
  genresFor,
  redirectFor,
  releaseGroup,
  tracklist,
  type Contributor,
  type Edition,
} from '../../lib/catalogue';
import { formatPartialDate, yearOf } from '../../lib/dates';
import { describeDuration, formatDuration, roleLabel, typeLabel } from '../../lib/format';
import { FORMAT_LABELS, HOLDING_FORMATS, OWNED_PHRASE, holdingsFor } from '../../lib/holdings';
import { playCounts } from '../../lib/history';

const id = Astro.params.id!;
const user = Astro.locals.user;
const viewerId = user?.id ?? (await ownerId());

const album = await releaseGroup(id, viewerId);
if (!album) {
  const merged = await redirectFor('release_group', id);
  if (merged) return Astro.redirect(`/album/${merged}`, 301);
  return Astro.rewrite('/404');
}

const allEditions = await editions(album.id);
const standardId = album.canonical_release_id;

// ?edition= picks which edition's tracklist to show; anything unknown falls
// back to the standard edition, the one album scores are computed from.
const requested = Astro.url.searchParams.get('edition');
const shown = allEditions.find((e) => e.id === requested) ?? allEditions.find((e) => e.id === standardId) ?? null;
const releaseId = shown?.id ?? null;
const isStandard = releaseId === standardId;

// Straight to the album on Spotify when its id is known; a search otherwise.
const albumSpotifyId = await env.DB.prepare('SELECT spotify_id FROM release_group WHERE id = ?').bind(album.id).first<string>('spotify_id');
const listenHref = spotifyLink('album', albumSpotifyId, `${album.credits[0]?.name ?? ''} ${album.title}`);

// The latest album rating, for the axes on the score panel.
const albumRating = viewerId ? ((await ratingHistory(viewerId, 'release_group', album.id))[0] ?? null) : null;

// The collection is private: only the signed-in owner of it sees it.
const holdings = user ? await holdingsFor(user.id, album.id) : [];
const holdingError = user ? Astro.url.searchParams.get('holding_error') : null;

const [tracks, standardTracks, genres, people] = await Promise.all([
  releaseId ? tracklist(releaseId, viewerId) : Promise.resolve([]),
  !isStandard && standardId ? tracklist(standardId, viewerId) : Promise.resolve([]),
  genresFor('release_group', album.id),
  releaseId ? contributors(releaseId) : Promise.resolve([]),
]);

// Tracks on this edition but not the standard one: bonus tracks, which do
// not count towards the album score.
const standardRecordings = new Set(standardTracks.map((t) => t.recording_id));
const isBonus = (recordingId: string) => !isStandard && !standardRecordings.has(recordingId);
const bonusCount = isStandard ? 0 : tracks.filter((t) => isBonus(t.recording_id)).length;
const missingCount = isStandard
  ? 0
  : standardTracks.filter((t) => !tracks.some((s) => s.recording_id === t.recording_id)).length;

const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`;
const differences = [
  bonusCount > 0 ? `${plural(bonusCount, 'bonus track')} not on the standard edition` : null,
  missingCount > 0 ? `${plural(missingCount, 'standard track')} missing` : null,
].filter(Boolean);
const editionNote = `${
  differences.length > 0 ? differences.join(', and ') : 'Same recordings as the standard edition'
}. Album scores always use the standard edition.`.replace(/^./, (c) => c.toUpperCase());

const editionLabel = (e: Edition) =>
  [e.format, yearOf(e.date), e.country].filter(Boolean).join(' · ') || e.title;
const editionHref = (e: Edition) =>
  e.id === standardId ? `${Astro.url.pathname}#tracklist-heading` : `${Astro.url.pathname}?edition=${e.id}#tracklist-heading`;

// Listening history is private too: play counts only for the signed-in listener.
const plays = user ? await playCounts(user.id, tracks.map((t) => t.recording_id)) : new Map<string, number>();
const totalPlays = [...plays.values()].reduce((a, b) => a + b, 0);

const discs = [...new Set(tracks.map((t) => t.disc))];
const albumArtistKey = album.credits.map((c) => c.artist_id).join();
const totalMs = tracks.reduce((sum, t) => sum + (t.length_ms ?? 0), 0);
const released = formatPartialDate(album.first_release_date, album.date_precision);

const byRole = new Map<string, Contributor[]>();
for (const person of people) {
  byRole.set(person.role, [...(byRole.get(person.role) ?? []), person]);
}

const here = Astro.url.pathname + Astro.url.search;
const rateHref = (type: string, entityId: string) =>
  `/edit/rate/${type}/${entityId}?return_to=${encodeURIComponent(here)}`;
const artistNames = album.credits.map((c) => c.name).join(', ');
---

<Base
  title={`${album.title} by ${artistNames}`}
  description={[
    `${typeLabel(album.type)}${yearOf(album.first_release_date) ? `, ${yearOf(album.first_release_date)}` : ''}.`,
    album.quality_score != null ? `Rated ${Math.round(album.quality_score)} out of 100.` : null,
    album.impact_note ? `“${album.impact_note}”` : null,
  ]
    .filter(Boolean)
    .join(' ')}
  image={album.art_key ? `/${album.art_key}/1200.jpg` : null}
>
  <article class="wrap album">
    <Backdrop artKey={album.art_key} />
    <header class="hero">
      <div class="art">
        <CoverArt
          artKey={album.art_key}
          title={album.title}
          alt={`Cover of ${album.title}`}
          sizes="(min-width: 48rem) 20rem, calc(100vw - 32px)"
          priority
        />
      </div>

      <div class="intro">
        <p class="eyebrow">
          {typeLabel(album.type)}
          {yearOf(album.first_release_date) && <> · <time datetime={album.first_release_date!}>{yearOf(album.first_release_date)}</time></>}
          {album.status !== 'released' && <> · {album.status === 'announced' ? 'Announced' : 'Cancelled'}</>}
        </p>
        <h1>{album.title}</h1>
        <p class="by"><CreditLine credits={album.credits} /></p>

        <ScorePanel
          quality={album.quality_score}
          personal={album.personal_score}
          ratedTracks={album.rated_track_count}
          trackCount={album.track_count}
          rating={albumRating}
          rateHref={user ? rateHref('release_group', album.id) : null}
        />

        {
          album.impact_note && (
            <figure class="impact-note">
              <blockquote>
                <p>{album.impact_note}</p>
              </blockquote>
              <figcaption>Why it matters</figcaption>
            </figure>
          )
        }

        {
          genres.length > 0 && (
            <ul class="genres" aria-label="Genres">
              {genres.map((genre) => <li>{genre.name}</li>)}
            </ul>
          )
        }

        <p class="listen">
          <a class="button" href={listenHref} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="9" />
              <path d="M7.5 10c3-1 6.3-.7 9 .8M8.2 13.2c2.4-.7 5-.5 7.2.6M8.8 16.2c1.8-.4 3.6-.3 5.3.4" />
            </svg>
            {albumSpotifyId ? 'Listen on Spotify' : 'Find on Spotify'}
            <span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        </p>
      </div>
    </header>

    <section class="tracks" aria-labelledby="tracklist-heading">
      <h2 id="tracklist-heading">Tracklist</h2>

      {
        allEditions.length > 1 && (
          <nav class="edition-switch" aria-label="Choose edition">
            <ul role="list">
              {allEditions.map((edition) => (
                <li>
                  <a href={editionHref(edition)} aria-current={edition.id === releaseId ? 'true' : undefined}>
                    <span class="switch-label">{editionLabel(edition)}</span>
                    <span class="switch-detail">
                      {edition.track_count} tracks{edition.id === standardId && ' · standard'}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }

      {
        shown && !isStandard && (
          <p class="edition-note">{editionNote}</p>
        )
      }

      {
        tracks.length === 0 ? (
          <p class="muted">No tracklist yet.</p>
        ) : (
          discs.map((disc) => (
            <Fragment>
              {discs.length > 1 && <h3 class="disc">Disc {disc}</h3>}
              <ol class="tracklist" role="list">
                {tracks
                  .filter((track) => track.disc === disc)
                  .map((track) => (
                    <li class="track">
                      <span class="position tabular" aria-hidden="true">{track.position}</span>
                      <div class="title">
                        <span class="name">
                          <span class="visually-hidden">Track {track.position}: </span>
                          {track.title}
                          {isBonus(track.recording_id) && <span class="tag">Bonus</span>}
                        </span>
                        {track.credits.map((c) => c.artist_id).join() !== albumArtistKey && (
                          <span class="track-artist">
                            <CreditLine credits={track.credits} />
                          </span>
                        )}
                        {plays.has(track.recording_id) && (
                          <span class="plays tabular">
                            {plays.get(track.recording_id)} {plays.get(track.recording_id) === 1 ? 'play' : 'plays'}
                          </span>
                        )}
                      </div>
                      <span class="length tabular">
                        {track.length_ms != null && (
                          <>
                            <span aria-hidden="true">{formatDuration(track.length_ms)}</span>
                            <span class="visually-hidden">{describeDuration(track.length_ms)}</span>
                          </>
                        )}
                      </span>
                      <span class="track-score">
                        <Score quality={track.quality_score} personal={track.personal_score} size="s" quietWhenEmpty />
                      </span>
                      {user && (
                        <a class="rate" href={rateHref('recording', track.recording_id)} title={`Rate ${track.title}`}>
                          <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z" />
                          </svg>
                          <span class="visually-hidden">Rate {track.title}</span>
                        </a>
                      )}
                    </li>
                  ))}
              </ol>
            </Fragment>
          ))
        )
      }

      {
        totalMs > 0 && (
          <p class="total muted">
            {tracks.length} tracks · {formatDuration(totalMs)}
            {totalPlays > 0 && ` · you have played these ${totalPlays.toLocaleString('en-GB')} times`}
          </p>
        )
      }
    </section>

    <div class="aside">
    {
      byRole.size > 0 && (
        <section class="credits" aria-labelledby="credits-heading">
          <h2 id="credits-heading">Credits</h2>
          <dl>
            {[...byRole].map(([role, list]) => (
              <div>
                <dt>{roleLabel(role, list.length)}</dt>
                <dd>
                  {list.map((person, i) => (
                    <Fragment>
                      <a href={`/artist/${person.artist_id}`}>{person.name}</a>
                      {i < list.length - 1 && ', '}
                    </Fragment>
                  ))}
                </dd>
              </div>
            ))}
          </dl>
        </section>
      )
    }

    <section class="editions" aria-labelledby="editions-heading">
      <h2 id="editions-heading">{allEditions.length === 1 ? 'Edition' : 'Editions'}</h2>
      {holdingError && <p class="holding-error" role="alert">{holdingError}</p>}
      {
        allEditions.length === 0 ? (
          <p class="muted">No editions yet{album.status === 'announced' ? ': this album is announced' : ''}.</p>
        ) : (
          <ul role="list">
            {allEditions.map((edition) => (
              <li>
                <a
                  class="edition-title"
                  href={editionHref(edition)}
                  aria-current={edition.id === releaseId ? 'true' : undefined}
                >
                  {edition.title}
                </a>
                <span class="muted">
                  {[
                    edition.id === standardId && allEditions.length > 1 ? 'Standard' : null,
                    `${edition.track_count} tracks`,
                    formatPartialDate(edition.date, edition.date_precision),
                    edition.country,
                    edition.label,
                    edition.format,
                  ]
                    .filter(Boolean)
                    .join(' · ')}
                </span>
                {holdings
                  .filter((h) => h.release_id === edition.id)
                  .map((h) => (
                    <form class="held" method="post" action="/api/write/holding">
                      <span>
                        <strong>{OWNED_PHRASE[h.format]}</strong>
                        {h.acquired_at && <span class="muted"> · since {formatPartialDate(h.acquired_at, h.date_precision as never)}</span>}
                        {h.notes && <span class="muted"> · {h.notes}</span>}
                      </span>
                      <input type="hidden" name="intent" value="remove" />
                      <input type="hidden" name="id" value={h.id} />
                      <button class="button button--quiet small" type="submit">
                        Remove<span class="visually-hidden"> {FORMAT_LABELS[h.format]} copy of {edition.title}</span>
                      </button>
                    </form>
                  ))}
                {user && (
                  <details class="own">
                    <summary>I own this edition</summary>
                    <form method="post" action="/api/write/holding" class="own-form">
                      <input type="hidden" name="release_id" value={edition.id} />
                      <input type="hidden" name="album_id" value={album.id} />
                      <div class="field">
                        <label for={`format-${edition.id}`}>Format</label>
                        <select class="input" id={`format-${edition.id}`} name="format">
                          {HOLDING_FORMATS.map((f) => <option value={f}>{FORMAT_LABELS[f]}</option>)}
                        </select>
                      </div>
                      <div class="field">
                        <label for={`acquired-${edition.id}`}>Since <span class="muted">(optional)</span></label>
                        <input class="input" id={`acquired-${edition.id}`} name="acquired" placeholder="2019 or 2019-06" autocomplete="off" />
                      </div>
                      <div class="field wide">
                        <label for={`notes-${edition.id}`}>Notes <span class="muted">(optional)</span></label>
                        <input class="input" id={`notes-${edition.id}`} name="notes" maxlength="300" placeholder="Signed, first pressing…" autocomplete="off" />
                      </div>
                      <button class="button" type="submit">Add to collection</button>
                    </form>
                  </details>
                )}
              </li>
            ))}
          </ul>
        )
      }
      {
        user && album.mbid && (
          <p class="muted">
            More editions are on MusicBrainz. Paste a release link into{' '}
            <a href="/edit/import">Import</a> to add one here.
          </p>
        )
      }
      {released && <p class="muted">First released {released}.</p>}
      {
        album.mbid && (
          <p>
            <a href={`https://musicbrainz.org/release-group/${album.mbid}`} rel="external">
              View on MusicBrainz
            </a>
          </p>
        )
      }
    </section>
    </div>
  </article>
</Base>

<style>
  /* minmax(0, 1fr): wide children such as the scrolling edition switcher
     must scroll inside the column, not widen the page. */
  .album,
  .aside {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
    align-content: start;
  }

  .hero {
    display: grid;
    gap: var(--space-5);
  }

  .art {
    align-self: start;
    max-width: 24rem;
    border-radius: var(--radius-m);
    box-shadow:
      0 2px 4px rgb(0 0 0 / 0.3),
      0 24px 60px -12px rgb(0 0 0 / 0.55);
  }

  .intro {
    display: grid;
    gap: var(--space-3);
    align-content: end;
  }

  h1 {
    font-size: clamp(2.2rem, 1.4rem + 3.2vw, 4.25rem);
    font-weight: 850;
    letter-spacing: -0.035em;
    line-height: 0.98;
    text-wrap: balance;
  }

  .by {
    font-size: var(--step-1);
    font-weight: 600;
  }

  .listen .button svg {
    width: 1.2rem;
    height: 1.2rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
  }

  .muted {
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .impact-note {
    position: relative;
    margin: var(--space-2) 0 0;
    padding-left: var(--space-6);
    max-width: 36rem;
  }

  .impact-note::before {
    content: '“';
    position: absolute;
    top: -0.35em;
    left: 0;
    color: var(--accent);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 3.5rem;
    line-height: 1;
  }

  .impact-note blockquote {
    margin: 0;
    font-size: var(--step-1);
    font-style: italic;
    line-height: 1.4;
    text-wrap: pretty;
  }

  .impact-note figcaption {
    margin-top: var(--space-1);
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .genres {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .genres li {
    padding: 0.2rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  h2 {
    font-size: var(--step-1);
    margin-bottom: var(--space-4);
  }

  .disc {
    font-size: var(--step--1);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: var(--space-5) 0 var(--space-2);
  }

  .tracklist {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }

  .track {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr) auto auto;
    align-items: center;
    column-gap: var(--space-3);
    min-height: 3.5rem;
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--border);
  }

  .track:has(.rate) {
    grid-template-columns: 1.75rem minmax(0, 1fr) auto auto auto;
  }

  .position {
    color: var(--text-subtle);
    text-align: right;
  }

  .title {
    display: grid;
    min-width: 0;
  }

  .name {
    font-weight: 550;
  }

  .track-artist {
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .length {
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .track-score {
    min-width: 2.25rem;
    text-align: right;
  }

  .rate {
    display: inline-grid;
    place-items: center;
    width: var(--target);
    height: var(--target);
    border-radius: 999px;
    color: var(--text-subtle);
    text-decoration: none;
    transition: color 0.15s, background-color 0.15s;
  }

  .rate svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linejoin: round;
  }

  .rate:hover,
  .rate:focus-visible {
    background: var(--surface-2);
    color: var(--accent);
  }

  /* Where hovering is possible, the star waits until the row is pointed at. */
  @media (hover: hover) {
    .track .rate {
      opacity: 0.35;
    }

    .track:hover .rate,
    .track .rate:focus-visible {
      opacity: 1;
    }
  }

  .track {
    transition: background-color 0.15s;
  }

  .track:hover {
    background: color-mix(in srgb, var(--surface-1) 70%, transparent);
  }

  .total {
    margin-top: var(--space-3);
  }

  .credits dl {
    display: grid;
    gap: var(--space-3);
    margin: 0;
  }

  .credits dt {
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .credits dd {
    margin: 0;
  }

  .editions ul {
    display: grid;
    gap: var(--space-3);
    margin: 0 0 var(--space-4);
    padding: 0;
    list-style: none;
  }

  .editions li {
    display: grid;
  }

  .plays {
    color: var(--text-subtle);
    font-size: var(--step--1);
  }

  .held {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-top: var(--space-1);
    padding: var(--space-1) var(--space-1) var(--space-1) var(--space-3);
    border-left: 3px solid var(--accent);
    font-size: var(--step--1);
  }

  .small {
    padding: 0 var(--space-3);
    font-size: var(--step--1);
  }

  .own summary {
    display: inline-flex;
    align-items: center;
    min-height: var(--target);
    color: var(--text-muted);
    font-size: var(--step--1);
    cursor: pointer;
  }

  /* inline-flex drops the native marker; this one is skipped by screen readers. */
  .own summary::before {
    content: '+' / '';
    margin-right: var(--space-2);
    font-weight: 700;
  }

  .own[open] summary::before {
    content: '−' / '';
  }

  .own-form {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    align-items: end;
    gap: var(--space-3);
    padding: var(--space-3) 0 var(--space-2);
  }

  .own-form .wide {
    grid-column: 1 / -1;
  }

  .own-form .button {
    justify-self: start;
  }

  .holding-error {
    color: var(--danger);
  }

  .edition-title[aria-current] {
    font-weight: 700;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
  }

  /* Edition switcher: a row of pills that scrolls sideways on a phone
     rather than wrapping into a tall block above the tracks. */
  .edition-switch {
    margin: 0 calc(var(--gutter) * -1) var(--space-4);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .edition-switch ul {
    display: flex;
    gap: var(--space-2);
    margin: 0;
    padding: 2px var(--gutter);
    list-style: none;
    width: max-content;
  }

  .edition-switch a {
    display: grid;
    min-height: var(--target);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-m);
    text-decoration: none;
    line-height: 1.25;
  }

  .edition-switch a:hover {
    border-color: var(--text-subtle);
  }

  .edition-switch a[aria-current] {
    border-color: var(--accent);
    background: var(--surface-2);
  }

  .switch-label {
    font-weight: 650;
    font-size: var(--step--1);
  }

  .switch-detail {
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .edition-note {
    margin-bottom: var(--space-4);
