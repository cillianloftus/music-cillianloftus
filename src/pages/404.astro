---
import Base from '../layouts/Base.astro';

Astro.response.status = 404;
---

<Base title="Not found">
  <div class="wrap">
    <h1>Not found</h1>
    <p>There is nothing at this address. It may have been merged into another entry.</p>
    <p><a href="/">Back to albums</a></p>
  </div>
</Base>

<style>
  .wrap {
    display: grid;
    gap: var(--space-4);
  }

  h1 {
    font-size: var(--step-2);
  }
</style>
