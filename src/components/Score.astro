---
/**
 * A score: quality, 0 to 100, coloured on the red-to-green scale. Impact is
 * not added to the number (it mostly lands on favourites that are already
 * near the top, so a sum crowds everything past 100); it shows as its own
 * mark, a ✦ that is stronger the more something mattered. Read aloud with
 * both.
 */
import { scoreTone } from '../lib/format';

interface Props {
  quality?: number | null | undefined;
  personal?: number | null | undefined;
  size?: 's' | 'm' | 'l';
  /** Show nothing (to the eye) when unrated: in long lists a dash on every row is noise. */
  quietWhenEmpty?: boolean;
  /**
   * In a ranked list, write the impact beside the mark: favourites cap at
   * 100, and the number after the ✦ is what tells them apart (and what
   * ranks them).
   */
  ranked?: boolean;
}

const { quality, personal, size = 'm', quietWhenEmpty = false, ranked = false } = Astro.props;
const rounded = quality == null ? null : Math.round(quality);
const impact = quality != null && personal != null ? Math.round(personal - quality) : 0;
/** 1 to 3: how strongly the mark shows. */
const level = impact <= 0 ? 0 : impact <= 4 ? 1 : impact <= 7 ? 2 : 3;
const label =
  rounded == null ? 'Not rated' : `Score ${rounded} out of 100${impact > 0 ? `, and an impact of ${impact} out of 10` : ''}`;
const tone = rounded == null ? null : scoreTone(rounded);
---

{
  rounded == null ? (
    <span class:list={['score', `score--${size}`, 'score--none', { 'score--ranked': ranked }]}>
      {!quietWhenEmpty && <span aria-hidden="true">–</span>}
      <span class="visually-hidden">{label}</span>
    </span>
  ) : (
    <span class:list={['score', `score--${size}`, { 'score--ranked': ranked }]}>
      <span aria-hidden="true" class={`tabular ${tone!.className}`} style={tone!.style}>
        {rounded}
      </span>
      {level > 0 && (
        <span class="mark" data-level={level} aria-hidden="true" title={`Impact ${impact} of 10`}>
          ✦{ranked && <span class="impact tabular">{impact}</span>}
        </span>
      )}
      <span class="visually-hidden">{label}</span>
    </span>
  )
}

<style>
  /* The mark hangs in reserved space to the right, so numbers line up
     with each other whether or not they carry one. */
  .score {
    position: relative;
    padding-right: 0.55em;
    display: inline-flex;
    align-items: baseline;
    gap: 0.2em;
    font-weight: 750;
    line-height: 1;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  /* Room for "✦10" in every row, so numbers still line up. */
  .score--ranked {
    padding-right: 1.5em;
  }

  .impact {
    margin-left: 0.1em;
    font-size: 0.95em;
    font-weight: 700;
    letter-spacing: 0;
  }

  .score--s {
    font-size: var(--step-0);
  }

  .score--m {
    font-size: var(--step-1);
  }

  .score--l {
    font-size: var(--step-3);
  }

  .score--none {
    color: var(--text-subtle);
    font-weight: 500;
  }

  /* Impact: a mark beside the number, stronger the more it mattered. */
  .mark {
    position: absolute;
    top: 0;
    right: 0;
    color: var(--accent);
    font-size: 0.62em;
    line-height: 1;
    transform: translateY(-0.2em);
  }

  .mark[data-level='1'] {
    opacity: 0.45;
  }

  .mark[data-level='2'] {
    opacity: 0.75;
  }

  .mark[data-level='3'] {
    text-shadow: 0 0 0.6em color-mix(in srgb, var(--accent) 60%, transparent);
  }
</style>
