---
/**
 * A score: quality, 0 to 100, coloured on the red-to-green scale. Impact is
 * not added to the number (it mostly lands on favourites that are already
 * near the top, so a sum crowds everything past 100); it shows as its own
 * mark, a ✦ that is stronger the more something mattered. Read aloud with
 * both.
 */
import { scoreTone } from '../lib/format';

interface Props {
  quality?: number | null | undefined;
  personal?: number | null | undefined;
  size?: 's' | 'm' | 'l';
  /** Show nothing (to the eye) when unrated: in long lists a dash on every row is noise. */
  quietWhenEmpty?: boolean;
  /**
   * In a ranked list, write the impact beside the mark: favourites cap at
   * 100, and the number after the ✦ is what tells them apart (and what
   * ranks them).
   */
  ranked?: boolean;
  /**
   * An album not fully rated: a small ring, filled as far as it is rated,
   * so a lower place in a ranking is no surprise (albums rank by how
   * complete their rating is, album-scores.ts).
   */
  completeness?: { rated: number; of: number } | null | undefined;
}

const { quality, personal, size = 'm', quietWhenEmpty = false, ranked = false, completeness = null } = Astro.props;
const partial = completeness && completeness.rated < completeness.of ? completeness : null;
// The ring's filled arc, on a circle of circumference 100.
const filled = partial ? Math.max(4, Math.round((partial.rated / partial.of) * 100)) : 0;
const rounded = quality == null ? null : Math.round(quality);
const impact = quality != null && personal != null ? Math.round(personal - quality) : 0;
/** 1 to 3: how strongly the mark shows. */
const level = impact <= 0 ? 0 : impact <= 4 ? 1 : impact <= 7 ? 2 : 3;
const label =
  rounded == null
    ? 'Not rated'
    : `Score ${rounded} out of 100${impact > 0 ? `, and an impact of ${impact} out of 10` : ''}${partial ? (partial.rated ? `, from ${partial.rated} of ${partial.of} tracks rated` : `, rated as a whole, none of its ${partial.of} tracks yet`) : ''}`;
const tone = rounded == null ? null : scoreTone(rounded);
---

{
  rounded == null ? (
    <span class:list={['score', `score--${size}`, 'score--none', { 'score--ranked': ranked }]}>
      {!quietWhenEmpty && <span aria-hidden="true">–</span>}
      <span class="visually-hidden">{label}</span>
    </span>
  ) : (
    <span class:list={['score', `score--${size}`, { 'score--ranked': ranked }]}>
      <span aria-hidden="true" class={`tabular ${tone!.className}`} style={tone!.style}>
        {rounded}
      </span>
      {level > 0 && (
        <span class="mark" data-level={level} aria-hidden="true" title={`Impact ${impact} of 10`}>
          ✦{ranked && <span class="impact tabular">{impact}</span>}
        </span>
      )}
      {partial && (
        <svg class="partial" viewBox="0 0 36 36" aria-hidden="true">
          <title>{partial.rated ? `${partial.rated} of ${partial.of} tracks rated` : `Rated as a whole; none of its ${partial.of} tracks yet`}</title>
          <circle class="partial-track" cx="18" cy="18" r="15.9155" />
          <circle class="partial-fill" cx="18" cy="18" r="15.9155" stroke-dasharray={`${filled} 100`} />
        </svg>
      )}
      <span class="visually-hidden">{label}</span>
    </span>
  )
}

<style>
  /* The mark hangs in reserved space to the right, so numbers line up
     with each other whether or not they carry one. */
  .score {
    position: relative;
    padding-right: 0.55em;
    display: inline-flex;
    align-items: baseline;
    gap: 0.2em;
    font-weight: 750;
    line-height: 1;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  /* Room for "✦10" in every row, so numbers still line up. */
  .score--ranked {
    padding-right: 1.5em;
  }

  .impact {
    margin-left: 0.1em;
    font-size: 0.95em;
    font-weight: 700;
    letter-spacing: 0;
  }

  .score--s {
    font-size: var(--step-0);
  }

  .score--m {
    font-size: var(--step-1);
  }

  .score--l {
    font-size: var(--step-3);
  }

  .score--none {
    color: var(--text-subtle);
    font-weight: 500;
  }

  /* Impact: a mark beside the number, stronger the more it mattered. */
  .mark {
    position: absolute;
    top: 0;
    right: 0;
    color: var(--accent);
    font-size: 0.62em;
    line-height: 1;
    transform: translateY(-0.2em);
  }

  .mark[data-level='1'] {
    opacity: 0.45;
  }

  .mark[data-level='2'] {
    opacity: 0.75;
  }

  /* Not fully rated: a small ring low in the same reserved space, filled
     as far as the album is rated. Quiet: a cue, not a warning. */
  .partial {
    position: absolute;
    right: -0.05em;
    bottom: -0.05em;
    width: 0.58em;
    height: 0.58em;
    rotate: -90deg;
  }

  .partial circle {
    fill: none;
    stroke-width: 6;
  }

  .partial-track {
    stroke: color-mix(in srgb, var(--text-subtle) 35%, transparent);
  }

  .partial-fill {
    stroke: var(--text-subtle);
    stroke-linecap: round;
  }

  .mark[data-level='3'] {
    text-shadow: 0 0 0.6em color-mix(in srgb, var(--accent) 60%, transparent);
  }
</style>
