---
/**
 * A list of short values (genres) edited as chips: each one a removable
 * tag, with a box that suggests from what already exists and adds on
 * Enter, comma or picking a suggestion. Backspace in an empty box takes
 * the last chip off.
 *
 * The suggestions are its own list (an ARIA combobox), not a <datalist>:
 * Chrome on Android draws a datalist as a see-through sheet over the page.
 *
 * Without JavaScript it is the comma-separated text field it enhances,
 * which is also what is submitted either way.
 */

interface Props {
  id: string;
  name: string;
  label: string;
  /** Comma-separated, as submitted. */
  value: string;
  options: string[];
  hint?: string;
  placeholder?: string;
}

const { id, name, label, value, options, hint, placeholder = 'Add one' } = Astro.props;
const hintId = hint ? `${id}-hint` : undefined;
---

<chip-input class="chips" data-placeholder={placeholder}>
  <label for={id}>{label}</label>
  <input class="input raw" id={id} name={name} value={value} list={`${id}-options`} aria-describedby={hintId} autocomplete="off" />
  <datalist id={`${id}-options`}>{options.map((o) => <option value={o} />)}</datalist>
  {hint && <span class="hint" id={hintId}>{hint}</span>}
</chip-input>

<script>
  class ChipInput extends HTMLElement {
    connectedCallback() {
      const raw = this.querySelector<HTMLInputElement>('input.raw');
      const label = this.querySelector('label');
      if (!raw || !label || this.dataset.ready) return;
      this.dataset.ready = '1';

      const values = raw.value
        .split(',')
        .map((v) => v.trim())
        .filter(Boolean);

      // The raw field keeps the name and is what submits; the person types in a new box.
      raw.type = 'hidden';
      raw.removeAttribute('id');
      const box = document.createElement('div');
      box.className = 'box';
      const list = document.createElement('ul');
      list.setAttribute('role', 'list');
      list.className = 'list';
      const entry = document.createElement('input');
      entry.className = 'entry';
      entry.id = label.htmlFor;
      const options = [...this.querySelectorAll('datalist option')].map((o) => (o as HTMLOptionElement).value);
      this.querySelector('datalist')?.remove();
      const listId = `${label.htmlFor}-suggestions`;
      entry.setAttribute('role', 'combobox');
      entry.setAttribute('aria-autocomplete', 'list');
      entry.setAttribute('aria-expanded', 'false');
      entry.setAttribute('aria-controls', listId);
      // Password managers (NordPass and co.) otherwise offer to fill these.
      for (const [k, v] of [['autocomplete', 'off'], ['data-1p-ignore', ''], ['data-lpignore', 'true'], ['data-bwignore', ''], ['data-form-type', 'other']]) entry.setAttribute(k, v);
      entry.placeholder = this.dataset.placeholder ?? '';
      const hint = raw.getAttribute('aria-describedby');
      if (hint) entry.setAttribute('aria-describedby', hint);
      raw.removeAttribute('list');
      box.appendChild(list);
      box.appendChild(entry);
      // The box and its suggestions share a frame, so the list opens just beneath the box.
      const frame = document.createElement('div');
      frame.className = 'frame';
      frame.appendChild(box);
      this.insertBefore(frame, raw);

      const suggest = document.createElement('ul');
      suggest.id = listId;
      suggest.className = 'suggest';
      suggest.setAttribute('role', 'listbox');
      suggest.setAttribute('aria-label', `${label.textContent ?? ''} suggestions`);
      suggest.hidden = true;
      frame.appendChild(suggest);

      const status = document.createElement('span');
      status.className = 'visually-hidden';
      status.setAttribute('role', 'status');
      this.appendChild(status);

      const sync = () => {
        raw.value = values.join(', ');
        list.replaceChildren(
          ...values.map((v, i) => {
            const li = document.createElement('li');
            li.className = 'chip';
            const text = document.createElement('span');
            text.textContent = v;
            const remove = document.createElement('button');
            remove.type = 'button';
            remove.className = 'chip-remove';
            remove.setAttribute('aria-label', `Remove ${v}`);
            remove.textContent = '×';
            remove.addEventListener('click', () => {
              values.splice(i, 1);
              sync();
              status.textContent = `${v} removed.`;
              entry.focus();
            });
            li.appendChild(text);
            li.appendChild(remove);
            return li;
          }),
        );
      };

      const add = (input: string) => {
        for (const part of input.split(',')) {
          const v = part.trim().toLowerCase();
          if (!v || values.some((x) => x.toLowerCase() === v)) continue;
          values.push(v);
          status.textContent = `${v} added.`;
        }
        entry.value = '';
        sync();
      };

      // Matches for what is typed: names starting with it first, then containing it.
      let active = -1;
      const shown = () => [...suggest.querySelectorAll<HTMLLIElement>('[role="option"]')];
      const close = () => {
        suggest.hidden = true;
        entry.setAttribute('aria-expanded', 'false');
        entry.removeAttribute('aria-activedescendant');
        active = -1;
      };
      const highlight = (i: number) => {
        const items = shown();
        active = items.length ? (i + items.length) % items.length : -1;
        items.forEach((li, j) => li.setAttribute('aria-selected', String(j === active)));
        if (active >= 0) {
          entry.setAttribute('aria-activedescendant', items[active]!.id);
          items[active]!.scrollIntoView({ block: 'nearest' });
        }
      };
      const refresh = () => {
        const q = entry.value.trim().toLowerCase();
        if (!q) return close();
        const taken = new Set(values.map((v) => v.toLowerCase()));
        const free = options.filter((o) => !taken.has(o.toLowerCase()));
        const starts = free.filter((o) => o.toLowerCase().startsWith(q));
        const contains = free.filter((o) => !o.toLowerCase().startsWith(q) && o.toLowerCase().includes(q));
        const matches = [...starts, ...contains].slice(0, 8);
        if (!matches.length) return close();
        suggest.replaceChildren(
          ...matches.map((m, i) => {
            const li = document.createElement('li');
            li.id = `${listId}-${i}`;
            li.setAttribute('role', 'option');
            li.setAttribute('aria-selected', 'false');
            li.textContent = m;
            // Pointer down, not click: the box would lose focus first and close the list.
            li.addEventListener('pointerdown', (event) => {
              event.preventDefault();
              add(m);
              close();
              entry.focus();
            });
            return li;
          }),
        );
        suggest.hidden = false;
        entry.setAttribute('aria-expanded', 'true');
        active = -1;
      };
      entry.addEventListener('input', refresh);
      entry.addEventListener('blur', close);

      entry.addEventListener('keydown', (event) => {
        if (!suggest.hidden && (event.key === 'ArrowDown' || event.key === 'ArrowUp')) {
          event.preventDefault();
          highlight(active + (event.key === 'ArrowDown' ? 1 : -1));
          return;
        }
        if (event.key === 'Escape' && !suggest.hidden) {
          event.preventDefault();
          close();
          return;
        }
        if (event.key === 'Enter' && active >= 0) {
          event.preventDefault();
          add(shown()[active]!.textContent ?? '');
          close();
          return;
        }
        if (event.key === 'Enter' || event.key === ',') {
          if (entry.value.trim()) {
            event.preventDefault();
            add(entry.value);
            close();
          } else if (event.key === ',') event.preventDefault();
        } else if (event.key === 'Backspace' && entry.value === '' && values.length) {
          const v = values.pop()!;
          sync();
          status.textContent = `${v} removed.`;
        }
      });
      // Whatever is half-typed counts when the form is saved.
      raw.form?.addEventListener('submit', () => entry.value.trim() && add(entry.value));
      box.addEventListener('click', (event) => event.target === box && entry.focus());
      sync();
    }
  }
  customElements.define('chip-input', ChipInput);
</script>

<style>
  .chips {
    display: grid;
    gap: var(--space-1);
  }

  label {
    font-weight: 600;
  }

  .hint {
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .chips :global(.box) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--target);
    padding: var(--space-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-m);
    background: var(--surface-1);
    cursor: text;
  }

  .chips :global(.box:focus-within) {
    outline: 2px solid var(--focus);
    outline-offset: 1px;
  }

  .chips :global(.list) {
    display: contents;
  }

  .chips :global(.chip) {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding-left: var(--space-3);
    border-radius: 999px;
    background: var(--surface-2);
    font-size: var(--step--1);
    font-weight: 600;
  }

  .chips :global(.chip-remove) {
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--text-muted);
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
  }

  .chips :global(.chip-remove:hover) {
    color: var(--danger);
  }

  .chips :global(.frame) {
    position: relative;
  }

  /* The suggestions: a solid sheet beneath the box, above what follows. */
  .chips :global(.suggest) {
    position: absolute;
    z-index: 20;
    top: calc(100% + var(--space-1));
    inset-inline: 0;
    max-height: 16rem;
    margin: 0;
    padding: var(--space-1);
    overflow-y: auto;
    list-style: none;
    border: 1px solid var(--border);
    border-radius: var(--radius-m);
    background: var(--surface-1);
    box-shadow: 0 10px 28px rgb(0 0 0 / 0.22);
  }

  .chips :global(.suggest[hidden]) {
    display: none;
  }

  .chips :global(.suggest [role='option']) {
    display: flex;
    align-items: center;
    min-height: var(--target);
    padding: 0 var(--space-3);
    border-radius: var(--radius-s);
    cursor: pointer;
  }

  .chips :global(.suggest [role='option']:hover),
  .chips :global(.suggest [aria-selected='true']) {
    background: var(--surface-2);
  }

  .chips :global(.entry) {
    flex: 1 1 8rem;
    min-width: 6rem;
    min-height: 2rem;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    outline: none;
  }
</style>
