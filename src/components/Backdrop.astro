---
/**
 * An ambient wash of colour behind a page's header, taken from cover art.
 *
 * It used to be the cover itself under a 72px blur, which looked right but
 * made scrolling heavy: a full-width filtered, masked layer. Now a script
 * samples a few colours from the smallest stored size (once, on a 3×3
 * canvas) and the wash is plain radial gradients of them, which cost
 * nothing to scroll. Colours are capped per theme so text over the wash
 * keeps its contrast whatever the cover: dark mode keeps them dim, light
 * mode keeps them pale. Without JavaScript there is simply no wash.
 */

interface Props {
  artKey?: string | null | undefined;
  /** Any other image, such as a playlist's generated art. */
  src?: string | null;
  /** How far down the page the wash reaches. */
  height?: string;
}

const { artKey, src, height = '36rem' } = Astro.props;
const image = src ?? (artKey ? `/${artKey}/250.jpg` : null);
---

{image && <div class="backdrop" aria-hidden="true" data-backdrop={image} style={`--backdrop-height: ${height}`}></div>}

<script>
  type RGB = [number, number, number];

  /** Six colours: the top row and middle row of a 3×3 average of the image. */
  function sample(img: HTMLImageElement): RGB[] {
    const canvas = document.createElement('canvas');
    canvas.width = canvas.height = 3;
    const ctx = canvas.getContext('2d', { willReadFrequently: true })!;
    ctx.imageSmoothingQuality = 'high';
    ctx.drawImage(img, 0, 0, 3, 3);
    const d = ctx.getImageData(0, 0, 3, 3).data;
    const at = (i: number): RGB => [d[i * 4]!, d[i * 4 + 1]!, d[i * 4 + 2]!];
    return [0, 1, 2, 3, 4, 5].map(at);
  }

  /** Richer, then held inside the band that keeps text readable on this theme. */
  function tune([r, g, b]: RGB, dark: boolean): RGB {
    const mean = (r + g + b) / 3;
    let c = [r, g, b].map((v) => mean + (v - mean) * 1.35) as RGB;
    const max = Math.max(...c, 1);
    const min = Math.min(...c);
    if (dark) {
      // At most ~100 in the brightest channel: muted text stays above 4.5:1.
      const scale = Math.min(1, 100 / max);
      c = c.map((v) => v * scale) as RGB;
    } else {
      // At least ~175 in the darkest channel: pale enough under dark text.
      const lift = Math.max(0, 175 - min);
      c = c.map((v) => Math.min(255, v + lift)) as RGB;
    }
    return c.map((v) => Math.round(Math.max(0, Math.min(255, v)))) as RGB;
  }

  function paint(el: HTMLElement, colours: RGB[]) {
    const dark = document.documentElement.dataset.theme !== 'light';
    const [tl, tc, tr, ml, mc, mr] = colours.map((c) => tune(c, dark)) as [RGB, RGB, RGB, RGB, RGB, RGB];
    const rgb = (c: RGB, a: number) => `rgb(${c[0]} ${c[1]} ${c[2]} / ${a})`;
    const a = dark ? 0.55 : 0.6;
    el.style.background = [
      `radial-gradient(ellipse 55% 75% at 12% 0%, ${rgb(tl, a)}, transparent 70%)`,
      `radial-gradient(ellipse 45% 70% at 50% 0%, ${rgb(tc, a * 0.8)}, transparent 70%)`,
      `radial-gradient(ellipse 55% 75% at 88% 0%, ${rgb(tr, a)}, transparent 70%)`,
      `radial-gradient(ellipse 50% 60% at 25% 55%, ${rgb(ml, a * 0.55)}, transparent 70%)`,
      `radial-gradient(ellipse 50% 60% at 75% 55%, ${rgb(mr, a * 0.55)}, transparent 70%)`,
      `radial-gradient(ellipse 70% 60% at 50% 35%, ${rgb(mc, a * 0.4)}, transparent 75%)`,
    ].join(', ');
  }

  const stored = (src: string): RGB[] | null => {
    try {
      const value = sessionStorage.getItem(`backdrop:${src}`);
      return value ? (JSON.parse(value) as RGB[]) : null;
    } catch {
      return null;
    }
  };

  for (const el of document.querySelectorAll<HTMLElement>('[data-backdrop]')) {
    const src = el.dataset.backdrop!;
    const known = stored(src);
    if (known) {
      paint(el, known);
      continue;
    }
    const img = new Image();
    img.decoding = 'async';
    img.src = src;
    img
      .decode()
      .then(() => {
        const colours = sample(img);
        try {
          sessionStorage.setItem(`backdrop:${src}`, JSON.stringify(colours));
        } catch {
          /* storage unavailable: sampled again next time */
        }
        paint(el, colours);
      })
      .catch(() => {});
  }
</script>

<style>
  /* Starts above the page, behind the sticky header, so the frosted
     header shows the colour through it instead of a pale band. */
  .backdrop {
    position: absolute;
    inset: calc(-1 * (var(--header-height) + 1px)) 0 auto;
    z-index: -1;
    height: calc(var(--backdrop-height) + var(--header-height) + 1px);
    max-width: none;
    /* Absolutely placed: no margin from the stack it sits in, or a pale
       strip shows above it. */
    margin: 0;
    pointer-events: none;
    /* Fades into the page rather than ending in an edge. Gradients only:
       nothing here needs filtering, so scrolling stays cheap. */
    mask-image: linear-gradient(to bottom, black 40%, transparent);
  }

  @media (prefers-reduced-transparency: reduce) {
    .backdrop {
      display: none;
    }
  }
</style>
