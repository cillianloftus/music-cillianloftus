---
import type { Theme } from '../lib/theme';

interface Props {
  theme: Theme;
}

const { theme } = Astro.props;
const user = Astro.locals.user;
const path = Astro.url.pathname;

const links = [
  { href: '/insights', label: 'Insights' },
  { href: '/diary', label: 'Diary' },
  { href: '/artists', label: 'Artists' },
  { href: '/albums', label: 'Albums' },
  { href: '/genres', label: 'Genres' },
  { href: '/playlists', label: 'Playlists' },
];

const under = (href: string) => path === href || path.startsWith(`${href}/`);

/*
 * Phones: a floating bar of five real places, in thumb reach, and no
 * header. Library holds the browsable sections (a strip of them across
 * the top of each section's page) and reopens the one last visited.
 */
const LIBRARY = [
  { href: '/artists', label: 'Artists', owns: '/artist' },
  { href: '/albums', label: 'Albums', owns: '/album' },
  { href: '/genres', label: 'Genres', owns: '/genre' },
  { href: '/playlists', label: 'Playlists', owns: '/playlist' },
  { href: '/diary', label: 'Diary', owns: '/year' },
];
const section = LIBRARY.find((s) => under(s.href) || under(s.owns));
const inLibrary = Boolean(section) || under('/track');
const onSectionPage = LIBRARY.some((s) => path === s.href);
const inYou = under('/manage') || under('/edit') || path === '/queue' || path === '/query';

// 24px grid, drawn as strokes.
const ICONS = {
  home: 'M4 10.5 12 4l8 6.5V19a1 1 0 0 1-1 1h-4.5v-5.5h-5V20H5a1 1 0 0 1-1-1z',
  library: 'M5 4.5v15 M9.5 4.5v15 M14 5.2l4.6 14.3',
  search: 'M10.5 17a6.5 6.5 0 1 0 0-13 6.5 6.5 0 0 0 0 13z M15.3 15.3 20 20',
  insights: 'M5 19.5v-5 M10 19.5v-9 M15 19.5v-6 M20 19.5V5',
  signin: 'M12 11.5a4 4 0 1 0 0-8 4 4 0 0 0 0 8z M4.5 20.5a7.5 7.5 0 0 1 15 0',
};
const initial = (user?.display_name || user?.email || '?').trim().charAt(0).toUpperCase();
const tabs = [
  { href: '/', label: 'Home', icon: ICONS.home, current: path === '/' },
  { href: section?.href ?? '/artists', label: 'Library', icon: ICONS.library, current: inLibrary, library: true },
  { href: '/search', label: 'Search', icon: ICONS.search, current: path === '/search', search: true },
  { href: '/insights', label: 'Insights', icon: ICONS.insights, current: under('/insights') },
];

// Cillian's own tools, in one menu.
const tools = user
  ? [
      { href: '/now', label: 'Now playing' },
      { href: '/queue', label: 'Rating queue' },
      { href: '/manage/import', label: 'Import' },
      { href: '/manage', label: 'Manage' },
    ]
  : [];
const inTools = tools.some((t) => (t.href === '/manage' ? inYou : path === t.href));

// Detail pages belong to their section: an artist to Artists, a playlist to Playlists.
const isCurrent = (href: string) => under(href) || (section?.href === href);
const next = theme === 'dark' ? 'light' : 'dark';
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/">music<span class="visually-hidden">, home</span></a>

    <nav class="wide" aria-label="Main">
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a
      class="icon-button search-link"
      href="/search"
      aria-label="Search"
      aria-keyshortcuts="/"
      title="Search (/)"
      aria-current={path === '/search' ? 'page' : undefined}
    >
      <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="10.5" cy="10.5" r="6"></circle>
        <path d="M15 15l5 5"></path>
      </svg>
    </a>

    {!user && <a class="sign-in" href="/manage">Sign in</a>}

    {
      tools.length > 0 && (
        <details class="you" data-you data-menu>
          <summary class="icon-button" aria-label="Your tools" title="Your tools" data-current={inTools ? 'true' : undefined}>
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
              <rect x="4" y="4" width="6.5" height="6.5" rx="1.5"></rect>
              <rect x="13.5" y="4" width="6.5" height="6.5" rx="1.5"></rect>
              <rect x="4" y="13.5" width="6.5" height="6.5" rx="1.5"></rect>
              <rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1.5"></rect>
            </svg>
          </summary>
          <ul class="you-menu" role="list">
            {tools.map((t) => (
              <li>
                <a href={t.href} aria-current={path === t.href ? 'page' : undefined}>
                  {t.label}
                </a>
              </li>
            ))}
          </ul>
        </details>
      )
    }

    <form class="theme" method="post" action="/api/theme" data-theme-toggle>
      <input type="hidden" name="theme" value={next} />
      <input type="hidden" name="return_to" value={Astro.url.pathname + Astro.url.search} />
      <button type="submit" aria-label={`Switch to ${next} mode`} title={`Switch to ${next} mode`}>
        <svg class="icon icon-sun" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4.5"></circle>
          <path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"></path>
        </svg>
        <svg class="icon icon-moon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5a8.5 8.5 0 1 0 10.7 10.7Z"></path>
        </svg>
      </button>
    </form>
  </div>
</header>

<nav class="tabbar" aria-label="Main" data-library-here={section?.href}>
  <ul>
    {
      tabs.map((tab) => (
        <li>
          <a
            href={tab.href}
            class:list={[{ 'search-link': tab.search }]}
            aria-current={tab.current ? 'page' : undefined}
            data-library-tab={tab.library ? '' : undefined}
          >
            <span class="glyph">
              <svg class="tab-icon" viewBox="0 0 24 24" aria-hidden="true"><path d={tab.icon}></path></svg>
            </span>
            <span class="tab-label">{tab.label}</span>
          </a>
        </li>
      ))
    }
    <li>
      <a href="/manage" aria-current={inYou ? 'page' : undefined}>
        <span class="glyph">
          {
            user ? (
              <span class="avatar" aria-hidden="true">{initial}</span>
            ) : (
              <svg class="tab-icon" viewBox="0 0 24 24" aria-hidden="true"><path d={ICONS.signin}></path></svg>
            )
          }
        </span>
        <span class="tab-label">{user ? 'You' : 'Sign in'}</span>
      </a>
    </li>
  </ul>
</nav>

{
  onSectionPage && (
    <nav class="library" aria-label="Library">
      <ul role="list">
        {LIBRARY.map((s) => (
          <li>
            <a href={s.href} aria-current={path === s.href ? 'page' : undefined}>
              {s.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<script>
  // Library reopens the section last visited.
  try {
    const here = document.querySelector<HTMLElement>('[data-library-here]')?.dataset.libraryHere;
    if (here) localStorage.setItem('library-section', here);
    const last = localStorage.getItem('library-section');
    const tab = document.querySelector<HTMLAnchorElement>('[data-library-tab]');
    if (tab && last?.startsWith('/') && !here) tab.href = last;
  } catch {}

  // A tab answers the moment it is touched, as an app's would: it shows as
  // the current one at once, while the page it leads to is on its way.
  const drawnCurrent = document.querySelector('.tabbar a[aria-current]');
  const markCurrent = (link: Element | null) => {
    for (const other of document.querySelectorAll('.tabbar a[aria-current]')) other.removeAttribute('aria-current');
    link?.setAttribute('aria-current', 'page');
  };
  for (const link of document.querySelectorAll<HTMLAnchorElement>('.tabbar a:not(.search-link)')) {
    link.addEventListener('click', (event) => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.defaultPrevented) return;
      markCurrent(link);
    });
  }
  // Coming back to this page by Back: the tabs as this page drew them.
  addEventListener('pageshow', (event) => {
    if (event.persisted) markCurrent(drawnCurrent);
  });

  // Progressive enhancement: without JS the form posts and reloads.
  const form = document.querySelector<HTMLFormElement>('[data-theme-toggle]');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const root = document.documentElement;
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    document.cookie = `theme=${next}; Path=/; Max-Age=31536000; SameSite=Lax; Secure`;
    document.querySelector('meta[name="theme-color"]')?.setAttribute(
      'content',
      next === 'light' ? '#f6f3ec' : '#0e0e10',
    );
    const after = next === 'dark' ? 'light' : 'dark';
    const button = form.querySelector('button')!;
    button.setAttribute('aria-label', `Switch to ${after} mode`);
    button.title = `Switch to ${after} mode`;
    form.querySelector<HTMLInputElement>('input[name="theme"]')!.value = after;
  });
</script>

<style>
  /* Stays at the top while the page scrolls under it, frosted so the page
     colour shows through. Blurring one short bar is cheap, unlike blurring
     a whole backdrop; where the filter is missing, or transparency is
     turned down, the bar is solid. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }

  /* The frosting sits on a layer behind the header, never on the header:
     a backdrop-filter makes its element the containing block for fixed
     children, which would pin the phone tab bar inside the header. */
  @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
    .site-header {
      background: none;
    }

    .site-header::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -1;
      background: color-mix(in srgb, var(--bg) 72%, transparent);
      -webkit-backdrop-filter: blur(14px) saturate(1.4);
      backdrop-filter: blur(14px) saturate(1.4);
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .site-header {
      background: var(--bg);
    }

    .site-header::before {
      display: none;
    }
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: var(--header-height);
  }

  .brand {
    font-weight: 800;
    font-size: var(--step-1);
    letter-spacing: -0.03em;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: var(--target);
  }

  .brand::after {
    content: '';
    width: 0.4em;
    height: 0.4em;
    margin-left: 0.12em;
    margin-top: 0.3em;
    border-radius: 50%;
    background: var(--accent);
  }

  .wide {
    margin-left: auto;
  }

  .wide ul {
    display: flex;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .wide a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target);
    padding-inline: var(--space-3);
    border-radius: 999px;
    color: var(--text-muted);
    font-weight: 600;
    text-decoration: none;
  }

  .wide a:hover {
    color: var(--text);
  }

  .wide a[aria-current='page'] {
    color: var(--text);
    background: var(--surface-2);
  }

  .sign-in {
    display: inline-flex;
    align-items: center;
    min-height: var(--target);
    padding-inline: var(--space-3);
    color: var(--text-muted);
    font-weight: 600;
    text-decoration: none;
  }

  .sign-in:hover {
    color: var(--text);
  }

  /* Phones: no header at all; the tab bar does the navigating. */
  .tabbar,
  .library {
    display: none;
  }

  @media (max-width: 39.99rem) {
    .site-header {
      display: none;
    }

    /* Floats clear of the screen edge, frosted so the page shows through
       faintly; solid where blur is missing or transparency turned down. */
    .tabbar {
      display: block;
      position: fixed;
      inset: auto var(--tabbar-inset) calc(var(--tabbar-inset) + env(safe-area-inset-bottom));
      z-index: 45;
      /* Held still while pages cross-fade (global.css). */
      view-transition-name: tabbar;
      border: 1px solid color-mix(in srgb, var(--border) 80%, transparent);
      border-radius: 1.5rem;
      background: var(--surface-1);
      box-shadow:
        0 1px 0 color-mix(in srgb, var(--text) 6%, transparent) inset,
        0 12px 32px -8px rgb(0 0 0 / 0.55);
    }

    @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
      .tabbar {
        background: color-mix(in srgb, var(--surface-1) 80%, transparent);
        -webkit-backdrop-filter: blur(18px) saturate(1.6);
        backdrop-filter: blur(18px) saturate(1.6);
      }
    }

    @media (prefers-reduced-transparency: reduce) {
      .tabbar {
        background: var(--surface-1);
      }
    }

    /* The keyboard is up (Base sets this): the bar stays down at the foot
       of the screen, under the keys, rather than riding up on them. */
    :global(:root[data-keyboard]) .tabbar {
      visibility: hidden;
    }

    /* Keep page content clear of the bar. */
    :global(body) {
      padding-bottom: var(--tabbar-space);
    }

    .library {
      display: block;
      padding-top: var(--space-2);
    }
  }

  .tabbar > ul {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    margin: 0;
    padding: 0 var(--space-1);
    list-style: none;
  }

  .tabbar a {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    min-height: var(--tabbar-height);
    color: var(--text-muted);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  /* The place you are: its icon sits in a soft pill of the accent. */
  .glyph {
    display: grid;
    place-items: center;
    width: 3.4rem;
    height: 2rem;
    border-radius: 999px;
    transition:
      background-color 0.2s ease,
      transform 0.2s ease;
  }

  .tabbar a[aria-current='page'] {
    color: var(--text);
  }

  .tabbar a[aria-current='page'] .glyph {
    background: color-mix(in srgb, var(--accent) 22%, transparent);
    color: var(--accent);
  }

  .tabbar a:active .glyph {
    transform: scale(0.92);
  }

  /* While the search panel is open, Search is where you are. */
  :global(:root[data-searching]) .tabbar a[aria-current='page'] {
    color: var(--text-muted);
  }

  :global(:root[data-searching]) .tabbar a[aria-current='page'] .glyph {
    background: none;
    color: inherit;
  }

  :global(:root[data-searching]) .tabbar .search-link {
    color: var(--text);
  }

  :global(:root[data-searching]) .tabbar .search-link .glyph {
    background: color-mix(in srgb, var(--accent) 22%, transparent);
    color: var(--accent);
  }

  .tab-icon {
    width: 1.5rem;
    height: 1.5rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .avatar {
    display: grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border: 1.8px solid currentColor;
    border-radius: 50%;
    font-size: 0.8rem;
    font-weight: 800;
    line-height: 1;
  }

  /* The Library's sections: a row of tabs across the top of each one,
     quieter than the pills a page uses for its own sorting. */
  .library ul {
    display: flex;
    gap: var(--space-5);
    margin: 0;
    padding: 0 var(--gutter);
    overflow-x: auto;
    scrollbar-width: none;
    list-style: none;
    border-bottom: 1px solid var(--border);
  }

  .library a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: var(--target);
    color: var(--text-muted);
    font-weight: 650;
    text-decoration: none;
    white-space: nowrap;
  }

  .library a[aria-current='page'] {
    color: var(--text);
  }

  .library a[aria-current='page']::after {
    content: '';
    position: absolute;
    inset: auto 0 -1px;
    height: 2px;
    border-radius: 2px;
    background: var(--accent);
  }

  .icon-button,
  .theme button {
    display: grid;
    place-items: center;
    width: var(--target);
    height: var(--target);
    border: 1px solid var(--border);
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
  }

  .icon-button {
    flex: none;
    color: inherit;
  }

  .icon-button[aria-current],
  .icon-button:hover,
  .theme button:hover {
    border-color: var(--text-subtle);
  }

  .icon {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  .icon-moon {
    fill: currentColor;
    stroke: none;
  }

  /* Show the icon for the mode you would switch to. */
  :global([data-theme='dark']) .icon-moon,
  :global([data-theme='light']) .icon-sun {
    display: none;
  }

  .you {
    position: relative;
  }

  .you summary {
    list-style: none;
    cursor: pointer;
  }

  .you summary::-webkit-details-marker {
    display: none;
  }

  .you summary[data-current='true'],
  .you[open] summary {
    background: var(--surface-2);
  }

  .you-menu {
    position: absolute;
    top: calc(100% + var(--space-2));
    right: 0;
    z-index: 50;
    display: grid;
    min-width: 12rem;
    margin: 0;
    padding: var(--space-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-m);
    background: var(--surface-1);
    box-shadow: 0 12px 32px -12px rgb(0 0 0 / 0.35);
    list-style: none;
  }

  .you-menu a {
    display: flex;
    align-items: center;
    min-height: var(--target);
    padding: 0 var(--space-3);
    border-radius: var(--radius-s);
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
  }

  .you-menu a:hover,
  .you-menu a[aria-current='page'] {
    background: var(--surface-2);
  }
</style>
