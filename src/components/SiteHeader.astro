---
import type { Theme } from '../lib/theme';

interface Props {
  theme: Theme;
}

const { theme } = Astro.props;
const user = Astro.locals.user;
const path = Astro.url.pathname;

// Icons are SVG path data on a 24px grid, drawn as strokes.
const links = [
  // Home is the brand on wide screens; on phones the bottom bar needs it.
  { href: '/', label: 'Home', icon: 'M4 11l8-7 8 7v9H4z M10 20v-5h4v5', phoneOnly: true },
  { href: '/diary', label: 'Diary', icon: 'M6 4h11a1 1 0 0 1 1 1v15H7a2 2 0 0 1-2-2V5a1 1 0 0 1 1-1z M5 17a2 2 0 0 1 2-2h11 M9 8h6' },
  { href: '/artists', label: 'Artists', icon: 'M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z M4 21a8 8 0 0 1 16 0' },
  { href: '/genres', label: 'Genres', icon: 'M9 9.5a5 5 0 1 0 0 .01M16.5 16a3.5 3.5 0 1 0 0 .01M17 6.5a2 2 0 1 0 0 .01' },
  { href: '/playlists', label: 'Playlists', icon: 'M4 6h12M4 12h12M4 18h7M18 15v6M15 18h6' },
];

// Cillian's own tools, in one menu.
const tools = user
  ? [
      { href: '/queue', label: 'Rating queue' },
      { href: '/manage/import', label: 'Import' },
      { href: '/insights', label: 'Insights' },
      { href: '/manage', label: 'Manage' },
    ]
  : [];
const inTools = tools.some((t) => (t.href === '/manage' ? path === '/manage' || path.startsWith('/manage/') || path.startsWith('/edit/') : path === t.href));

// The most specific matching link is current, so /queue marks Queue,
// not Manage (/edit).
// Detail pages belong to their section: an album to Albums, a playlist to Playlists.
const SECTION_OF: Record<string, string> = { '/album': '/', '/artist': '/artists', '/playlist': '/playlists' };
const section = Object.entries(SECTION_OF).find(([prefix]) => path.startsWith(`${prefix}/`))?.[1];
const matches = (href: string) =>
  href === section || (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));
const currentHref = links
  .map((link) => link.href)
  .filter(matches)
  .sort((a, b) => b.length - a.length)[0];
const isCurrent = (href: string) => href === currentHref;
const next = theme === 'dark' ? 'light' : 'dark';
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/">music<span class="visually-hidden">, home</span></a>

    <nav aria-label="Main">
      <ul>
        {
          links.map((link) => (
            <li class:list={[{ 'phone-only': link.phoneOnly }]}>
              <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
                <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true">
                  <path d={link.icon}></path>
                </svg>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a
      class="icon-button search-link"
      href="/search"
      aria-label="Search"
      aria-keyshortcuts="/"
      title="Search (/)"
      aria-current={path === '/search' ? 'page' : undefined}
    >
      <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="10.5" cy="10.5" r="6"></circle>
        <path d="M15 15l5 5"></path>
      </svg>
    </a>

    {
      tools.length > 0 && (
        <details class="you" data-you data-menu>
          <summary class="icon-button" aria-label="Your tools" title="Your tools" data-current={inTools ? 'true' : undefined}>
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
              <rect x="4" y="4" width="6.5" height="6.5" rx="1.5"></rect>
              <rect x="13.5" y="4" width="6.5" height="6.5" rx="1.5"></rect>
              <rect x="4" y="13.5" width="6.5" height="6.5" rx="1.5"></rect>
              <rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1.5"></rect>
            </svg>
          </summary>
          <ul class="you-menu" role="list">
            {tools.map((t) => (
              <li>
                <a href={t.href} aria-current={path === t.href ? 'page' : undefined}>
                  {t.label}
                </a>
              </li>
            ))}
          </ul>
        </details>
      )
    }

    <form class="theme" method="post" action="/api/theme" data-theme-toggle>
      <input type="hidden" name="theme" value={next} />
      <input type="hidden" name="return_to" value={Astro.url.pathname + Astro.url.search} />
      <button type="submit" aria-label={`Switch to ${next} mode`} title={`Switch to ${next} mode`}>
        <svg class="icon icon-sun" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4.5"></circle>
          <path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"></path>
        </svg>
        <svg class="icon icon-moon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5a8.5 8.5 0 1 0 10.7 10.7Z"></path>
        </svg>
      </button>
    </form>
  </div>
</header>

<script>
  // "/" goes to search from anywhere, as on most sites with one; on the
  // search page it puts the cursor in the box. Never while typing.
  document.addEventListener('keydown', (event) => {
    if (event.key !== '/' || event.ctrlKey || event.metaKey || event.altKey) return;
    const target = event.target as HTMLElement | null;
    if (target?.closest('input, textarea, select, [contenteditable]')) return;
    event.preventDefault();
    const box = document.querySelector<HTMLInputElement>('input[name="q"]');
    if (box) {
      box.focus();
      box.select();
    } else {
      location.href = '/search';
    }
  });

  // Progressive enhancement: without JS the form posts and reloads.
  const form = document.querySelector<HTMLFormElement>('[data-theme-toggle]');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const root = document.documentElement;
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    document.cookie = `theme=${next}; Path=/; Max-Age=31536000; SameSite=Lax; Secure`;
    document.querySelector('meta[name="theme-color"]')?.setAttribute(
      'content',
      next === 'light' ? '#f6f3ec' : '#0e0e10',
    );
    const after = next === 'dark' ? 'light' : 'dark';
    const button = form.querySelector('button')!;
    button.setAttribute('aria-label', `Switch to ${after} mode`);
    button.title = `Switch to ${after} mode`;
    form.querySelector<HTMLInputElement>('input[name="theme"]')!.value = after;
  });
</script>

<style>
  /* Stays at the top while the page scrolls under it, frosted so the page
     colour shows through. Blurring one short bar is cheap, unlike blurring
     a whole backdrop; where the filter is missing, or transparency is
     turned down, the bar is solid. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }

  /* The frosting sits on a layer behind the header, never on the header:
     a backdrop-filter makes its element the containing block for fixed
     children, which would pin the phone tab bar inside the header. */
  @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
    .site-header {
      background: none;
    }

    .site-header::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -1;
      background: color-mix(in srgb, var(--bg) 72%, transparent);
      -webkit-backdrop-filter: blur(14px) saturate(1.4);
      backdrop-filter: blur(14px) saturate(1.4);
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .site-header {
      background: var(--bg);
    }

    .site-header::before {
      display: none;
    }
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: var(--header-height);
  }

  .brand {
    font-weight: 800;
    font-size: var(--step-1);
    letter-spacing: -0.03em;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: var(--target);
  }

  .brand::after {
    content: '';
    width: 0.4em;
    height: 0.4em;
    margin-left: 0.12em;
    margin-top: 0.3em;
    border-radius: 50%;
    background: var(--accent);
  }

  nav {
    margin-left: auto;
  }

  nav ul {
    display: flex;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target);
    padding-inline: var(--space-3);
    border-radius: 999px;
    color: var(--text-muted);
    font-weight: 600;
    text-decoration: none;
  }

  nav a:hover {
    color: var(--text);
  }

  nav a[aria-current='page'] {
    color: var(--text);
    background: var(--surface-2);
  }

  .nav-icon {
    display: none;
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Phones: the nav becomes a bar along the bottom, in thumb reach, and the
     header keeps only the brand and theme toggle. */
  @media (max-width: 39.99rem) {
    nav {
      position: fixed;
      inset: auto 0 0 0;
      z-index: 20;
      margin: 0;
      padding-bottom: env(safe-area-inset-bottom);
      border-top: 1px solid var(--border);
      background: var(--surface-1);
    }

    nav ul {
      justify-content: space-around;
    }

    nav li {
      flex: 1;
    }

    nav a {
      flex-direction: column;
      justify-content: center;
      gap: 2px;
      width: 100%;
      min-height: 3.5rem;
      padding: 0;
      border-radius: 0;
      font-size: 0.75rem;
    }

    nav a[aria-current='page'] {
      background: none;
      color: var(--accent);
    }

    .nav-icon {
      display: block;
    }

    .search-link {
      margin-left: auto;
    }

    /* Keep page content clear of the bar. */
    :global(body) {
      padding-bottom: calc(3.5rem + env(safe-area-inset-bottom));
    }
  }

  .icon-button,
  .theme button {
    display: grid;
    place-items: center;
    width: var(--target);
    height: var(--target);
    border: 1px solid var(--border);
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
  }

  .icon-button {
    flex: none;
    color: inherit;
  }

  .icon-button[aria-current],
  .icon-button:hover,
  .theme button:hover {
    border-color: var(--text-subtle);
  }

  .icon {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  .icon-moon {
    fill: currentColor;
    stroke: none;
  }

  /* Show the icon for the mode you would switch to. */
  :global([data-theme='dark']) .icon-moon,
  :global([data-theme='light']) .icon-sun {
    display: none;
  }

  /* Home lives in the bottom bar on phones only. */
  .phone-only {
    display: none;
  }

  @media (max-width: 39.99rem) {
    .phone-only {
      display: block;
    }
  }

  .you {
    position: relative;
  }

  .you summary {
    list-style: none;
    cursor: pointer;
  }

  .you summary::-webkit-details-marker {
    display: none;
  }

  .you summary[data-current='true'],
  .you[open] summary {
    background: var(--surface-2);
  }

  .you-menu {
    position: absolute;
    top: calc(100% + var(--space-2));
    right: 0;
    z-index: 50;
    display: grid;
    min-width: 12rem;
    margin: 0;
    padding: var(--space-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-m);
    background: var(--surface-1);
    box-shadow: 0 12px 32px -12px rgb(0 0 0 / 0.35);
    list-style: none;
  }

  .you-menu a {
    display: flex;
    align-items: center;
    min-height: var(--target);
    padding: 0 var(--space-3);
    border-radius: var(--radius-s);
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
  }

  .you-menu a:hover,
  .you-menu a[aria-current='page'] {
    background: var(--surface-2);
  }
</style>
