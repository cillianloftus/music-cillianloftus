---
/**
 * The row of actions under a track's or album's title: Listen (on Spotify,
 * or a search there), Edit for the owner, and the thing's pages elsewhere
 * as small round icons, so they are at hand without a row of their own.
 * Shared by track and album pages: change it here, both follow.
 */
import ElsewhereLink from './ElsewhereLink.astro';
import ListenButton from './ListenButton.astro';

interface Props {
  /** Where Listen goes: the Spotify page, or a Spotify search. */
  listenHref: string;
  /** The Spotify id, when known: Listen plays it in place (data-play). */
  spotifyId: string | null;
  kind: 'track' | 'album';
  editHref?: string | null;
  /** Pages elsewhere; a Spotify one is left out, as Listen is it. */
  links?: { label: string; href: string; icon: string }[];
}

const { listenHref, spotifyId, kind, editHref = null, links = [] } = Astro.props;
const elsewhere = links.filter((l) => l.icon !== 'spotify');
---

<p class="actions">
  <ListenButton href={listenHref} spotifyId={spotifyId} kind={kind} />
  {
    editHref && (
      <a class="button button--quiet" href={editHref}>
        Edit
      </a>
    )
  }
  {
    elsewhere.map((l) => <ElsewhereLink href={l.href} label={l.label} icon={l.icon} iconOnly />)
  }
</p>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
</style>
