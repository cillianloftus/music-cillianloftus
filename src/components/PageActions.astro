---
/**
 * The row of actions under a track's or album's title: Listen (on Spotify,
 * or a search there), Edit for the owner, and the thing's pages elsewhere
 * as small round icons, so they are at hand without a row of their own.
 * Shared by track and album pages: change it here, both follow.
 */
import ElsewhereLink from './ElsewhereLink.astro';
import ListenButton from './ListenButton.astro';

interface Props {
  /** Where Listen goes: the Spotify page, or a Spotify search. */
  listenHref: string;
  /** The Spotify id, when known: Listen plays it in place (data-play). */
  spotifyId: string | null;
  kind: 'track' | 'album';
  editHref?: string | null;
  /** Pages elsewhere; a Spotify one is left out, as Listen is it. */
  links?: { label: string; href: string; icon: string }[];
  /** An album edition with no Spotify id yet: Listen finds it first (ListenButton). */
  findEdition?: string | null;
  /** Your own uploaded audio for it: Play your files starts it here (local-player.ts). */
  playHref?: string | null;
}

const { listenHref, spotifyId, kind, editHref = null, links = [], findEdition = null, playHref = null } = Astro.props;
const elsewhere = links.filter((l) => l.icon !== 'spotify');
---

<p class="actions">
  {
    playHref && (
      // Started in place by local-player.ts, and kept playing from page to page.
      <a class="button button--primary play-files" href={playHref}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z" /></svg>
        {kind === 'album' ? 'Play your files' : 'Play your file'}
      </a>
    )
  }
  <ListenButton href={listenHref} spotifyId={spotifyId} kind={kind} findEdition={findEdition} />
  {
    editHref && (
      <a class="button button--quiet" href={editHref}>
        Edit
      </a>
    )
  }
  {
    elsewhere.map((l) => <ElsewhereLink href={l.href} label={l.label} icon={l.icon} iconOnly />)
  }
</p>

<style>
  .play-files svg {
    width: 1rem;
    height: 1rem;
    fill: currentColor;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
</style>
