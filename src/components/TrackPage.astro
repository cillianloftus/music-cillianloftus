---
/**
 * One page of an artist's favourite tracks, numbered from `from` + 1. The
 * artist page draws the first; the rest arrive from /artist/[id]/tracks.
 * Rows are MediaRows, as every list of tracks is.
 */
import MediaRow from './MediaRow.astro';
import RowList from './RowList.astro';
import type { ArtistTrack } from '../lib/catalogue';

interface Props {
  tracks: ArtistTrack[];
  from: number;
}

const { tracks, from } = Astro.props;
---

<RowList ordered start={from + 1}>
  {
    tracks.map((t, i) => (
      <MediaRow
        href={`/track/${t.id}`}
        title={t.title}
        artKey={t.art_key}
        artTitle={t.album_title ?? t.title}
        rank={from + i + 1}
        score={{ quality: t.quality_score, personal: t.personal_score }}
        ranked
      >
        {t.album_title && (t.album_id ? <a class="album-link" href={`/album/${t.album_id}`}>{t.album_title}</a> : <span>{t.album_title}</span>)}
        {t.plays > 0 && (
          <span class="tabular">
            {t.plays.toLocaleString('en-GB')} {t.plays === 1 ? 'play' : 'plays'}
          </span>
        )}
      </MediaRow>
    ))
  }
</RowList>

<style>
  .album-link {
    text-decoration: none;
  }

  .album-link:hover {
    text-decoration: underline;
  }
</style>
