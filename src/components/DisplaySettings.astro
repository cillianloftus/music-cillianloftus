---
/**
 * How the site looks for this visitor: light or dark, and how big
 * everything is. The mode is a cookie (rendered on the server, so no flash);
 * the size is kept in this browser and applied in the page head before
 * anything paints (see Base.astro), and scales every rem on the site.
 */
import type { Theme } from '../lib/theme';

interface Props {
  theme: Theme;
}

const { theme } = Astro.props;
const returnTo = Astro.url.pathname + Astro.url.search;
---

<div class="display">
  <form class="mode" method="post" action="/api/theme" data-mode>
    <input type="hidden" name="return_to" value={returnTo} />
    <fieldset>
      <legend>Mode</legend>
      <div class="segments">
        <button type="submit" name="theme" value="dark" aria-pressed={theme === 'dark' ? 'true' : 'false'}>Dark</button>
        <button type="submit" name="theme" value="light" aria-pressed={theme === 'light' ? 'true' : 'false'}>Light</button>
      </div>
    </fieldset>
  </form>

  <div class="size" data-size>
    <label for="ui-scale">Text size</label>
    <output for="ui-scale" data-size-out>100%</output>
    <input id="ui-scale" type="range" min="0.8" max="1.3" step="0.01" value="1" data-size-input />
    <button type="button" class="reset" data-size-reset hidden>Reset</button>
  </div>
</div>

<script>
  const root = document.documentElement;

  // Mode: switch at once, without the round trip; the form posts without JavaScript.
  const mode = document.querySelector<HTMLFormElement>('[data-mode]');
  mode?.addEventListener('submit', (event) => {
    event.preventDefault();
    const next = (event.submitter as HTMLButtonElement | null)?.value === 'light' ? 'light' : 'dark';
    root.dataset.theme = next;
    document.cookie = `theme=${next}; Path=/; Max-Age=31536000; SameSite=Lax; Secure`;
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', next === 'light' ? '#f6f3ec' : '#0e0e10');
    for (const button of mode.querySelectorAll('button')) button.setAttribute('aria-pressed', String(button.value === next));
  });

  // Size: previewed live as the thumb moves, kept in this browser.
  const box = document.querySelector<HTMLElement>('[data-size]');
  if (box) {
    const input = box.querySelector<HTMLInputElement>('[data-size-input]')!;
    const out = box.querySelector<HTMLOutputElement>('[data-size-out]')!;
    const reset = box.querySelector<HTMLButtonElement>('[data-size-reset]')!;
    const show = (scale: number) => {
      out.value = `${Math.round(scale * 100)}%`;
      reset.hidden = Math.abs(scale - 1) < 0.005;
    };
    const apply = (scale: number) => {
      root.style.setProperty('--ui-scale', String(scale));
      show(scale);
      try {
        if (Math.abs(scale - 1) < 0.005) localStorage.removeItem('ui-scale');
        else localStorage.setItem('ui-scale', String(scale));
      } catch {}
    };
    const current = Number(getComputedStyle(root).getPropertyValue('--ui-scale')) || 1;
    input.value = String(current);
    show(current);
    // Everything above the slider grows or shrinks with it, which would carry
    // it off screen mid-drag: scroll by the same amount to keep it in place.
    input.addEventListener('input', () => {
      const before = input.getBoundingClientRect().top;
      apply(Number(input.value));
      window.scrollBy(0, input.getBoundingClientRect().top - before);
    });
    reset.addEventListener('click', () => {
      input.value = '1';
      apply(1);
    });
  }
</script>

<style>
  .display {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-m);
    background: var(--surface-1);
  }

  fieldset {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    border: 0;
  }

  legend,
  label {
    float: left;
    font-weight: 700;
  }

  .segments {
    display: inline-flex;
    padding: 3px;
    border: 1px solid var(--border);
    border-radius: 999px;
  }

  .segments button {
    min-height: calc(var(--target) - 8px);
    padding-inline: var(--space-4);
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--text-muted);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .segments button[aria-pressed='true'] {
    background: var(--surface-2);
    color: var(--text);
  }

  .size {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }

  output {
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  input[type='range'] {
    grid-column: 1 / -1;
    width: 100%;
    min-height: var(--target);
    margin: 0;
    accent-color: var(--accent);
  }

  .reset {
    grid-column: 1 / -1;
    justify-self: start;
    min-height: var(--target);
    padding: 0;
    border: 0;
    background: none;
    color: var(--text-muted);
    font: inherit;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, currentColor 32%, transparent);
    text-underline-offset: 0.22em;
    cursor: pointer;
  }
</style>
