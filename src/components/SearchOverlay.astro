---
/**
 * Search as an overlay over the current page: opens from the header's
 * search button, "/" or Ctrl/Cmd+K; closes on Escape, a click outside, or
 * following a result. Results come as you type. Without JavaScript the
 * search button simply goes to the search page.
 *
 * On phones it is a panel of its own above the tab bar, opened from the
 * Search tab with the keyboard already up (focus has to happen in the same
 * tap for that, hence a panel rather than a page): the box sits at the
 * bottom, in thumb reach, with things to browse above it until you type.
 * Back closes it.
 */
---

<dialog class="search-overlay" data-search-overlay aria-label="Search">
  <form method="get" action="/search" class="search-box" role="search">
    <svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="10.5" cy="10.5" r="6"></circle>
      <path d="M15 15l5 5"></path>
    </svg>
    <label for="overlay-q" class="visually-hidden">Search artists, albums and tracks</label>
    <input
      id="overlay-q"
      name="q"
      type="search"
      placeholder="Artists, albums, tracks"
      autocomplete="off"
      spellcheck="false"
      data-1p-ignore
      data-lpignore="true"
      data-bwignore
      data-form-type="other"
    />
    <button type="button" class="close" data-close aria-label="Close search">Esc</button>
  </form>
  <div class="results" data-results aria-live="polite"></div>
  <div class="suggest" data-suggest hidden></div>
</dialog>

<script>
  import { pictureAt } from '../lib/pictures';

  type Row = { href: string; title: string; detail: string; art: string | null; score?: number | null };
  type Found = { q: string; canImport?: boolean; artists: Row[]; albums: Row[]; tracks: Row[] };

  const dialog = document.querySelector<HTMLDialogElement>('[data-search-overlay]');
  const input = dialog?.querySelector<HTMLInputElement>('input');
  const results = dialog?.querySelector<HTMLElement>('[data-results]');
  let timer: number | undefined;
  let latest = '';

  const phone = window.matchMedia('(max-width: 39.99rem)');
  const suggest = dialog?.querySelector<HTMLElement>('[data-suggest]');
  let suggested = false;

  function open() {
    if (!dialog) return;
    if (dialog.open) {
      input?.focus();
      return;
    }
    if (phone.matches) {
      // Not modal: the tab bar stays in reach below it.
      dialog.show();
      document.documentElement.dataset.searching = '';
      history.pushState({ search: true }, '');
      showSuggestions();
    } else {
      dialog.showModal();
    }
    input?.select();
  }
  function close() {
    if (!dialog?.open) return;
    input?.blur();
    dialog.close();
  }
  dialog?.addEventListener('close', () => {
    // The box hides with the panel but can keep focus, and Android then
    // leaves its keyboard up over a page with nothing to type in.
    input?.blur();
    delete document.documentElement.dataset.searching;
    if (history.state?.search) history.back();
  });
  // Following a link from the panel takes the panel's history entry, so
  // one Back returns to the page it was opened over.
  dialog?.addEventListener('click', (event) => {
    const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('a[href]');
    if (!link || !history.state?.search || event.metaKey || event.ctrlKey || event.shiftKey) return;
    event.preventDefault();
    location.replace(link.href);
  });
  // A page brought back from the back/forward cache starts with the panel shut.
  window.addEventListener('pageshow', (event) => {
    if (event.persisted && dialog?.open && !history.state?.search) {
      input?.blur();
      dialog.close();
    }
  });
  // Back closes the panel rather than leaving the page.
  window.addEventListener('popstate', () => {
    if (dialog?.open) {
      history.replaceState(null, '');
      input?.blur();
      dialog.close();
    }
  });

  type Pick = { href: string; title: string; art?: string | null; image?: string | null; hue?: number };
  type Picks = { recent: Pick[]; artists: Pick[]; genres: Pick[] };

  async function showSuggestions() {
    if (!suggest || suggested) return;
    suggested = true;
    try {
      const picks = (await (await fetch('/api/suggest')).json()) as Picks;
      const section = (name: string, kind: string, items: Pick[], draw: (p: Pick) => HTMLElement) => {
        const el = document.createElement('section');
        const h = document.createElement('h2');
        h.textContent = name;
        const ul = document.createElement('ul');
        ul.setAttribute('role', 'list');
        ul.className = kind;
        for (const item of items) {
          const li = document.createElement('li');
          li.appendChild(draw(item));
          ul.appendChild(li);
        }
        el.appendChild(h);
        el.appendChild(ul);
        return el;
      };
      const tile = (p: Pick, round = false) => {
        const a = document.createElement('a');
        a.href = p.href;
        const pic = document.createElement('span');
        pic.className = round ? 'pic round' : 'pic';
        const src = p.image ? pictureAt(p.image, 160) : p.art ? `/${p.art}/128.webp` : null;
        if (src) {
          const img = document.createElement('img');
          img.src = src;
          img.alt = '';
          img.loading = 'lazy';
          pic.appendChild(img);
        }
        const name = document.createElement('span');
        name.className = 'name';
        name.textContent = p.title;
        a.appendChild(pic);
        a.appendChild(name);
        return a;
      };
      const genre = (p: Pick) => {
        const a = document.createElement('a');
        a.href = p.href;
        a.className = 'genre';
        a.style.setProperty('--h', String(p.hue ?? 30));
        a.textContent = p.title;
        return a;
      };
      const parts = [
        picks.recent.length ? section('Rated lately', 'row', picks.recent, (p) => tile(p)) : null,
        picks.artists.length ? section('Artists you rate highest', 'row', picks.artists, (p) => tile(p, true)) : null,
        picks.genres.length ? section('Genres', 'genres', picks.genres, genre) : null,
      ].filter((x): x is HTMLElement => x !== null);
      suggest.replaceChildren(...parts);
      suggest.hidden = (input?.value.trim().length ?? 0) >= 2;
    } catch {
      suggested = false;
    }
  }

  // The header's search button opens the overlay instead of the page.
  document.querySelectorAll<HTMLAnchorElement>('a.search-link').forEach((link) =>
    link.addEventListener('click', (event) => {
      if (event.metaKey || event.ctrlKey || event.shiftKey) return;
      event.preventDefault();
      open();
    }),
  );
  document.addEventListener('keydown', (event) => {
    const typing = (event.target as HTMLElement).closest('input, textarea, select, [contenteditable]');
    if ((event.key === 'k' && (event.metaKey || event.ctrlKey)) || (event.key === '/' && !typing)) {
      event.preventDefault();
      open();
    }
  });
  // A click on the backdrop (the dialog itself, outside its box) closes it.
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) close();
  });
  dialog?.querySelector('[data-close]')?.addEventListener('click', close);

  function row(r: Row): HTMLLIElement {
    const li = document.createElement('li');
    const a = document.createElement('a');
    a.href = r.href;
    const art = document.createElement('span');
    art.className = 'art';
    if (r.art) {
      const img = document.createElement('img');
      img.src = `/${r.art}/128.webp`;
      img.alt = '';
      img.loading = 'lazy';
      art.appendChild(img);
    }
    const text = document.createElement('span');
    text.className = 'text';
    const title = document.createElement('span');
    title.className = 'title';
    title.textContent = r.title;
    const detail = document.createElement('span');
    detail.className = 'detail';
    detail.textContent = r.detail;
    text.appendChild(title);
    text.appendChild(detail);
    a.appendChild(art);
    a.appendChild(text);
    if (r.score != null) {
      const score = document.createElement('span');
      score.className = 'score tabular';
      score.textContent = String(r.score);
      a.appendChild(score);
    }
    li.appendChild(a);
    return li;
  }

  function render(found: Found) {
    if (!results) return;
    const groups: [string, Row[]][] = [
      ['Artists', found.artists],
      ['Albums', found.albums],
      ['Tracks', found.tracks],
    ];
    const sections = groups
      .filter(([, rows]) => rows.length)
      .map(([name, rows]) => {
        const section = document.createElement('section');
        const h = document.createElement('h2');
        h.textContent = name;
        const ul = document.createElement('ul');
        ul.setAttribute('role', 'list');
        rows.forEach((r) => ul.appendChild(row(r)));
        section.appendChild(h);
        section.appendChild(ul);
        return section;
      });
    // Nobody here by that name: offer to bring their discography in.
    const offer = () => {
      const a = document.createElement('a');
      a.className = 'import-offer';
      a.href = `/manage/import?${new URLSearchParams({ artist: found.q })}#disco-heading`;
      a.textContent = `Import “${found.q}” from MusicBrainz →`;
      return a;
    };
    const canOffer = found.canImport && found.q.length >= 2 && found.artists.length === 0;
    if (sections.length === 0) {
      const p = document.createElement('p');
      p.className = 'empty';
      if (found.q.length < 2) {
        results.replaceChildren();
        return;
      }
      p.textContent = `Nothing called “${found.q}” here yet.`;
      results.replaceChildren(p, ...(canOffer ? [offer()] : []));
    } else {
      const all = document.createElement('a');
      all.className = 'all';
      all.href = `/search?q=${encodeURIComponent(found.q)}`;
      all.textContent = 'All results';
      results.replaceChildren(...sections, ...(canOffer ? [offer()] : []), all);
    }
  }

  input?.addEventListener('input', () => {
    window.clearTimeout(timer);
    const q = input.value.trim();
    latest = q;
    if (suggest && suggested) suggest.hidden = q.length >= 2;
    timer = window.setTimeout(async () => {
      if (q.length < 2) return render({ q, artists: [], albums: [], tracks: [] });
      try {
        const res = await fetch(`/api/search?q=${encodeURIComponent(q)}`);
        const found = (await res.json()) as Found;
        if (found.q === latest) render(found);
      } catch {
        /* Offline: the Enter key still goes to the search page. */
      }
    }, 150);
  });

  // Up and down move through results; Enter in the box opens the first.
  dialog?.addEventListener('keydown', (event) => {
    const links = [...(results?.querySelectorAll<HTMLAnchorElement>('a') ?? [])];
    const at = links.indexOf(document.activeElement as HTMLAnchorElement);
    if (event.key === 'ArrowDown') {
      event.preventDefault();
      (links[at + 1] ?? links[0])?.focus();
    } else if (event.key === 'ArrowUp') {
      event.preventDefault();
      if (at <= 0) input?.focus();
      else links[at - 1]?.focus();
    } else if (event.key === 'Enter' && document.activeElement === input && links[0] && input?.value.trim()) {
      event.preventDefault();
      location.href = links[0].href;
    }
  });
</script>

<style>
  .search-overlay {
    width: min(40rem, calc(100vw - 2 * var(--gutter)));
    max-height: min(80vh, 44rem);
    margin: 10vh auto auto;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-l);
    background: var(--surface-1);
    color: var(--text);
    box-shadow: 0 30px 80px -20px rgb(0 0 0 / 0.5);
    overflow: hidden;
  }

  .search-overlay[open] {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    animation: drop 0.16s ease-out;
  }

  .search-overlay::backdrop {
    background: rgb(0 0 0 / 0.35);
    backdrop-filter: blur(3px);
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--border);
  }

  .search-icon {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: var(--text-subtle);
    stroke-width: 2;
    stroke-linecap: round;
  }

  .search-box input {
    flex: 1;
    min-width: 0;
    min-height: var(--target);
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    font-size: var(--step-1);
    outline: none;
  }

  .close {
    flex: none;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-s);
    background: none;
    color: var(--text-muted);
    font: inherit;
    font-size: 0.75rem;
    font-weight: 700;
    cursor: pointer;
  }

  .results {
    overflow-y: auto;
    padding: var(--space-2) var(--space-2) var(--space-3);
  }

  .results :global(h2) {
    margin: var(--space-3) var(--space-3) var(--space-1);
    color: var(--text-subtle);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .results :global(ul) {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .results :global(li a) {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-m);
    color: inherit;
    text-decoration: none;
  }

  .results :global(li a:hover),
  .results :global(li a:focus-visible) {
    background: var(--surface-2);
    outline: none;
  }

  .results :global(.art) {
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
    overflow: hidden;
    border-radius: var(--radius-s);
    background: var(--surface-2);
  }

  .results :global(.art img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .results :global(.text) {
    display: grid;
    flex: 1;
    min-width: 0;
  }

  .results :global(.title) {
    overflow: hidden;
    font-weight: 700;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .results :global(.detail) {
    overflow: hidden;
    color: var(--text-muted);
    font-size: var(--step--1);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .results :global(.score) {
    flex: none;
    font-weight: 800;
  }

  .results :global(.all) {
    display: inline-flex;
    margin: var(--space-3) var(--space-3) 0;
    color: var(--text-muted);
    font-size: var(--step--1);
    font-weight: 650;
  }

  .results :global(.empty) {
    padding: var(--space-4);
    color: var(--text-muted);
  }

  @keyframes drop {
    from {
      opacity: 0;
      transform: translateY(-0.5rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .search-overlay[open] {
      animation: none;
    }
  }

  .results :global(.import-offer) {
    display: flex;
    align-items: center;
    min-height: var(--target);
    margin: var(--space-2) var(--space-3) 0;
    padding: 0 var(--space-4);
    border: 1px dashed var(--accent);
    border-radius: var(--radius-m);
    color: var(--accent);
    font-weight: 700;
    text-decoration: none;
  }

  .results :global(.import-offer:hover) {
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }

  .suggest {
    padding: var(--space-4) 0 var(--space-5);
  }

  .suggest :global(section + section) {
    margin-top: var(--space-5);
  }

  .suggest :global(h2) {
    margin: 0 var(--gutter) var(--space-3);
    font-size: var(--step-1);
  }

  .suggest :global(ul) {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* A row that scrolls sideways, starting on the page's left edge. */
  .suggest :global(.row) {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 6.5rem;
    gap: var(--space-3);
    padding-inline: var(--gutter);
    overflow-x: auto;
    scroll-padding-inline: var(--gutter);
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .suggest :global(.row li) {
    scroll-snap-align: start;
  }

  .suggest :global(.row a) {
    display: grid;
    gap: var(--space-2);
    color: inherit;
    text-decoration: none;
  }

  .suggest :global(.pic) {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius-s);
    background: var(--surface-2);
  }

  .suggest :global(.pic.round) {
    border-radius: 50%;
  }

  .suggest :global(.pic img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .suggest :global(.name) {
    display: -webkit-box;
    overflow: hidden;
    font-size: var(--step--1);
    font-weight: 650;
    line-height: 1.3;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .suggest :global(.genres) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2);
    padding-inline: var(--gutter);
  }

  /* Each genre in its own colour, the one the genre map gives it. */
  .suggest :global(.genre) {
    display: flex;
    align-items: end;
    min-height: 4rem;
    padding: var(--space-3);
    border-radius: var(--radius-m);
    background: oklch(0.42 0.11 var(--h));
    color: #fff;
    font-weight: 750;
    line-height: 1.2;
    text-decoration: none;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.5rem);
    }
  }

  /* Before anything is typed it is one clean bar: no empty panel or rule. */
  .results:empty {
    display: none;
  }

  .search-overlay:has(.results:empty) .search-box {
    border-bottom: 0;
  }

  .search-overlay:has(.results:empty) {
    grid-template-rows: auto;
  }

  /* Phones: a panel filling the whole screen, the box at the bottom with its
     surface running on down behind the floating tab bar (so no page shows
     through around the bar), everything else scrolling above it. */
  @media (max-width: 39.99rem) {
    .search-overlay {
      position: fixed;
      inset: 0;
      z-index: 44;
      width: auto;
      max-width: none;
      height: auto;
      max-height: none;
      margin: 0;
      border: 0;
      border-radius: 0;
      background: var(--bg);
      box-shadow: none;
    }

    .search-overlay[open],
    .search-overlay:has(.results:empty)[open] {
      display: flex;
      flex-direction: column;
      animation: rise 0.14s ease-out;
    }

    .results,
    .suggest {
      flex: 1;
      min-height: 0;
      overflow-y: auto;
      overscroll-behavior: contain;
    }

    .search-box,
    .search-overlay:has(.results:empty) .search-box {
      order: 2;
      padding: var(--space-2) var(--gutter) calc(var(--space-2) + var(--tabbar-space));
      border-top: 1px solid var(--border);
      border-bottom: 0;
      background: var(--surface-1);
    }

    /* Keyboard up: the tab bar has stepped away, so the box sits on the keys. */
    :global(:root[data-keyboard]) .search-overlay .search-box {
      padding-bottom: var(--space-2);
    }

    .search-box input {
      font-size: var(--step-0);
    }

    /* Escape means nothing on a phone; Back and the tabs close it. */
    .close {
      display: none;
    }
  }
</style>
