---
/**
 * The genre tree as a tree (src/lib/genre-tree-art.ts). The whole tree fits
 * the screen; tapping it, or the button, zooms in to read the canopy, and
 * it scrolls both ways from where it was tapped. The genre list on the
 * page carries the same information as text, so the drawing is hidden
 * from assistive technology.
 */
import { hueOf } from '../lib/art/playlist';
import type { TreeArt } from '../lib/genre-tree-art';

interface Props {
  art: TreeArt;
}

const { art } = Astro.props;
const f = (n: number) => n.toFixed(1);
const plural = (n: number) => `${n} ${n === 1 ? 'track' : 'tracks'}`;
---

<figure class="tree-art" data-tree-art>
  <div class="frame" data-frame>
    <svg viewBox={art.viewBox} aria-hidden="true" focusable="false" data-svg>
      <path class="trunk" d={art.trunk} />
      <g class="branches" fill="none" stroke-linecap="round">
        {
          art.branches.map((b) => (
            <path d={b.d} stroke-width={f(b.width)} class:list={[{ graft: b.graft }]} style={`--h: ${hueOf(b.family)}`} />
          ))
        }
      </g>
      {
        art.leaves.map((leaf) => (
          <a href={`/genre/${leaf.id}`} tabindex="-1" class="leaf-link">
            <title>
              {leaf.name}: {plural(leaf.total)}
              {leaf.total !== leaf.tracks && leaf.tracks > 0 ? ` (${leaf.tracks} tagged ${leaf.name} itself)` : ''}
            </title>
            {leaf.r > 0 && (
              <path
                class="leaf"
                style={`--h: ${hueOf(leaf.family)}`}
                transform={`translate(${f(leaf.x)} ${f(leaf.y)}) rotate(${f(leaf.angle)})`}
                d={`M0,${f(leaf.r * 1.2)}Q${f(leaf.r)},0 0,${f(-leaf.r * 1.5)}Q${f(-leaf.r)},0 0,${f(leaf.r * 1.2)}Z`}
              />
            )}
            {leaf.label && (
              <text
                class:list={['label', { fork: !leaf.outer }]}
                x={f(leaf.label.x)}
                y={f(leaf.label.y)}
                font-size={f(leaf.label.size)}
                text-anchor={leaf.label.anchor}
                dominant-baseline={leaf.outer ? 'central' : 'auto'}
                transform={leaf.label.rotate ? `rotate(${f(leaf.label.rotate)} ${f(leaf.label.x)} ${f(leaf.label.y)})` : undefined}
              >
                {leaf.name}
              </text>
            )}
            {/* A larger, invisible target than the leaf. */}
            <circle class="hit" cx={f(leaf.x)} cy={f(leaf.y)} r={f(Math.max(leaf.r + 4, 8))} />
          </a>
        ))
      }
    </svg>
  </div>
  <figcaption>
    <span class="muted">
      {art.count} genres. Thickness is tracks beneath; a second branch into a genre is a further parent.
    </span>
    <button type="button" class="button button--quiet zoom" aria-pressed="false" data-zoom>Zoom in</button>
  </figcaption>
</figure>

<script>
  for (const figure of document.querySelectorAll<HTMLElement>('[data-tree-art]')) {
    const frame = figure.querySelector<HTMLElement>('[data-frame]')!;
    const svg = figure.querySelector<SVGSVGElement>('[data-svg]')!;
    const button = figure.querySelector<HTMLButtonElement>('[data-zoom]')!;
    const ZOOM = 3;

    /** Zooms in on a point given as shares of the drawing's width and height. */
    const zoom = (on: boolean, fx = 0.5, fy = 0.35) => {
      figure.classList.toggle('zoomed', on);
      button.setAttribute('aria-pressed', String(on));
      button.textContent = on ? 'Zoom out' : 'Zoom in';
      if (on) {
        frame.scrollLeft = fx * svg.clientWidth - frame.clientWidth / 2;
        frame.scrollTop = fy * svg.clientHeight - frame.clientHeight / 2;
      }
    };
    button.addEventListener('click', () => zoom(!figure.classList.contains('zoomed')));
    // A tap on the whole tree zooms to that spot; once zoomed, leaves are links.
    svg.addEventListener('click', (event) => {
      if (figure.classList.contains('zoomed')) return;
      event.preventDefault();
      const box = svg.getBoundingClientRect();
      zoom(true, (event.clientX - box.left) / box.width, (event.clientY - box.top) / box.height);
    });
    figure.style.setProperty('--zoom', String(ZOOM));
  }
</script>

<style>
  .tree-art {
    display: grid;
    gap: var(--space-3);
    margin: 0;
  }

  .frame {
    overflow: hidden;
    border-radius: var(--radius-l);
    background: radial-gradient(ellipse at 50% 40%, color-mix(in oklch, var(--surface-1) 70%, transparent), transparent 70%);
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
    max-height: 80vh;
    margin-inline: auto;
    font-family: var(--font-sans);
    cursor: zoom-in;
  }

  .zoomed .frame {
    overflow: auto;
    max-height: 75vh;
    overscroll-behavior: contain;
  }

  .zoomed svg {
    width: calc(100% * var(--zoom, 3));
    max-width: none;
    max-height: none;
    cursor: auto;
  }

  .trunk {
    fill: oklch(0.36 0.025 60);
  }

  /* Bark in each family's hue, muted, so the leaves carry the colour. */
  .branches path {
    stroke: oklch(0.4 0.035 var(--h));
  }

  .branches .graft {
    stroke: oklch(0.55 0.08 var(--h));
    stroke-opacity: 0.45;
  }

  .leaf {
    fill: oklch(0.7 0.14 var(--h));
  }

  .label {
    fill: var(--text-muted);
    font-weight: 600;
  }

  /* Names at forks sit over branches: a halo of the page keeps them clear. */
  .label.fork {
    fill: var(--text);
    font-weight: 750;
    paint-order: stroke;
    stroke: var(--bg);
    stroke-width: 4px;
    stroke-linejoin: round;
  }

  .hit {
    fill: transparent;
  }

  .leaf-link:hover .leaf,
  .leaf-link:focus-visible .leaf {
    stroke: var(--text);
    stroke-width: 1.5;
  }

  .leaf-link:hover .label {
    fill: var(--text);
  }

  :global([data-theme='light']) .trunk {
    fill: oklch(0.55 0.04 60);
  }

  :global([data-theme='light']) .branches path {
    stroke: oklch(0.62 0.04 var(--h));
  }

  :global([data-theme='light']) .branches .graft {
    stroke: oklch(0.55 0.09 var(--h));
  }

  :global([data-theme='light']) .leaf {
    fill: oklch(0.6 0.15 var(--h));
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    font-size: var(--step--1);
  }

  .muted {
    color: var(--text-muted);
  }
</style>
