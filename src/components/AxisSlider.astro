---
/**
 * One rating axis, 0 to 10 in halves. A plain number field without
 * JavaScript; with it, a large touch slider with the value shown big in
 * the score colours, and a clear button, because leaving an axis blank is
 * meaningful (it is left out of the composite, not counted as zero).
 *
 * The number field stays the form's real input either way; the slider
 * only drives it (src/lib/client/axis-slider.ts), so what is submitted
 * never depends on the script.
 */

interface Props {
  name: string;
  label: string;
  hint?: string;
  value: number | null | undefined;
  /** Colour the value on the score scale (axes); impact uses the accent. */
  tone?: 'score' | 'accent';
  /** Offer "Doesn't apply" (an instrumental has no lyrics). */
  canNotApply?: boolean;
  notApplicable?: boolean;
}

import { scoreWord } from '../lib/format';

const { name, label, hint, value, tone = 'score', canNotApply = false, notApplicable = false } = Astro.props;
const hintId = hint ? `${name}-hint` : undefined;
// What the value means on the rating scale ("enjoy", "great"), shown small before it.
const word = tone === 'score' && value != null && !notApplicable ? scoreWord(value * 10) : undefined;
---

<div class:list={['axis', { 'is-na': notApplicable }]} data-axis data-tone={tone}>
  <div class="axis-head">
    <div class="axis-name">
      <label for={name}>{label}</label>
      {hint && <span class="hint" id={hintId}>{hint}</span>}
    </div>
    <output class="axis-value tabular" for={name} data-value data-word={word} aria-hidden="true">{notApplicable ? 'n/a' : (value ?? '–')}</output>
  </div>
  <input
    class="input axis-number"
    id={name}
    name={name}
    type="number"
    inputmode="decimal"
    min="0"
    max="10"
    step="0.5"
    value={value ?? ''}
    aria-describedby={hintId}
  />
  {
    canNotApply && (
      <label class="axis-na">
        <input type="checkbox" name={`na_${name}`} checked={notApplicable} data-na />
        <span>N/a<span class="visually-hidden"> (doesn’t apply)</span></span>
      </label>
    )
  }
</div>

<script>
  import { enhanceAxes } from '../lib/client/axis-slider';

  enhanceAxes();
</script>

<style>
  /* Two lines an axis: name, what it means and the value; then the
     slider, clear and n/a. Every axis fits on one phone screen. */
  .axis {
    display: grid;
    gap: 0;
    padding: var(--space-2) 0 0;
    border-bottom: 1px solid var(--border);
  }

  .axis-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .axis-name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--space-2);
    min-width: 0;
  }

  .axis-name label {
    font-weight: 650;
  }

  /* The value's meaning, small and quiet before it: "enjoy 7.5". */
  .axis-value[data-word]::before {
    content: attr(data-word);
    margin-right: 0.45em;
    color: var(--text-subtle);
    font-size: 0.55em;
    font-weight: 600;
    letter-spacing: 0;
    vertical-align: 0.15em;
  }

  .axis-value {
    min-width: 3ch;
    color: var(--text-subtle);
    font-size: var(--step-1);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    text-align: right;
  }

  .axis-number {
    max-width: 8rem;
  }

  .hint {
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .axis-na {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: var(--space-1);
    min-height: var(--target);
    color: var(--text-muted);
    font-size: var(--step--1);
    font-weight: 600;
    cursor: pointer;
  }

  .axis-na input {
    width: 1.1rem;
    height: 1.1rem;
    accent-color: var(--accent);
  }

  .is-na .axis-value {
    color: var(--text-subtle) !important;
    font-size: var(--step-1);
  }

  .is-na :global(.axis-control) {
    opacity: 0.35;
  }

  .is-na :global(.axis-clear) {
    visibility: hidden;
  }

  /* Enhanced: the slider replaces the number field on screen. */
  .axis :global(.axis-control) {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .axis :global(input[type='range']) {
    flex: 1;
    min-width: 0;
    /* Up and down is the page scrolling, not a rating (axis-slider.ts). */
    touch-action: pan-y;
    height: var(--target);
    margin: 0;
    background: transparent;
    cursor: pointer;
    appearance: none;
    -webkit-appearance: none;
    --fill: 0%;
    --thumb: oklch(var(--score-l) var(--score-c) var(--h, 145));
  }

  .axis[data-tone='accent'] :global(input[type='range']) {
    --thumb: var(--accent);
  }

  .axis :global(input[type='range']::-webkit-slider-runnable-track) {
    height: 8px;
    border-radius: 999px;
    background: linear-gradient(to right, var(--thumb) var(--fill), color-mix(in srgb, var(--text) 14%, transparent) var(--fill));
  }

  .axis :global(input[type='range']::-moz-range-track) {
    height: 8px;
    border-radius: 999px;
    background: linear-gradient(to right, var(--thumb) var(--fill), color-mix(in srgb, var(--text) 14%, transparent) var(--fill));
  }

  .axis :global(input[type='range']::-webkit-slider-thumb) {
    width: 28px;
    height: 28px;
    margin-top: -10px;
    border: 3px solid var(--surface-1);
    border-radius: 50%;
    background: var(--thumb);
    box-shadow: 0 1px 4px rgb(0 0 0 / 0.35);
    -webkit-appearance: none;
  }

  .axis :global(input[type='range']::-moz-range-thumb) {
    width: 22px;
    height: 22px;
    border: 3px solid var(--surface-1);
    border-radius: 50%;
    background: var(--thumb);
    box-shadow: 0 1px 4px rgb(0 0 0 / 0.35);
  }

  .axis :global(input[type='range']:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
    border-radius: 999px;
  }

  /* Not rated yet: the thumb waits, faint, until the slider is touched. */
  .axis:global(.is-unset) :global(input[type='range']) {
    --thumb: var(--text-subtle);
    opacity: 0.55;
  }

  .axis :global(.axis-clear) {
    display: grid;
    place-items: center;
    width: var(--target);
    height: var(--target);
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--text-subtle);
    cursor: pointer;
  }

  .axis :global(.axis-clear:hover) {
    background: var(--surface-2);
    color: var(--text);
  }

  .axis:global(.is-unset) :global(.axis-clear) {
    visibility: hidden;
  }

  .axis :global(.axis-clear svg) {
    width: 1rem;
    height: 1rem;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }
</style>
