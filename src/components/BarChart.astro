---
/**
 * A bar chart drawn on the server as SVG: thin bars with rounded ends
 * anchored to the baseline, a 2px gap between them, quiet gridlines, and
 * a hover readout on each bar (a native tooltip, plus a focus outline so
 * the keyboard reaches them). The same numbers are in a table beneath,
 * because a chart alone shuts some readers out.
 *
 * Vertical by default; horizontal for long category names (genres).
 */

export interface Bar {
  label: string;
  value: number;
  /** Words for the readout and table: "12 tracks", "avg 84". */
  detail: string;
  /** A CSS colour; the series colour when omitted. */
  colour?: string;
  href?: string;
}

interface Props {
  bars: Bar[];
  /** Names the chart for screen readers and the table caption. */
  title: string;
  orientation?: 'vertical' | 'horizontal';
  /** The top of the scale; the largest value when omitted. */
  max?: number;
  min?: number;
  /** How a gridline value reads: "50", "50%". */
  unit?: string;
  /** Header for the value column in the table. */
  valueLabel?: string;
  /** Label every nth bar on a crowded horizontal axis. */
  labelEvery?: number;
}

const { bars, title, orientation = 'vertical', max, min = 0, unit = '', valueLabel = 'Value', labelEvery = 1 } = Astro.props;
const top = max ?? Math.max(1, ...bars.map((b) => b.value));
const span = Math.max(1e-9, top - min);
const niceStep = (range: number) => {
  const raw = range / 4;
  const pow = 10 ** Math.floor(Math.log10(raw));
  return [1, 2, 2.5, 5, 10].map((m) => m * pow).find((s) => s >= raw) ?? raw;
};
const step = niceStep(span);
const ticks: number[] = [];
for (let t = Math.ceil(min / step) * step; t <= top + 1e-9; t += step) ticks.push(Math.round(t * 100) / 100);

// Vertical geometry
const W = 640;
const H = 220;
const PAD = { top: 12, right: 8, bottom: 28, left: 36 };
const plotW = W - PAD.left - PAD.right;
const plotH = H - PAD.top - PAD.bottom;
const slot = bars.length ? plotW / bars.length : plotW;
const gap = 2;
const barW = Math.max(2, Math.min(48, slot - gap));
const y = (v: number) => PAD.top + plotH - ((v - min) / span) * plotH;

/** A bar with its free end rounded (4px) and its baseline end square. */
function columnPath(x: number, value: number): string {
  const yTop = y(Math.max(value, min));
  const base = PAD.top + plotH;
  const r = Math.min(4, barW / 2, Math.max(0, base - yTop));
  return `M${x},${base} V${yTop + r} Q${x},${yTop} ${x + r},${yTop} H${x + barW - r} Q${x + barW},${yTop} ${x + barW},${yTop + r} V${base} Z`;
}

// Horizontal geometry
const ROW = 30;
const LABEL_W = 150;
const HW = 640;
const HH = bars.length * ROW + 24;
const hPlotW = HW - LABEL_W - 56;
const hx = (v: number) => LABEL_W + ((v - min) / span) * hPlotW;
function rowPath(i: number, value: number): string {
  const yy = i * ROW + 6;
  const h = ROW - 12;
  const x1 = hx(Math.max(value, min));
  const r = Math.min(4, h / 2, Math.max(0, x1 - LABEL_W));
  return `M${LABEL_W},${yy} H${x1 - r} Q${x1},${yy} ${x1},${yy + r} V${yy + h - r} Q${x1},${yy + h} ${x1 - r},${yy + h} H${LABEL_W} Z`;
}
const fmt = (v: number) => `${Math.round(v * 10) / 10}${unit}`;
---

<figure class="chart">
  {
    orientation === 'vertical' ? (
      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={title} preserveAspectRatio="xMidYMid meet">
        {ticks.map((t) => (
          <g class="grid">
            <line x1={PAD.left} x2={W - PAD.right} y1={y(t)} y2={y(t)} />
            <text x={PAD.left - 6} y={y(t)} text-anchor="end" dominant-baseline="central">
              {fmt(t)}
            </text>
          </g>
        ))}
        {bars.map((b, i) => {
          const x = PAD.left + i * slot + (slot - barW) / 2;
          return (
            <g class="bar" tabindex="0" aria-label={`${b.label}: ${b.detail}`}>
              <title>{`${b.label}: ${b.detail}`}</title>
              <rect class="hit" x={PAD.left + i * slot} y={PAD.top} width={slot} height={plotH} />
              {b.value > min && <path d={columnPath(x, b.value)} style={b.colour ? `fill: ${b.colour}` : undefined} />}
              {i % labelEvery === 0 && (
                <text class="tick" x={x + barW / 2} y={H - 10} text-anchor="middle">
                  {b.label}
                </text>
              )}
            </g>
          );
        })}
        <line class="baseline" x1={PAD.left} x2={W - PAD.right} y1={PAD.top + plotH} y2={PAD.top + plotH} />
      </svg>
    ) : (
      <svg viewBox={`0 0 ${HW} ${HH}`} role="img" aria-label={title} preserveAspectRatio="xMidYMid meet">
        {ticks.map((t) => (
          <g class="grid">
            <line x1={hx(t)} x2={hx(t)} y1={0} y2={HH - 20} />
            <text x={hx(t)} y={HH - 6} text-anchor="middle">
              {fmt(t)}
            </text>
          </g>
        ))}
        {bars.map((b, i) => (
          <g class="bar" tabindex="0" aria-label={`${b.label}: ${b.detail}`}>
            <title>{`${b.label}: ${b.detail}`}</title>
            <rect class="hit" x={0} y={i * ROW} width={HW} height={ROW} />
            <text class="row-label" x={LABEL_W - 10} y={i * ROW + ROW / 2} text-anchor="end" dominant-baseline="central">
              {b.label}
            </text>
            {b.value > min && <path d={rowPath(i, b.value)} style={b.colour ? `fill: ${b.colour}` : undefined} />}
            <text class="row-value" x={hx(Math.max(b.value, min)) + 8} y={i * ROW + ROW / 2} dominant-baseline="central">
              {fmt(b.value)}
            </text>
          </g>
        ))}
      </svg>
    )
  }
  <details class="table">
    <summary>Show as a table</summary>
    <table>
      <caption class="visually-hidden">{title}</caption>
      <thead>
        <tr>
          <th scope="col">{orientation === 'vertical' ? '' : 'Name'}</th>
          <th scope="col">{valueLabel}</th>
          <th scope="col">Detail</th>
        </tr>
      </thead>
      <tbody>
        {bars.map((b) => (
          <tr>
            <th scope="row">{b.href ? <a href={b.href}>{b.label}</a> : b.label}</th>
            <td class="tabular">{fmt(b.value)}</td>
            <td>{b.detail}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </details>
</figure>

<style>
  .chart {
    display: grid;
    gap: var(--space-2);
    margin: 0;
  }

  svg {
    width: 100%;
    height: auto;
    overflow: visible;
    font-family: var(--font-sans);
  }

  .grid line {
    stroke: var(--border);
    stroke-width: 1;
  }

  .grid text,
  .tick {
    fill: var(--text-subtle);
    font-size: 11px;
  }

  .baseline {
    stroke: var(--text-subtle);
    stroke-width: 1;
  }

  .bar path {
    fill: var(--accent);
    transition: opacity 0.15s;
  }

  .bar .hit {
    fill: transparent;
  }

  /* Hovering one bar quietens the rest. */
  svg:has(.bar:hover) .bar:not(:hover) path,
  svg:has(.bar:focus-visible) .bar:not(:focus-visible) path {
    opacity: 0.45;
  }

  .bar:focus,
  .bar:focus-visible {
    outline: none;
  }

  .bar:focus-visible .hit {
    stroke: var(--focus);
    stroke-width: 2;
  }

  .row-label {
    fill: var(--text);
    font-size: 13px;
    font-weight: 600;
  }

  .row-value {
    fill: var(--text-muted);
    font-size: 12px;
    font-weight: 600;
  }

  .table summary {
    display: inline-flex;
    align-items: center;
    min-height: var(--target);
    color: var(--text-muted);
    font-size: var(--step--1);
    cursor: pointer;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step--1);
  }

  th,
  td {
    padding: var(--space-2) var(--space-3) var(--space-2) 0;
    border-bottom: 1px solid var(--border);
    text-align: left;
  }

  thead th {
    color: var(--text-muted);
  }
</style>
