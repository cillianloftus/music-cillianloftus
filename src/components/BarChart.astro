---
/**
 * A bar chart drawn on the server as SVG: thin bars with rounded ends
 * anchored to the baseline, a 2px gap between them, quiet gridlines, and
 * a hover readout on each bar (a native tooltip, plus a focus outline so
 * the keyboard reaches them). The same numbers are in a table beneath,
 * because a chart alone shuts some readers out.
 *
 * Vertical by default; horizontal for long category names (genres).
 */

export interface Bar {
  label: string;
  value: number;
  /** Words for the readout and table: "12 tracks", "avg 84". */
  detail: string;
  /** A CSS colour; the series colour when omitted. */
  colour?: string;
  href?: string;
}

interface Props {
  bars: Bar[];
  /** Names the chart for screen readers and the table caption. */
  title: string;
  orientation?: 'vertical' | 'horizontal';
  /** The top of the scale; the largest value when omitted. */
  max?: number;
  min?: number;
  /** How a gridline value reads: "50", "50%". */
  unit?: string;
  /** Header for the value column in the table. */
  valueLabel?: string;
  /** Label every nth bar on a crowded horizontal axis. */
  labelEvery?: number;
}

const { bars, title, orientation = 'vertical', max, min = 0, unit = '', valueLabel = 'Value', labelEvery = 1 } = Astro.props;
const top = max ?? Math.max(1, ...bars.map((b) => b.value));
const span = Math.max(1e-9, top - min);
const niceStep = (range: number) => {
  const raw = range / 4;
  const pow = 10 ** Math.floor(Math.log10(raw));
  return [1, 2, 2.5, 5, 10].map((m) => m * pow).find((s) => s >= raw) ?? raw;
};
const step = niceStep(span);
const ticks: number[] = [];
for (let t = Math.ceil(min / step) * step; t <= top + 1e-9; t += step) ticks.push(Math.round(t * 100) / 100);

/** Where a value sits on the scale, as a percentage. */
const at = (v: number) => Math.max(0, Math.min(100, ((v - min) / span) * 100)).toFixed(2);
const crowded = bars.length > 8;
const fmt = (v: number) => `${Math.round(v * 10) / 10}${unit}`;
---

<figure class="chart">
  {
    orientation === 'vertical' ? (
      <div class:list={['vchart', { crowded }]} role="group" aria-label={title} style={`--n: ${bars.length}`}>
        <div class="plot">
          {ticks.map((t) => (
            <div class="gridline" style={`--at: ${at(t)}`} aria-hidden="true">
              <span>{fmt(t)}</span>
            </div>
          ))}
          <ol class="cols" role="list">
            {bars.map((b) => (
              <li class="col" tabindex="0" aria-label={`${b.label}: ${b.detail}`} title={`${b.label}: ${b.detail}`}>
                {b.value > min && <span class="fill" style={`--size: ${at(b.value)}${b.colour ? `; --colour: ${b.colour}` : ''}`} />}
              </li>
            ))}
          </ol>
        </div>
        <ol class="xlabels" role="list" aria-hidden="true">
          {bars.map((b, i) => (
            <li>{i % labelEvery === 0 ? b.label : ''}</li>
          ))}
        </ol>
      </div>
    ) : (
      <ol class="hchart" role="list" aria-label={title}>
        {bars.map((b) => (
          <li class="hrow" tabindex="0" aria-label={`${b.label}: ${b.detail}`} title={`${b.label}: ${b.detail}`}>
            <span class="hlabel" aria-hidden="true">
              {b.label}
            </span>
            <span class="track" aria-hidden="true">
              {b.value > min && <span class="fill" style={`--size: ${at(b.value)}${b.colour ? `; --colour: ${b.colour}` : ''}`} />}
            </span>
            <span class="hvalue tabular" aria-hidden="true">
              {fmt(b.value)}
            </span>
          </li>
        ))}
      </ol>
    )
  }
  <details class="table">
    <summary>Show as a table</summary>
    <table>
      <caption class="visually-hidden">{title}</caption>
      <thead>
        <tr>
          <th scope="col">{orientation === 'vertical' ? '' : 'Name'}</th>
          <th scope="col">{valueLabel}</th>
          <th scope="col">Detail</th>
        </tr>
      </thead>
      <tbody>
        {bars.map((b) => (
          <tr>
            <th scope="row">{b.href ? <a href={b.href}>{b.label}</a> : b.label}</th>
            <td class="tabular">{fmt(b.value)}</td>
            <td>{b.detail}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </details>
</figure>

<style>
  .chart {
    display: grid;
    gap: var(--space-2);
    margin: 0;
  }

  /* Drawn in HTML rather than a scaled picture, so its words stay at
     reading size on a phone. */
  .vchart {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    grid-template-rows: clamp(9rem, 32vw, 13rem) auto;
    column-gap: var(--space-2);
    /* Room for the top label, which sits half above the plot. */
    padding-top: var(--space-3);
  }

  .plot {
    position: relative;
    grid-column: 2;
    border-bottom: 1px solid var(--text-subtle);
  }

  .gridline {
    position: absolute;
    inset: auto 0 calc(var(--at) * 1%);
    border-top: 1px solid var(--border);
  }

  .gridline span {
    position: absolute;
    right: calc(100% + var(--space-2));
    bottom: 0;
    transform: translateY(50%);
    color: var(--text-subtle);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .cols,
  .xlabels {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cols {
    position: relative;
    height: 100%;
    align-items: end;
  }

  .col {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    height: 100%;
    border-radius: 4px 4px 0 0;
    cursor: default;
  }

  .col .fill {
    width: min(100%, 3rem);
    height: calc(var(--size) * 1%);
    border-radius: 4px 4px 0 0;
    background: var(--colour, var(--accent));
    transition: opacity 0.15s;
  }

  .xlabels {
    grid-column: 2;
    padding-top: var(--space-1);
  }

  .xlabels li {
    display: -webkit-box;
    overflow: hidden;
    color: var(--text-subtle);
    font-size: 0.75rem;
    line-height: 1.2;
    text-align: center;
    overflow-wrap: anywhere;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }

  /* Many bars on a narrow screen: every other label, so none collide. */
  @media (max-width: 39.99rem) {
    .crowded .xlabels li:nth-child(even) {
      visibility: hidden;
    }
  }

  .hchart {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hrow {
    display: grid;
    grid-template-columns: minmax(0, 9rem) minmax(0, 1fr) 2.75rem;
    align-items: center;
    gap: var(--space-3);
    min-height: 1.9rem;
    border-radius: var(--radius-s);
    cursor: default;
  }

  @media (max-width: 39.99rem) {
    .hrow {
      grid-template-columns: minmax(0, 7.5rem) minmax(0, 1fr) 2.5rem;
      gap: var(--space-2);
    }
  }

  .hlabel {
    overflow: hidden;
    font-size: var(--step--1);
    font-weight: 600;
    text-align: right;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .track {
    height: 0.9rem;
  }

  .track .fill {
    display: block;
    width: calc(var(--size) * 1%);
    height: 100%;
    border-radius: 0 4px 4px 0;
    background: var(--colour, var(--accent));
    transition: opacity 0.15s;
  }

  .hvalue {
    color: var(--text-muted);
    font-size: var(--step--1);
    font-weight: 600;
  }

  /* Hovering one bar quietens the rest. */
  .chart:has(.col:hover, .hrow:hover) :is(.col, .hrow):not(:hover) .fill,
  .chart:has(.col:focus-visible, .hrow:focus-visible) :is(.col, .hrow):not(:focus-visible) .fill {
    opacity: 0.45;
  }

  .col:focus-visible,
  .hrow:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .table summary {
    display: inline-flex;
    align-items: center;
    min-height: var(--target);
    color: var(--text-muted);
    font-size: var(--step--1);
    cursor: pointer;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step--1);
  }

  th,
  td {
    padding: var(--space-2) var(--space-3) var(--space-2) 0;
    border-bottom: 1px solid var(--border);
    text-align: left;
  }

  thead th {
    color: var(--text-muted);
  }
</style>
