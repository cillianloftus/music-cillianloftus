---
/**
 * Who made a track or an album, edited by hand: grouped by role, each with
 * a remove button, and a row to add someone. Anything after the list (a
 * lookup, a note) goes in the slot.
 */
import { creditRoles, groupCredits, roleUses, ROLE_FAMILIES, type CreditRow, type CreditTarget } from '../lib/credits';
import Edited from './Edited.astro';
import { editsOf } from '../lib/revert';

interface Props {
  entity: CreditTarget;
  id: string;
  credits: CreditRow[];
  byHand: boolean;
  defaultRole?: string;
  heading?: string;
  /** Only artist roles (an album: everything else comes from its tracks). */
  artistsOnly?: boolean;
}

const { entity, id, credits, byHand, defaultRole = 'writer', heading = 'Credits', artistsOnly = false } = Astro.props;
const groups = new Map<string, CreditRow[]>();
for (const c of credits) groups.set(c.role, [...(groups.get(c.role) ?? []), c]);
const roles = (await creditRoles()).filter((r) => !artistsOnly || r.family === 'artist');
const labelOf = new Map(roles.map((r) => [r.id, r.label]));
const roleLabel = (role: string) => labelOf.get(role) ?? role;
const families = groupCredits(roles, (r) => r).map((g) => ({ family: g.key, name: g.name, roles: g.items }));
const custom = roles.filter((r) => !r.builtin);
const uses = await roleUses(custom.map((r) => r.id));
const removable = custom.map((r) => ({ ...r, uses: uses.get(r.id) ?? 0 }));
const listId = `credit-artists-${entity}`;
const creditEdits = byHand ? await editsOf(entity, id) : new Map<string, boolean>();
---

<section aria-labelledby={`credits-heading-${entity}`} id="credits" class="card credits-card">
  <div class="section-head">
    <h2 id={`credits-heading-${entity}`}>{heading}</h2>
    {
      byHand && (
        <form method="post" action="/api/write/revert" class="edited-credits">
          <Edited entity={entity} id={id} field="credits" edits={creditEdits} />
        </form>
      )
    }
  </div>

  <div data-credit-list>
  {
    credits.length === 0 ? (
      <p class="muted">No credits.</p>
    ) : (
      <dl class="credits">
        {[...groups].map(([role, rows]) => (
          <div class="group">
            <dt>{roleLabel(role)}</dt>
            {rows.map((c) => (
              <dd>
                <a href={`/artist/${c.artist_id}`}>{c.name}</a>
                {c.credited_as && <span class="muted"> as “{c.credited_as}”</span>}
                <form method="post" action="/api/write/credits">
                  <input type="hidden" name="entity" value={entity} />
                  <input type="hidden" name="id" value={id} />
                  <input type="hidden" name="intent" value="remove_credit" />
                  <input type="hidden" name="credit" value={c.id} />
                  <button class="remove" type="submit" aria-label={`Remove ${c.name} as ${roleLabel(role).toLowerCase()}`}>
                    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" /></svg>
                  </button>
                </form>
              </dd>
            ))}
          </div>
        ))}
      </dl>
    )
  }
  </div>

  <form method="post" action="/api/write/credits" class="add" data-credit-add>
    <input type="hidden" name="entity" value={entity} />
    <input type="hidden" name="id" value={id} />
    <input type="hidden" name="intent" value="add_credit" />
    <div class="field">
      <label for={`credit-role-${entity}`}>Role</label>
      {/* Typed into and searched (the script below); the list stays for no-JS and as the value sent. */}
      <input
        class="input role-search"
        id={`credit-role-search-${entity}`}
        list={`credit-roles-${entity}`}
        value={roleLabel(defaultRole)}
        hidden
        autocomplete="off"
        spellcheck="false"
        data-role-search
        data-many
        data-1p-ignore
        data-lpignore="true"
        data-bwignore
        data-form-type="other"
      />
      <datalist id={`credit-roles-${entity}`}>{roles.map((r) => <option value={r.label} />)}</datalist>
      <select class="input" id={`credit-role-${entity}`} name="role" data-role-select>
        {families.map((f) => (
          <optgroup label={f.name}>
            {f.roles.map((r) => (
              <option value={r.id} selected={r.id === defaultRole}>
                {r.label}
              </option>
            ))}
          </optgroup>
        ))}
      </select>
    </div>
    <div class="field grow">
      <label for={`credit-who-${entity}`}>Who</label>
      <input
        class="input"
        id={`credit-who-${entity}`}
        name="who"
        list={listId}
        data-artist-names
        required
        maxlength="200"
        autocomplete="off"
        data-1p-ignore
        data-lpignore="true"
        data-bwignore
        data-form-type="other"
        aria-describedby={`credit-hint-${entity}`}
      />
    </div>
    <button class="button button--primary" type="submit">Add</button>
    <span class="hint" id={`credit-hint-${entity}`}>Anyone new is added as typed. Several roles for one person: separate them with commas.</span>
    <span class="add-status" role="status" data-credit-status></span>
  </form>

  {!artistsOnly && <details class="roles">
    <summary>A role that is not listed</summary>
    <form method="post" action="/api/write/credits" class="add">
      <input type="hidden" name="entity" value={entity} />
      <input type="hidden" name="id" value={id} />
      <input type="hidden" name="intent" value="add_role" />
      <div class="field grow">
        <label for={`role-label-${entity}`}>Name it as the sleeve does</label>
        <input class="input" id={`role-label-${entity}`} name="label" required maxlength="60" placeholder="Vocal arrangement" autocomplete="off" data-1p-ignore data-lpignore="true" data-bwignore data-form-type="other" />
      </div>
      <div class="field">
        <label for={`role-family-${entity}`}>Kind</label>
        <select class="input" id={`role-family-${entity}`} name="family">
          {Object.entries(ROLE_FAMILIES).map(([value, name]) => <option value={value} selected={value === 'performance'}>{name}</option>)}
        </select>
      </div>
      <button class="button" type="submit">Add role</button>
    </form>
    {
      removable.length > 0 && (
        <ul role="list" class="custom">
          {removable.map((r) => (
            <li>
              <span>{r.label}</span>
              <span class="muted small">{r.uses === 0 ? 'unused' : `${r.uses} ${r.uses === 1 ? 'credit' : 'credits'}`}</span>
              {r.uses === 0 && (
                <form method="post" action="/api/write/credits">
                  <input type="hidden" name="entity" value={entity} />
                  <input type="hidden" name="id" value={id} />
                  <input type="hidden" name="intent" value="remove_role" />
                  <input type="hidden" name="role" value={r.id} />
                  <button class="remove" type="submit" aria-label={`Remove the role ${r.label}`}>
                    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" /></svg>
                  </button>
                </form>
              )}
            </li>
          ))}
        </ul>
      )
    }
  </details>}

  <slot />
  <!-- Filled from /api/write/artist-names when a Who field is first used (below). -->
  <datalist id={listId} data-artist-names></datalist>
</section>

<script>
  // Names to suggest for Who, fetched the first time one is focused.
  import '../lib/client/artist-names';

  /**
   * Credits are added and removed in place, so a whole sleeve can be
   * entered one after another without the page reloading each time:
   *
   * - The role is typed and searched ("guit" finds the guitars) rather
   *   than scrolled for; the select underneath is still what is sent.
   * - Add posts in the background and the list is redrawn from the page
   *   the server answers with; Who empties and the role is ready to retype.
   * - The X takes the credit out at once, then the list is redrawn too.
   *
   * Without JavaScript every form posts and the page reloads, as before.
   */
  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-credit-add]')) {
    const search = form.querySelector<HTMLInputElement>('[data-role-search]');
    // (Cast: this project's DOM types trip over HTMLSelectElement's own remove().)
    const select = form.querySelector('[data-role-select]') as unknown as HTMLSelectElement | null;
    if (!search || !select) continue;
    const label = form.querySelector<HTMLLabelElement>(`label[for="${select.id}"]`);
    search.hidden = false;
    select.hidden = true;
    if (label) label.htmlFor = search.id;
    const byLabel = new Map([...select.options].map((o) => [o.text.trim().toLowerCase(), o.value]));
    // Several roles for one person, comma-separated (data-many): each is suggested as it is typed.
    const match = () => {
      const parts = search.value.split(',').map((p) => p.trim()).filter(Boolean);
      const unknown = parts.find((p) => !byLabel.has(p.toLowerCase()));
      const roles = parts.map((p) => byLabel.get(p.toLowerCase())).filter((r): r is string => Boolean(r));
      if (roles[0]) select.value = roles[0];
      form.dataset.roles = JSON.stringify(unknown ? [] : roles);
      search.setCustomValidity(
        !parts.length ? 'Type what they did.' : unknown ? `“${unknown}” isn’t a role yet. Pick one from the list, or add it below.` : '',
      );
      return !unknown && roles.length > 0;
    };
    match();
    search.addEventListener('input', match);
    search.addEventListener('change', match);
    // Focused, the old role is selected, so typing replaces it.
    search.addEventListener('focus', () => search.select());
  }

  const swapList = (card: Element, html: string) => {
    const cards = [...document.querySelectorAll('.credits-card')];
    const fresh = new DOMParser().parseFromString(html, 'text/html').querySelectorAll('.credits-card')[cards.indexOf(card)];
    if (!fresh) return false;
    for (const part of ['[data-credit-list]', '.section-head']) {
      const now = card.querySelector(part);
      const next = fresh.querySelector(part);
      if (now && next) now.innerHTML = next.innerHTML;
    }
    return true;
  };

  /** Posts a credits form; the page it lands on, and what it said. */
  async function post(form: HTMLFormElement, body = new FormData(form)) {
    const res = await fetch(form.action, { method: 'POST', body });
    const params = new URL(res.url).searchParams;
    const ok = res.ok && !params.get('error');
    // The page this edit was opened from shows the change when gone back to (SoftForms).
    const from = (history.state as { editFrom?: string } | null)?.editFrom;
    if (ok && from) {
      try {
        sessionStorage.setItem('soft-stale', from);
      } catch {}
    }
    return { ok, html: await res.text(), error: params.get('error'), done: params.get('done') };
  }

  // Before the page's own soft saving (SoftForms) can take the submit.
  document.addEventListener(
    'submit',
    async (event) => {
      const form = event.target as HTMLFormElement;
      const card = form.closest('.credits-card');
      const intent = form.querySelector<HTMLInputElement>('input[name="intent"]')?.value;
      if (!card || (intent !== 'add_credit' && intent !== 'remove_credit')) return;
      event.preventDefault();
      event.stopImmediatePropagation();
      const status = card.querySelector<HTMLElement>('[data-credit-status]');
      const say = (text: string, error = false) => {
        if (!status) return;
        status.textContent = text;
        status.classList.toggle('is-error', error);
      };

      if (intent === 'remove_credit') {
        // Gone at once; the list is redrawn when the server agrees.
        const row = form.closest('dd');
        const group = row?.closest('.group');
        if (row) row.hidden = true;
        if (group && ![...group.querySelectorAll('dd')].some((d) => !d.hidden)) (group as HTMLElement).hidden = true;
        try {
          const result = await post(form);
          if (!result.ok) throw new Error(result.error ?? 'That could not be removed.');
          swapList(card, result.html);
          say('Removed.');
        } catch (error) {
          if (row) row.hidden = false;
          if (group) (group as HTMLElement).hidden = false;
          say(error instanceof Error ? error.message : 'That could not be removed.', true);
        }
        return;
      }

      const search = form.querySelector<HTMLInputElement>('[data-role-search]');
      const who = form.querySelector<HTMLInputElement>('input[name="who"]');
      if (search && !search.checkValidity()) {
        search.reportValidity();
        return;
      }
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (button) button.disabled = true;
      say('Adding…');
      // Every role typed, one field each; the server credits them all.
      const body = new FormData(form);
      const roles = JSON.parse(form.dataset.roles || '[]') as string[];
      if (search && roles.length) {
        body.delete('role');
        for (const role of roles) body.append('role', role);
      }
      try {
        const result = await post(form, body);
        if (!result.ok) throw new Error(result.error ?? 'That could not be saved.');
        swapList(card, result.html);
        say(result.done ?? 'Added.');
        if (who) who.value = '';
        // Ready for the next: the role, selected, to type over.
        (search ?? who)?.focus();
        search?.select();
      } catch (error) {
        say(error instanceof Error ? error.message : 'That could not be saved.', true);
      } finally {
        if (button) button.disabled = false;
      }
    },
    true,
  );
</script>

<style>
  .add-status {
    flex-basis: 100%;
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .add-status:empty {
    display: none;
  }

  .add-status.is-error {
    color: var(--danger);
  }

  .group[hidden],
  dd[hidden],
  .add [hidden] {
    display: none;
  }

  .role-search {
    min-width: 12rem;
  }

  .card {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-l);
    background: var(--surface-1);
  }

  h2 {
    font-size: var(--step-1);
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .pill {
    padding: 2px var(--space-2);
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--text-muted);
    font-size: var(--step--1);
    font-weight: 600;
  }

  .credits {
    display: grid;
    margin: 0;
  }

  .group {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    column-gap: var(--space-4);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--border);
  }

  dt {
    grid-row: span 20;
    padding-top: var(--space-2);
    color: var(--text-muted);
    font-size: var(--step--1);
    font-weight: 600;
  }

  dd {
    display: flex;
    grid-column: 2;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--target);
    margin: 0;
  }

  dd a {
    font-weight: 650;
  }

  dd form {
    margin-left: auto;
  }

  .remove {
    display: grid;
    place-items: center;
    width: var(--target);
    height: var(--target);
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--text-subtle);
    cursor: pointer;
  }

  .remove:hover {
    background: var(--surface-2);
    color: var(--danger);
  }

  .remove svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  .add {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .add .field {
    display: grid;
    gap: var(--space-1);
  }

  .add label {
    font-size: var(--step--1);
    font-weight: 600;
  }

  .grow {
    flex: 1 1 12rem;
  }

  .add .hint {
    flex-basis: 100%;
  }

  .roles summary {
    display: inline-flex;
    align-items: center;
    min-height: var(--target);
    color: var(--text-muted);
    font-size: var(--step--1);
    cursor: pointer;
  }

  .custom {
    display: grid;
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
  }

  .custom li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--target);
  }

  .custom form {
    margin-left: auto;
  }

  .credits-card :global(.hint) {
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .credits-card :global(.lookup) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }
</style>
