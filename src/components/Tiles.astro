---
/**
 * Tiles two to a row on phones, up to four where there is room; an open
 * one takes the whole row, and the ones after it close up (dense) rather
 * than leave a gap.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={['tiles', className]}>
  <slot />
</div>

<style>
  .tiles {
    display: grid;
    /* At least 10.5rem each (two on a phone), at most four to a row. */
    grid-template-columns: repeat(auto-fill, minmax(max(10.5rem, calc((100% - 3 * var(--space-3)) / 4)), 1fr));
    grid-auto-flow: row dense;
    gap: var(--space-3);
  }

</style>
