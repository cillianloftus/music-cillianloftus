---
/**
 * Album art from stored derivatives: WebP at five widths for the browser to
 * choose from (made once each, src/lib/import/coverart.ts), the JPEG for
 * anything that ignores srcset. Square and sized up front, so it never
 * shifts layout. Without art, a quiet tile built from the title stands in.
 */
import { WEBP_SIZES } from '../lib/import/coverart';

interface Props {
  artKey: string | null;
  title: string;
  /** Empty when the title is already announced next to the image. */
  alt?: string;
  sizes: string;
  /** For the one above-the-fold image on a page. */
  priority?: boolean;
}

const { artKey, title, alt = '', sizes, priority = false } = Astro.props;
const base = artKey ? `/${artKey}` : null;
const initials = title
  .replace(/[^\p{L}\p{N}\s]/gu, '')
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((word) => word[0]!.toUpperCase())
  .join('');
---

{
  base ? (
    <img
      class="cover"
      src={`${base}/500.jpg`}
      srcset={WEBP_SIZES.map((w) => `${base}/${w}.webp ${w}w`).join(', ')}
      sizes={sizes}
      width="500"
      height="500"
      alt={alt}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : undefined}
      decoding="async"
    />
  ) : (
    // Sized like a cover (500 by 500, square), so it lays out as one wherever a cover would.
    <svg
      class="cover cover--empty"
      viewBox="0 0 100 100"
      width="500"
      height="500"
      role={alt ? 'img' : undefined}
      aria-label={alt || undefined}
      aria-hidden={alt ? undefined : 'true'}
    >
      <text x="50" y="50" text-anchor="middle" dominant-baseline="central">{initials}</text>
    </svg>
  )
}

<style>
  .cover {
    width: 100%;
    aspect-ratio: 1;
    border-radius: var(--radius-m);
    background: var(--surface-2);
    object-fit: cover;
  }

  .cover--empty {
    display: block;
    height: auto;
    background:
      radial-gradient(circle at 30% 25%, color-mix(in srgb, var(--accent) 22%, transparent), transparent 60%),
      var(--surface-2);
  }

  /* In the tile's own units, so the letters keep their share at any card width. */
  .cover--empty text {
    fill: var(--text-subtle);
    font-size: 28px;
    font-weight: 800;
    letter-spacing: -0.04em;
  }
</style>
