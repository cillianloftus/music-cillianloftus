---
import type { GenreTreeNode } from '../lib/genres';

interface Props {
  nodes: GenreTreeNode[];
}

const { nodes } = Astro.props;
const plural = (n: number) => `${n} ${n === 1 ? 'track' : 'tracks'}`;
---

<ul role="list">
  {
    nodes.map((node) => (
      <li>
        <span class="name">{node.name}</span>{' '}
        <span class="count">
          {plural(node.total)}
          {node.children.length > 0 && node.tracks > 0 && ` (${node.tracks} tagged ${node.name} itself)`}
        </span>
        {node.children.length > 0 && <Astro.self nodes={node.children} />}
      </li>
    ))
  }
</ul>

<style>
  ul {
    margin: 0;
    padding-left: var(--space-5);
    list-style: none;
    border-left: 1px solid var(--border);
  }

  :global(.genre-list) > ul {
    padding-left: 0;
    border-left: 0;
  }

  li {
    padding-block: var(--space-1);
  }

  .name {
    font-weight: 600;
  }

  .count {
    color: var(--text-muted);
    font-size: var(--step--1);
  }
</style>
