---
/**
 * The results of a query or a search: albums as cards, tracks as rows,
 * artists as plain rows. Tracks and albums use the shared pieces (MediaRow,
 * CardGrid), so results look like every other list of them.
 */
import EmptyState from './EmptyState.astro';
import type { QueryResult } from '../lib/query/run';
import AlbumCard from './AlbumCard.astro';
import CardGrid from './CardGrid.astro';
import CreditLine from './CreditLine.astro';
import MediaRow from './MediaRow.astro';
import RowList from './RowList.astro';
import Score from './Score.astro';
import { describeDuration, formatDuration } from '../lib/format';

interface Props {
  results: QueryResult[];
  /** Number the rows. Off where order is relevance rather than a ranking. */
  ranked?: boolean;
}

const { results, ranked = true } = Astro.props;
const kind = results[0]?.kind;
---

{
  results.length === 0 ? (
    <EmptyState>Nothing matches yet.</EmptyState>
  ) : kind === 'release_group' ? (
    <CardGrid>{results.map((r) => r.kind === 'release_group' && <li><AlbumCard album={r} /></li>)}</CardGrid>
  ) : kind === 'artist' ? (
    <ol class="rows" role="list">
      {results.map(
        (r, i) =>
          r.kind === 'artist' && (
            <li class="row">
              <span class="rank tabular" aria-hidden="true">{i + 1}</span>
              <div class="main">
                <a class="title" href={`/artist/${r.id}`}>{r.name}</a>
                <span class="sub">
                  {r.album_count} {r.album_count === 1 ? 'album' : 'albums'} · {r.rated_track_count} rated tracks
                </span>
              </div>
              <Score quality={r.avg_rating} size="s" />
            </li>
          ),
      )}
    </ol>
  ) : (
    <RowList ordered={ranked}>
      {results.map(
        (r, i) =>
          r.kind === 'recording' && (
            <MediaRow
              href={`/track/${r.id}`}
              title={r.title}
              artKey={r.art_key}
              artTitle={r.album_title ?? r.title}
              rank={ranked ? i + 1 : undefined}
              score={{ quality: r.quality_score, personal: r.personal_score }}
              scoreSize="s"
              ranked
            >
              <span>
                <CreditLine credits={r.credits} />
                {r.album_id && (
                  <>
                    {' · '}
                    <a class="album-link" href={`/album/${r.album_id}`}>{r.album_title}</a>
                  </>
                )}
              </span>
              <span slot="aside" class="tabular">
                {r.length_ms != null && (
                  <>
                    <span aria-hidden="true">{formatDuration(r.length_ms)}</span>
                    <span class="visually-hidden">{describeDuration(r.length_ms)}</span>
                  </>
                )}
              </span>
            </MediaRow>
          ),
      )}
    </RowList>
  )
}

<style>
  .album-link {
    color: inherit;
  }

  /* Artists: no picture here, so a rank, the name and a line beneath. */
  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .row {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--border);
  }

  .rank {
    color: var(--text-subtle);
    font-weight: 700;
    text-align: right;
  }

  .main {
    display: grid;
    min-width: 0;
  }

  .title {
    font-weight: 650;
    text-decoration: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .title:hover {
    text-decoration: underline;
  }

  .sub {
    color: var(--text-muted);
    font-size: var(--step--1);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
