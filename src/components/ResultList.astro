---
import type { QueryResult } from '../lib/query/run';
import AlbumCard from './AlbumCard.astro';
import CoverArt from './CoverArt.astro';
import CreditLine from './CreditLine.astro';
import Score from './Score.astro';
import { describeDuration, formatDuration } from '../lib/format';

interface Props {
  results: QueryResult[];
  /** Number the rows. Off where order is relevance rather than a ranking. */
  ranked?: boolean;
}

const { results, ranked = true } = Astro.props;
const kind = results[0]?.kind;
---

{
  results.length === 0 ? (
    <p class="empty">Nothing matches yet.</p>
  ) : kind === 'release_group' ? (
    <ol class="albums" role="list">
      {results.map((r) => r.kind === 'release_group' && <li><AlbumCard album={r} /></li>)}
    </ol>
  ) : kind === 'artist' ? (
    <ol class="rows" role="list">
      {results.map(
        (r, i) =>
          r.kind === 'artist' && (
            <li class="row row--artist">
              <span class="rank tabular" aria-hidden="true">{i + 1}</span>
              <div class="main">
                <a class="title" href={`/artist/${r.id}`}>{r.name}</a>
                <span class="sub">
                  {r.album_count} {r.album_count === 1 ? 'album' : 'albums'} · {r.rated_track_count} rated tracks
                </span>
              </div>
              <Score quality={r.avg_rating} size="s" />
            </li>
          ),
      )}
    </ol>
  ) : (
    <ol class:list={['rows', { unranked: !ranked }]} role="list">
      {results.map(
        (r, i) =>
          r.kind === 'recording' && (
            <li class="row">
              {ranked && <span class="rank tabular" aria-hidden="true">{i + 1}</span>}
              <div class="thumb">
                <CoverArt artKey={r.art_key} title={r.album_title ?? r.title} sizes="3rem" />
              </div>
              <div class="main">
                <a class="title track-link" href={`/track/${r.id}`}>{r.title}</a>
                <span class="sub">
                  <CreditLine credits={r.credits} />
                  {r.album_id && (
                    <>
                      {' · '}
                      <a href={`/album/${r.album_id}`}>{r.album_title}</a>
                    </>
                  )}
                </span>
              </div>
              <span class="length tabular">
                {r.length_ms != null && (
                  <>
                    <span aria-hidden="true">{formatDuration(r.length_ms)}</span>
                    <span class="visually-hidden">{describeDuration(r.length_ms)}</span>
                  </>
                )}
              </span>
              <Score ranked quality={r.quality_score} personal={r.personal_score} size="s" />
            </li>
          ),
      )}
    </ol>
  )
}

<style>
  .track-link {
    text-decoration: none;
  }

  .track-link:hover {
    text-decoration: underline;
  }

  .empty {
    padding: var(--space-6);
    border: 1px dashed var(--border);
    border-radius: var(--radius-l);
    color: var(--text-muted);
  }

  .albums {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(10rem, 40%), 1fr));
    gap: var(--space-6) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }

  .row {
    display: grid;
    grid-template-columns: 1.75rem 3rem minmax(0, 1fr) auto auto;
    align-items: center;
    gap: var(--space-3);
    min-height: 4rem;
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--border);
  }

  .row--artist {
    grid-template-columns: 1.75rem minmax(0, 1fr) auto;
  }

  .rank {
    color: var(--text-subtle);
    text-align: right;
  }

  .thumb :global(.cover) {
    border-radius: var(--radius-s);
  }

  .main {
    display: grid;
    min-width: 0;
  }

  .title {
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sub {
    color: var(--text-muted);
    font-size: var(--step--1);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .length {
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  @media (max-width: 30rem) {
    .length {
      display: none;
    }

    .row {
      grid-template-columns: 1.5rem 3rem minmax(0, 1fr) auto;
    }

    .unranked .row {
      grid-template-columns: 3rem minmax(0, 1fr) auto;
    }
  }

  @media (min-width: 30.01rem) {
    .unranked .row {
      grid-template-columns: 3rem minmax(0, 1fr) auto auto;
    }
  }
</style>
