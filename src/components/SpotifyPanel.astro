---
/**
 * The owner's Spotify controls for a playlist: push, the last push's
 * report, and anything Spotify could not supply. Nothing is dropped
 * silently (ARCHITECTURE.md §6).
 */
import { latestPush, type JobPayloads } from '../lib/jobs/queue';
import { connection, isConfigured } from '../lib/spotify/client';

interface Props {
  definitionId: string;
  spotifyPlaylistId: string | null;
  entity: string;
  userId: string;
}

const { definitionId, spotifyPlaylistId, entity, userId } = Astro.props;
const configured = isConfigured();
const status = configured ? await connection(userId) : null;
const job = await latestPush(definitionId);
const payload = job ? (JSON.parse(job.payload_json) as JobPayloads['spotify_push']) : null;
const report = job?.status === 'done' ? payload?.result : undefined;
const busy = job?.status === 'queued' || job?.status === 'running';
const when = new Intl.DateTimeFormat('en-IE', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Europe/Dublin' });
const canPush = entity === 'recording' && configured && status && status.days_left > 0;
---

<section id="spotify" class="spotify" aria-labelledby="spotify-heading" data-busy={busy ? 'true' : undefined}>
  <div class="head">
    <h2 id="spotify-heading">Spotify</h2>
    {
      spotifyPlaylistId && (
        <a href={`https://open.spotify.com/playlist/${spotifyPlaylistId}`} rel="external">
          Open<span class="visually-hidden"> in Spotify</span>
        </a>
      )
    }
  </div>

  {
    entity !== 'recording' ? (
      <p class="muted">Only track playlists can be pushed to Spotify.</p>
    ) : !configured || !status ? (
      <p class="muted">
        <a href="/manage/spotify">Connect Spotify</a> to push this playlist.
      </p>
    ) : status.days_left <= 0 ? (
      <p class="muted">
        The Spotify authorisation has expired. <a href="/manage/spotify">Reconnect</a> to push again.
      </p>
    ) : null
  }

  {
    canPush && (
      <form method="post" action="/api/write/spotify/push" data-push={definitionId}>
        <input type="hidden" name="definition_id" value={definitionId} />
        <button class="button button--primary" type="submit" disabled={busy}>
          {busy ? 'Pushing…' : spotifyPlaylistId ? 'Update on Spotify' : 'Push to Spotify'}
        </button>
      </form>
    )
  }

  <div role="status">
    {busy && <p class="muted">Matching tracks and updating the playlist. Refresh in a moment.</p>}
    {
      job?.status === 'failed' && (
        <p class="error">
          The last push failed: {job.error}{' '}
          {job.error?.includes('/manage/spotify') && <a href="/manage/spotify">Reconnect</a>}
        </p>
      )
    }
    {
      report && (
        <div class="report">
          <p>
            Pushed {report.pushed} of {report.selected} tracks
            {job?.finished_at && <> · {when.format(new Date(job.finished_at))}</>}.
          </p>
          {report.unmatched.length > 0 && (
            <details>
              <summary>{report.unmatched.length} not found on Spotify</summary>
              <ul>
                {report.unmatched.map((t) => (
                  <li>
                    {t.title}
                    {t.artist && <span class="muted"> · {t.artist}</span>}
                  </li>
                ))}
              </ul>
            </details>
          )}
          {report.unplayable.length > 0 && (
            <details open>
              <summary>{report.unplayable.length} not playable in your country</summary>
              <ul>
                {report.unplayable.map((t) => (
                  <li>{t.title}</li>
                ))}
              </ul>
            </details>
          )}
        </div>
      )
    }
  </div>
</section>

<script>
  /**
   * Draws the playlist's generated art into a JPEG and sends it with the
   * push, so the Spotify playlist gets the same cover. Workers have no
   * canvas; browsers do. Any failure falls back to a plain push.
   */
  async function coverJpeg(definitionId: string): Promise<Blob | null> {
    const image = new Image();
    image.src = `/playlist/${definitionId}/art.svg`;
    await image.decode();
    const canvas = document.createElement('canvas');
    canvas.width = canvas.height = 640;
    canvas.getContext('2d')!.drawImage(image, 0, 0, 640, 640);
    // Spotify's limit is 256 KB of base64: about 190 KB of JPEG.
    for (const quality of [0.9, 0.8, 0.65, 0.5]) {
      const blob = await new Promise<Blob | null>((resolve) => canvas.toBlob(resolve, 'image/jpeg', quality));
      if (blob && blob.size <= 190_000) return blob;
    }
    return null;
  }

  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-push]')) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const button = form.querySelector('button');
      if (button) {
        button.disabled = true;
        button.textContent = 'Pushing…';
      }
      const body = new FormData(form);
      try {
        const cover = await coverJpeg(form.dataset.push!);
        if (cover) body.set('art', cover, 'cover.jpg');
      } catch {
        // No cover this time; the tracks still go up.
      }
      try {
        const response = await fetch(form.action, { method: 'POST', body });
        location.assign(response.redirected ? response.url : location.href);
      } catch {
        form.submit();
      }
    });
  }
</script>

<style>
  .spotify {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    padding: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-l);
    background: var(--surface-1);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-4);
  }

  h2 {
    font-size: var(--step-1);
  }

  .head a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target);
    font-weight: 600;
  }

  .muted {
    color: var(--text-muted);
  }

  .error {
    color: var(--danger);
  }

  .report {
    display: grid;
    gap: var(--space-2);
  }

  summary {
    cursor: pointer;
    min-height: var(--target);
    display: flex;
    align-items: center;
    font-weight: 600;
  }

  details ul {
    margin: 0;
    padding-left: 1.2rem;
  }

  button[disabled] {
    opacity: 0.6;
    cursor: progress;
  }
</style>
