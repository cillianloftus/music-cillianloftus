---
import type { CreditPart } from '../lib/catalogue';

interface Props {
  credits: CreditPart[];
  /** Links each artist (the default). Inside a card whose title link is
      stretched over it, the artist links sit above that, so both work. */
  link?: boolean;
}

const { credits, link = true } = Astro.props;
---

{
  credits.length === 0 ? (
    <span>Unknown artist</span>
  ) : (
    credits.map((part, i) => (
      <Fragment>
        {link ? (
          <a class="credit-link" href={`/artist/${part.artist_id}`}>
            {part.name}
          </a>
        ) : (
          part.name
        )}
        {/* The final join phrase is usually empty; trailing text is dropped. */}
        {i < credits.length - 1 ? part.join_phrase || ', ' : ''}
      </Fragment>
    ))
  )
}

<style>
  .credit-link {
    position: relative;
    z-index: 2;
  }
</style>
