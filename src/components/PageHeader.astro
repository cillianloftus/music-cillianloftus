---
/**
 * The head of a library page (Artists, Diary, Genres, Playlists, Insights):
 * the title, how many there are beside it, and the page's one action at the
 * far end, all on one baseline. One size and one spacing for every such
 * page, so moving between them nothing jumps.
 */
interface Props {
  title: string;
  /** Shown small beside the title, as on shelf headings ("Albums 6"). */
  count?: number | null;
}
const { title, count = null } = Astro.props;
---

<header class="page-head">
  <h1>
    {title}
    {count !== null && <span class="count tabular">{count.toLocaleString('en-GB')}</span>}
  </h1>
  {Astro.slots.has('default') && <div class="actions"><slot /></div>}
</header>

<style>
  .page-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3) var(--space-5);
    padding-top: var(--space-6);
  }

  h1 {
    font-size: clamp(2.2rem, 1.6rem + 2.4vw, 3.25rem);
    font-weight: 850;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  /* Sits on the title's baseline, quietly. */
  .count {
    margin-left: 0.8em;
    color: var(--text-muted);
    font-size: 0.42em;
    font-weight: 650;
    letter-spacing: 0;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3);
  }
</style>
