---
/**
 * A grid of album cards: two across a phone, as many 12rem columns as fit
 * from 40rem. The same on Albums, the home page, genre and label pages.
 * Other attributes (data-…) pass through to the list.
 */
type Props = Record<string, unknown>;
const attrs = Astro.props;
---

<ul role="list" class="card-grid" {...attrs}>
  <slot />
</ul>

<style>
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(10rem, 40%), 1fr));
    gap: var(--space-6) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    .card-grid {
      grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
      gap: var(--space-6) var(--space-5);
    }
  }
</style>
