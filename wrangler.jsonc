{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": [
		"global_fetch_strictly_public",
		// AsyncLocalStorage, for values shared within one request (src/lib/request-scope.ts).
		"nodejs_als"
	],
	"name": "music-cillianloftus",
	// Wraps Astro's fetch handler and adds the scheduled handler for jobs.
	"main": "./src/worker.ts",
	"triggers": {
		// Every minute: the job runner. 04:00 UTC: the daily backup (src/worker.ts).
		"crons": ["* * * * *", "0 4 * * *"]
	},
	"vars": {
		// Cloudflare Access. The Worker verifies the Access JWT itself, so the
		// workers.dev URL cannot be used to bypass the Access policy.
		"ACCESS_TEAM_DOMAIN": "flat-cake-1c45.cloudflareaccess.com",
		"ACCESS_AUD": "783c29ec68d2f0ca1f137dca9ee90dcf6aabde40a7b39680569224e74c54a57b"
	},
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// One database and one image store for every version of the site: the
	// dev server reads and writes production's directly ("remote": true),
	// so anything imported or rated locally is live at once. LOCAL_DB=1 or
	// PERSIST_TO=<dir> runs on a local copy instead (astro.config.mjs).
	"d1_databases": [
		{
			"binding": "DB",
			"remote": true,
			"database_name": "music-db",
			"database_id": "1def270c-5393-4f62-a025-eec092098626"
		}
	],
	"kv_namespaces": [
		{
			"binding": "CACHE",
			"id": "fc56db1303464d6b98992d6068b8d896"
		}
	],
	"r2_buckets": [
		{
			"binding": "ASSET_STORE",
			"remote": true,
			"bucket_name": "music-assets"
		}
	],
	"ai": {
		"binding": "AI"
	},
	// Smaller WebP copies of covers, each made once on first request and
	// kept in R2 beside the JPEGs (src/lib/import/coverart.ts).
	"images": {
		"binding": "IMAGES",
		"remote": true
	}
}