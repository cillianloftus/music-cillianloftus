{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "music-cillianloftus",
	// Wraps Astro's fetch handler and adds the scheduled handler for jobs.
	"main": "./src/worker.ts",
	"triggers": {
		// Every minute: the job runner. 04:00 UTC: the daily backup (src/worker.ts).
		"crons": ["* * * * *", "0 4 * * *"]
	},
	"vars": {
		// Cloudflare Access. The Worker verifies the Access JWT itself, so the
		// workers.dev URL cannot be used to bypass the Access policy.
		"ACCESS_TEAM_DOMAIN": "",
		"ACCESS_AUD": ""
	},
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "music-db",
			"database_id": "1def270c-5393-4f62-a025-eec092098626"
		}
	],
	"kv_namespaces": [
		{
			"binding": "CACHE",
			"id": "fc56db1303464d6b98992d6068b8d896"
		}
	],
	"r2_buckets": [
		{
			"binding": "ASSET_STORE",
			"bucket_name": "music-assets"
		}
	],
	"ai": {
		"binding": "AI"
	}
}